    "Pause playback on a Sonos room or group.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sæt afspilning på pause i et Sonos-rum eller en gruppe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiedergabe in einem Sonos-Raum oder einer Gruppe anhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausar la reproducción en una habitación o grupo Sonos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre en pause la lecture dans une pièce ou un groupe Sonos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettere in pausa la riproduzione in una stanza o un gruppo Sonos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonos の部屋またはグループで再生を一時停止します。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sett avspilling på pause i et Sonos-rom eller en gruppe."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspelen pauzeren in een Sonos-kamer of -groep."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymaj odtwarzanie w pokoju lub grupie Sonos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausar a reprodução numa divisão ou grupo Sonos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa uppspelning i ett Sonos-rum eller en grupp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Sonos 房间或分组中暂停播放。"
          }
        }
      }
    },

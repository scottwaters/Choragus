    "Apply a saved group preset — restores the rooms grouped together plus their per-speaker volumes and EQ.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anvend en gemt gruppeforudindstilling – gendanner de grupperede rum samt lydstyrke og EQ pr. højttaler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine gespeicherte Gruppenvoreinstellung anwenden – stellt die gruppierten Räume samt Lautstärke und EQ je Lautsprecher wieder her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicar un ajuste de grupo guardado: restaura las habitaciones agrupadas junto con el volumen y EQ de cada altavoz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliquer un préréglage de groupe enregistré : rétablit les pièces groupées ainsi que le volume et l'égaliseur de chaque enceinte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Applica un preset di gruppo salvato: ripristina le stanze raggruppate con volume ed EQ di ogni diffusore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したグループプリセットを適用します。グループ化された部屋と、スピーカーごとの音量および EQ を復元します。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk en lagret gruppeforhåndsinnstilling – gjenoppretter rommene i gruppen samt volum og EQ per høyttaler."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een opgeslagen groepsvoorinstelling toepassen: herstelt de gegroepeerde kamers plus volume en EQ per speaker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastosuj zapisany preset grupy – przywraca zgrupowane pokoje oraz głośność i EQ każdego głośnika."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicar uma predefinição de grupo guardada: repõe as divisões agrupadas e o volume e EQ de cada coluna."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillämpa en sparad gruppförinställning – återställer de grupperade rummen samt volym och EQ per högtalare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用已保存的分组预设：恢复分组的房间以及每个扬声器的音量和 EQ。"
          }
        }
      }
    },
    "Go to the previous track in the room's queue.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå til forrige nummer i rummets kø."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum vorherigen Titel in der Warteschlange des Raums springen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ir a la pista anterior de la cola de la habitación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenir à la piste précédente de la file de la pièce."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna al brano precedente nella coda della stanza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "部屋のキューの前のトラックへ戻ります。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå til forrige spor i rommets kø."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naar het vorige nummer in de wachtrij van de kamer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejdź do poprzedniego utworu w kolejce pokoju."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ir para a faixa anterior na fila da divisão."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gå till föregående spår i rummets kö."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到房间队列中的上一曲。"
          }
        }
      }
    },

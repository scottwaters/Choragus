    "Plays the room if paused, pauses if playing.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspiller hvis sat på pause, sætter på pause hvis den afspiller."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt die Wiedergabe fort, wenn pausiert; pausiert, wenn sie läuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce si está en pausa, pausa si está reproduciendo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprend la lecture si elle est en pause, la met en pause sinon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduce se in pausa, mette in pausa se in riproduzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止中なら再生し、再生中なら一時停止します。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiller hvis satt på pause, pauser hvis den spiller."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speelt af als gepauzeerd, pauzeert als er wordt afgespeeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarza, jeśli wstrzymano; wstrzymuje, jeśli odtwarza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduz se estiver em pausa, pausa se estiver a reproduzir."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spelar om pausad, pausar om den spelar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已暂停则播放，正在播放则暂停。"
          }
        }
      }
    },

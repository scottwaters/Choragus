    "Set the volume on every speaker in the room or group. Levels are clamped to the Sonos 0–100 range.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indstil lydstyrken på hver højttaler i rummet eller gruppen. Niveauer begrænses til Sonos-området 0–100."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lautstärke jedes Lautsprechers im Raum oder in der Gruppe einstellen. Werte werden auf den Sonos-Bereich 0–100 begrenzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustar el volumen de cada altavoz de la habitación o grupo. Los niveles se limitan al rango Sonos 0–100."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Régler le volume de chaque enceinte de la pièce ou du groupe. Les niveaux sont limités à la plage Sonos 0–100."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta il volume di ogni diffusore nella stanza o nel gruppo. I livelli sono limitati all'intervallo Sonos 0–100."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "部屋またはグループのすべてのスピーカーの音量を設定します。レベルは Sonos の 0～100 の範囲に制限されます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Still volumet på hver høyttaler i rommet eller gruppen. Nivåer begrenses til Sonos-området 0–100."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het volume van elke speaker in de kamer of groep instellen. Niveaus worden beperkt tot het Sonos-bereik 0–100."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw głośność każdego głośnika w pokoju lub grupie. Poziomy są ograniczone do zakresu Sonos 0–100."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Definir o volume de cada coluna na divisão ou grupo. Os níveis são limitados ao intervalo Sonos 0–100."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",

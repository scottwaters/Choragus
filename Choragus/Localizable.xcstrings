    },
    "Play a speaker's line-in or TV input in a room. Selecting an input that is already playing leaves it playing, so this can run on a schedule.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspil en højttalers line-in- eller tv-indgang i et rum. En indgang, der allerede spiller, fortsætter, så handlingen kan køre efter en tidsplan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den Line-In- oder TV-Eingang eines Lautsprechers in einem Raum abspielen. Ein bereits laufender Eingang läuft weiter, daher kann die Aktion zeitgesteuert ausgeführt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproducir la entrada de línea o TV de un altavoz en una habitación. Una entrada que ya suena sigue sonando, así que puede ejecutarse de forma programada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lire l'entrée ligne ou TV d'une enceinte dans une pièce. Une entrée déjà en lecture le reste, l'action peut donc s'exécuter selon un horaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprodurre l'ingresso line-in o TV di un diffusore in una stanza. Un ingresso già in riproduzione resta tale, quindi l'azione può essere programmata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スピーカーのライン入力または TV 入力を部屋で再生します。再生中の入力はそのまま再生を続けるため、スケジュール実行に使えます。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spill en høyttalers line-in- eller TV-inngang i et rom. En inngang som allerede spiller fortsetter, så handlingen kan kjøres etter en tidsplan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De line-in- of tv-ingang van een speaker in een kamer afspelen. Een ingang die al speelt blijft spelen, dus dit kan volgens een schema draaien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarzaj wejście line-in lub TV głośnika w pokoju. Już odtwarzane wejście gra dalej, więc akcja może działać według harmonogramu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduzir a entrada de linha ou TV de uma coluna numa divisão. Uma entrada já em reprodução continua, pelo que a ação pode ser agendada."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela en högtalares line-in- eller TV-ingång i ett rum. En ingång som redan spelar fortsätter spela, så åtgärden kan köras enligt schema."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在房间中播放某个扬声器的线路输入或电视输入。正在播放的输入会继续播放，因此可以按计划运行。"
          }
        }
      }
    },

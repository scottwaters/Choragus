    "helpLicenseBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varemærker tilhører deres respektive ejere. Sonos er et registreret varemærke tilhørende Sonos, Inc."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marken gehören ihren jeweiligen Inhabern. Sonos ist eine eingetragene Marke von Sonos, Inc."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trademarks belong to their respective owners. Sonos is a registered trademark of Sonos, Inc."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las marcas pertenecen a sus respectivos propietarios. Sonos es una marca registrada de Sonos, Inc."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les marques appartiennent à leurs propriétaires respectifs. Sonos est une marque déposée de Sonos, Inc."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I marchi appartengono ai rispettivi proprietari. Sonos è un marchio registrato di Sonos, Inc."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "商標はそれぞれの所有者に帰属します。SonosはSonos, Inc.の登録商標です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varemerker tilhører sine respektive eiere. Sonos er et registrert varemerke for Sonos, Inc."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handelsmerken zijn eigendom van hun respectieve eigenaren. Sonos is een geregistreerd handelsmerk van Sonos, Inc."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znaki towarowe należą do ich prawowitych właścicieli. Sonos jest zastrzeżonym znakiem towarowym Sonos, Inc."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As marcas registradas pertencem aos seus respectivos proprietários. Sonos é uma marca registrada da Sonos, Inc."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varumärken tillhör sina respektive ägare. Sonos är ett registrerat varumärke som tillhör Sonos, Inc."
          }
        },
        "zh-Hans" : {

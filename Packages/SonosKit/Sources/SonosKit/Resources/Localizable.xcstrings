    "helpMCPBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstillinger → AI → Agentadgang gør Choragus til en Model Context Protocol-server, så en AI-assistent på denne Mac (Claude Desktop, Claude Code og andre) kan vise rum og højttalere, se hvad der afspilles, styre afspilning, lydstyrke, bland, gentag og sovetimer, læse og redigere køen, gennemse og søge i musikbiblioteket, medieservere, radio og tilkoblede tjenester, læse og redigere Choragus-playlister og mapper, bruge historikken, gemme og anvende forudindstillinger, vælge en linjeindgang og bygge en playliste ud fra en sangliste, hvor hver sang matches i biblioteket eller en tjeneste, mens rummets kø fyldes efterhånden som der findes match."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen → KI → Agentenzugriff macht Choragus zu einem Model-Context-Protocol-Server, sodass ein KI-Assistent auf diesem Mac (Claude Desktop, Claude Code und andere) Räume und Lautsprecher auflisten, die Wiedergabe sehen, Wiedergabe, Lautstärke, Zufall, Wiederholung und Schlummer-Timer steuern, die Warteschlange lesen und bearbeiten, Musikbibliothek, Medienserver, Radio und angemeldete Dienste durchsuchen, Choragus-Playlists und Ordner lesen und bearbeiten, den Wiedergabeverlauf nutzen, Voreinstellungen sichern und anwenden, einen Line-In wählen und aus einer Songliste eine Playlist erstellen kann, wobei jeder Song in der Bibliothek oder bei einem Dienst abgeglichen wird und die Warteschlange eines Raums mit jedem Treffer wächst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings → AI → Agent access turns Choragus into a Model Context Protocol server, so an AI assistant on this Mac (Claude Desktop, Claude Code and others) can list rooms and speakers, see what is playing, control playback, volume, shuffle, repeat and sleep timers, read and edit the queue, browse and search the music library, media servers, radio and signed-in services, read and edit Choragus playlists and folders, use the play history, save and apply presets, select a line-in, and build a playlist from a song list, matching each song on the library or a service and filling a room's queue as matches land."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes → IA → Acceso de agentes convierte Choragus en un servidor Model Context Protocol, de modo que un asistente de IA en este Mac (Claude Desktop, Claude Code y otros) puede listar habitaciones y altavoces, ver qué suena, controlar reproducción, volumen, aleatorio, repetición y temporizador de reposo, leer y editar la cola, explorar y buscar en la biblioteca, servidores multimedia, radio y servicios conectados, leer y editar listas y carpetas de Choragus, usar el historial, guardar y aplicar ajustes preestablecidos, elegir una entrada de línea y construir una lista a partir de canciones, comprobando cada una en la biblioteca o un servicio mientras la cola de la habitación se llena con las coincidencias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglages → IA → Accès des agents fait de Choragus un serveur Model Context Protocol : un assistant IA sur ce Mac (Claude Desktop, Claude Code et autres) peut lister pièces et enceintes, voir ce qui joue, piloter lecture, volume, aléatoire, répétition et minuteur de veille, lire et modifier la file, parcourir et chercher dans la bibliothèque, les serveurs multimédias, la radio et les services connectés, lire et modifier les playlists et dossiers Choragus, exploiter l'historique, enregistrer et appliquer des préréglages, choisir une entrée ligne, et construire une playlist depuis une liste de titres, chaque titre étant apparié dans la bibliothèque ou un service tandis que la file d'une pièce se remplit au fil des correspondances."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impostazioni → IA → Accesso agenti trasforma Choragus in un server Model Context Protocol: un assistente IA su questo Mac (Claude Desktop, Claude Code e altri) può elencare stanze e diffusori, vedere cosa è in riproduzione, controllare riproduzione, volume, casuale, ripetizione e timer di spegnimento, leggere e modificare la coda, sfogliare e cercare in libreria, server multimediali, radio e servizi collegati, leggere e modificare playlist e cartelle Choragus, usare la cronologia, salvare e applicare preset, scegliere un ingresso line-in e costruire una playlist da un elenco di brani, verificando ciascuno in libreria o su un servizio mentre la coda della stanza si riempie a ogni corrispondenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定 → AI → エージェントアクセスで Choragus は Model Context Protocol サーバーになり、この Mac の AI アシスタント（Claude Desktop、Claude Code など）が部屋とスピーカーの一覧、再生中の確認、再生・音量・シャッフル・リピート・スリープタイマーの操作、キューの読み取りと編集、ライブラリ・メディアサーバー・ラジオ・サインイン済みサービスの閲覧と検索、Choragus プレイリストとフォルダの読み取りと編集、再生履歴の利用、プリセットの保存と適用、ライン入力の選択、曲リストからのプレイリスト作成（各曲をライブラリまたはサービスで照合し、一致するたびに部屋のキューへ追加）を行えます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innstillinger → KI → Agenttilgang gjør Choragus til en Model Context Protocol-server, slik at en KI-assistent på denne Macen (Claude Desktop, Claude Code og andre) kan liste rom og høyttalere, se hva som spilles, styre avspilling, volum, tilfeldig, gjenta og sovetimer, lese og redigere køen, bla og søke i musikkbiblioteket, medieservere, radio og påloggede tjenester, lese og redigere Choragus-spillelister og mapper, bruke historikken, lagre og bruke forvalg, velge linjeinngang og bygge en spilleliste fra en sangliste der hver sang matches i biblioteket eller en tjeneste mens rommets kø fylles etter hvert som treff kommer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instellingen → AI → Agenttoegang maakt van Choragus een Model Context Protocol-server, zodat een AI-assistent op deze Mac (Claude Desktop, Claude Code en andere) kamers en speakers kan opsommen, kan zien wat er speelt, afspelen, volume, shuffle, herhalen en slaaptimers kan bedienen, de wachtrij kan lezen en bewerken, de muziekbibliotheek, mediaservers, radio en aangemelde diensten kan doorbladeren en doorzoeken, Choragus-afspeellijsten en mappen kan lezen en bewerken, de afspeelgeschiedenis kan gebruiken, voorinstellingen kan opslaan en toepassen, een line-in kan kiezen en een afspeellijst uit een nummerlijst kan bouwen, waarbij elk nummer in de bibliotheek of bij een dienst wordt gezocht en de wachtrij van een kamer zich vult zodra er treffers zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawienia → AI → Dostęp agentów zamienia Choragus w serwer Model Context Protocol, dzięki czemu asystent AI na tym Macu (Claude Desktop, Claude Code i inne) może wyświetlać pokoje i głośniki, sprawdzać, co gra, sterować odtwarzaniem, głośnością, losowaniem, powtarzaniem i wyłącznikiem czasowym, czytać i edytować kolejkę, przeglądać i przeszukiwać bibliotekę, serwery multimediów, radio i zalogowane usługi, czytać i edytować playlisty oraz foldery Choragus, korzystać z historii, zapisywać i stosować ustawienia wstępne, wybierać wejście liniowe i budować playlistę z listy utworów, dopasowując każdy w bibliotece lub usłudze, podczas gdy kolejka pokoju zapełnia się kolejnymi trafieniami."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes → IA → Acesso de agentes transforma o Choragus num servidor Model Context Protocol, para que um assistente de IA neste Mac (Claude Desktop, Claude Code e outros) possa listar salas e colunas, ver o que está a tocar, controlar reprodução, volume, aleatório, repetição e temporizador de suspensão, ler e editar a fila, navegar e pesquisar na biblioteca, servidores multimédia, rádio e serviços com sessão iniciada, ler e editar playlists e pastas do Choragus, usar o histórico, guardar e aplicar predefinições, escolher uma entrada de linha e construir uma playlist a partir de uma lista de músicas, verificando cada uma na biblioteca ou num serviço enquanto a fila da sala se enche à medida que surgem correspondências."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inställningar → AI → Agentåtkomst gör Choragus till en Model Context Protocol-server så att en AI-assistent på den här datorn (Claude Desktop, Claude Code med flera) kan lista rum och högtalare, se vad som spelas, styra uppspelning, volym, blandning, upprepning och sovtimer, läsa och redigera kön, bläddra och söka i musikbiblioteket, mediaservrar, radio och inloggade tjänster, läsa och redigera Choragus-spellistor och mappar, använda historiken, spara och tillämpa förval, välja en linjeingång och bygga en spellista från en låtlista där varje låt matchas i biblioteket eller en tjänst medan rummets kö fylls i takt med träffarna."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置 → AI → 代理访问会将 Choragus 变成 Model Context Protocol 服务器，这台 Mac 上的 AI 助手（Claude Desktop、Claude Code 等）可以列出房间和扬声器、查看正在播放的内容、控制播放、音量、随机、重复和睡眠定时器、读取和编辑队列、浏览和搜索资料库、媒体服务器、广播和已登录的服务、读取和编辑 Choragus 播放列表和文件夹、使用播放历史、保存和应用预设、选择线路输入，并根据歌曲列表构建播放列表：每首歌在资料库或服务中匹配，匹配到的曲目会随即加入房间的队列。"
          }
        }
      }
    },
    "helpMCPClientsBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiér slutpunkt og adgangstoken fra Indstillinger. Claude Code: kør kommandoen nedenfor. Claude Desktop og andre klienter, der starter en kommando, bruger samme slutpunkt via mcp-remote-broen (npx mcp-remote <slutpunkt> --header \"Authorization: Bearer <token>\"). Choragus skal køre; Åbn ved login og vågeblus-indstillingen holder det tilgængeligt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiere Endpunkt und Zugriffstoken aus den Einstellungen. Claude Code: führe den unten gezeigten Befehl aus. Claude Desktop und andere Clients, die einen Befehl starten, erreichen denselben Endpunkt über die mcp-remote-Brücke (npx mcp-remote <Endpunkt> --header \"Authorization: Bearer <Token>\"). Choragus muss laufen; „Beim Anmelden öffnen“ und die Ruhezustandsoption halten es erreichbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy the endpoint and access token from Settings. Claude Code: run the command shown below. Claude Desktop and other clients that launch a command take the same endpoint through the mcp-remote bridge (npx mcp-remote <endpoint> --header \"Authorization: Bearer <token>\"). Choragus has to be running; Open Choragus at login and the sleep option keep it available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia el punto de conexión y el token desde Ajustes. Claude Code: ejecuta el comando mostrado abajo. Claude Desktop y otros clientes que lanzan un comando usan el mismo punto mediante el puente mcp-remote (npx mcp-remote <punto> --header \"Authorization: Bearer <token>\"). Choragus debe estar abierto; Abrir al iniciar sesión y la opción de reposo lo mantienen disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiez le point d'accès et le jeton depuis les Réglages. Claude Code : exécutez la commande ci-dessous. Claude Desktop et les autres clients qui lancent une commande passent par la passerelle mcp-remote (npx mcp-remote <point d'accès> --header \"Authorization: Bearer <jeton>\"). Choragus doit être ouvert ; « Ouvrir à l'ouverture de session » et l'option de veille le gardent disponible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia endpoint e token di accesso dalle Impostazioni. Claude Code: esegui il comando mostrato sotto. Claude Desktop e gli altri client che avviano un comando usano lo stesso endpoint tramite il bridge mcp-remote (npx mcp-remote <endpoint> --header \"Authorization: Bearer <token>\"). Choragus deve essere aperto; Apri all'accesso e l'opzione stop lo tengono disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定からエンドポイントとアクセストークンをコピーします。Claude Code: 下のコマンドを実行します。Claude Desktop などコマンドを起動するクライアントは mcp-remote ブリッジ（npx mcp-remote <エンドポイント> --header \"Authorization: Bearer <トークン>\"）で同じエンドポイントを使います。Choragus が起動している必要があります。「ログイン時に開く」とスリープ設定で利用可能な状態を保てます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopier endepunkt og tilgangstoken fra Innstillinger. Claude Code: kjør kommandoen under. Claude Desktop og andre klienter som starter en kommando bruker samme endepunkt via mcp-remote-broen (npx mcp-remote <endepunkt> --header \"Authorization: Bearer <token>\"). Choragus må kjøre; Åpne ved pålogging og dvalevalget holder det tilgjengelig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieer het eindpunt en het toegangstoken uit Instellingen. Claude Code: voer de onderstaande opdracht uit. Claude Desktop en andere clients die een opdracht starten, gebruiken hetzelfde eindpunt via de mcp-remote-brug (npx mcp-remote <eindpunt> --header \"Authorization: Bearer <token>\"). Choragus moet draaien; Openen bij inloggen en de sluimeroptie houden het beschikbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skopiuj punkt końcowy i token dostępu z Ustawień. Claude Code: uruchom polecenie poniżej. Claude Desktop i inne klienty uruchamiające polecenie korzystają z tego samego punktu przez mostek mcp-remote (npx mcp-remote <punkt> --header \"Authorization: Bearer <token>\"). Choragus musi działać; Otwieraj przy logowaniu i opcja usypiania utrzymują dostępność."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie o endpoint e o token de acesso em Ajustes. Claude Code: execute o comando abaixo. O Claude Desktop e outros clientes que iniciam um comando usam o mesmo endpoint pela ponte mcp-remote (npx mcp-remote <endpoint> --header \"Authorization: Bearer <token>\"). O Choragus precisa estar aberto; Abrir ao iniciar sessão e a opção de repouso mantêm-no disponível."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiera slutpunkt och åtkomsttoken från Inställningar. Claude Code: kör kommandot nedan. Claude Desktop och andra klienter som startar ett kommando når samma slutpunkt via bryggan mcp-remote (npx mcp-remote <slutpunkt> --header \"Authorization: Bearer <token>\"). Choragus måste vara igång; Öppna vid inloggning och vilo-alternativet håller det tillgängligt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从设置中复制端点和访问令牌。Claude Code：运行下方命令。Claude Desktop 及其他通过命令启动的客户端可经 mcp-remote 桥接使用同一端点（npx mcp-remote <端点> --header \"Authorization: Bearer <令牌>\"）。Choragus 必须处于运行状态；“登录时打开”和睡眠选项可保持其可用。"
          }
        }
      }
    },

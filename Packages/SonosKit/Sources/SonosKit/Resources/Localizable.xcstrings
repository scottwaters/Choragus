    "helpBrowseSectionCardsBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidepanelets sektioner foldes sammen med et klik på overskriften, og Choragus husker hvilke der er foldet sammen. Træk en sektionsoverskrift for at ordne sektionerne som du vil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abschnitte der Seitenleiste lassen sich per Klick auf ihre Kopfzeile einklappen; Choragus merkt sich, welche eingeklappt sind. Ziehen Sie eine Kopfzeile, um die Abschnitte beliebig anzuordnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidebar sections collapse with a click on their header, and Choragus remembers which are collapsed. Drag a section header to put the sections in any order."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las secciones de la barra lateral se contraen con un clic en su cabecera, y Choragus recuerda cuáles están contraídas. Arrastra una cabecera para ordenar las secciones como quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sections de la barre latérale se replient d'un clic sur leur en-tête, et Choragus retient lesquelles sont repliées. Faites glisser un en-tête pour ranger les sections dans l'ordre voulu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sezioni della barra laterale si comprimono con un clic sull'intestazione, e Choragus ricorda quali sono compresse. Trascina un'intestazione per disporre le sezioni nell'ordine desiderato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイドバーのセクションはヘッダーをクリックすると折りたたまれ、Choragus はどれが折りたたまれているかを記憶します。セクションのヘッダーをドラッグすると、好きな順序に並べ替えられます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefeltets seksjoner slås sammen med et klikk på overskriften, og Choragus husker hvilke som er slått sammen. Dra en seksjonsoverskrift for å ordne seksjonene slik du vil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secties in de zijbalk klappen in met een klik op hun kop, en Choragus onthoudt welke zijn ingeklapt. Sleep een sectiekop om de secties in elke gewenste volgorde te zetten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekcje paska bocznego zwijają się po kliknięciu nagłówka, a Choragus zapamiętuje, które są zwinięte. Przeciągnij nagłówek sekcji, aby ułożyć sekcje w dowolnej kolejności."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As secções da barra lateral recolhem-se com um clique no cabeçalho, e o Choragus lembra-se de quais estão recolhidas. Arraste um cabeçalho de secção para ordenar as secções como quiser."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidofältets sektioner fälls ihop med ett klick på rubriken, och Choragus kommer ihåg vilka som är ihopfällda. Dra en sektionsrubrik för att ordna sektionerna som du vill."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击侧边栏各分区的标题可将其折叠，Choragus 会记住折叠状态。拖动分区标题可按任意顺序排列分区。"
          }
        }
      }
    },

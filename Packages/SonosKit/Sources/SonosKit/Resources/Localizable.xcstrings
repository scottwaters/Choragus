    "helpSortBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver gennemse- og søgeliste har en Sortér-menu: Relevans, Titel A–Å eller Å–A, Kunstner A–Å eller Å–A når rækkerne nævner en kunstner, og Nyeste eller Ældste når rækkerne har en dato."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Browse- und Suchliste hat ein Sortiermenü: Relevanz, Titel A–Z oder Z–A, Künstler A–Z oder Z–A, wenn Zeilen einen Künstler nennen, und Neueste oder Älteste, wenn Zeilen ein Datum tragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every browse and search list has a Sort menu: Relevance, Title A–Z or Z–A, Artist A–Z or Z–A when rows name an artist, and Newest or Oldest when rows carry a date."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toda lista de exploración y búsqueda tiene un menú Ordenar: Relevancia, Título A–Z o Z–A, Artista A–Z o Z–A cuando las filas nombran un artista, y Más reciente o Más antiguo cuando llevan fecha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque liste de navigation et de recherche a un menu Tri : Pertinence, Titre A–Z ou Z–A, Artiste A–Z ou Z–A quand les lignes nomment un artiste, et Plus récent ou Plus ancien quand elles portent une date."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni elenco di navigazione e ricerca ha un menu Ordina: Rilevanza, Titolo A–Z o Z–A, Artista A–Z o Z–A quando le righe indicano un artista, e Più recente o Più vecchio quando hanno una data."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのブラウズ・検索リストに並べ替えメニューがあります。関連度、タイトル A–Z / Z–A、行にアーティストがあればアーティスト A–Z / Z–A、日付があれば新しい順 / 古い順です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver bla- og søkeliste har en Sorter-meny: Relevans, Tittel A–Å eller Å–A, Artist A–Å eller Å–A når radene oppgir en artist, og Nyest eller Eldst når radene har en dato."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke bladerlijst en zoeklijst heeft een Sorteermenu: Relevantie, Titel A–Z of Z–A, Artiest A–Z of Z–A als rijen een artiest noemen, en Nieuwste of Oudste als rijen een datum hebben."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda lista przeglądania i wyszukiwania ma menu Sortuj: Trafność, Tytuł A–Z lub Z–A, Wykonawca A–Z lub Z–A, gdy wiersze podają wykonawcę, oraz Najnowsze lub Najstarsze, gdy wiersze mają datę."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as listas de navegação e pesquisa têm um menu Ordenar: Relevância, Título A–Z ou Z–A, Artista A–Z ou Z–A quando as linhas indicam um artista, e Mais recente ou Mais antigo quando têm data."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje bläddrings- och söklista har en Sortera-meny: Relevans, Titel A–Ö eller Ö–A, Artist A–Ö eller Ö–A när raderna anger en artist, samt Nyast eller Äldst när raderna har ett datum."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个浏览和搜索列表都有排序菜单：相关度、标题 A–Z 或 Z–A、行中含艺人时的艺人 A–Z 或 Z–A，以及行中含日期时的最新或最旧。"
          }
        }
      }
    },

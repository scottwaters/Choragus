    "helpIndependenceBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S1- og S2-grupper kan ikke flettes på tværs af platforme. Det er en Sonos-begrænsning, ikke en app-begrænsning. Hvert system har sin egen kø, sine egne forudindstillinger og sine egne favoritter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S1- und S2-Gruppen können nicht plattformübergreifend zusammengeführt werden. Das ist eine Sonos-Beschränkung, keine Einschränkung der App. Jedes System hat eine eigene Warteschlange, eigene Voreinstellungen und eigene Favoriten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S1 and S2 groups cannot be merged across platforms. This is a Sonos constraint, not an app limitation. Each system has its own queue, its own presets, and its own favorites."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los grupos S1 y S2 no pueden unirse entre plataformas. Es una restricción de Sonos, no una limitación de la app. Cada sistema tiene su propia cola, sus propios preajustes y sus propios favoritos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les groupes S1 et S2 ne peuvent pas être fusionnés entre plateformes. Il s’agit d’une contrainte Sonos, pas d’une limitation de l’app. Chaque système possède sa propre file d’attente, ses propres préréglages et ses propres favoris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I gruppi S1 e S2 non possono essere uniti tra piattaforme. È un vincolo di Sonos, non una limitazione dell’app. Ogni sistema ha la propria coda, i propri preset e i propri preferiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S1とS2のグループは、異なるプラットフォーム間で統合できません。これはアプリの制限ではなく、Sonosの制約です。各システムには独自のキュー、プリセット、お気に入りがあります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S1- og S2-grupper kan ikke slås sammen på tvers av plattformer. Dette er en Sonos-begrensning, ikke en begrensning i appen. Hvert system har sin egen kø, sine egne forhåndsinnstillinger og sine egne favoritter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S1- en S2-groepen kunnen niet worden samengevoegd over platforms heen. Dat is een Sonos-beperking, geen beperking van de app. Elk systeem heeft zijn eigen wachtrij, eigen presets en eigen favorieten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupy S1 i S2 nie mogą być łączone między platformami. To ograniczenie Sonos, nie aplikacji. Każdy system ma własną kolejkę, własne ustawienia i własne ulubione."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupos S1 e S2 não podem ser combinados entre plataformas. Isso é uma restrição do Sonos, não uma limitação do app. Cada sistema tem sua própria fila, predefinições e favoritos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S1- och S2-grupper kan inte slås samman över plattformsgränser. Det är en Sonos-begränsning, inte en begränsning i appen. Varje system har sin egen kö, sina egna förinställningar och sina egna favoriter."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S1 和 S2 组无法跨平台合并。这是 Sonos 的限制，不是应用的限制。每个系统有各自的队列、预设和收藏。"
          }
        }
      }
    },
    "helpKaraokePopoutBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg Visualisering → Karaoke (⌘K), eller Karaoke i gnistmenuen i værktøjslinjen, for at åbne et separat karaokevindue, der kan ændres i størrelse. Det viser de samme synkroniserede tekster meget større — læsbare tværs over rummet — og følger det rum, der var valgt, da det blev åbnet. Vælg et andet rum, og åbn det igen for at skifte rum."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle Visualisierung → Karaoke (⌘K) oder Karaoke im Funkel-Menü der Symbolleiste, um ein eigenes, größenveränderbares Karaoke-Fenster zu öffnen. Es zeigt dieselben synchronisierten Texte viel größer — vom anderen Ende des Raums lesbar — und folgt dem beim Öffnen gewählten Raum. Wähle einen anderen Raum und öffne es erneut, um den Raum zu wechseln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose Visualisation → Karaoke (⌘K), or Karaoke in the sparkles menu on the toolbar, to open a separate, resizable karaoke window. It shows the same synced lyrics at much larger size — readable from across a room — and follows the room selected when it was opened. Select another room and open it again to switch which room it tracks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige Visualización → Karaoke (⌘K), o Karaoke en el menú de destellos de la barra, para abrir una ventana de karaoke aparte y redimensionable. Muestra las mismas letras sincronizadas mucho más grandes — legibles desde el otro lado de la sala — y sigue la habitación seleccionada al abrirla. Selecciona otra habitación y ábrela de nuevo para cambiar de habitación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez Visualisation → Karaoké (⌘K), ou Karaoké dans le menu étincelles de la barre d'outils, pour ouvrir une fenêtre karaoké séparée et redimensionnable. Elle affiche les mêmes paroles synchronisées en bien plus grand — lisibles de l'autre bout de la pièce — et suit la pièce sélectionnée à l'ouverture. Sélectionnez une autre pièce et rouvrez-la pour changer de pièce suivie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli Visualizzazione → Karaoke (⌘K), o Karaoke nel menu scintille della barra degli strumenti, per aprire una finestra karaoke separata e ridimensionabile. Mostra gli stessi testi sincronizzati molto più grandi — leggibili dall'altra parte della stanza — e segue la stanza selezionata all'apertura. Seleziona un'altra stanza e riaprila per cambiare stanza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビジュアライゼーション → カラオケ（⌘K）またはツールバーのきらめきメニューのカラオケを選ぶと、サイズ変更できる独立したカラオケウィンドウが開きます。同じ同期歌詞を部屋の反対側からも読める大きさで表示し、開いたときに選択していた部屋に追従します。別の部屋を選んで開き直すと追従する部屋が切り替わります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg Visualisering → Karaoke (⌘K), eller Karaoke i gnistmenyen på verktøylinjen, for å åpne et eget karaokevindu som kan endres i størrelse. Det viser de samme synkroniserte tekstene mye større — lesbare tvers over rommet — og følger rommet som var valgt da det ble åpnet. Velg et annet rom og åpne det på nytt for å bytte rom."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies Visualisatie → Karaoke (⌘K), of Karaoke in het sterretjesmenu op de knoppenbalk, om een apart, schaalbaar karaokevenster te openen. Het toont dezelfde gesynchroniseerde songteksten veel groter — leesbaar van de andere kant van de kamer — en volgt de kamer die bij het openen was gekozen. Kies een andere kamer en open het opnieuw om van kamer te wisselen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz Wizualizacja → Karaoke (⌘K) lub Karaoke w menu iskier na pasku narzędzi, aby otworzyć osobne, skalowalne okno karaoke. Pokazuje te same zsynchronizowane teksty w znacznie większym rozmiarze — czytelne z drugiego końca pokoju — i podąża za pokojem wybranym przy otwarciu. Wybierz inny pokój i otwórz je ponownie, aby zmienić śledzony pokój."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha Visualização → Karaoke (⌘K), ou Karaoke no menu de brilhos da barra de ferramentas, para abrir uma janela de karaoke separada e redimensionável. Mostra as mesmas letras sincronizadas muito maiores — legíveis do outro lado da sala — e segue a sala selecionada quando foi aberta. Selecione outra sala e abra-a de novo para mudar de sala."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj Visualisering → Karaoke (⌘K), eller Karaoke i gnistmenyn i verktygsfältet, för att öppna ett separat, storleksändringsbart karaokefönster. Det visar samma synkade texter mycket större — läsbara tvärs över rummet — och följer rummet som var valt när det öppnades. Välj ett annat rum och öppna det igen för att byta rum."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择可视化 → 卡拉 OK（⌘K），或工具栏闪光菜单中的卡拉 OK，可打开一个独立、可调整大小的卡拉 OK 窗口。它以大得多的字号显示同样的同步歌词，隔着房间也能看清，并跟随打开时选中的房间。选择另一个房间再打开一次即可切换跟随的房间。"
          }
        }
      }
    },

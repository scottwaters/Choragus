    "largeAddReadyBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik på ”Tilføj alle” for at sætte disse numre i kø. Køpanelet opdateres løbende, efterhånden som de tilføjes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke auf „Alle hinzufügen“, um diese Titel in die Warteschlange aufzunehmen. Die Warteschlange wird beim Hinzufügen fortlaufend aktualisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click Add All to queue these tracks. The queue panel will update progressively as they’re added."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa «Añadir todo» para poner estas canciones en la cola. El panel de la cola se irá actualizando a medida que se añadan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur « Tout ajouter » pour mettre ces morceaux en file d’attente. Le panneau de file d’attente se met à jour au fur et à mesure de leur ajout."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic su «Aggiungi tutto» per mettere questi brani in coda. Il pannello della coda si aggiornerà progressivamente man mano che vengono aggiunti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「すべて追加」をクリックすると、これらの曲がキューに追加されます。追加されるたびにキューパネルが順次更新されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikk på «Legg til alle» for å legge disse sporene i køen. Køpanelet oppdateres etter hvert som de legges til."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik op ‘Alles toevoegen’ om deze nummers in de wachtrij te plaatsen. Het wachtrijpaneel wordt geleidelijk bijgewerkt naarmate ze worden toegevoegd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij „Dodaj wszystkie”, aby dodać te utwory do kolejki. Panel kolejki będzie aktualizowany na bieżąco w miarę ich dodawania."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique em «Adicionar todas» para colocar estas faixas na fila. O painel da fila será atualizado progressivamente à medida que forem adicionadas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicka på ”Lägg till alla” för att köa dessa spår. Köpanelen uppdateras efter hand som de läggs till."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按“全部添加”将这些曲目加入队列。在添加过程中，队列面板将逐步更新。"
          }
        }
      }
    },

    "diagSaveEncryptedLogHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriver en krypteret diagnosepakke til en placering, du vælger. Pakken er ugennemsigtig for alle undtagen vedligeholderen — del den direkte med vedkommende."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibt ein verschlüsseltes Diagnose-Bundle an einen Ort deiner Wahl. Das Bundle ist für alle außer dem Betreuer undurchsichtig — teile es direkt mit ihm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Writes an encrypted diagnostic bundle to a location you choose. The bundle is opaque to anyone except the maintainer — share it directly with them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe un paquete de diagnóstico cifrado en la ubicación que elijas. El paquete es opaco para cualquiera excepto el responsable — compártelo directamente con él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrit un lot de diagnostic chiffré à l’emplacement de votre choix. Le lot est opaque pour tous sauf le mainteneur — partagez-le directement avec lui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrive un pacchetto diagnostico cifrato in una posizione a tua scelta. Il pacchetto è opaco per chiunque tranne il manutentore — condividilo direttamente con lui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した場所に暗号化された診断バンドルを書き出します。バンドルはメンテナー以外には不透明です。直接共有してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriver en kryptert diagnosepakke til en plassering du velger. Pakken er ugjennomsiktig for alle unntatt vedlikeholderen — del den direkte med vedkommende."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schrijft een versleuteld diagnostisch pakket naar een door jou gekozen locatie. Het pakket is ondoorzichtig voor iedereen behalve de beheerder — deel het rechtstreeks met hem."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuje zaszyfrowany pakiet diagnostyczny w wybranej lokalizacji. Pakiet jest nieczytelny dla wszystkich oprócz opiekuna — udostępnij go bezpośrednio."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escreve um pacote de diagnóstico cifrado num local à sua escolha. O pacote é opaco para todos exceto o responsável — partilhe-o diretamente com ele."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriver ett krypterat diagnospaket till en plats du väljer. Paketet är ogenomskinligt för alla utom underhållaren — dela det direkt med honom."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将加密的诊断包写入您选择的位置。除维护者外的任何人都看不到包内容——请直接与维护者分享。"
          }
        }
      }
    },

    "karaokeStyleHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynamisk forstørrer den aktive linje og dæmper naboerne. Klassisk holder hver synlig linje i én størrelse som en traditionel karaokeskærm — kun gennemsigtigheden markerer den aktive linje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Dynamisch“ vergrößert die aktive Zeile und blendet benachbarte Zeilen ab. „Klassisch“ hält jede sichtbare Zeile auf einer Größe wie auf einem traditionellen Karaoke-Bildschirm — nur die Deckkraft markiert die aktive Zeile."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynamic scales the active line up and dims neighbours. Classic holds every visible line at one size so the readout matches a traditional karaoke screen — only opacity marks the active row."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Dinámico” aumenta la línea activa y atenuá las vecinas. “Clásico” mantiene cada línea visible al mismo tamaño, como una pantalla de karaoke tradicional; solo la opacidad marca la línea activa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Dynamique » agrandit la ligne active et atténue les voisines. « Classique » maintient chaque ligne visible à la même taille, comme un écran de karaoké traditionnel ; seule l’opacité marque la ligne active."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Dinamico” ingrandisce la riga attiva e attenua le vicine. “Classico” mantiene ogni riga visibile alla stessa dimensione, come uno schermo karaoke tradizionale; solo l’opacità segna la riga attiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ダイナミック」はアクティブ行を拡大し、隣接行を暗くします。「クラシック」は伝統的なカラオケ画面のように、表示されるすべての行を同じサイズで表示し、不透明度だけでアクティブ行を示します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynamisk forstørrer den aktive linjen og demper naboene. Klassisk holder hver synlig linje i én størrelse som en tradisjonell karaokeskjerm — bare opasiteten markerer den aktive linjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynamisch vergroot de actieve regel en dimt de buren. Klassiek houdt elke zichtbare regel op één grootte zoals een traditioneel karaokescherm — alleen de dekking markeert de actieve regel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryb dynamiczny powiększa aktywną linię i przyciemnia sąsiednie. Klasyczny utrzymuje każdą widoczną linię w jednym rozmiarze — tylko nieprzezroczystość oznacza aktywną linię."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dinâmico amplia a linha ativa e atenua as vizinhas. Clássico mantém cada linha visível num único tamanho, como uma tela de karaokê tradicional; apenas a opacidade marca a linha ativa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynamiskt förstorar den aktiva raden och dämpar grannraderna. Klassiskt håller varje synlig rad i en storlek som en traditionell karaokeskärm — bara opaciteten markerar den aktiva raden."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「动态」会放大当前歌词行并淡化相邻行。「经典」保持所有可见行为同一尺寸，与传统卡拉OK屏幕一致，仅通过不透明度标注当前行。"
          }
        }
      }
    },

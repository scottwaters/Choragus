        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non testé — nous ne savons pas encore si ce service fonctionne avec Choragus. Touchez Connecter pour essayer ; signalez le résultat sur GitHub afin que nous puissions le marquer comme confirmé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non testato — non sappiamo ancora se questo servizio funziona tramite Choragus. Tocca Connetti per provare; segnala l’esito su GitHub così possiamo contrassegnarlo come confermato funzionante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未テスト — このサービスが Choragus で動作するかはまだ不明です。「接続」をタップして試してください。結果を GitHub で報告していただければ、動作確認済みとしてマークします。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke testet — vi vet ikke ennå om denne tjenesten fungerer via Choragus. Trykk Koble til for å prøve; rapporter resultatet på GitHub så vi kan markere den som bekreftet fungerende."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niet getest — we weten nog niet of deze dienst werkt via Choragus. Tik op Verbind om het te proberen; meld succes of mislukking op GitHub zodat we het als bevestigd werkend kunnen markeren."
          }
        },
        "pl" : {
          "stringUnit" : {

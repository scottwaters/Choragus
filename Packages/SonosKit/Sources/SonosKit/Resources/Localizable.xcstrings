    "directBrowseUnavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direkte gennemsyn er ikke tilgængeligt. Brug SMAPI Plex-posten under Musiktjenester i sidepanelet for at gennemse via Sonos-relæet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direktes Durchsuchen nicht verfügbar. Verwende den SMAPI-Plex-Eintrag unter Musikdienste in der Seitenleiste, um über das Sonos-Relay zu browsen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direct browse unavailable. Use the Music Services SMAPI Plex entry from the sidebar to browse via Sonos's relay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exploración directa no disponible. Usa la entrada Plex de SMAPI en Servicios de música de la barra lateral para explorar mediante el relé de Sonos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navigation directe indisponible. Utilisez l'entrée Plex SMAPI des Services musicaux dans la barre latérale pour naviguer via le relais Sonos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esplorazione diretta non disponibile. Usa la voce Plex SMAPI in Servizi musicali nella barra laterale per sfogliare tramite il relay Sonos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直接ブラウズは利用できません。サイドバーのミュージックサービスにある SMAPI Plex の項目を使って Sonos リレー経由でブラウズしてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direkte bla er ikke tilgjengelig. Bruk SMAPI Plex-oppføringen under Musikktjenester i sidefeltet for å bla via Sonos-reléet."
          }
        },
        "nl" : {

    "mcpQuietHoursHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I disse timer må en assistent ikke sætte nogen højttaler over den stille grænse, uanset den normale grænse. Bruger denne Macs ur."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwischen diesen Uhrzeiten darf ein Assistent keinen Lautsprecher über die Ruhegrenze stellen, unabhängig von der normalen Grenze. Nutzt die Uhr dieses Macs."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Between these hours an assistant may not set any speaker above the quiet limit, whatever the standing limit says. Uses this Mac's clock."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre estas horas un asistente no puede poner ningún altavoz por encima del límite de silencio, sea cual sea el límite habitual. Usa el reloj de este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre ces heures, un assistant ne peut régler aucune enceinte au-dessus de la limite calme, quelle que soit la limite habituelle. Utilise l'horloge de ce Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In queste ore un assistente non può portare alcun diffusore oltre il limite silenzioso, qualunque sia il limite abituale. Usa l'orologio di questo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この時間帯は、通常の上限にかかわらず、アシスタントはどのスピーカーも静音上限を超えて設定できません。この Mac の時計を使用します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I disse timene kan ikke en assistent sette noen høyttaler over den stille grensen, uansett den vanlige grensen. Bruker klokken på denne Macen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tussen deze uren mag een assistent geen enkele speaker boven de stille limiet zetten, ongeacht de normale limiet. Gebruikt de klok van deze Mac."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W tych godzinach asystent nie może ustawić żadnego głośnika powyżej limitu ciszy, niezależnie od zwykłego limitu. Używa zegara tego Maca."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre estas horas um assistente não pode pôr nenhuma coluna acima do limite de silêncio, seja qual for o limite habitual. Usa o relógio deste Mac."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under dessa timmar får en assistent inte ställa någon högtalare över den tysta gränsen, oavsett den vanliga gränsen. Använder den här datorns klocka."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此时段内，无论常规上限如何，助手都不能将任何扬声器设置得高于安静上限。使用这台 Mac 的时钟。"
          }
        }
      }
    },

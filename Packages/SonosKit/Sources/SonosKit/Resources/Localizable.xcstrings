    "homeTheaterSurroundHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under musikafspilning kan surround-højttalerne supplere med subtil, ambient lyd eller højere fuldbredde-lyd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während der Musikwiedergabe können Surround-Lautsprecher dezenten, ambienten Klang oder lauten Vollbereichs-Ton beisteuern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "During music playback, the surround speakers can supplement with subtle, ambient sound or louder, full range sound."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante la reproducción de música, los altavoces surround pueden complementar con sonido ambiental sutil o sonido de rango completo más alto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant la lecture de musique, les enceintes surround peuvent ajouter un son subtil et ambiant ou un son plus fort et pleine bande."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante la riproduzione musicale, i surround possono integrare con suono ambientale sottile o pieno più forte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音楽再生中、サラウンドスピーカーは控えめの環境音もしくは大きなフルレンジの音で補完できます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under musikkavspilling kan surround-høyttalerne supplere med subtil, ambient lyd eller høyere fullbredde-lyd."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tijdens muziekweergave kunnen de surround-luidsprekers aanvullen met subtiele omgevingsklank of luider, volledig bereik."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podczas odtwarzania muzyki głośniki surround mogą uzupełniać subtelnym dźwiękiem otoczenia lub głośniejszym dźwiękiem pełnozakresowym."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante a reprodução, os alto-falantes surround podem complementar com som ambiental sutil ou som de faixa completa mais alto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under musikuppspelning kan surroundhögtalarna komplettera med subtilt, ambient ljud eller högre fullregisterljud."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音乐播放期间，环绕音箱可以提供微妙的环境声音或更响亮的全频声音。"
          }
        }
      }
    },

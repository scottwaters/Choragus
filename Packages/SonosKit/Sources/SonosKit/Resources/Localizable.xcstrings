    "helpIgnoreTVBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Ignorer TV / HDMI / Linjeindgang\" under Indstillinger skjuler disse indgange, så en soundbars tv-kilde aldrig vises som en afspilningsmulighed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„TV / HDMI / Line-In ignorieren“ in den Einstellungen blendet diese Eingänge aus, sodass die Fernsehquelle einer Soundbar nie als Wiedergabeoption erscheint."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignore TV / HDMI / Line-In in Settings hides those inputs, so a soundbar's television source never appears as something to play."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Ignorar TV / HDMI / Entrada de línea\" en Ajustes oculta esas entradas, para que la fuente de televisión de una barra de sonido nunca aparezca como algo para reproducir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'option \"Ignorer TV / HDMI / Entrée ligne\" dans les Réglages masque ces entrées, de sorte que la source de la télévision d'une barre de son n'apparaît jamais comme un élément à lire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Ignora TV / HDMI / Ingresso linea\" in Impostazioni nasconde quegli ingressi, in modo che la sorgente televisiva di una soundbar non appaia mai come opzione da riprodurre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」の「TV / HDMI / ライン入力を無視」をオンにするとこれらの入力が非表示になるため、サウンドバーのテレビソースが再生可能な項目として表示されることはありません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Ignorer TV / HDMI / Linjeinngang\" i Innstillinger skjuler disse inngangene, slik at lydplankens TV-kilde aldri vises som noe du kan spille av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Negeer TV / HDMI / Lijn-in\" in Instellingen verbergt deze invoer, zodat de televisiebron van een soundbar nooit verschijnt als iets om af te spelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Ignoruj TV / HDMI / Wejście liniowe\" w Ustawieniach ukrywa te wejścia, dzięki czemu źródło telewizyjne soundbara nigdy nie pojawia się jako opcja do odtwarzania."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Ignorar TV / HDMI / Entrada de linha\" nas Definições oculta essas entradas, para que a fonte de televisão de uma barra de som nunca apareça como algo a reproduzir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Ignorera TV / HDMI / Linjeingång\" i Inställningar döljer dessa ingångar, så en soundbars TV-källa aldrig visas som ett uppspelningsalternativ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“设置”中的“忽略 TV / HDMI / 线路输入”会隐藏这些输入，这样条形音响的电视音源就永远不会显示为可播放项目。"
          }
        }
      }
    },

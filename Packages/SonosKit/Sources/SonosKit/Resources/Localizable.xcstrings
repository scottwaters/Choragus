    "helpQueueLibraryBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinduet Playlistehåndtering (⌘L) gemmer køer på denne Mac, ordnet i mapper. Gem den aktuelle kø, gendan en til enhver gruppe, eller eksportér en kø som M3U eller CSV. Lokale køer er private for Choragus — de skrives ikke til Sonos-systemet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Fenster Playlist-Manager (⌘L) speichert Warteschlangen auf diesem Mac, geordnet in Ordnern. Sichere die aktuelle Warteschlange, stelle eine in jeder Gruppe wieder her oder exportiere sie als M3U oder CSV. Lokale Warteschlangen bleiben in Choragus — sie werden nicht ins Sonos-System geschrieben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Playlist Manager window (⌘L) stores play queues on this Mac, organised into folders. Save the current queue, restore one to any group, or export a queue as M3U or CSV. Local queues are private to Choragus — they are not written to the Sonos system."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ventana Gestor de listas (⌘L) guarda colas en este Mac, organizadas en carpetas. Guarda la cola actual, restaura una en cualquier grupo o expórtala como M3U o CSV. Las colas locales son privadas de Choragus: no se escriben en el sistema Sonos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fenêtre Gestionnaire de playlists (⌘L) conserve des files de lecture sur ce Mac, classées en dossiers. Enregistrez la file actuelle, restaurez-en une dans n'importe quel groupe ou exportez-la en M3U ou CSV. Les files locales restent propres à Choragus — elles ne sont pas écrites dans le système Sonos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La finestra Gestione playlist (⌘L) conserva le code su questo Mac, organizzate in cartelle. Salva la coda corrente, ripristinane una in qualsiasi gruppo o esportala come M3U o CSV. Le code locali restano private di Choragus — non vengono scritte nel sistema Sonos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレイリストマネージャウィンドウ（⌘L）は、この Mac にキューをフォルダ整理して保存します。現在のキューを保存し、任意のグループに復元し、M3U または CSV に書き出せます。ローカルのキューは Choragus 内だけのもので、Sonos システムには書き込まれません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinduet Spillelistebehandling (⌘L) lagrer køer på denne Macen, ordnet i mapper. Lagre den gjeldende køen, gjenopprett en til hvilken som helst gruppe, eller eksporter en kø som M3U eller CSV. Lokale køer er private for Choragus — de skrives ikke til Sonos-systemet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het venster Afspeellijstbeheer (⌘L) bewaart wachtrijen op deze Mac, geordend in mappen. Bewaar de huidige wachtrij, herstel er een naar elke groep of exporteer een wachtrij als M3U of CSV. Lokale wachtrijen blijven binnen Choragus — ze worden niet naar het Sonos-systeem geschreven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okno Menedżer playlist (⌘L) przechowuje kolejki na tym Macu, uporządkowane w folderach. Zapisz bieżącą kolejkę, przywróć ją do dowolnej grupy lub wyeksportuj jako M3U lub CSV. Lokalne kolejki są prywatne dla Choragus — nie są zapisywane w systemie Sonos."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A janela Gestor de playlists (⌘L) guarda filas neste Mac, organizadas em pastas. Guarde a fila atual, restaure uma para qualquer grupo ou exporte uma fila como M3U ou CSV. As filas locais são privadas do Choragus — não são escritas no sistema Sonos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fönstret Spellisthanteraren (⌘L) lagrar köer på den här datorn, ordnade i mappar. Spara den aktuella kön, återställ en till valfri grupp eller exportera en kö som M3U eller CSV. Lokala köer är privata för Choragus — de skrivs inte till Sonos-systemet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放列表管理器窗口（⌘L）把播放队列保存在这台 Mac 上，按文件夹整理。保存当前队列、恢复到任意分组，或导出为 M3U 或 CSV。本地队列仅属于 Choragus，不会写入 Sonos 系统。"
          }
        }
      }
    },
    "helpQueueLibraryDeletedBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når en Choragus-afspilningsliste slettes, flyttes den til Slettede emner i sidepanelet, hvor Gendan lægger den tilbage i dens mapper. Slettede afspilningslister fjernes permanent efter 30 dage, eller med det samme via Tøm slettede emner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Löschen einer Choragus-Playlist wird sie in die Gelöschten Objekte in der Seitenleiste verschoben; „Wiederherstellen“ legt sie wieder in ihre Ordner. Gelöschte Playlists werden nach 30 Tagen endgültig entfernt, oder sofort mit „Gelöschte Objekte leeren“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting a Choragus playlist moves it to Deleted Items in the sidebar, where Restore puts it back in its folders. Deleted playlists are removed for good after 30 days, or at once with Empty Deleted Items."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al eliminar una lista de Choragus, pasa a Elementos eliminados en la barra lateral, donde Restaurar la devuelve a sus carpetas. Las listas eliminadas se borran definitivamente a los 30 días, o de inmediato con Vaciar elementos eliminados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression d'une liste Choragus la déplace dans Éléments supprimés, dans la barre latérale, où Restaurer la remet dans ses dossiers. Les listes supprimées sont retirées définitivement après 30 jours, ou immédiatement avec Vider les éléments supprimés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminando una playlist Choragus la si sposta in Elementi eliminati nella barra laterale, dove Ripristina la riporta nelle sue cartelle. Le playlist eliminate vengono rimosse definitivamente dopo 30 giorni, o subito con Svuota elementi eliminati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus プレイリストを削除するとサイドバーの「削除済み項目」に移動し、「復元」で元のフォルダに戻せます。削除したプレイリストは 30 日後に完全に消去されるか、「削除済み項目を空にする」ですぐに消去できます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når en Choragus-spilleliste slettes, flyttes den til Slettede elementer i sidepanelet, der Gjenopprett legger den tilbake i mappene sine. Slettede spillelister fjernes permanent etter 30 dager, eller med en gang via Tøm slettede elementer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een Choragus-afspeellijst verwijderen verplaatst haar naar Verwijderde items in de zijbalk, waar Herstellen haar terug in haar mappen zet. Verwijderde afspeellijsten worden na 30 dagen definitief verwijderd, of direct met Verwijderde items legen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięcie playlisty Choragus przenosi ją do Usuniętych elementów na pasku bocznym, gdzie Przywróć umieszcza ją z powrotem w jej folderach. Usunięte playlisty są trwale usuwane po 30 dniach lub od razu przez Opróżnij usunięte elementy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluir uma playlist do Choragus a move para Itens excluídos na barra lateral, onde Restaurar a devolve às suas pastas. Playlists excluídas são removidas definitivamente após 30 dias, ou de imediato com Esvaziar itens excluídos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När en Choragus-spellista raderas flyttas den till Raderade objekt i sidofältet, där Återställ lägger tillbaka den i sina mappar. Raderade spellistor tas bort permanent efter 30 dagar, eller direkt med Töm raderade objekt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除 Choragus 播放列表会将其移至侧边栏的“已删除项目”，在那里“恢复”可将其放回原文件夹。已删除的播放列表会在 30 天后被永久清除，或通过“清空已删除项目”立即清除。"
          }
        }
      }
    },
    "helpQueueLibraryExportBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En kø kan eksporteres som M3U eller CSV, dubleres eller klones til en Choragus-kø, så en Sonos-playliste kan redigeres uden at røre ved originalen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Warteschlange kann als M3U oder CSV exportiert, dupliziert oder in eine Choragus-Warteschlange geklont werden, sodass eine Sonos-Playlist bearbeitet werden kann, ohne das Original zu verändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A queue can be exported as M3U or CSV, duplicated, or cloned into a Choragus queue so a Sonos playlist can be edited without touching the original."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una cola puede exportarse como M3U o CSV, duplicarse o clonarse en una cola de Choragus para poder editar una playlist de Sonos sin tocar la original."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une file d'attente peut être exportée au format M3U ou CSV, dupliquée ou clonée dans une file d'attente Choragus pour qu'une playlist Sonos puisse être modifiée sans toucher à l'original."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una coda può essere esportata come M3U o CSV, duplicata o clonata in una coda Choragus in modo da poter modificare una playlist Sonos senza toccare l'originale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キューはM3UまたはCSVとして書き出したり、複製したり、Choragusキューにクローン化したりできるため、オリジナルを変更せずにSonosプレイリストを編集できます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En kø kan eksporteres som M3U eller CSV, dupliseres, eller klones til en Choragus-kø slik at en Sonos-spilleliste kan redigeres uten at originalen røres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een wachtrij kan worden geëxporteerd als M3U of CSV, worden gedupliceerd of worden gekloond naar een Choragus-wachtrij, zodat een Sonos-afspeellijst kan worden bewerkt zonder het origineel te wijzigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolejkę można wyeksportować jako M3U lub CSV, powielić lub sklonować do kolejki Choragus, dzięki czemu playlistę Sonos można edytować bez modyfikowania oryginału."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma fila pode ser exportada como M3U ou CSV, duplicada ou clonada numa fila Choragus para que uma playlist Sonos possa ser editada sem alterar a original."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En kö kan exporteras som M3U eller CSV, dupliceras eller klonas till en Choragus-kö så att en Sonos-spellista kan redigeras utan att originalet ändras."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "队列可导出为 M3U 或 CSV 格式、进行复制，或者克隆到 Choragus 队列，这样即可在不修改原播放列表的情况下编辑 Sonos 播放列表。"
          }
        }
      }
    },

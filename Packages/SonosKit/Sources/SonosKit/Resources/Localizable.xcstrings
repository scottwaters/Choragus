    "testedConnectedBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotify og Plex er testet og bekræftet. Tilslut din konto; for Spotify skal du derefter tilføje en favoritsæt via Sonos-appen for at aktivere fuld gennemsyn og afspilning. Plex streamer fra din egen server, så når det er tilsluttet, fungerer søgning direkte mod dit bibliotek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotify und Plex wurden getestet und bestätigt. Verbinde dein Konto; füge für Spotify danach einen favorisierten Song über die Sonos-App hinzu, um vollständiges Durchsuchen und Wiedergabe zu aktivieren. Plex streamt vom eigenen Server, daher funktioniert die Suche nach dem Verbinden direkt gegen deine Bibliothek."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotify and Plex have been tested and confirmed working. Connect your account; for Spotify, then add one favorited song through the Sonos app to enable full browsing and playback. Plex streams from your own server, so once connected the search works against your library directly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotify y Plex han sido probados y confirmados. Conecta tu cuenta; para Spotify, agrega después una canción favorita a través de la app Sonos para habilitar navegación y reproducción completas. Plex transmite desde tu propio servidor, así que una vez conectado la búsqueda funciona directamente contra tu biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotify et Plex ont été testés et fonctionnent. Connectez votre compte ; pour Spotify, ajoutez ensuite une chanson favorite via l’application Sonos pour activer la navigation et la lecture complètes. Plex diffuse depuis votre propre serveur, donc une fois connecté, la recherche fonctionne directement avec votre bibliothèque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotify e Plex sono stati testati e confermati. Connetti il tuo account; per Spotify, aggiungi poi un brano preferito tramite l’app Sonos per abilitare navigazione e riproduzione complete. Plex trasmette dal tuo server, quindi una volta connesso la ricerca funziona direttamente sulla tua libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotify と Plex はテスト済みで動作します。アカウントを接続してください。Spotify の場合、その後 Sonos アプリでお気に入りの曲を 1 つ追加してフルブラウズと再生を有効にしてください。Plex は自分のサーバーからストリームするので、接続後はライブラリに対して検索が直接動作します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotify og Plex er testet og bekreftet. Koble til kontoen din; for Spotify, legg deretter til en favorisert låt via Sonos-appen for å aktivere full bla og avspilling. Plex streamer fra din egen server, så når det er tilkoblet fungerer søk direkte mot biblioteket ditt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotify en Plex zijn getest en werken. Verbind je account; voor Spotify voeg je daarna één favoriet nummer toe via de Sonos-app om volledig bladeren en afspelen in te schakelen. Plex streamt vanaf je eigen server, dus na verbinden werkt zoeken direct tegen je bibliotheek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotify i Plex zostały przetestowane i działają. Połącz konto; dla Spotify dodaj potem jeden polubiony utwór w aplikacji Sonos, aby włączyć pełne przeglądanie i odtwarzanie. Plex strumieniuje z Twojego własnego serwera, więc po połączeniu wyszukiwanie działa bezpośrednio na Twojej bibliotece."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotify e Plex foram testados e funcionam. Conecte sua conta; para Spotify, adicione depois uma música favorita pelo app Sonos para ativar navegação e reprodução completas. Plex transmite do seu próprio servidor, então depois de conectado a busca funciona direto contra sua biblioteca."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotify och Plex har testats och fungerar. Anslut ditt konto; för Spotify, lägg sedan till en favoriserad låt via Sonos-appen för att aktivera full bläddring och uppspelning. Plex strömmar från din egen server, så när det är anslutet fungerar sökning direkt mot ditt bibliotek."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotify 和 Plex 已测试并确认可用。连接您的账户；对于 Spotify，然后通过 Sonos 应用添加一首收藏歌曲，以启用完整浏览和播放。Plex 从您自己的服务器传输，因此连接后搜索直接针对您的库运行。"
          }
        }
      }
    },

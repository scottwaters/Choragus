    "doubleScrobbleWarning" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis Spotify, Apple Music eller en anden musiktjeneste allerede scrobbler til Last.fm, vil aktivering her give dubletter. Udeluk dem nedenfor, eller lad dette være deaktiveret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Spotify, Apple Music oder ein anderer Musikdienst bereits zu Last.fm scrobbelt, erzeugt eine Aktivierung hier Duplikate. Schließe diese Dienste unten aus oder lasse dies deaktiviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If Spotify, Apple Music, or another music service is already scrobbling to Last.fm, enabling it here will produce duplicates. Exclude those services below, or leave this disabled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si Spotify, Apple Music u otro servicio ya hace scrobble a Last.fm, activarlo aquí generará duplicados. Excluye esos servicios abajo o deja esto desactivado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si Spotify, Apple Music ou un autre service musical scrobble déjà vers Last.fm, l’activer ici créera des doublons. Excluez ces services ci-dessous ou laissez cette option désactivée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se Spotify, Apple Music o un altro servizio sta già facendo scrobble su Last.fm, abilitarlo qui produrrà duplicati. Escludi quei servizi di seguito o lascia disattivato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotify、Apple Music などの他サービスが既に Last.fm にスクロブルしている場合、ここで有効にすると重複します。それらを下で除外するか、無効のままにしてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis Spotify, Apple Music eller en annen musikktjeneste allerede scrobbler til Last.fm, vil aktivering her gi duplikater. Ekskluder dem nedenfor, eller la dette være deaktivert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Spotify, Apple Music of een andere muziekdienst al scrobblet naar Last.fm, zorgt inschakelen hier voor duplicaten. Sluit die diensten hieronder uit of laat dit uitgeschakeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli Spotify, Apple Music lub inna usługa już scrobbluje do Last.fm, włączenie tego tutaj spowoduje duplikaty. Wyklucz te usługi poniżej lub pozostaw to wyłączone."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se o Spotify, Apple Music ou outro serviço já faz scrobble para o Last.fm, ativá-lo aqui gerará duplicatas. Exclua esses serviços abaixo ou deixe desativado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om Spotify, Apple Music eller en annan musiktjänst redan scrobblar till Last.fm ger aktivering här dubbletter. Uteslut dem nedan eller låt detta vara avaktiverat."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果 Spotify、Apple Music 或其他音乐服务已在 Scrobble 至 Last.fm，在此启用会产生重复。请在下方排除这些服务，或保持此项禁用。"
          }
        }
      }
    },

    "ssdpMulticastTTLHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor mange routere højttalersøgningen må krydse. Hæv værdien, når højttalerne står på et andet VLAN eller subnet. Ingen effekt, hvis netværket blokerer multicast."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viele Router die Lautsprechersuche passieren darf. Erhöhen, wenn Lautsprecher in einem anderen VLAN oder Subnetz stehen. Ohne Wirkung, wenn das Netzwerk Multicast blockiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How many routers the speaker search may cross. Raise it when speakers sit on another VLAN or subnet. Has no effect where the network blocks multicast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuántos routers puede atravesar la búsqueda de altavoces. Auméntelo cuando los altavoces estén en otra VLAN o subred. No surte efecto si la red bloquea la multidifusión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre de routeurs que la recherche d’enceintes peut traverser. Augmentez-le lorsque les enceintes se trouvent sur un autre VLAN ou sous-réseau. Sans effet si le réseau bloque le multicast."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanti router può attraversare la ricerca dei diffusori. Aumentarlo quando i diffusori sono su un’altra VLAN o subnet. Nessun effetto se la rete blocca il multicast."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スピーカー検索が通過できるルーターの数です。スピーカーが別のVLANやサブネットにある場合は値を上げてください。ネットワークがマルチキャストを遮断している場合は効果がありません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor mange rutere høyttalersøket kan krysse. Øk verdien når høyttalerne står på et annet VLAN eller subnett. Ingen effekt hvis nettverket blokkerer multicast."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoeveel routers de speakerzoekopdracht mag passeren. Verhoog dit als speakers op een ander VLAN of subnet staan. Heeft geen effect als het netwerk multicast blokkeert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ile routerów może pokonać wyszukiwanie głośników. Zwiększ wartość, gdy głośniki są w innej sieci VLAN lub podsieci. Nie działa, gdy sieć blokuje multiemisję."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quantos routers a procura de colunas pode atravessar. Aumente quando as colunas estiverem noutra VLAN ou sub-rede. Não tem efeito se a rede bloquear multicast."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hur många routrar högtalarsökningen får passera. Höj värdet när högtalarna finns på ett annat VLAN eller subnät. Ingen effekt om nätverket blockerar multicast."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音箱搜索可穿越的路由器数量。当音箱位于其他 VLAN 或子网时请调高。若网络阻止组播则无效。"
          }
        }
      }
    },
    "staleLayoutChanged" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {

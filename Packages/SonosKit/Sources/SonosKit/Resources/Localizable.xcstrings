    "visColourSchemeHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farvekilde til scenebelysningen. Albumcover udleder tonerne fra det aktuelle cover; Choragus anvender logoets neonsæt; Brugerdefineret anvender farverne nedenfor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farbquelle für die Bühnenbeleuchtung. Albumcover leitet die Töne vom aktuellen Cover ab; Choragus verwendet das Neon-Set des Logos; Benutzerdefiniert verwendet die unten gewählten Farben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colour source for the stage lighting. Album art derives the tones from the current cover; Choragus applies the logo's neon set; Custom applies the colours selected below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuente de color de la iluminación. Portada del álbum deriva los tonos de la portada actual; Choragus aplica el conjunto neón del logotipo; Personalizado aplica los colores seleccionados abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Source des couleurs de l’éclairage. Pochette d’album dérive les tons de la pochette actuelle ; Choragus applique le jeu néon du logo ; Personnalisé applique les couleurs choisies ci-dessous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Origine dei colori delle luci. Copertina album deriva i toni dalla copertina corrente; Choragus applica il set neon del logo; Personalizzato applica i colori selezionati sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照明の配色ソース。アルバムアートは現在のカバーからトーンを導出、Choragusはロゴのネオンセット、カスタムは下で選択した色を適用します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fargekilde for scenebelysningen. Albumomslag utleder tonene fra gjeldende omslag; Choragus bruker logoens neonsett; Egendefinert bruker fargene nedenfor."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleurenbron voor de podiumverlichting. Albumhoes leidt de tinten af van de huidige hoes; Choragus past de neonset van het logo toe; Aangepast gebruikt de hieronder gekozen kleuren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Źródło kolorów oświetlenia. Okładka albumu wyprowadza tony z bieżącej okładki; Choragus stosuje neonowy zestaw logo; Niestandardowy stosuje kolory wybrane poniżej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonte de cor da iluminação. Capa do álbum deriva os tons da capa atual; Choragus aplica o conjunto néon do logótipo; Personalizado aplica as cores selecionadas abaixo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Färgkälla för scenbelysningen. Albumomslag härleder tonerna från aktuellt omslag; Choragus använder logotypens neonset; Anpassad använder färgerna nedan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "舞台灯光的配色来源。专辑封面从当前封面提取色调；Choragus 应用标志的霓虹配色；自定义应用下方选择的颜色。"
          }
        }
      }
    },

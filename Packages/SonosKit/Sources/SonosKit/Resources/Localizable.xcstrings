    "playlistBuilderIntro" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beskriv playlisten for AI'en, eller indsæt én sang pr. linje som Titel - Kunstner. Sangene matches på den valgte tjeneste og gemmes som en Choragus-playliste Playlistestyringen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschreibe die Playlist für die KI oder füge einen Titel pro Zeile als Titel - Interpret ein. Die Titel werden über den gewählten Dienst gefunden und als Choragus-Playlist in der Playlist-Manager gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe the playlist for the AI, or paste one song per line as Title - Artist. Songs are matched on the selected service and saved as a Choragus playlist in the Playlist Manager."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe la lista para la IA o pega una canción por línea como Título - Artista. Las canciones se buscan en el servicio seleccionado y se guardan como lista de Choragus en el Gestor de listas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décrivez la playlist pour l'IA, ou collez un titre par ligne au format Titre - Artiste. Les titres sont recherchés sur le service sélectionné et enregistrés comme playlist Choragus dans la bibliothèque de files d'attente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descrivi la playlist per l'IA o incolla un brano per riga come Titolo - Artista. I brani vengono cercati sul servizio selezionato e salvati come playlist Choragus in Gestione playlist."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI にプレイリストの内容を伝えるか、1行に1曲ずつ「タイトル - アーティスト」の形式で貼り付けます。曲は選択したサービスで検索され、プレイリスト管理の Choragus プレイリストとして保存されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beskriv spillelisten for AI-en, eller lim inn én sang per linje som Tittel - Artist. Sangene matches på valgt tjeneste og lagres som en Choragus-spilleliste i Spillelistebehandleren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschrijf de afspeellijst voor de AI of plak één nummer per regel als Titel - Artiest. Nummers worden op de gekozen dienst gezocht en opgeslagen als Choragus-afspeellijst in Afspeellijstbeheer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opisz playlistę dla AI lub wklej jeden utwór na wiersz w formacie Tytuł - Wykonawca. Utwory są wyszukiwane w wybranej usłudze i zapisywane jako playlista Choragus w bibliotece kolejek."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descreva a playlist para a IA ou cole uma música por linha como Título - Artista. As músicas são localizadas no serviço selecionado e salvas como playlist do Choragus no Gerenciador de playlists."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beskriv spellistan för AI:n eller klistra in en låt per rad som Titel - Artist. Låtarna matchas på vald tjänst och sparas som en Choragus-spellista i Spellisthanteraren."

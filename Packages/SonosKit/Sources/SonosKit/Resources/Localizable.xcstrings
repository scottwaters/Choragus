    "amPromptBodyDenied" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus skal bruge Apple Music-adgang for at søge i kataloget. Åbn Systemindstillinger → Anonymitet og sikkerhed → Medier og Apple Music, og aktivér Choragus."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus benötigt Apple Music-Zugriff, um den Katalog zu durchsuchen. Öffne Systemeinstellungen → Datenschutz & Sicherheit → Medien & Apple Music und aktiviere Choragus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus needs Apple Music access to search the catalog. Open System Settings → Privacy & Security → Media & Apple Music and enable Choragus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus necesita acceso a Apple Music para buscar en el catálogo. Abre Ajustes del Sistema → Privacidad y seguridad → Contenido y Apple Music y activa Choragus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus a besoin de l’accès à Apple Music pour rechercher dans le catalogue. Ouvrez Réglages Système → Confidentialité et sécurité → Médias et Apple Music et activez Choragus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus ha bisogno dell’accesso ad Apple Music per cercare nel catalogo. Apri Impostazioni di Sistema → Privacy e sicurezza → Contenuti multimediali e Apple Music e attiva Choragus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カタログを検索するにはChoragusにApple Musicへのアクセスが必要です。システム設定 → プライバシーとセキュリティ → メディアとApple Musicを開き、Choragusを有効にしてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus trenger Apple Music-tilgang for å søke i katalogen. Åpne Systeminnstillinger → Personvern og sikkerhet → Medier og Apple Music og slå på Choragus."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus heeft Apple Music-toegang nodig om de catalogus te doorzoeken. Open Systeeminstellingen → Privacy en beveiliging → Media en Apple Music en schakel Choragus in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus potrzebuje dostępu do Apple Music, aby przeszukać katalog. Otwórz Ustawienia systemowe → Prywatność i bezpieczeństwo → Multimedia i Apple Music i włącz Choragus."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Choragus precisa de acesso ao Apple Music para buscar no catálogo. Abra Ajustes do Sistema → Privacidade e Segurança → Mídia e Apple Music e ative o Choragus."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus behöver Apple Music-åtkomst för att söka i katalogen. Öppna Systeminställningar → Integritet och säkerhet → Media och Apple Music och aktivera Choragus."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus 需要 Apple Music 访问权限才能搜索目录。打开系统设置 → 隐私与安全性 → 媒体与 Apple Music，并启用 Choragus。"
          }
        }
      }
    },
    "amPromptBodyNoSubscription" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søgning i Apple Music kræver et aktivt abonnement på det Apple-id, du er logget ind med på denne Mac."
          }
        },
        "de" : {
          "stringUnit" : {

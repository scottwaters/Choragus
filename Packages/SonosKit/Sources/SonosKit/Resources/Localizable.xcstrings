        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache d’images : limitez le cache des pochettes sur disque par taille (Mo) et âge (jours) ; en cas de dépassement, les plus anciennes sont évincées d’abord."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache immagini: limita la cache delle copertine su disco per dimensione (MB) ed età (giorni); in caso di overflow vengono eliminate prima le più vecchie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像キャッシュ：ディスク上のアートワークキャッシュをサイズ（MB）と期間（日数）で制限します。上限を超えると古いものから順に削除されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildecache: begrens omslagscachen på disk etter størrelse (MB) og alder (dager); ved overfylling fjernes de eldste først."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afbeeldingscache: begrens de hoeslay-cache op schijf op grootte (MB) en leeftijd (dagen); bij overloop worden de oudste het eerst verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pamięć podręczna obrazów: ogranicz pamięć okładek na dysku według rozmiaru (MB) i wieku (dni); przy przepełnieniu usuwane są najpierw najstarsze."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache de imagens: limite a cache de capas em disco por tamanho (MB) e idade (dias); em caso de excesso, as mais antigas são removidas primeiro."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildcache: begränsa skivomslagscachen på disk efter storlek (MB) och ålder (dagar); vid överflod tas de äldsta bort först."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图像缓存：按大小（MB）和使用天数限制磁盘上的封面缓存；超过上限时优先清除最早的条目。"
          }
        }
      }
    },

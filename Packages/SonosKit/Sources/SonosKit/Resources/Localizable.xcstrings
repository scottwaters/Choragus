    "helpAIPlaylistsAIBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfigurer en udbyder i Indstillinger → AI: Claude, OpenAI eller et OpenAI-kompatibelt endpoint (DeepSeek, lokal Ollama- eller LM Studio-server). Gem API-nøglen — opbevares i macOS-nøgleringen og sendes kun til den udbyder — og tryk Test. Når testen er bestået, vises udbyderen i kildemenuen. Skriv en beskrivelse og tryk Generer; sangene vises, mens AI'en skriver dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richte unter Einstellungen → KI einen Anbieter ein: Claude, OpenAI oder einen OpenAI-kompatiblen Endpunkt (DeepSeek, lokaler Ollama- oder LM-Studio-Server). Speichere den API-Schlüssel — er liegt im macOS-Schlüsselbund und wird nur an diesen Anbieter gesendet — und drücke Testen. Nach bestandenem Test erscheint der Anbieter im Quellmenü des Erstellers. Beschreibung eingeben, Generieren drücken — die Titel erscheinen während der Generierung in der Liste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure a provider in Settings → AI: Claude, OpenAI, or any OpenAI-compatible endpoint (DeepSeek, a local Ollama or LM Studio server). Save the API key — it is stored in the macOS keychain and only ever sent to that provider — then press Test. Once the test passes, the provider appears in the builder's source menu. Type a description, press Generate, and the songs stream into the list as the AI writes them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura un proveedor en Ajustes → IA: Claude, OpenAI o cualquier punto compatible con OpenAI (DeepSeek, un servidor local Ollama o LM Studio). Guarda la clave de API — se almacena en el llavero de macOS y solo se envía a ese proveedor — y pulsa Probar. Superada la prueba, el proveedor aparece en el menú de origen. Escribe una descripción y pulsa Generar; las canciones aparecen mientras la IA las escribe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configurez un fournisseur dans Réglages → IA : Claude, OpenAI ou tout point de terminaison compatible OpenAI (DeepSeek, serveur local Ollama ou LM Studio). Enregistrez la clé API — conservée dans le trousseau macOS et envoyée uniquement à ce fournisseur — puis lancez Tester. Une fois le test réussi, le fournisseur apparaît dans le menu source. Saisissez une description, appuyez sur Générer : les titres s'affichent au fil de la génération."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura un provider in Impostazioni → IA: Claude, OpenAI o qualsiasi endpoint compatibile OpenAI (DeepSeek, un server locale Ollama o LM Studio). Salva la chiave API — conservata nel portachiavi macOS e inviata solo a quel provider — poi premi Prova. Superato il test, il provider compare nel menu sorgente. Scrivi una descrizione e premi Genera: i brani compaiono man mano che l'IA li scrive."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定 → AI でプロバイダを設定します（Claude、OpenAI、または DeepSeek、ローカルの Ollama / LM Studio など OpenAI 互換エンドポイント）。API キーを保存し（macOS キーチェーンに保管され、そのプロバイダにのみ送信）、テストを実行します。合格するとビルダーのソースメニューに表示されます。説明を入力して生成を押すと、曲が順次リストに流れ込みます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sett opp en leverandør i Innstillinger → AI: Claude, OpenAI eller et OpenAI-kompatibelt endepunkt (DeepSeek, lokal Ollama- eller LM Studio-server). Lagre API-nøkkelen — lagres i macOS-nøkkelringen og sendes bare til den leverandøren — og trykk Test. Når testen bestås, vises leverandøren i kildemenyen. Skriv en beskrivelse og trykk Generer; sangene dukker opp mens AI-en skriver dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel een aanbieder in via Instellingen → AI: Claude, OpenAI of een OpenAI-compatibel eindpunt (DeepSeek, lokale Ollama- of LM Studio-server). Sla de API-sleutel op — bewaard in de macOS-sleutelhanger en alleen naar die aanbieder verzonden — en druk op Testen. Na een geslaagde test verschijnt de aanbieder in het bronmenu. Typ een beschrijving en druk op Genereren; de nummers verschijnen terwijl de AI ze schrijft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skonfiguruj dostawcę w Ustawieniach → AI: Claude, OpenAI lub dowolny punkt zgodny z OpenAI (DeepSeek, lokalny serwer Ollama lub LM Studio). Zapisz klucz API — przechowywany w pęku kluczy macOS i wysyłany tylko do tego dostawcy — i naciśnij Testuj. Po udanym teście dostawca pojawi się w menu źródła. Wpisz opis i naciśnij Generuj; utwory pojawiają się w miarę pisania przez AI."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure um provedor em Ajustes → IA: Claude, OpenAI ou qualquer endpoint compatível com OpenAI (DeepSeek, servidor local Ollama ou LM Studio). Salve a chave de API — guardada nas chaves do macOS e enviada apenas a esse provedor — e pressione Testar. Aprovado o teste, o provedor aparece no menu de origem. Digite uma descrição e pressione Gerar; as músicas aparecem enquanto a IA as escreve."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfigurera en leverantör i Inställningar → AI: Claude, OpenAI eller valfri OpenAI-kompatibel slutpunkt (DeepSeek, lokal Ollama- eller LM Studio-server). Spara API-nyckeln — lagras i macOS nyckelring och skickas bara till den leverantören — och tryck Testa. När testet lyckats visas leverantören i källmenyn. Skriv en beskrivning och tryck Generera; låtarna dyker upp medan AI:n skriver dem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在设置 → AI 中配置提供商：Claude、OpenAI 或任何 OpenAI 兼容端点（DeepSeek、本地 Ollama 或 LM Studio）。保存 API 密钥（存在 macOS 钥匙串中，仅发送给该提供商），然后点击测试。测试通过后，该提供商会出现在源菜单中。输入描述并点击生成，歌曲会随生成逐步出现在列表中。"
          }
        }
      }
    },

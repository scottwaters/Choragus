    "diagCopyRowWithPayloadHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopierer rækken med LAN-IP’er, stier og enheds-ID’er intakte. Autentificeringstokens fjernes stadig (de gemmes aldrig). Til lokal fejlfinding eller deling via en betroet kanal."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiert die Zeile mit LAN-IPs, Pfaden und Geräte-IDs. Auth-Token werden weiterhin entfernt (sie werden nie gespeichert). Für lokale Fehlersuche oder Weitergabe über einen vertrauenswürdigen Kanal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copies the row with LAN IPs, paths, and device IDs intact. Auth tokens are still removed (they were never persisted). For local debugging or sharing through a trusted channel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia la fila con IP de LAN, rutas e identificadores de dispositivo intactos. Los tokens de autenticación se eliminan (nunca se guardan). Para depuración local o compartir por un canal de confianza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie la ligne avec les IP LAN, chemins et identifiants d’appareil intacts. Les jetons d’auth sont toujours retirés (ils ne sont jamais stockés). Pour le débogage local ou un partage via un canal de confiance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia la riga con IP della LAN, percorsi e ID dispositivo intatti. I token di autenticazione vengono comunque rimossi (non vengono mai salvati). Per debug locale o condivisione tramite un canale fidato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LAN IP、パス、デバイス ID をそのまま含めて行をコピーします。認証トークンは引き続き削除されます（保存されません）。ローカルデバッグや信頼できるチャネル経由の共有用です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopierer raden med LAN-IP-er, baner og enhets-ID-er intakte. Autentiseringstokens fjernes fortsatt (de lagres aldri). For lokal feilsøking eller deling via en betrodd kanal."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieert de rij met LAN-IP’s, paden en apparaat-ID’s intact. Auth-tokens worden nog steeds verwijderd (ze worden nooit opgeslagen). Voor lokale foutopsporing of delen via een vertrouwd kanaal."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiuje wiersz z nienaruszonymi adresami IP LAN, ścieżkami i identyfikatorami urządzeń. Tokeny uwierzytelniania są nadal usuwane (nigdy nie są zapisywane). Do lokalnego debugowania lub udostępniania zaufanym kanałem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia a linha com IPs da LAN, caminhos e IDs de dispositivo intactos. Os tokens de autenticação continuam a ser removidos (nunca são guardados). Para depuração local ou partilha através de um canal de confiança."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopierar raden med LAN-IP, sökvägar och enhets-ID intakta. Autentiseringstokens tas fortfarande bort (de sparas aldrig). För lokal felsökning eller delning via en betrodd kanal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "复制该行，保留 LAN IP、路径和设备 ID。认证令牌仍会被移除（从不持久化）。用于本地调试或通过可信渠道共享。"
          }
        }
      }
    },

    "topArtistsByPlaysDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top-kunstnere efter kumulative afspilninger, rangeret som historikken skrider frem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top-Künstler nach kumulativen Wiedergaben, im Verlauf der Geschichte gerangiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top artists by cumulative plays, ranked as history advances."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artistas top por reproducciones acumuladas, clasificados a medida que avanza el historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artistes principaux par lectures cumulées, classés au fil de l’historique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artisti top per riproduzioni cumulative, classificati con l’avanzare della cronologia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "累計再生数によるトップアーティスト。履歴の進行に応じてランク付けされます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topp-artister etter kumulative avspillinger, rangert etter hvert som historikken går."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topartiesten op basis van cumulatieve afspelingen, gerangschikt naarmate de geschiedenis vordert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top artyści wg łącznych odtworzeń, klasyfikowani w miarę postępu historii."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top artistas por reproduções cumulativas, classificados à medida que o histórico avança."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topp-artister efter kumulativa uppspelningar, rankade i takt med att historiken fortskrider."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按累计播放次数排名的顶尖艺术家，随历史推进而变化。"
          }
        }
      }
    },
    "topArtistsRoomsDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top-kunstnere ↔ rum. Buerne bliver tykkere, når samafspilninger akkumuleres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top-Künstler ↔ Räume. Bögen werden dicker, wenn sich gemeinsame Wiedergaben ansammeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top artists ↔ rooms. Arcs thicken as co-plays accumulate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artistas top ↔ habitaciones. Los arcos se engrosan a medida que se acumulan las reproducciones conjuntas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artistes principaux ↔ pièces. Les arcs s’épaississent à mesure que les co-lectures s’accumulent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artisti top ↔ stanze. Gli archi si ispessiscono con l’accumularsi delle co-riproduzioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トップアーティスト ↔ 部屋。共聴数が累積されるにつれてアークが太くなります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topp-artister ↔ rom. Buer blir tykkere etter hvert som sam-avspillinger akkumuleres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topartiesten ↔ kamers. Bogen worden dikker naarmate co-afspelingen toenemen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top artyści ↔ pokoje. Łuki grubnieją, gdy wsółodtworzenia się kumulują."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top artistas ↔ divisões. Os arcos engrossam à medida que as co-reproduções se acumulam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topp-artister ↔ rum. Bågar förtjockas när samuppspelningar ackumuleras."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顶尖艺术家 ↔ 房间。随着共同播放增加，弧线变粗。"
          }
        }
      }

    "helpServiceSetupBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på Tilslut på en blå eller gul række for at starte AppLink-OAuth-flødet — Choragus åbner udbyderens godkendelsesside i browseren; log ind der, og rækken bliver grøn. For tjenester, der har brug for en Sonos-favorit for at afsløre deres konto-serienummer, forbliver rækken orange (“tilføj en favorit for at fuldføre opsætningen”), indtil du har tilføjet en i den officielle Sonos-app."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe in einer blauen oder gelben Zeile auf Verbinden, um den AppLink-OAuth-Vorgang zu starten — Choragus öffnet die Autorisierungsseite des Anbieters in deinem Browser; melde dich dort an, dann wird die Zeile grün. Für Dienste, die einen Sonos-Favoriten benötigen, um ihre Konto-Seriennummer zu liefern, bleibt die Zeile orange („Favorit hinzufügen, um die Einrichtung abzuschließen“), bis du einen in der offiziellen Sonos-App hinzugefügt hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap Connect on a blue or yellow row to start the AppLink OAuth flow — Choragus opens the provider's authorization page in your browser; sign in there and the row turns green. For services that need a Sonos Favorite to surface their account-serial number, the row stays orange (\"add a favourite to finish setup\") until you've added one in the official Sonos app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca Conectar en una fila azul o amarilla para iniciar el flujo OAuth de AppLink — Choragus abre la página de autorización del proveedor en tu navegador; inicia sesión allí y la fila se pondrá verde. Para servicios que necesitan un Favorito Sonos para aportar su número de serie de cuenta, la fila permanece naranja (“añade un favorito para finalizar la configuración”) hasta que añadas uno en la app oficial de Sonos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez Connecter sur une ligne bleue ou jaune pour lancer le flux OAuth AppLink — Choragus ouvre la page d’autorisation du fournisseur dans votre navigateur ; identifiez-vous et la ligne passe au vert. Pour les services qui ont besoin d’un favori Sonos pour faire apparaître leur numéro de série de compte, la ligne reste orange (« ajoutez un favori pour finir la configuration ») tant que vous n’en avez pas ajouté un dans l’application Sonos officielle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca Connetti su una riga blu o gialla per avviare il flusso OAuth AppLink — Choragus apre la pagina di autorizzazione del fornitore nel browser; accedi e la riga diventa verde. Per i servizi che hanno bisogno di un Preferito Sonos per esporre il loro numero di serie dell’account, la riga rimane arancione (“aggiungi un preferito per terminare la configurazione”) finché non ne aggiungi uno nell’app Sonos ufficiale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "青または黄色の行で「接続」をタップすると AppLink の OAuth フローが開始されます—Choragus はブラウザでプロバイダーの認証ページを開きます。サインインすると行が緑になります。アカウントシリアル番号を取得するには Sonos ファベリットが必要なサービスの行は、公式 Sonos アプリでファベリットを追加するまでオレンジ（「ファベリットを追加してセットアップを完了してください」）のままです。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk Koble til på en blå eller gul rad for å starte AppLink-OAuth-flyten — Choragus åpner leverandørens autorisasjonsside i nettleseren; logg inn der og raden blir grønn. For tjenester som trenger en Sonos-favoritt for å få fram konto-serienummeret sitt, forblir raden oransje (“legg til en favoritt for å fullføre oppsettet”) til du har lagt til én i den offisielle Sonos-appen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op Verbind in een blauwe of gele rij om de AppLink-OAuth-stroom te starten — Choragus opent de autorisatiepagina van de aanbieder in je browser; log daar in en de rij wordt groen. Voor diensten die een Sonos-favoriet nodig hebben om hun account-serienummer op te leveren, blijft de rij oranje (“voeg een favoriet toe om de installatie te voltooien”) totdat je er een hebt toegevoegd in de officiële Sonos-app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotknij Połącz w niebieskim lub żółtym wierszu, aby rozpocząć przepływ OAuth AppLink — Choragus otworzy stronę autoryzacji dostawcy w przeglądarce; po zalogowaniu wiersz zmieni się na zielony. Dla usług, które wymagają Sonos Ulubionego do ujawnienia numeru seryjnego konta, wiersz pozostaje pomarańczowy („dodaj ulubione, aby dokończyć konfigurację”) do czasu dodania go w oficjalnej aplikacji Sonos."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em Ligar numa linha azul ou amarela para iniciar o fluxo OAuth do AppLink — o Choragus abre a página de autorização do fornecedor no seu browser; inicie sessão e a linha fica verde. Para serviços que precisam de um Favorito Sonos para revelar o número de série da conta, a linha fica laranja (“adicione um favorito para concluir a configuração”) até o adicionar na app oficial Sonos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på Anslut på en blå eller gul rad för att starta AppLink-OAuth-flödet — Choragus öppnar leverantörens autentiseringssida i webbläsaren; logga in där och raden blir grön. För tjänster som behöver en Sonos-favorit för att avslöja sitt kontoserienummer förblir raden orange (”lägg till en favorit för att slutföra inställningen”) tills du lägger till en i den officiella Sonos-appen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在蓝色或黄色行中点击「连接」以启动 AppLink OAuth 流程—Choragus 会在浏览器中打开服务提供商的授权页面；登录后行变为绿色。对于需要 Sonos 收藏来浮现账户序列号的服务，行会保持橙色（「添加收藏以完成设置」），直到您在官方 Sonos 应用中添加一个收藏。"
          }
        }
      }
    },

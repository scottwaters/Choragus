    "errAppNetworkUnavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Netværket er utilgængeligt. Tjek din Wi-Fi-forbindelse. Som regel forbigående — rapportér kun hvis det sker ofte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Netzwerk ist nicht verfügbar. Prüfe deine WLAN-Verbindung. Meist vorübergehend — melde es nur, wenn es häufig auftritt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The network is unavailable. Check your Wi-Fi connection. Usually transient — only report if it happens often."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La red no está disponible. Comprueba tu conexión Wi-Fi. Suele ser pasajero — infórmalo solo si ocurre a menudo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le réseau est indisponible. Vérifiez votre connexion Wi-Fi. Généralement passager — ne le signalez que si cela se répète."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La rete non è disponibile. Controlla la connessione Wi-Fi. Di solito è temporaneo — segnalalo solo se accade spesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットワークを利用できません。Wi-Fi 接続を確認してください。通常は一時的です。頻発する場合のみ報告してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nettverket er utilgjengelig. Sjekk Wi-Fi-tilkoblingen. Vanligvis forbigående — meld bare fra hvis det skjer ofte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het netwerk is niet beschikbaar. Controleer je wifi-verbinding. Meestal tijdelijk — meld het alleen als het vaak gebeurt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieć jest niedostępna. Sprawdź połączenie Wi-Fi. Zwykle chwilowe — zgłoś tylko, jeśli zdarza się często."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",

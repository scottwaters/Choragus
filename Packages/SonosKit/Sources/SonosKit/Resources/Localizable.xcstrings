    "helpHistoryActionsBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Højreklik på en historikpost for at afspille den nu, afspille den som det næste eller tilføje den til slutningen af køen. Rummets filter matcher enten den nøjagtige gruppe eller enhver gruppe, rummet var en del af."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke mit der rechten Maustaste auf einen Verlaufseintrag, um ihn sofort abzuspielen, als Nächstes abzuspielen oder ans Ende der Warteschlange anzufügen. Der Raumfilter entspricht entweder der exakten Gruppe oder einer beliebigen Gruppe, an der der Raum beteiligt war."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Right-click any history entry to play it now, play it next, or add it to the end of the queue. The room filter matches either the exact group or any group the room took part in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic con el botón derecho en cualquier entrada del historial para reproducirla ahora, reproducirla a continuación o añadirla al final de la cola. El filtro de habitación coincide con el grupo exacto o con cualquier grupo del que la habitación formara parte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites un clic droit sur n'importe quelle entrée de l'historique pour la lire maintenant, la lire ensuite ou l'ajouter à la fin de la file d'attente. Le filtre par pièce correspond au groupe exact ou à tout groupe auquel la pièce a participé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic con il tasto destro su qualsiasi voce della cronologia per riprodurla ora, riprodurla dopo o aggiungerla alla fine della coda. Il filtro della stanza corrisponde al gruppo esatto o a qualsiasi gruppo a cui la stanza ha preso parte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴エントリを右クリックすると、今すぐ再生、次に再生、またはキューの最後に追加できます。ルームフィルタは、完全一致のグループ、またはそのルームが参加したグループのいずれかに一致します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høyreklikk på en historikkoppføring for å spille den nå, spille den neste, eller legge den til på slutten av køen. Romfilteret samsvarer med enten den eksakte gruppen eller en hvilken som helst gruppe rommet var en del av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik met de rechtermuisknop op een geschiedenisvermelding om deze nu af te spelen, als volgende af te spelen of aan het einde van de wachtrij toe te voegen. Het kamerfilter komt overeen met de exacte groep of een groep waar de kamer deel van uitmaakte."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij prawym przyciskiem myszy dowolną pozycję w historii, aby odtworzyć ją teraz, odtworzyć jako następną lub dodać na koniec kolejki. Filtr pokoju dopasowuje się do dokładnej grupy lub dowolnej grupy, której pokój był częścią."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique com o botão direito em qualquer entrada do histórico para reproduzi-la agora, em seguida ou adicioná-la ao final da fila. O filtro de ambiente corresponde ao grupo exato ou a qualquer grupo do qual o ambiente fez parte."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Högerklicka på valfri historikpost för att spela den nu, spela den härnäst eller lägga till den i slutet av kön. Rumsfiltret matchar antingen den exakta gruppen eller valfri grupp som rummet deltog i."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右键点按任何历史记录条目，可选择立即播放、下一首播放或将其添加到队列末尾。房间过滤器将匹配完全相同的群组或该房间参与过的任何群组。"
          }
        }
      }
    },
    "helpHistoryTabBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokalt afspilningsantal for det aktuelle spor i din Choragus-historik — samlede afspilninger, rum hvor det blev spillet, senest-afspillet-tid og de tyve seneste afspilninger. Læses fra historikdatabasen; intet forlader din maskine."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokale Wiedergabezähler für den aktuellen Titel in deinem Choragus-Verlauf — Gesamtwiedergaben, Räume, in denen er lief, letzter Wiedergabezeitpunkt und die letzten zwanzig Wiedergaben. Liest aus der Verlauf-Datenbank; nichts verlässt deinen Rechner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Local play count for the current track in your Choragus history — total plays, rooms it played in, last-played time, and the most recent twenty plays. Reads from the play-history database; nothing leaves your machine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conteo local de reproducciones para la pista actual en tu historial de Choragus — reproducciones totales, habitaciones donde sonó, hora de la última reproducción y las veinte más recientes. Se lee de la base de datos del historial; nada sale de tu máquina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre de lectures local du morceau dans votre historique Choragus — total des lectures, pièces où il a été joué, dernière lecture et les vingt lectures les plus récentes. Lu depuis la base d’historique ; rien ne quitte votre machine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conteggio di riproduzioni locale per il brano corrente nella cronologia di Choragus — totale riproduzioni, stanze in cui è stato suonato, ultimo ascolto e le venti più recenti. Letto dal database della cronologia; nulla lascia la tua macchina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus のプレイ履歴における現在のトラックのローカルな再生回数—累計再生回数、再生された部屋、最後に再生された時刻、最近の20件の再生記録を表示します。プレイ履歴データベースから読み込み、データはマシンから外に出ません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokal avspillingstellingen for det aktuelle sporet i Choragus-historikken — totale avspillinger, rom det har spilt i, sist-spilt-tid og de tjue siste avspillingene. Leses fra historikkdatabasen; ingenting forlater maskinen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokale afspeelstand voor het huidige nummer in je Choragus-geschiedenis — totaal afspelingen, kamers waarin het speelde, laatst-gespeelde tijd en de twintig meest recente afspelingen. Gelezen uit de afspeelgeschiedenis-database; niets verlaat je machine."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokalna liczba odtworzeń bieżącego utworu w historii Choragus — suma odtworzeń, pokoje, w których odtwarzano, czas ostatniego odtworzenia i dwadzieścia najnowszych odtworzeń. Czytane z bazy historii odtwarzania; nic nie opuszcza Twojej maszyny."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contagem local de reproduções da faixa atual no seu histórico do Choragus — reproduções totais, divisões onde tocou, hora da última reprodução e as vinte mais recentes. É lido da base de dados de histórico; nada sai da sua máquina."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokal uppspelningsräknare för aktuellt spår i din Choragus-historik — totala uppspelningar, rum där det spelats, senast-spelad-tid och de tjugo senaste uppspelningarna. Läses från historikdatabasen; inget lämnar din maskin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此标签从您的 Choragus 播放历史中读取当前曲目的本地播放次数—累计播放次数、播放过的房间、上次播放时间以及最近 20 次播放记录。数据从本机数据库读取，不会传输到外部。"
          }
        }
      }
    },

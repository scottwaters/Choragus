    "musicServersHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus kan gennemse UPnP/DLNA-musikservere på dit netværk, hvilket Sonos ikke kan. Servere findes automatisk, når det er muligt; tilføj en via adresse, hvis den ikke vises. Afspilning kræver, at dine højttalere kan nå den direkte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus kann UPnP/DLNA-Musikserver im Netzwerk durchsuchen — Sonos selbst kann das nicht. Server werden nach Möglichkeit automatisch gefunden; ist einer nicht aufgeführt, per Adresse hinzufügen. Zum Abspielen müssen die Lautsprecher den Server direkt erreichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus can browse UPnP/DLNA music servers on your network, which Sonos itself cannot. Servers are found automatically where possible; add one by address if it isn't listed. Playing from a server needs your speakers to reach it directly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus puede explorar servidores de música UPnP/DLNA de su red, algo que Sonos no puede hacer. Los servidores se detectan automáticamente cuando es posible; añada uno por dirección si no aparece. Para reproducir, sus altavoces deben poder acceder a él directamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus peut parcourir les serveurs de musique UPnP/DLNA de votre réseau, ce que Sonos ne sait pas faire. Les serveurs sont détectés automatiquement quand c’est possible ; ajoutez-en un par adresse s’il n’apparaît pas. La lecture exige que vos enceintes puissent l’atteindre directement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus può sfogliare i server musicali UPnP/DLNA della rete, cosa che Sonos non può fare. I server vengono trovati automaticamente quando possibile; aggiungerne uno per indirizzo se non compare. Per riprodurre, i diffusori devono poterlo raggiungere direttamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragusは、Sonos自体では対応していないネットワーク上のUPnP/DLNAミュージックサーバーを参照できます。可能な場合は自動的に検出されます。表示されない場合はアドレスで追加してください。再生には、スピーカーがサーバーに直接接続できる必要があります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus kan bla i UPnP/DLNA-musikkservere på nettverket, noe Sonos ikke kan. Servere blir funnet automatisk når det lar seg gjøre; legg til én via adresse hvis den ikke vises. Avspilling krever at høyttalerne når serveren direkte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus kan UPnP/DLNA-muziekservers in je netwerk doorbladeren, iets wat Sonos zelf niet kan. Servers worden waar mogelijk automatisch gevonden; voeg er een toe via het adres als hij niet in de lijst staat. Afspelen vereist dat je speakers de server rechtstreeks kunnen bereiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus może przeglądać serwery muzyczne UPnP/DLNA w sieci, czego sam Sonos nie potrafi. Serwery są wykrywane automatycznie, gdy to możliwe; jeśli serwera nie ma na liście, dodaj go według adresu. Odtwarzanie wymaga, aby głośniki miały do niego bezpośredni dostęp."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Choragus pode navegar em servidores de música UPnP/DLNA na sua rede, algo que o Sonos não faz. Os servidores são encontrados automaticamente sempre que possível; adicione um por endereço se não aparecer. Para reproduzir, as colunas têm de conseguir alcançá-lo diretamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus kan bläddra bland UPnP/DLNA-musikservrar i nätverket, vilket Sonos inte kan. Servrar hittas automatiskt när det går; lägg till en via adress om den inte visas. Uppspelning kräver att högtalarna når servern direkt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus 可以浏览网络中的 UPnP/DLNA 音乐服务器，而 Sonos 本身不支持。可用时会自动发现服务器；若未列出，可通过地址添加。播放需要音箱能够直接访问该服务器。"
          }
        }
      }
    },

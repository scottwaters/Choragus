    "mcpEnableHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lader AI-assistenter som Claude styre Choragus via Model Context Protocol: rum, afspilning, lydstyrke, kø, afspilningslister og forudindstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaubt KI-Assistenten wie Claude, Choragus über das Model Context Protocol zu steuern: Räume, Wiedergabe, Lautstärke, Warteschlange, Playlists und Voreinstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lets AI assistants such as Claude control Choragus through the Model Context Protocol: rooms, playback, volume, queue, playlists and presets."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que asistentes de IA como Claude controlen Choragus mediante el Model Context Protocol: habitaciones, reproducción, volumen, cola, listas y ajustes guardados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet aux assistants IA comme Claude de piloter Choragus via le Model Context Protocol : pièces, lecture, volume, file, playlists et préréglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consente ad assistenti IA come Claude di controllare Choragus tramite il Model Context Protocol: stanze, riproduzione, volume, coda, playlist e preset."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude などの AI アシスタントが Model Context Protocol 経由で Choragus を操作できます: 部屋、再生、音量、キュー、プレイリスト、プリセット。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lar KI-assistenter som Claude styre Choragus via Model Context Protocol: rom, avspilling, volum, kø, spillelister og forhåndsinnstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat AI-assistenten zoals Claude Choragus besturen via het Model Context Protocol: kamers, afspelen, volume, wachtrij, afspeellijsten en voorinstellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwala asystentom AI, takim jak Claude, sterować Choragus przez Model Context Protocol: pokoje, odtwarzanie, głośność, kolejka, playlisty i ustawienia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que assistentes de IA como o Claude controlem o Choragus pelo Model Context Protocol: salas, reprodução, volume, fila, playlists e predefinições."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låter AI-assistenter som Claude styra Choragus via Model Context Protocol: rum, uppspelning, volym, kö, spellistor och förval."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许 Claude 等 AI 助手通过 Model Context Protocol 控制 Choragus：房间、播放、音量、队列、播放列表和预设。"
          }
        }
      }
    },

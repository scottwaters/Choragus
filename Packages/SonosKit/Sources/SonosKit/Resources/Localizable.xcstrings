    "helpAlarmsNotesBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidspunkter følger højttalernes eget ur. En engangsalarm ringer næste gang tidspunktet indtræffer og bliver derefter stående slukket i listen. Choragus læser og skriver alarmer på den højttaler, der ejer husstandens alarmliste, så en ændring her vises med det samme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uhrzeiten folgen der Uhr der Lautsprecher. Ein einmaliger Wecker klingelt beim nächsten Erreichen seiner Zeit und bleibt danach ausgeschaltet in der Liste. Choragus liest und schreibt Wecker auf dem Lautsprecher, der die Weckerliste des Haushalts führt, sodass Änderungen sofort sichtbar sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Times follow the speakers' own clock. A once-only alarm fires at the next occurrence of its time and then stays in the list switched off. Choragus reads and writes alarms on the speaker that owns the household's alarm list, so a change made here shows at once."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las horas siguen el reloj de los altavoces. Una alarma de una sola vez suena en la siguiente ocurrencia de su hora y luego permanece en la lista desactivada. Choragus lee y escribe las alarmas en el altavoz que posee la lista del hogar, así que un cambio hecho aquí aparece al instante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les heures suivent l'horloge des enceintes. Une alarme unique se déclenche à la prochaine occurrence de son heure puis reste dans la liste, désactivée. Choragus lit et écrit les alarmes sur l'enceinte qui détient la liste du foyer, donc un changement fait ici apparaît aussitôt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli orari seguono l'orologio dei diffusori. Una sveglia singola suona alla prossima occorrenza del suo orario e poi resta nell'elenco disattivata. Choragus legge e scrive le sveglie sul diffusore che detiene l'elenco della casa, quindi una modifica fatta qui appare subito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時刻はスピーカー自身の時計に従います。1 回のみのアラームは次にその時刻になったとき鳴り、その後はオフのまま一覧に残ります。Choragus は家庭のアラーム一覧を保持するスピーカーに対して読み書きするため、ここでの変更はすぐに反映されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidene følger høyttalernes egen klokke. En engangsalarm ringer neste gang tidspunktet inntreffer og blir deretter liggende avslått i listen. Choragus leser og skriver alarmer på høyttaleren som eier husstandens alarmliste, så en endring her vises med en gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tijden volgen de klok van de speakers. Een eenmalige wekker gaat af bij de eerstvolgende keer dat de tijd wordt bereikt en blijft daarna uitgeschakeld in de lijst. Choragus leest en schrijft wekkers op de speaker die de wekkerlijst van het huishouden beheert, dus een wijziging hier is meteen zichtbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godziny zależą od zegara głośników. Alarm jednorazowy dzwoni przy najbliższym wystąpieniu swojej godziny, a potem pozostaje na liście wyłączony. Choragus czyta i zapisuje alarmy na głośniku, który przechowuje listę alarmów domu, więc zmiana wykonana tutaj jest widoczna od razu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As horas seguem o relógio das colunas. Um alarme único toca na próxima ocorrência da sua hora e depois fica na lista desligado. O Choragus lê e escreve alarmes na coluna que detém a lista de alarmes da casa, por isso uma alteração feita aqui aparece de imediato."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tider följer högtalarnas egen klocka. Ett engångsalarm ringer nästa gång tiden inträffar och ligger sedan kvar avstängt i listan. Choragus läser och skriver alarm på den högtalare som äger hushållets alarmlista, så en ändring här syns direkt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时间以扬声器自身的时钟为准。仅一次的闹钟会在下次到达该时间时响起，之后以关闭状态留在列表中。Choragus 在持有家庭闹钟列表的扬声器上读写闹钟，因此在此所做的更改会立即显示。"
          }
        }
      }
    },
    "helpAppleMusicBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søg i Apple Music efter nummer, kunstner eller album. Tryk på en kunstner for hele diskografien (nyeste først); tryk på et album for nummerlisten. Søgninger følger butikken — regionen følger dit Apple-id."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchsuche Apple Music nach Titel, Künstler oder Album. Ein Klick auf einen Künstler öffnet die vollständige Diskografie (neueste zuerst); ein Klick auf ein Album zeigt die Titelliste. Die Suche ist Storefront-bewusst — die Region folgt deiner Apple-ID."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search Apple Music by track, artist, or album. Tap an artist to drill into their full discography (newest first); tap an album for its tracklist. Searches are storefront-aware — region follows your Apple ID."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca en Apple Music por pista, artista o álbum. Toca un artista para ver toda su discografía (lo más reciente primero); toca un álbum para su lista de pistas. Las búsquedas siguen la tienda — la región sigue a tu ID de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherchez dans Apple Music par titre, artiste ou album. Touchez un artiste pour parcourir toute sa discographie (plus récent d'abord) ; touchez un album pour sa liste de titres. La recherche suit la vitrine — la région suit votre identifiant Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca in Apple Music per brano, artista o album. Tocca un artista per la discografia completa (più recente prima); tocca un album per l'elenco dei brani. Le ricerche seguono lo storefront — la regione segue il tuo ID Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Music を曲、アーティスト、アルバムで検索します。アーティストをタップすると全ディスコグラフィ（新しい順）、アルバムをタップするとトラックリストが開きます。検索はストアフロントに従い、地域は Apple ID に準じます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søk i Apple Music etter spor, artist eller album. Trykk på en artist for hele diskografien (nyest først); trykk på et album for sporlisten. Søk følger butikken — regionen følger Apple-ID-en din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoek in Apple Music op nummer, artiest of album. Tik op een artiest voor de volledige discografie (nieuwste eerst); tik op een album voor de tracklijst. Zoeken volgt de storefront — de regio volgt je Apple ID."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szukaj w Apple Music według utworu, wykonawcy lub albumu. Stuknij wykonawcę, aby zobaczyć całą dyskografię (najnowsze najpierw); stuknij album, aby zobaczyć listę utworów. Wyszukiwanie zależy od sklepu — region wynika z Twojego Apple ID."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesquise na Apple Music por faixa, artista ou álbum. Toque num artista para a discografia completa (mais recente primeiro); toque num álbum para a lista de faixas. As pesquisas seguem a loja — a região segue o seu ID Apple."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sök i Apple Music efter spår, artist eller album. Tryck på en artist för hela diskografin (nyast först); tryck på ett album för spårlistan. Sökningar följer butiken — regionen följer ditt Apple-ID."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按曲目、艺人或专辑搜索 Apple Music。点击艺人可查看完整作品集（最新在前）；点击专辑查看曲目列表。搜索跟随商店区域，由你的 Apple ID 决定。"
          }
        }
      }
    },

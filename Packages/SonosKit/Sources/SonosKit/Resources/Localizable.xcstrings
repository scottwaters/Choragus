        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunstnerbiografi, foto, tags og lignende kunstnere fra Wikipedia, MusicBrainz og Last.fm — alt på dit app-sprog. Albumets udgivelsesdato og sporliste, når tilgængeligt. Højreklik for at opdatere metadata; klik på fotoet for at forstørre; klik på Wikipedia-linket for at åbne artiklen i browseren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interpretenbiografie, Foto, Tags und ähnliche Künstler aus Wikipedia, MusicBrainz und Last.fm — alles in deiner App-Sprache. Albumerscheinungsdatum und Tracklist, sofern verfügbar. Rechtsklick zum Aktualisieren der Metadaten; Klick auf das Foto zum Vergrößern; Klick auf den Wikipedia-Link öffnet den Artikel im Browser."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artist bio, photo, tags, and similar artists from Wikipedia, MusicBrainz, and Last.fm — all in your app language. Album release date and tracklist when available. Right-click to refresh metadata; click the artist photo to enlarge; click the Wikipedia link to open the article in your browser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biografía, foto, etiquetas y artistas similares desde Wikipedia, MusicBrainz y Last.fm — todo en el idioma de la app. Fecha de lanzamiento del álbum y lista de pistas cuando estén disponibles. Clic derecho para actualizar los metadatos; clic en la foto para ampliar; clic en el enlace de Wikipedia para abrir el artículo en tu navegador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biographie d’artiste, photo, tags et artistes similaires depuis Wikipédia, MusicBrainz et Last.fm — tout dans la langue de l’application. Date de sortie de l’album et tracklist si disponibles. Clic droit pour rafraîchir les métadonnées ; clic sur la photo pour agrandir ; clic sur le lien Wikipédia pour ouvrir l’article dans votre navigateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biografia, foto, tag e artisti simili da Wikipedia, MusicBrainz e Last.fm — tutto nella lingua dell’app. Data di pubblicazione dell’album e tracklist quando disponibili. Clic destro per aggiornare i metadati; clic sulla foto per ingrandire; clic sul link a Wikipedia per aprire l’articolo nel browser."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wikipedia、MusicBrainz、Last.fm からのアーティストの紹介・写真・タグ・類似アーティストをアプリの言語で表示します。利用可能な場合はアルバムのリリース日とトラックリストも表示されます。右クリックでメタデータを更新、アーティストの写真をクリックして拡大、Wikipediaリンクでブラウザに記事を開きます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artistbiografi, bilde, tagger og lignende artister fra Wikipedia, MusicBrainz og Last.fm — alt på appspråket ditt. Albumets utgivelsesdato og sporliste der tilgjengelig. Høyreklikk for å oppdatere metadata; klikk på bildet for å forstørre; klikk på Wikipedia-lenken for å åpne artikkelen i nettleseren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artiestbio, foto, tags en vergelijkbare artiesten uit Wikipedia, MusicBrainz en Last.fm — alles in je app-taal. Album-releasedatum en tracklijst indien beschikbaar. Rechterklik om metadata te vernieuwen; klik op de foto om te vergroten; klik op de Wikipedia-link om het artikel in je browser te openen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biografia artysty, zdjęcie, tagi i podobni artyści z Wikipedii, MusicBrainz oraz Last.fm — wszystko w języku aplikacji. Data wydania albumu i lista utworów, gdy są dostępne. Kliknięcie prawym przyciskiem odświeża metadane; kliknięcie zdjęcia powiększa; kliknięcie linku do Wikipedii otwiera artykuł w przeglądarce."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biografia, foto, etiquetas e artistas semelhantes da Wikipédia, MusicBrainz e Last.fm — tudo no idioma da app. Data de lançamento do álbum e alinhamento de faixas quando disponíveis. Clique com o botão direito para atualizar os metadados; clique na foto para ampliar; clique no link da Wikipédia para abrir o artigo no seu navegador."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artistbiografi, foto, taggar och liknande artister från Wikipedia, MusicBrainz och Last.fm — allt på ditt appspråk. Albumets utgivningsdatum och spårlista när det går. Högerklicka för att uppdatera metadata; klicka på fotot för att förstora; klicka på Wikipedia-länken för att öppna artikeln i webbläsaren."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来自 Wikipedia、MusicBrainz 与 Last.fm 的艺术家介绍、照片、标签及相似艺术家—均使用您的应用语言。如有可用数据，会显示专辑发行日期及曲目列表。右键刷新元数据；点击照片放大；点击 Wikipedia 链接在浏览器中打开文章。"
          }
        }
      }
    },

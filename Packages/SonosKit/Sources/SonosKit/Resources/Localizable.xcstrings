    "eachCellOneDayDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver celle = en dag. Lysere = mere lyttetid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Zelle = ein Tag. Heller = mehr Hörzeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each cell = one day. Brighter = more listening time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada celda = un día. Más brillante = más tiempo de escucha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque cellule = un jour. Plus lumineux = plus de temps d’écoute."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni cella = un giorno. Più luminoso = più tempo di ascolto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各セル = 1日。明るいほど聴取時間が長いです。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver celle = én dag. Lysere = mer lyttetid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke cel = één dag. Helderder = meer luistertijd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda komórka = jeden dzień. Jaśniej = więcej czasu słuchania."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada célula = um dia. Mais brilhante = mais tempo de escuta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje cell = en dag. Ljusare = mer lyssningstid."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个格子 = 一天。越亮 = 职听时间越长。"
          }
        }
      }
    },

    "helpGroupingSpeakersBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En gruppe har én koordinator og nul eller flere medlemmer. Alle medlemmer afspiller det samme som koordinatoren, synkront."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Gruppe hat einen Koordinator und null oder mehr Mitglieder. Alle Mitglieder spielen synchron das wieder, was der Koordinator abspielt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A group has one coordinator and zero or more members. All members play whatever the coordinator plays, in sync."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un grupo tiene un coordinador y cero o más miembros. Todos los miembros reproducen lo mismo que el coordinador, en sincronía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un groupe comporte un coordinateur et zéro ou plusieurs membres. Tous les membres lisent de manière synchronisée ce que lit le coordinateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un gruppo ha un coordinatore e zero o più membri. Tutti i membri riproducono ciò che riproduce il coordinatore, in sincronia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グループには1つのコーディネーターと0以上のメンバーがあります。すべてのメンバーはコーディネーターと同期して再生します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En gruppe har én koordinator og null eller flere medlemmer. Alle medlemmer spiller det samme som koordinatoren, synkronisert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een groep heeft één coördinator en nul of meer leden. Alle leden spelen synchroon af wat de coördinator afspeelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupa ma jednego koordynatora i zero lub więcej członków. Wszyscy członkowie odtwarzają to samo co koordynator, zsynchronizowane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um grupo tem um coordenador e zero ou mais membros. Todos os membros reproduzem o que o coordenador reproduz, em sincronia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En grupp har en koordinator och noll eller fler medlemmar. Alla medlemmar spelar upp det koordinatorn spelar, synkroniserat."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个组有一个协调器和零个或多个成员。所有成员与协调器同步播放相同内容。"
          }
        }
      }
    },

    "welcomeBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at afspille musik fra streamingtjenester skal du først konfigurere dine højttalere og tjenester (Spotify, Apple Music, TuneIn og andre) i den officielle Sonos-app.\n\nÅbn derefter Indstillinger (⌘,) → Musik for at aktivere de tjenester, du vil søge og gennemse her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Musik von Streaming-Diensten abzuspielen, richte zunächst deine Lautsprecher und Dienste (Spotify, Apple Music, TuneIn und andere) in der offiziellen Sonos-App ein.\\n\\nÖffne dann Einstellungen (⌘,) → Musik, um die Dienste zu aktivieren, die du hier suchen und durchsuchen möchtest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Settings (⌘,) → Music to choose what to listen to.\n\n• TuneIn, Calm Radio, Sonos Radio, Apple Music search — just tick the checkbox; no other setup needed.\n\n• Spotify, Plex, Apple Music playback — first add the service in the official Sonos app (and play one song from it as a Sonos Favorite for Spotify and Apple Music), then click Connect in Settings → Music.\n\nFor step-by-step instructions, click the Setup Guide button at the top of the Music section."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para reproducir música de servicios de streaming, primero configura tus altavoces y servicios (Spotify, Apple Music, TuneIn y otros) en la app oficial de Sonos.\n\nLuego abre Ajustes (⌘,) → Música para activar los servicios que quieras buscar y explorar aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour lire de la musique depuis des services de streaming, configurez d’abord vos enceintes et vos services (Spotify, Apple Music, TuneIn et autres) dans l’application Sonos officielle.\n\nOuvrez ensuite Réglages (⌘,) → Musique pour activer les services que vous souhaitez rechercher et explorer ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per riprodurre musica dai servizi di streaming, configura prima i tuoi altoparlanti e servizi (Spotify, Apple Music, TuneIn e altri) nell’app Sonos ufficiale.\n\nPoi apri Impostazioni (⌘,) → Musica per abilitare i servizi che vuoi cercare ed esplorare qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストリーミングサービスから音楽を再生するには、まず公式の Sonos アプリでスピーカーとサービス（Spotify、Apple Music、TuneIn など）を設定してください。\n\n次に設定（⌘,）→ 音楽を開いて、ここで検索・閲覧したいサービスを有効にしてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å spille musikk fra strømmetjenester, still først inn høyttalerne og tjenestene (Spotify, Apple Music, TuneIn og andre) i den offisielle Sonos-appen.\n\nÅpne deretter Innstillinger (⌘,) → Musikk for å aktivere tjenestene du vil søke og bla gjennom her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om muziek van streamingdiensten af te spelen, stel je eerst je luidsprekers en diensten (Spotify, Apple Music, TuneIn en andere) in de officiële Sonos-app in.\\n\\nOpen vervolgens Instellingen (⌘,) → Muziek om de diensten in te schakelen die je hier wilt doorzoeken en bladeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby odtwarzać muzykę ze streamingu, najpierw skonfiguruj głośniki i serwisy (Spotify, Apple Music, TuneIn i inne) w oficjalnej aplikacji Sonos.\n\nNastępnie otwórz Ustawienia (⌘,) → Muzyka, aby włączyć serwisy, które chcesz tutaj przeszukiwać i przeglądać."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para reproduzir música de serviços de streaming, primeiro configure seus alto-falantes e serviços (Spotify, Apple Music, TuneIn e outros) no aplicativo oficial do Sonos.\n\nEm seguida, abra Configurações (⌘,) → Música para ativar os serviços que deseja pesquisar e navegar aqui."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att spela musik från strömningstjänster, ställ först in högtalarna och tjänsterna (Spotify, Apple Music, TuneIn med flera) i den officiella Sonos-appen.\n\nÖppna sedan Inställningar (⌘,) → Musik för att aktivera de tjänster du vill söka och bläddra i här."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要从流媒体服务播放音乐，请先在官方 Sonos 应用中设置您的音箱和服务（Spotify、Apple Music、TuneIn 等）。\n\n然后打开设置（⌘,）→ 音乐，启用您想在此处搜索和浏览的服务。"
          }
        }
      }
    },

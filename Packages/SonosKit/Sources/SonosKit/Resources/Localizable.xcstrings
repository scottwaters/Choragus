    "helpRebrandBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus hed tidligere SonosController. Bundle-id’et er flyttet til com.choragus.app og nøgleringen følger; eksisterende Last.fm- og musiktjeneste-godkendelser skal genforbindes én gang efter opgraderingen. Kodebasen, vedligeholderen og kildekoderepository’et er ellers uforandret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus hieß früher SonosController. Die Bundle-ID wurde auf com.choragus.app umgestellt und der Schlüsselbund folgt; bestehende Last.fm- und Musikdienst-Anmeldungen müssen nach dem Update einmal neu verknüpft werden. Codebasis, Betreuer und Quell-Repository bleiben unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus was previously named SonosController. The bundle identifier moved to com.choragus.app and the Keychain service follows; existing Last.fm and music-service authentications need to be re-linked once after upgrading. The codebase, maintainer, and source repository are otherwise unchanged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus se llamaba anteriormente SonosController. El identificador del paquete se ha movido a com.choragus.app y el llavero sigue ese cambio; las autenticaciones existentes de Last.fm y servicios de música deben volver a vincularse una vez tras actualizar. El código, el mantenedor y el repositorio de origen no han cambiado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus s’appelait auparavant SonosController. L’identifiant de bundle est devenu com.choragus.app et le trousseau suit ; les authentifications Last.fm et services de musique existantes doivent être relinkées une fois après la mise à jour. La base de code, le mainteneur et le référentiel source sont par ailleurs inchangés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus si chiamava in precedenza SonosController. L’identificatore del bundle è passato a com.choragus.app e il portachiavi segue; le autenticazioni esistenti di Last.fm e dei servizi musicali devono essere ricollegate una volta dopo l’aggiornamento. La codebase, il manutentore e il repository sorgente sono per il resto invariati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus は以前 SonosController と呼ばれていました。バンドル ID は com.choragus.app に移行し、キーチェーンもそれに合わせて変更されました。アップグレード後、既存の Last.fm とミュージックサービスの認証は一度再リンクする必要があります。それ以外のコードベース、メンテナ、ソースリポジトリは変わりません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus het tidligere SonosController. Pakke-ID-en er flyttet til com.choragus.app og nøkkelringen følger; eksisterende Last.fm- og musikktjeneste-autentiseringer må kobles på nytt én gang etter oppgraderingen. Kodebasen, vedlikeholderen og kildekodelageret er ellers uendret."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus heette voorheen SonosController. De bundle-id is verplaatst naar com.choragus.app en de sleutelhanger volgt; bestaande Last.fm- en muziekservice-authenticaties moeten na de upgrade één keer opnieuw worden gekoppeld. De codebasis, beheerder en broncode-repository zijn verder ongewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus nazywał się wcześniej SonosController. Identyfikator pakietu został przeniesiony na com.choragus.app, a pęk kluczy podąża za nim; istniejące uwierzytelnienia Last.fm oraz usług muzycznych należy po aktualizacji raz ponołączyć. Kod, opiekun oraz repozytorium źródłowe pozostają bez zmian."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus chamava-se anteriormente SonosController. O identificador de pacote passou para com.choragus.app e o chaveiro acompanha; as autenticações existentes de Last.fm e serviços de música precisam ser religadas uma vez após a atualização. Código, mantenedor e repositório de origem permanecem inalterados."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus hette tidigare SonosController. Paket-ID:t har flyttats till com.choragus.app och nyckelringen följer; befintliga Last.fm- och musiktjänstautentiseringar måste länkas om en gång efter uppgradering. Kodbasen, underhållaren och källkodsförrådet är i övrigt oförändrade."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus 之前名为 SonosController。Bundle ID 已迁移至 com.choragus.app，钥匙串也随之调整；升级后现有的 Last.fm 与音乐服务认证需重新关联一次。代码库、维护者与源代码仓库保持不变。"
          }
        }
      }
    },

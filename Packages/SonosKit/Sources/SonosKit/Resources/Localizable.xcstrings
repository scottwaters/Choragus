    "visRandomArtMixHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andelen af felter på væggen, der trækkes tilfældigt fra hele din afspilningshistorik i stedet for det aktuelle spørs genre. Højere værdier holder væggen varieret, selv når én genre dominerer køen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anteil der Wandkacheln, die zufällig aus deinem gesamten Wiedergabeverlauf statt aus dem Genre des aktuellen Titels gezogen werden. Höhere Werte halten die Wand abwechslungsreich, auch wenn ein Genre dominiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percentage of wall tiles drawn from your full play history at random rather than the current track’s genre. Higher values keep the wall feeling varied even when one genre dominates the queue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porcentaje de mosaicos del muro tomados al azar de todo tu historial en lugar del género del tema actual. Valores más altos mantienen el muro variado incluso cuando un género domina la cola."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pourcentage des cases du mur tirées au hasard dans l’ensemble de votre historique d’écoute plutôt que dans le genre du morceau en cours. Une valeur plus élevée maintient un mur varié même lorsqu’un genre domine la file."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percentuale di tessere della parete prelevate a caso dall’intera cronologia anziché dal genere del brano in riproduzione. Valori più alti mantengono la parete varia anche quando un genere domina la coda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のトラックのジャンルではなく再生履歴全体からランダムに描画される痁のタイルの割合。値が高いほど、キューのジャンルが偏っても痁の多様性が保たれます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andel av rutene på veggen som velges tilfeldig fra hele lyttehistorikken din i stedet for sjangeren til sporet som spilles. Høyere verdier holder veggen variert selv når en sjanger dominerer køen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percentage muurtegels dat willekeurig uit je volledige afspeelgeschiedenis komt in plaats van het genre van het huidige nummer. Hogere waarden houden de muur gevarieerd, zelfs als één genre de wachtrij domineert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procent kafelków ściany dobieranych losowo z całej historii odtwarzania zamiast z gatunku bieżącego utworu. Wyższe wartości utrzymują różnorodność ściany nawet wtedy, gdy w kolejce dominuje jeden gatunek."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percentagem das peças do mural retiradas ao acaso do histórico completo em vez do género da faixa em reprodução. Valores mais altos mantêm o mural variado mesmo quando um género domina a fila."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andel av väggens rutor som dras slumpmässigt ur hela din lyssningshistorik i stället för det aktuella spårets genre. Högre värden håller väggen omväxlande även när en genre dominerar kön."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从整个播放历史中随机选取而非取自当前曲目类型的墙面瓷片百分比。数值越高，即使某一类型主导队列，墙面也能保持丰富变化。"
          }
        }
      }
    },

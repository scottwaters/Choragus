    "mcpShowInToolbarHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved siden af Indstillinger sidder et MCP-mærke, mens serveren kører, med et lys i dens tilstand: grønt i drift, orange mislykkedes, gråt stoppet. Klik for anmodningsloggen i Diagnostik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neben den Einstellungen sitzt ein MCP-Abzeichen, solange der Server läuft, mit einem Licht in seinem Zustand: grün läuft, orange fehlgeschlagen, grau gestoppt. Ein Klick öffnet das Anfrageprotokoll in der Diagnose."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An MCP badge sits next to Settings while the server is on, with a light in its state: green running, orange failed, grey stopped. Click it for the request log in Diagnostics."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Junto a Ajustes aparece una insignia MCP mientras el servidor está activo, con una luz según su estado: verde en marcha, naranja con fallo, gris detenido. Haz clic para ver el registro de solicitudes en Diagnóstico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un badge MCP se place à côté des Réglages tant que le serveur tourne, avec un voyant dans son état : vert en marche, orange en échec, gris arrêté. Cliquez-le pour le journal des requêtes dans le Diagnostic."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accanto a Impostazioni compare un contrassegno MCP mentre il server è attivo, con una spia del suo stato: verde in funzione, arancione fallito, grigio fermo. Fai clic per il registro delle richieste in Diagnostica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーが動作している間、設定の隣に MCP バッジが表示され、状態を示すライトが付きます（緑：稼働中、オレンジ：起動失敗、グレー：停止）。クリックすると診断のリクエストログが開きます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ved siden av Innstillinger sitter et MCP-merke mens serveren kjører, med et lys i tilstanden: grønt i drift, oransje mislyktes, grått stoppet. Klikk for forespørselsloggen i Diagnostikk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naast Instellingen staat een MCP-badge zolang de server draait, met een lampje in zijn status: groen draait, oranje mislukt, grijs gestopt. Klik erop voor het verzoeklog in Diagnose."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obok Ustawień pojawia się plakietka MCP, gdy serwer działa, z lampką stanu: zielona działa, pomarańczowa błąd, szara zatrzymany. Kliknij, aby otworzyć dziennik żądań w Diagnostyce."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao lado de Ajustes aparece um distintivo MCP enquanto o servidor está ligado, com uma luz do seu estado: verde a correr, laranja falhou, cinzento parado. Clique para o registo de pedidos no Diagnóstico."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bredvid Inställningar sitter en MCP-bricka medan servern är igång, med en lampa i dess tillstånd: grön igång, orange misslyckad, grå stoppad. Klicka för förfrågningsloggen i Diagnostik."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器运行时，设置旁会显示 MCP 标记，并带有状态指示灯：绿色运行中、橙色启动失败、灰色已停止。点击可在诊断中查看请求日志。"
          }
        }
      }
    },

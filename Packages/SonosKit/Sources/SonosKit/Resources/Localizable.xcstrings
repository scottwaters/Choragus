    "helpTransportStateBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus bruger UPnP-begivenhedsabonnementer til næsten øjeblikkelige statusopdateringer. Hvis netværket taber begivenheder, skifter appen automatisk til periodisk polling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus nutzt UPnP-Ereignisabonnements für nahezu sofortige Statusaktualisierungen. Gehen im Netzwerk Ereignisse verloren, wechselt die App automatisch auf regelmäßiges Abrufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus uses UPnP event subscriptions for near-instant state updates. If your network drops events, the app falls back to periodic polling automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus usa suscripciones a eventos UPnP para actualizaciones de estado casi instantáneas. Si la red pierde eventos, la app cambia automáticamente a sondeo periódico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus utilise les abonnements à des événements UPnP pour des mises à jour d’état quasi instantanées. Si votre réseau perd des événements, l’app bascule automatiquement sur une interrogation périodique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus usa le sottoscrizioni agli eventi UPnP per aggiornamenti di stato quasi istantanei. Se la rete perde eventi, l’app passa automaticamente al polling periodico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChoragusはUPnPイベント購読を使用してほぼ瞬時に状態を更新します。ネットワークでイベントが欠落した場合、アプリは自動的に定期ポーリングに切り替わります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus bruker UPnP-hendelsesabonnementer for nær umiddelbare statusoppdateringer. Hvis nettverket mister hendelser, bytter appen automatisk til periodisk polling."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus gebruikt UPnP-abonnementen voor bijna direct statusupdate. Als je netwerk events laat vallen, schakelt de app automatisch over op periodieke polling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus korzysta z subskrypcji zdarzeń UPnP dla niemal natychmiastowych aktualizacji stanu. Jeśli sieć gubi zdarzenia, aplikacja automatycznie przełącza się na okresowe odpytywanie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Choragus usa assinaturas de eventos UPnP para atualizações de estado quase instantâneas. Se a rede perder eventos, o app volta automaticamente para consulta periódica."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus använder UPnP-händelseprenumerationer för nästan omedelbara statusuppdateringar. Om nätverket tappar händelser övergår appen automatiskt till periodisk polling."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus 使用 UPnP 事件订阅实现近乎实时的状态更新。如果网络丢失事件，应用会自动回退到定期轮询。"
          }
        }
      }
    },
    "helpVisIntroBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menuen Visualiseringer (og gnistknappen i værktøjslinjen) åbner to fuldskærmsvisninger, der følger det valgte rum: Back of the Club (⌘J) og Karaoke-vinduet (⌘K). Begge kan flyttes til en anden skærm og køre videre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Menü „Visualisierungen“ (und der Funkel-Button in der Symbolleiste) öffnet zwei Vollbildansichten, die dem gewählten Raum folgen: Back of the Club (⌘J) und das Karaoke-Fenster (⌘K). Beide lassen sich auf einen anderen Bildschirm schieben und laufen lassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Visualisation menu (and the sparkles button in the toolbar) opens two full-screen views that follow the selected room: Back of the Club (⌘J) and the Karaoke window (⌘K). Both can be moved to another display and left running."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El menú Visualizaciones (y el botón de destellos de la barra de herramientas) abre dos vistas a pantalla completa que siguen la habitación seleccionada: Back of the Club (⌘J) y la ventana de Karaoke (⌘K). Ambas pueden moverse a otra pantalla y dejarse funcionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le menu Visualisations (et le bouton étincelles de la barre d'outils) ouvre deux vues plein écran qui suivent la pièce sélectionnée : Back of the Club (⌘J) et la fenêtre Karaoké (⌘K). Les deux peuvent être déplacées sur un autre écran et laissées tourner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il menu Visualizzazioni (e il pulsante scintille nella barra degli strumenti) apre due viste a schermo intero che seguono la stanza selezionata: Back of the Club (⌘J) e la finestra Karaoke (⌘K). Entrambe si possono spostare su un altro schermo e lasciare in esecuzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ビジュアライゼーション」メニュー（ツールバーのきらめきボタン）は、選択中の部屋に追従する 2 つのフルスクリーン表示を開きます。Back of the Club（⌘J）とカラオケウィンドウ（⌘K）です。どちらも別のディスプレイへ移動して表示し続けられます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyen Visualiseringer (og gnistknappen i verktøylinjen) åpner to fullskjermvisninger som følger det valgte rommet: Back of the Club (⌘J) og Karaoke-vinduet (⌘K). Begge kan flyttes til en annen skjerm og bli stående."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het menu Visualisaties (en de sterretjesknop in de knoppenbalk) opent twee schermvullende weergaven die de gekozen kamer volgen: Back of the Club (⌘J) en het Karaoke-venster (⌘K). Beide kunnen naar een ander scherm worden verplaatst en blijven draaien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menu Wizualizacje (i przycisk iskier na pasku narzędzi) otwiera dwa pełnoekranowe widoki podążające za wybranym pokojem: Back of the Club (⌘J) i okno Karaoke (⌘K). Oba można przenieść na inny ekran i zostawić włączone."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O menu Visualizações (e o botão de brilhos na barra de ferramentas) abre duas vistas em ecrã inteiro que seguem a sala selecionada: Back of the Club (⌘J) e a janela de Karaoke (⌘K). Ambas podem ir para outro ecrã e ficar a correr."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyn Visualiseringar (och gnistknappen i verktygsfältet) öppnar två helskärmsvyer som följer det valda rummet: Back of the Club (⌘J) och Karaokefönstret (⌘K). Båda kan flyttas till en annan skärm och lämnas igång."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“可视化”菜单（以及工具栏中的闪光按钮）会打开两个跟随所选房间的全屏视图：Back of the Club（⌘J）和卡拉 OK 窗口（⌘K）。两者都可以移到另一台显示器上持续运行。"
          }
        }
      }
    },
    "helpVisLightingBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyset aflæser farverne i det aktuelle cover og bygger sin wash og sine stråler kun af de toner, så rummet får albummets palet; skift tones over i stedet for at klippe. Et cover uden farve, eller intet cover, falder tilbage på et hussæt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Licht liest die Farben des aktuellen Covers und baut Wash und Beams nur aus diesen Tönen, sodass der Raum die Palette des Albums annimmt; Wechsel werden überblendet, nie hart geschnitten. Farbloses oder fehlendes Cover fällt auf ein Haus-Set zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The lighting reads the colours of the current cover and builds its wash and beams from those tones only, so the room takes on the album's palette; changes crossfade rather than cut. Album art with no colour, or none at all, falls back to a house set."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La iluminación lee los colores de la carátula actual y construye su baño y sus haces solo con esos tonos, así la sala adopta la paleta del álbum; los cambios se funden en vez de cortar. Una carátula sin color, o ausente, recurre a un juego de casa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'éclairage lit les couleurs de la pochette en cours et construit sa nappe et ses faisceaux uniquement à partir de ces tons : la salle prend la palette de l'album ; les changements se fondent au lieu de couper. Une pochette sans couleur, ou absente, revient à un jeu maison."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le luci leggono i colori della copertina corrente e costruiscono wash e fasci solo da quei toni, così la sala assume la palette dell'album; i cambi sfumano invece di tagliare. Una copertina senza colore, o assente, ricade su un set di casa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照明は現在のカバーの色を読み取り、そのトーンだけでウォッシュとビームを構成するため、会場はアルバムのパレットに染まります。切り替えはカットではなくクロスフェードです。色のないカバーやカバーがない場合はハウスセットになります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyset leser fargene i det gjeldende omslaget og bygger wash og stråler bare av de tonene, så rommet tar albumets palett; skifter tones over i stedet for å klippe. Et omslag uten farge, eller ingen, faller tilbake til et hus-sett."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De verlichting leest de kleuren van de huidige hoes en bouwt wash en beams alleen uit die tinten, zodat de zaal het palet van het album aanneemt; overgangen vloeien in plaats van te knippen. Een hoes zonder kleur, of geen hoes, valt terug op een huisset."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oświetlenie odczytuje kolory bieżącej okładki i buduje wash oraz wiązki wyłącznie z tych tonów, więc sala przyjmuje paletę albumu; zmiany przenikają zamiast ciąć. Okładka bez koloru lub jej brak wraca do zestawu domowego."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A iluminação lê as cores da capa atual e constrói o banho e os feixes só com esses tons, para a sala ganhar a paleta do álbum; as mudanças fundem-se em vez de cortar. Uma capa sem cor, ou ausente, volta a um conjunto da casa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ljuset läser färgerna i det aktuella omslaget och bygger sin wash och sina strålar enbart av de tonerna, så rummet tar albumets palett; byten tonar över i stället för att klippa. Ett omslag utan färg, eller inget alls, faller tillbaka på ett husset."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "灯光读取当前封面的颜色，只用这些色调构成洗光和光束，使房间呈现专辑的配色；变化以交叉淡化而非硬切完成。没有颜色或没有封面时回落到默认灯光组。"
          }
        }
      }
    },
    "helpVisSettingsBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstillinger → Visualiseringer styrer væggen: Farveskema (Cover, Choragus-neonsættet eller Tilpasset med wash, stråler og accent), Genrematch (Delvis lukker beslægtede undergenrer ind, Fuld holder sig til den præcise genre), Historikkilde (kun denne gruppe eller alle højttalere), Tilfældigt mix (hvor meget af væggen der er tilfældig historik frem for genrematch) og kunstnerens Om-panel. Back of the Club er beta: layout og lys ændres mellem versioner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen → Visualisierungen steuert die Wand: Farbschema (Albumcover, das Choragus-Neon-Set oder eigene Wash-, Beam- und Akzentfarben), Genre-Abgleich (Teilweise lässt verwandte Subgenres zu, Vollständig bleibt beim genauen Genre), Verlaufsquelle (nur diese Gruppe oder alle Lautsprecher), Zufalls-Mix (wie viel der Wand zufälliger Verlauf statt Genre-Treffer ist) und das Künstler-Infopanel. Back of the Club ist Beta: Layout und Licht ändern sich zwischen Versionen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings → Visualisations controls the wall: Colour scheme (Album art, the Choragus neon set, or Custom wash, beams and accent), Genre matching (Partial lets related sub-genres in, Full keeps to the exact genre), History source (this group only, or every speaker), Random art mix (how much of the wall is random history rather than genre matches) and the artist About panel. Back of the Club is a beta: layout and lighting change between releases."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes → Visualizaciones controla el muro: Esquema de color (Carátula, el juego neón de Choragus o Personalizado con baño, haces y acento), Coincidencia de género (Parcial admite subgéneros afines, Completa se ciñe al género exacto), Fuente del historial (solo este grupo o todos los altavoces), Mezcla aleatoria (cuánto del muro es historial al azar en vez de coincidencias de género) y el panel Acerca del artista. Back of the Club está en beta: la disposición y la iluminación cambian entre versiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglages → Visualisations pilote le mur : Palette (Pochette, le jeu néon Choragus, ou Personnalisé pour nappe, faisceaux et accent), Correspondance de genre (Partielle admet les sous-genres proches, Complète s'en tient au genre exact), Source d'historique (ce groupe seul ou toutes les enceintes), Mélange aléatoire (part du mur tirée de l'historique au hasard plutôt que du genre) et le panneau À propos de l'artiste. Back of the Club est en bêta : disposition et éclairage changent d'une version à l'autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impostazioni → Visualizzazioni governa la parete: Schema colori (Copertina, il set neon Choragus o Personalizzato con wash, fasci e accento), Corrispondenza genere (Parziale ammette sottogeneri affini, Completa resta sul genere esatto), Fonte cronologia (solo questo gruppo o tutti i diffusori), Mix casuale (quanta parete è cronologia casuale anziché corrispondenze di genere) e il pannello Info artista. Back of the Club è in beta: layout e luci cambiano tra le versioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定 → ビジュアライゼーションでウォールを制御します。カラースキーム（アルバムアート、Choragus ネオンセット、またはウォッシュ・ビーム・アクセントのカスタム）、ジャンル一致（部分一致は近いサブジャンルも含め、完全一致は同一ジャンルのみ）、履歴ソース（このグループのみ、または全スピーカー）、ランダムアートの割合（ジャンル一致ではなくランダム履歴が占める割合）、アーティスト情報パネル。Back of the Club はベータ版で、レイアウトと照明はリリース間で変わります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innstillinger → Visualiseringer styrer veggen: Fargeskjema (Omslag, Choragus-neonsettet eller Egendefinert med wash, stråler og aksent), Sjangermatching (Delvis slipper inn beslektede undersjangre, Full holder seg til nøyaktig sjanger), Historikkilde (bare denne gruppen eller alle høyttalere), Tilfeldig miks (hvor mye av veggen som er tilfeldig historikk i stedet for sjangertreff) og Om-panelet for artisten. Back of the Club er beta: layout og lys endres mellom versjoner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instellingen → Visualisaties regelt de wand: Kleurenschema (Albumhoes, de Choragus-neonset of Aangepast met wash, beams en accent), Genrematching (Gedeeltelijk laat verwante subgenres toe, Volledig houdt het bij het exacte genre), Geschiedenisbron (alleen deze groep of alle speakers), Willekeurige mix (hoeveel van de wand willekeurige geschiedenis is in plaats van genrematches) en het Over-paneel van de artiest. Back of the Club is bèta: indeling en verlichting veranderen tussen versies."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawienia → Wizualizacje sterują ścianą: Schemat kolorów (Okładka, zestaw neonowy Choragus lub Własny z wash, wiązkami i akcentem), Dopasowanie gatunku (Częściowe dopuszcza pokrewne podgatunki, Pełne trzyma się dokładnego gatunku), Źródło historii (tylko ta grupa lub wszystkie głośniki), Losowa mieszanka (ile ściany to losowa historia zamiast dopasowań gatunku) i panel O artyście. Back of the Club to beta: układ i światła zmieniają się między wydaniami."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes → Visualizações controla o mural: Esquema de cores (Capa, o conjunto néon do Choragus ou Personalizado com banho, feixes e realce), Correspondência de género (Parcial admite subgéneros próximos, Completa mantém o género exato), Fonte do histórico (só este grupo ou todas as colunas), Mistura aleatória (quanto do mural é histórico aleatório em vez de correspondências de género) e o painel Sobre o artista. O Back of the Club está em beta: disposição e luzes mudam entre versões."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inställningar → Visualiseringar styr väggen: Färgschema (Omslag, Choragus neonset eller Anpassat med wash, strålar och accent), Genrematchning (Delvis släpper in närliggande subgenrer, Full håller sig till exakt genre), Historikkälla (bara den här gruppen eller alla högtalare), Slumpmix (hur mycket av väggen som är slumpad historik i stället för genreträffar) och artistens Om-panel. Back of the Club är beta: layout och ljus ändras mellan versioner."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置 → 可视化控制这面墙：配色方案（专辑封面、Choragus 霓虹组或自定义洗光、光束与强调色）、流派匹配（部分允许相近子流派，完全只保留精确流派）、历史来源（仅本组或全部扬声器）、随机封面比例（墙上有多少来自随机历史而非流派匹配）和艺人简介面板。Back of the Club 为测试版：布局和灯光会在版本间变化。"
          }
        }
      }
    },
    "helpVisualisationsBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menuen Visualiseringer åbner Back of the Club, en fuldskærmsvæg bygget af albumcoverne fra det, der afspilles, og det, der er blevet afspillet. Du indstiller farvetema, genrematch og belysningsadfærd under Indstillinger → Visualiseringer. Det er en betafunktion: Layout og belysning ændres mellem udgivelser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Menü „Visualisierungen“ öffnet Back of the Club, eine bildschirmfüllende Wand aus den Albumcovern der aktuell und zuvor gespielten Titel. Farbschema, Genre-Anpassung und Beleuchtungsverhalten stellst du unter Einstellungen → Visualisierungen ein. Es handelt sich um eine Beta-Funktion: Layout und Beleuchtung können sich zwischen Versionen ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Visualisation menu opens Back of the Club, a full-screen wall built from the album art of what is playing and what has played. Colour scheme, genre matching and lighting behaviour are set in Settings → Visualisations. It is a beta feature: layout and lighting change between releases."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El menú Visualizaciones abre Back of the Club, un muro a pantalla completa construido con las portadas de los álbumes de lo que está sonando y lo que ha sonado. El esquema de colores, la coincidencia de géneros y el comportamiento de la iluminación los configuras en Ajustes → Visualizaciones. Es una función beta: el diseño y la iluminación cambian entre versiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le menu Visualisations ouvre Back of the Club, un mur en plein écran composé des pochettes d'albums de ce qui est en cours de lecture et de ce qui a été lu. Vous pouvez configurer le schéma de couleurs, la correspondance des genres et le comportement de l'éclairage dans Réglages → Visualisations. Il s'agit d'une fonctionnalité bêta : la disposition et l'éclairage peuvent changer entre les versions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il menu Effetti visivi apre Back of the Club, una parete a tutto schermo creata con le copertine degli album in riproduzione e di quelli già riprodotti. Configuri la combinazione di colori, la corrispondenza dei generi e il comportamento dell'illuminazione in Impostazioni → Effetti visivi. È una funzionalità beta: il layout e l'illuminazione cambiano da una versione all'altra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ビジュアライザ」メニューからBack of the Clubを開きます。これは、現在再生中の曲やこれまでに再生した曲のアルバムアートから構築されるフルスクリーンの壁です。カラースキーム、ジャンルのマッチング、照明の動作は、「設定」→「ビジュアライザ」で設定します。これはベータ版の機能であり、レイアウトと照明はリリースごとに変更されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visualiseringer-menyen åpner Back of the Club, en fullskjermvegg bygget fra albumbildene til det som spilles og det som har blitt spilt. Du angir fargeskjema, sjangertilpasning og lysatferd under Innstillinger → Visualiseringer. Det er en betafunksjon: layout og belysning endres mellom ulike versjoner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het menu Visualisaties opent Back of the Club, een schermvullende muur opgebouwd uit de albumhoezen van wat er nu speelt en wat er is afgespeeld. Kleurenschema, genrematching en belichtingsgedrag stel je in via Instellingen → Visualisaties. Het is een bètafunctie: lay-out en belichting veranderen tussen releases."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menu Wizualizacje otwiera Back of the Club, pełnoekranową ścianę zbudowaną z okładek albumów utworów aktualnie oraz wcześniej odtwarzanych. Schemat kolorów, dopasowywanie gatunków oraz zachowanie oświetlenia można ustawić w menu Ustawienia → Wizualizacje. Jest to funkcja w wersji beta: układ i oświetlenie zmieniają się w zależności od wydania."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O menu Efeitos visuais abre o Back of the Club, uma parede em ecrã completo construída a partir das capas dos álbuns do que está a tocar e do que já tocou. Podes definir o esquema de cores, a correspondência de géneros e o comportamento da iluminação em Definições → Efeitos visuais. É uma funcionalidade beta: a disposição e a iluminação mudam entre versões."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyn Visualiseringar öppnar Back of the Club, en helskärmsvägg byggd av skivomslagen för det som spelas och det som har spelats. Du ställer in färgschema, genrematchning och belysningsbeteende i Inställningar → Visualiseringar. Det är en betafunktion: layout och belysning ändras mellan olika versioner."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“视觉效果”菜单会打开Back of the Club，这是一面由正在播放和已播放专辑的插图构成的全屏展示墙。你可以在“设置”→“视觉效果”中设置配色方案、类型匹配和灯光效果。这是一项测试版功能：布局和灯光效果会在不同版本间有所变化。"
          }
        }
      }
    },

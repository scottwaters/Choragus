    "diagNetworkSettleNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linkstatistik er tællere, der aflæses fra hver højttaler, så den første aflæsning efter åbning af denne fane kan se foruroligende høj ud. Vent et par minutter — tallene stabiliserer sig, når der modtages gentagne målinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindungsstatistiken sind Zähler, die von jedem Lautsprecher ausgelesen werden, daher kann der erste Wert nach dem Öffnen dieses Tabs alarmierend hoch erscheinen. Warte ein bis zwei Minuten — die Zahlen pendeln sich ein, sobald wiederholte Messwerte eintreffen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Link statistics are counters read from each speaker, so the first reading after opening this tab can look alarmingly high. Give it a minute or two — the figures settle as repeat samples arrive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las estadísticas de enlace son contadores leídos de cada altavoz, por lo que la primera lectura después de abrir esta pestaña puede parecer alarmantemente alta. Espera un par de minutos — las cifras se estabilizarán a medida que lleguen muestras repetidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les statistiques de liaison sont des compteurs lus à partir de chaque enceinte. La première lecture après l'ouverture de cet onglet peut donc sembler anormalement élevée. Attendez une minute ou deux — les chiffres se stabilisent à mesure que les échantillons répétés arrivent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le statistiche di collegamento sono contatori letti da ciascuno speaker, pertanto la prima lettura dopo l'apertura di questo pannello può sembrare eccessivamente alta. Attendi un paio di minuti — i dati si stabilizzano man mano che arrivano misurazioni ripetute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンク統計は各スピーカーから読み取られるカウンターであるため、このタブを開いた直後の最初の読み取り値が驚くほど高く見える場合があります。1〜2分お待ちください。サンプルの再取得が繰り返されると、数値は安定します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koblingsstatistikk er tellere som leses fra hver høyttaler, så den første avlesningen etter at du har åpnet denne fanen kan se urovekkende høy ut. Vent et minutt eller to — tallene stabiliserer seg etter hvert som gjentatte målinger mottas."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindingsstatistiken zijn tellers die van elke luidspreker worden uitgelezen, waardoor de eerste meting na het openen van dit tabblad alarmerend hoog kan lijken. Wacht een minuut of twee — de cijfers stabiliseren zich zodra herhaalde metingen binnenkomen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statystyki łącza to liczniki odczytywane z każdego głośnika, dlatego pierwszy odczyt po otwarciu tej karty może wydawać się alarmująco wysoki. Poczekaj minutę lub dwie — liczby ustabilizują się, gdy zaczną napływać kolejne pomiary."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As estatísticas de link são contadores lidos de cada alto-falante, portanto, a primeira leitura após abrir esta aba pode parecer assustadoramente alta. Aguarde um ou dois minutos — os números se estabilizam à medida que novas amostras chegam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Länkstatistik är räknare som läses av från varje högtalare, så den första avläsningen efter att den här fliken har öppnats kan se oroväckande hög ut. Vänta någon minut — siffrorna stabiliseras när upprepade samplingar tas emot."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "链路统计信息是从每个扬声器读取的计数器，因此打开此标签页后的第一次读数可能会高得惊人。请等待一两分钟 — 随着重复采样的到达，数值会稳定下来。"
          }
        }
      }
    },

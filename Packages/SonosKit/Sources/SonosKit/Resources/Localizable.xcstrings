    "mediaKeysEnabledHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afspil, sæt på pause og spring over fra tastaturets medierække. Bluetooth-høretelefoner og bilanlæg sender de samme kommandoer og kan starte afspilning uventet. Slå fra for at give tasterne tilbage til andre apps."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiedergabe, Pause und Überspringen über die Medientastenreihe. Bluetooth-Kopfhörer und Autoradios senden dieselben Befehle und können die Wiedergabe unerwartet starten. Deaktiviere diese Option, um die Tasten an andere Apps zu übergeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play, pause and skip from the keyboard media row. Bluetooth headphones and car units can send the same commands, which can start playback unexpectedly. Turn this off to hand the keys back to other apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce, pausa y salta desde la fila multimedia del teclado. Los auriculares Bluetooth y los equipos de coche envían los mismos comandos y pueden iniciar la reproducción de forma inesperada. Desactívalo para devolver las teclas a otras apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lecture, pause et saut depuis la rangée multimédia du clavier. Les casques Bluetooth et les autoradios envoient les mêmes commandes et peuvent démarrer la lecture de manière inattendue. Désactivez cette option pour rendre les touches aux autres applications."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riproduci, metti in pausa e salta dalla fila multimediale della tastiera. Le cuffie Bluetooth e gli impianti dell’auto inviano gli stessi comandi e possono avviare la riproduzione in modo imprevisto. Disattiva per restituire i tasti alle altre app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーボードのメディアキーで再生・一時停止・スキップを行います。Bluetoothヘッドフォンやカーオーディオも同じコマンドを送信し、意図しない再生開始の原因になります。オフにすると他のアプリにキーを返します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spill av, pause og hopp fra tastaturets medierad. Bluetooth-hodetelefoner og bilanlegg sender de samme kommandoene og kan starte avspilling uventet. Slå av for å gi tastene tilbake til andre apper."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afspelen, pauzeren en overslaan via de mediarij van het toetsenbord. Bluetooth-koptelefoons en autosystemen sturen dezelfde opdrachten en kunnen het afspelen onverwacht starten. Schakel dit uit om de toetsen aan andere apps terug te geven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odtwarzanie, pauza i pomijanie za pomocą klawiszy multimedialnych. Słuchawki Bluetooth i zestawy samochodowe wysyłają te same polecenia i mogą nieoczekiwanie rozpocząć odtwarzanie. Wyłącz, aby oddać klawisze innym aplikacjom."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduz, pausa e avança a partir da fila de teclas de multimédia. Auscultadores Bluetooth e sistemas de automóvel enviam os mesmos comandos e podem iniciar a reprodução inesperadamente. Desative para devolver as teclas a outras aplicações."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spela, pausa och hoppa från tangentbordets mediarad. Bluetooth-hörlurar och bilstereo skickar samma kommandon och kan starta uppspelning oväntat. Stäng av för att lämna tillbaka tangenterna till andra appar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用键盘媒体键播放、暂停和切歌。蓝牙耳机和车载设备会发送相同的命令，可能意外开始播放。关闭后媒体键交给其他应用。"
          }
        }
      }
    },

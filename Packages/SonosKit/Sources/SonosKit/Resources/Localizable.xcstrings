    "helpPlaylistManagementBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos-playlister vises under Playlister i Gennemse. Højreklik på en for at omdøbe eller slette den; ændringer skrives til Sonos-systemet, så alle controllere ser dem. Gemte køer lagret i Choragus administreres separat i vinduet Playlistestyring."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos-Playlists erscheinen unter Playlists in Durchsuchen. Klicke mit der rechten Maustaste auf eine, um sie umzubenennen oder zu löschen; Änderungen werden in das Sonos-System geschrieben, sodass jeder Controller sie sieht. In Choragus gespeicherte Warteschlangen werden separat im Fenster \"Playlist-Manager\" verwaltet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos playlists appear under Playlists in Browse. Right-click one to rename or delete it; changes are written to the Sonos system, so every controller sees them. Saved queues stored inside Choragus are managed separately, in the Playlist Manager window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las listas de reproducción de Sonos aparecen en Listas de reproducción dentro de Explorar. Haz clic derecho en una para cambiarle el nombre o eliminarla; los cambios se guardan en el sistema Sonos para que todos los controladores los vean. Las colas guardadas dentro de Choragus se administran por separado en la ventana Gestor de listas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les playlists Sonos apparaissent sous Playlists dans Parcourir. Faites un clic droit sur l'une d'elles pour la renommer ou la supprimer ; les modifications sont écrites dans le système Sonos, afin que chaque contrôleur les voie. Les files d'attente enregistrées dans Choragus sont gérées séparément, dans la fenêtre Gestionnaire de playlists."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le playlist Sonos appaiono sotto Playlist in Sfoglia. Fai clic con il tasto destro su una di esse per rinominarla o eliminarla; le modifiche vengono scritte nel sistema Sonos, in modo che ogni controller le veda. Le code salvate all'interno di Choragus sono gestite separatamente, nella finestra Libreria code."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonosプレイリストは「ブラウズ」の「プレイリスト」に表示されます。右クリックして名前の変更や削除を行うと、変更がSonosシステムに書き込まれ、すべてのコントローラーに反映されます。Choragus内に保存されたキューは、「プレイリスト管理」ウィンドウで個別に管理されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos-spillelister vises under Spillelister i Bla gjennom. Høyreklikk på en for å gi den nytt navn eller slette den; endringer skrives til Sonos-systemet, slik at hver kontroller ser dem. Lagrede køer i Choragus administreres separat, i Spillelistebehandler-vinduet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos-afspeellijsten verschijnen onder Afspeellijsten in Bladeren. Klik er met de rechtermuisknop op om deze te hernoemen of te verwijderen; wijzigingen worden naar het Sonos-systeem geschreven, zodat elke controller ze ziet. Opgeslagen wachtrijen in Choragus worden afzonderlijk beheerd in het venster Afspeellijstbeheer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playlisty Sonos pojawiają się w sekcji Playlisty w zakładce Przeglądaj. Kliknij prawym przyciskiem myszy, aby zmienić nazwę lub usunąć playlistę; zmiany są zapisywane w systemie Sonos, więc każdy kontroler je widzi. Zapisane kolejki w aplikacji Choragus są zarządzane oddzielnie, w oknie Menedżer playlist."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As listas de reprodução Sonos aparecem em Listas de reprodução na secção Explorar. Clica com o botão direito numa delas para a renomear ou eliminar; as alterações são guardadas no sistema Sonos, pelo que todos os controladores as veem. As filas guardadas no Choragus são geridas separadamente, na janela Gerenciador de playlists."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos-spellistor visas under Spellistor i Bläddra. Högerklicka på en för att byta namn på eller ta bort den; ändringar skrivs till Sonos-systemet så att alla kontroller ser dem. Sparade köer i Choragus hanteras separat i fönstret Spellisthanterare."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos 播放列表出现在“浏览”中的“播放列表”下。右键点按可重命名或删除；更改将写入 Sonos 系统，因此每个控制器都能看到。存储在 Choragus 内的已保存队列在“播放列表管理”窗口中单独管理。"
          }
        }
      }
    },

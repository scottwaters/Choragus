    "listeningClockDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinkel = time på dagen (0 øverst). Radius = hvor nyligt (centrum = nyeste). Farve = tjeneste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Winkel = Tageszeit (0 oben). Radius = wie aktuell (Zentrum = neueste). Farbe = Dienst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angle = hour of day (0 at top). Radius = how recent (centre = latest). Colour = service."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ángulo = hora del día (0 arriba). Radio = qué tan reciente (centro = más reciente). Color = servicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angle = heure du jour (0 en haut). Rayon = ancienneté (centre = plus récent). Couleur = service."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angolo = ora del giorno (0 in alto). Raggio = quanto recente (centro = più recente). Colore = servizio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "角度 = 時刻（上が 0）。半径 = 新しさ（中央 = 最新）。色 = サービス。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinkel = time på dagen (0 øverst). Radius = hvor nylig (sentrum = nyeste). Farge = tjeneste."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoek = uur van de dag (0 bovenaan). Straal = hoe recent (centrum = laatste). Kleur = dienst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kąt = godzina dnia (0 u góry). Promień = jak niedawno (środek = najnowsze). Kolor = usługa."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ângulo = hora do dia (0 no topo). Raio = recente (centro = mais recente). Cor = serviço."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinkel = timme på dygnet (0 överst). Radie = hur nyligen (centrum = senast). Färg = tjänst."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "角度 = 一天中的小时（顶部为 0）。半径 = 时间新近程度（中心 = 最近）。颜色 = 服务。"
          }
        }
      }
    },

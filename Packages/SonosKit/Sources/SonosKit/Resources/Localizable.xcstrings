    "diagEncryptedReportBugHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriver en krypteret pakke til din Downloads-mappe, viser den i Finder og åbner GitHub Issues, så du kan trække filen ind i teksten. Pakken er ugennemsigtig for alle undtagen vedligeholderen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibt ein verschlüsseltes Paket in deinen Downloads-Ordner, zeigt es im Finder an und öffnet GitHub Issues, damit du die Datei in den Beitrag ziehen kannst. Das Paket ist für alle außer dem Betreuer undurchsichtig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Writes an encrypted bundle to your Downloads folder, reveals it in Finder, and opens GitHub Issues so you can drag the file into the body. The bundle is opaque to anyone except the maintainer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe un paquete cifrado en tu carpeta Descargas, lo muestra en Finder y abre GitHub Issues para que arrastres el archivo al cuerpo. El paquete es opaco para cualquiera excepto el responsable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrit un lot chiffré dans votre dossier Téléchargements, le révèle dans le Finder et ouvre GitHub Issues pour que vous puissiez glisser le fichier dans le corps. Le lot est opaque pour quiconque sauf le mainteneur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrive un pacchetto cifrato nella cartella Download, lo mostra nel Finder e apre GitHub Issues per trascinarlo nel corpo. Il pacchetto è opaco per chiunque tranne il manutentore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗号化されたバンドルをダウンロードフォルダに書き出し、Finderで表示して、GitHub Issuesを開きます。ファイルを本文にドラッグしてください。バンドルはメンテナー以外には不透明です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriver en kryptert pakke til Nedlastinger-mappen, viser den i Finder og åpner GitHub Issues så du kan dra filen inn i teksten. Pakken er ugjennomsiktig for alle unntatt vedlikeholderen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schrijft een versleuteld pakket naar je Downloads-map, toont het in Finder en opent GitHub Issues zodat je het bestand in de tekst kunt slepen. Het pakket is ondoorzichtig voor iedereen behalve de beheerder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuje zaszyfrowany pakiet w folderze Pobrane, pokazuje go w Finderze i otwiera GitHub Issues, aby przeciągnąć plik do treści. Pakiet jest nieczytelny dla wszystkich oprócz opiekuna."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escreve um pacote cifrado na pasta Transferências, mostra-o no Finder e abre o GitHub Issues para arrastar o ficheiro para o corpo. O pacote é opaco para todos exceto o responsável."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriver ett krypterat paket till din Nedladdningar-mapp, visar det i Finder och öppnar GitHub Issues så att du kan dra filen in i texten. Paketet är ogenomskinligt för alla utom underhållaren."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将加密的包写入“下载”文件夹，在 Finder 中显示，并打开 GitHub Issues，便于将文件拖入正文。除维护者外的任何人都看不到包内容。"
          }
        }
      }
    },

    "helpAboutBody1" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus er en tredjepartscontroller til Sonos-højttalere. Den er ikke tilknyttet eller godkendt af Sonos, Inc."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus ist ein Controller eines Drittanbieters für Sonos-Lautsprecher. Er ist weder mit Sonos, Inc. verbunden noch von Sonos unterstützt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus is a third-party controller for Sonos speakers. It is not affiliated with or endorsed by Sonos, Inc."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus es un controlador de terceros para altavoces Sonos. No está afiliado ni respaldado por Sonos, Inc."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus est un contrôleur tiers pour les enceintes Sonos. Il n’est ni affilié ni approuvé par Sonos, Inc."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus è un controller di terze parti per altoparlanti Sonos. Non è affiliato né approvato da Sonos, Inc."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChoragusはSonosスピーカー用のサードパーティ製コントローラーです。Sonos, Inc.とは関係も承認もありません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus er en tredjepartskontroller for Sonos-høyttalere. Den er ikke tilknyttet eller støttet av Sonos, Inc."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus is een controller van derden voor Sonos-luidsprekers. De app is niet verbonden met of goedgekeurd door Sonos, Inc."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus to kontroler innej firmy dla głośników Sonos. Nie jest powiązany z ani popierany przez Sonos, Inc."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Choragus é um controlador de terceiros para caixas Sonos. Não é afiliado nem endossado pela Sonos, Inc."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus är en tredjepartskontroll för Sonos-högtalare. Det är varken associerat med eller godkänt av Sonos, Inc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus 是适用于 Sonos 音箱的第三方控制器，与 Sonos, Inc. 无关联、未获其认可。"
          }
        }
      }
    },
    "helpAboutBody2" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al styring bruger lokal UPnP over dit hjemmenetværk. Ingen data forlader dit netværk, og der kræves ingen cloud-konto. Godkendelse af musiktjenester (hvis aktiveret) bruger standardforløbet Sonos SMAPI."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gesamte Steuerung erfolgt über lokales UPnP in deinem Heimnetzwerk. Es verlassen keine Daten dein Netzwerk und es ist kein Cloud-Konto erforderlich. Die Authentifizierung bei Musikdiensten (wenn aktiviert) erfolgt über den standardmäßigen Sonos-SMAPI-Ablauf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All control uses local UPnP over your home network. No data leaves your network and no cloud account is required. Music service authentication (when enabled) uses the standard Sonos SMAPI flow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo el control usa UPnP local en tu red doméstica. Ningún dato sale de tu red y no se requiere cuenta en la nube. La autenticación de servicios musicales (si se activa) usa el flujo estándar SMAPI de Sonos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les commandes utilisent l’UPnP local sur votre réseau domestique. Aucune donnée ne quitte votre réseau et aucun compte cloud n’est requis. L’authentification des services musicaux (si activée) utilise le flux SMAPI Sonos standard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto il controllo usa UPnP locale sulla rete domestica. Nessun dato lascia la tua rete e non è richiesto alcun account cloud. L’autenticazione ai servizi musicali (se attiva) utilizza il flusso Sonos SMAPI standard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての操作はホームネットワーク上のローカルUPnPを経由します。ネットワーク外にデータが流出しず、クラウドアカウントは不要です。音楽サービスの認証（有効時）は標準のSonos SMAPIフローを使用します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All styring bruker lokal UPnP over hjemmenettverket. Ingen data forlater nettverket ditt, og ingen skykonto er nødvendig. Autentisering av musikktjenester (hvis aktivert) bruker standard Sonos SMAPI-flyten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle bediening gebruikt lokaal UPnP via je thuisnetwerk. Er verlaten geen gegevens je netwerk en er is geen cloudaccount nodig. Authenticatie van muziekdiensten (indien ingeschakeld) verloopt via de standaard Sonos SMAPI-flow."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Całe sterowanie wykorzystuje lokalne UPnP w sieci domowej. Żadne dane nie opuszczają sieci i konto w chmurze nie jest wymagane. Uwierzytelnianie usług muzycznych (jeśli włączone) używa standardowego przepływu Sonos SMAPI."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo o controle usa UPnP local na sua rede doméstica. Nenhum dado sai da sua rede e não é necessária conta na nuvem. A autenticação de serviços de música (quando ativa) usa o fluxo padrão Sonos SMAPI."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All styrning använder lokal UPnP över hemnätverket. Ingen data lämnar nätverket och inget molnkonto krävs. Autentisering av musiktjänster (om aktiverad) använder standardflödet Sonos SMAPI."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有控制均在家庭网络中通过本地 UPnP 进行。不会有数据离开您的网络，也无需云账户。音乐服务认证（如启用）使用标准的 Sonos SMAPI 流程。"
          }
        }
      }
    },

    "connectsToPlexDirectlyDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus opretter forbindelse direkte til din Plex-server — ingen Sonos-relæ. Du skal kun gøre dette én gang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus verbindet sich direkt mit deinem Plex-Server — ohne Sonos-Relay. Du musst dies nur einmal tun."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",

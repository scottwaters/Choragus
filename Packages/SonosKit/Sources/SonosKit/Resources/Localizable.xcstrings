          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Choragus → Instellingen… (⌘,) om de app te configureren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz Choragus → Ustawienia… (⌘,), aby skonfigurować aplikację."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra Choragus → Configurações… (⌘,) para configurar o app."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna Choragus → Inställningar… (⌘,) för att konfigurera appen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开 Choragus → 设置…（⌘,）配置应用。"
          }
        }
      }
    },

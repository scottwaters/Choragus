    "amDetailDenied" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giv Apple Music-adgang under Anonymitet og sikkerhed → Medier og Apple Music for at aktivere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Music-Zugriff unter Datenschutz & Sicherheit → Medien & Apple Music erteilen, um zu aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",

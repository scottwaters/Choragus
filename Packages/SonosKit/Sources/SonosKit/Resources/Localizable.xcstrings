    "helpNoSpeakersFoundBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sørg for, at Mac’en er på samme Wi-Fi-netværk som højttalerne. Når appen beder om tilladelse til at tilgå enheder på det lokale netværk, giv den — ellers virker registreringen ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle sicher, dass sich der Mac im selben WLAN wie die Lautsprecher befindet. Wenn die App die Berechtigung zum Zugriff auf Geräte im lokalen Netzwerk anfordert, erteile sie — andernfalls funktioniert die Erkennung nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure the Mac is on the same Wi-Fi network as the speakers. When the app asks for permission to access devices on the local network, grant it — discovery will not work otherwise."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asegúrate de que el Mac esté en la misma red Wi-Fi que los altavoces. Cuando la app pida permiso para acceder a dispositivos en la red local, concédelo, de lo contrario la detección no funcionará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assurez-vous que le Mac est sur le même réseau Wi-Fi que les enceintes. Lorsque l’app demande l’autorisation d’accéder aux appareils du réseau local, accordez-la — sinon la détection ne fonctionnera pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assicurati che il Mac sia sulla stessa rete Wi-Fi degli altoparlanti. Quando l’app chiede l’autorizzazione ad accedere ai dispositivi sulla rete locale, concedila — altrimenti il rilevamento non funzionerà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macがスピーカーと同じWi-Fiネットワークに接続されていることを確認してください。ローカルネットワーク上のデバイスへのアクセス許可が求められたら許可してください—そうしないと検出は機能しません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sørg for at Macen er på samme Wi-Fi-nettverk som høyttalerne. Når appen ber om tillatelse til å nå enheter på det lokale nettverket, gi den — ellers vil ikke oppdagelsen fungere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zorg dat de Mac op hetzelfde Wi-Fi-netwerk zit als de luidsprekers. Verleen de app toestemming om apparaten op het lokale netwerk te benaderen — anders werkt detectie niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upewnij się, że Mac jest w tej samej sieci Wi-Fi co głośniki. Gdy aplikacja poprosi o pozwolenie na dostęp do urządzeń w sieci lokalnej, udziel go — inaczej wykrywanie nie zadziała."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique se o Mac está na mesma rede Wi-Fi das caixas. Quando o app pedir permissão para acessar dispositivos na rede local, conceda — caso contrário, a descoberta não funcionará."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säkerställ att Macen är på samma Wi-Fi-nätverk som högtalarna. När appen ber om tillstånd att komma åt enheter på det lokala nätverket, bevilja det — annars fungerar inte upptäckten."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确保 Mac 和音箱在同一 Wi-Fi 网络。当应用请求访问本地网络设备权限时，请授予，否则无法发现。"
          }
        }
      }
    },

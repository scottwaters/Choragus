    "helpMoreServicesBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TIDAL gennemser og afspiller fra en tilknyttet Sonos-konto. Suno har sit eget udforsk-vindue til offentlige sange og playlister. SomaFM streamer uden konto. Hver slås til i Indstillinger → Musik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TIDAL durchsucht und spielt über ein verknüpftes Sonos-Konto. Suno hat ein eigenes Entdecken-Fenster für öffentliche Songs und Playlists. SomaFM streamt ohne Konto. Alle werden unter Einstellungen → Musik eingeschaltet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TIDAL browses and plays from a linked Sonos account. Suno has its own explore window for public songs and playlists. SomaFM streams without any account. Each is switched on in Settings → Music."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TIDAL explora y reproduce desde una cuenta Sonos vinculada. Suno tiene su propia ventana de exploración para canciones y listas públicas. SomaFM emite sin cuenta. Cada uno se activa en Ajustes → Música."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TIDAL parcourt et lit depuis un compte Sonos lié. Suno a sa propre fenêtre d'exploration pour les titres et playlists publics. SomaFM diffuse sans compte. Chacun s'active dans Réglages → Musique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TIDAL sfoglia e riproduce da un account Sonos collegato. Suno ha una propria finestra di esplorazione per brani e playlist pubblici. SomaFM trasmette senza account. Ognuno si attiva in Impostazioni → Musica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TIDAL は連携した Sonos アカウントから閲覧・再生します。Suno には公開曲とプレイリストを探す専用ウィンドウがあります。SomaFM はアカウントなしでストリーミングできます。いずれも設定 → ミュージックで有効にします。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TIDAL blar og spiller fra en koblet Sonos-konto. Suno har sitt eget utforsk-vindu for offentlige sanger og spillelister. SomaFM strømmer uten konto. Hver slås på i Innstillinger → Musikk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TIDAL bladert en speelt via een gekoppeld Sonos-account. Suno heeft een eigen verkenvenster voor openbare nummers en afspeellijsten. SomaFM streamt zonder account. Elk wordt ingeschakeld in Instellingen → Muziek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TIDAL przegląda i odtwarza z połączonego konta Sonos. Suno ma własne okno eksploracji publicznych utworów i playlist. SomaFM streamuje bez konta. Każdą włącza się w Ustawienia → Muzyka."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O TIDAL navega e toca a partir de uma conta Sonos associada. O Suno tem a sua própria janela de exploração para músicas e playlists públicas. A SomaFM transmite sem conta. Cada um é ativado em Ajustes → Música."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TIDAL bläddrar och spelar från ett länkat Sonos-konto. Suno har ett eget utforskarfönster för offentliga låtar och spellistor. SomaFM strömmar utan konto. Var och en slås på i Inställningar → Musik."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TIDAL 通过已关联的 Sonos 账户浏览和播放。Suno 有自己的探索窗口，用于公开歌曲和播放列表。SomaFM 无需账户即可播放。均在设置 → 音乐中开启。"
          }
        }
      }
    },

        }
      }
    },
    "helpBulletDiscovery" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Højttalere på dit lokale netværk registreres automatisk via SSDP og Bonjour (mDNS) — virker på flade netværk og på segmenterede VLAN, hvor mDNS reflekteres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lautsprecher in deinem lokalen Netzwerk werden automatisch per SSDP und Bonjour (mDNS) erkannt — funktioniert in flachen Netzwerken und in segmentierten VLANs mit mDNS-Reflektion."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speakers on your local network are discovered automatically via SSDP and Bonjour (mDNS) — works on flat networks and on segmented VLANs where mDNS is reflected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los altavoces de tu red local se descubren automáticamente mediante SSDP y Bonjour (mDNS) — funciona en redes planas y en VLAN segmentadas donde mDNS está reflejado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les enceintes de votre réseau local sont détectées automatiquement via SSDP et Bonjour (mDNS) — fonctionne sur les réseaux plats et sur les VLAN segmentés où mDNS est reflété."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli altoparlanti nella tua rete locale vengono rilevati automaticamente tramite SSDP e Bonjour (mDNS) — funziona su reti piatte e su VLAN segmentate dove mDNS è riflesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルネットワーク上のスピーカーは SSDP と Bonjour（mDNS）により自動的に検出されます—フラットネットワークとmDNSリフレクション有りのセグメントVLANの両方で動作します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høyttalere på det lokale nettverket oppdages automatisk via SSDP og Bonjour (mDNS) — fungerer på flate nettverk og på segmenterte VLAN-er der mDNS reflekteres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luidsprekers op je lokale netwerk worden automatisch gedetecteerd via SSDP en Bonjour (mDNS) — werkt op vlakke netwerken en op gesegmenteerde VLAN’s waar mDNS gereflecteerd wordt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Głośniki w sieci lokalnej są wykrywane automatycznie przez SSDP i Bonjour (mDNS) — działa w sieciach płaskich i w segmentowanych VLAN-ach z odbiciem mDNS."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As caixas na rede local são descobertas automaticamente via SSDP e Bonjour (mDNS) — funciona em redes planas e em VLAN segmentadas onde mDNS é refletido."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Högtalare i ditt lokala nätverk upptäcks automatiskt via SSDP och Bonjour (mDNS) — fungerar på platta nätverk och på segmenterade VLAN där mDNS reflekteras."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本地网络上的音箱通过 SSDP 和 Bonjour（mDNS）自动发现—适用于扁平网络及已反射 mDNS 的分段 VLAN。"
          }
        }
      }
    },
    "helpBulletDiscoveryHopLimit" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hopgrænse for søgning — hvor mange routere højttalersøgningen må krydse. Standardværdien 4 når højttalere på et andet VLAN eller subnet, når netværket router multicast; hæv den på større netværk. Blokerer netværket multicast, så brug Bonjour."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suchreichweite (Hops) — wie viele Router die Lautsprechersuche passieren darf. Der Standardwert 4 erreicht Lautsprecher in einem anderen VLAN oder Subnetz, sofern das Netzwerk Multicast weiterleitet; für größere Netzwerke erhöhen. Blockiert das Netzwerk Multicast, hilft nur Bonjour."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discovery hop limit — how many routers the speaker search may cross. The default of 4 reaches speakers on another VLAN or subnet where the network routes multicast; raise it for larger networks. It cannot help where the network blocks multicast, so use Bonjour there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Límite de saltos de detección: cuántos routers puede atravesar la búsqueda de altavoces. El valor predeterminado de 4 alcanza altavoces en otra VLAN o subred cuando la red enruta la multidifusión; auméntelo en redes grandes. Si la red bloquea la multidifusión, use Bonjour."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite de sauts pour la découverte — nombre de routeurs que la recherche d’enceintes peut traverser. La valeur par défaut de 4 atteint les enceintes situées sur un autre VLAN ou sous-réseau lorsque le réseau achemine le multicast ; augmentez-la sur les grands réseaux. Si le réseau bloque le multicast, utilisez Bonjour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite di hop per il rilevamento: quanti router può attraversare la ricerca dei diffusori. Il valore predefinito 4 raggiunge i diffusori su un’altra VLAN o subnet se la rete instrada il multicast; aumentarlo sulle reti più grandi. Se la rete blocca il multicast, usare Bonjour."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検出のホップ制限 — スピーカー検索が通過できるルーターの数です。既定値の4は、ネットワークがマルチキャストをルーティングしていれば別のVLANやサブネット上のスピーカーに届きます。大規模なネットワークでは値を上げてください。マルチキャストが遮断されている場合はBonjourを使用します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoppgrense for søk — hvor mange rutere høyttalersøket kan krysse. Standardverdien 4 når høyttalere på et annet VLAN eller subnett når nettverket ruter multicast; øk den på større nettverk. Blokkerer nettverket multicast, bruk Bonjour."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoplimiet voor detectie — hoeveel routers de speakerzoekopdracht mag passeren. De standaardwaarde 4 bereikt speakers op een ander VLAN of subnet als het netwerk multicast routeert; verhoog dit op grotere netwerken. Blokkeert het netwerk multicast, gebruik dan Bonjour."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limit przeskoków wykrywania — ile routerów może pokonać wyszukiwanie głośników. Domyślna wartość 4 obejmuje głośniki w innej sieci VLAN lub podsieci, jeśli sieć kieruje multiemisję; zwiększ ją w większych sieciach. Gdy sieć blokuje multiemisję, użyj Bonjour."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite de saltos da deteção — quantos routers a procura de colunas pode atravessar. O valor predefinido de 4 alcança colunas noutra VLAN ou sub-rede quando a rede encaminha multicast; aumente-o em redes maiores. Se a rede bloquear multicast, use o Bonjour."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoppgräns för sökning — hur många routrar högtalarsökningen får passera. Standardvärdet 4 når högtalare på ett annat VLAN eller subnät när nätverket dirigerar multicast; höj det på större nätverk. Blockerar nätverket multicast får du använda Bonjour."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发现跳数限制——音箱搜索可穿越的路由器数量。默认值 4 可在网络转发组播时找到位于其他 VLAN 或子网的音箱；网络较大时请调高。若网络阻止组播，请改用 Bonjour。"
          }
        }
      }
    },
    "helpBulletDiscoveryMode" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opdagelse: Auto kører SSDP + Bonjour sammen (standard), Bonjour begrænser til mDNS, Ældre multicast begrænser til SSDP."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entdeckung: Auto verwendet SSDP + Bonjour zusammen (Standard), Bonjour beschränkt sich auf mDNS, Legacy-Multicast beschränkt sich auf SSDP."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discovery: Auto runs SSDP + Bonjour together (default), Bonjour limits to mDNS, Legacy Multicast restricts to SSDP."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detección: Auto usa SSDP + Bonjour juntos (predeterminado), Bonjour se limita a mDNS, Multidifusión heredada se limita a SSDP."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Découverte : Auto utilise SSDP + Bonjour ensemble (par défaut), Bonjour se limite à mDNS, Multidiffusion héritée se limite à SSDP."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rilevamento: Auto usa SSDP + Bonjour insieme (predefinito), Bonjour si limita a mDNS, Multicast legacy si limita a SSDP."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検出：「自動」は SSDP と Bonjour を一緒に実行し（既定値）、「Bonjour」は mDNS のみ、「レガシーマルチキャスト」は SSDP のみを使用します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppdagelse: Auto kjører SSDP + Bonjour sammen (standard), Bonjour begrenser til mDNS, Eldre multicast begrenser til SSDP."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detectie: Auto gebruikt SSDP + Bonjour samen (standaard), Bonjour beperkt tot mDNS, Legacy Multicast beperkt tot SSDP."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykrywanie: Auto używa SSDP + Bonjour razem (domyślnie), Bonjour ogranicza do mDNS, Legacy Multicast ogranicza do SSDP."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descoberta: Auto executa SSDP + Bonjour juntos (predefinição), Bonjour limita a mDNS, Multicast legado limita a SSDP."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upptäckt: Auto kör SSDP + Bonjour tillsammans (standard), Bonjour begränsar till mDNS, Äldre multicast begränsar till SSDP."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发现：「自动」同时使用 SSDP 和 Bonjour（默认），「Bonjour」仅限于 mDNS，「传统多播」仅限于 SSDP。"
          }
        }
      }
    },
    "helpBulletDisplayTab" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skærm rummer også Karaoke-tema (lyst eller mørkt kun for det vindue), Skjul diagnostikikon i værktøjslinjen og Tastaturbetjening: medietaster styrer afspilningen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darstellung enthält außerdem das Karaoke-Design (hell oder dunkel nur für dieses Fenster), Diagnosesymbol in der Symbolleiste ausblenden und Tastatursteuerung: Medientasten steuern die Wiedergabe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Display also holds the Karaoke theme (light or dark for that window alone), Hide diagnostics icon in toolbar, and Keyboard controls: Media keys control playback."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pantalla incluye también el tema de Karaoke (claro u oscuro solo para esa ventana), Ocultar icono de diagnóstico en la barra, y Controles de teclado: las teclas multimedia controlan la reproducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affichage contient aussi le thème Karaoké (clair ou sombre pour cette seule fenêtre), Masquer l'icône Diagnostic de la barre d'outils, et Commandes clavier : les touches multimédia pilotent la lecture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schermo contiene anche il tema Karaoke (chiaro o scuro solo per quella finestra), Nascondi icona diagnostica nella barra, e Controlli da tastiera: i tasti multimediali controllano la riproduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「表示」にはカラオケテーマ（そのウィンドウだけライト／ダーク）、ツールバーの診断アイコンを隠す、キーボード操作：メディアキーで再生を操作、もあります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjerm har også Karaoke-tema (lyst eller mørkt bare for det vinduet), Skjul diagnostikkikonet i verktøylinjen og Tastaturkontroller: medietaster styrer avspillingen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weergave bevat ook het Karaoke-thema (licht of donker voor alleen dat venster), Diagnosepictogram in knoppenbalk verbergen en Toetsenbordbediening: mediatoetsen bedienen het afspelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyświetlanie zawiera też motyw Karaoke (jasny lub ciemny tylko dla tego okna), Ukryj ikonę diagnostyki na pasku narzędzi oraz Sterowanie klawiaturą: klawisze multimedialne sterują odtwarzaniem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ecrã inclui ainda o tema do Karaoke (claro ou escuro só para essa janela), Ocultar ícone de diagnóstico na barra e Controlos de teclado: as teclas multimédia controlam a reprodução."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skärm har även Karaoketema (ljust eller mörkt bara för det fönstret), Dölj diagnostikikonen i verktygsfältet och Tangentbordskontroller: medieknappar styr uppspelningen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“显示”还包含卡拉 OK 主题（仅该窗口的浅色或深色）、在工具栏隐藏诊断图标，以及键盘控制：媒体键控制播放。"
          }
        }
      }
    },

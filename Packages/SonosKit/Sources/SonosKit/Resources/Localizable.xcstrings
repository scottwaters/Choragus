    "lastFMCredentialsIntro" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrobbling til Last.fm kræver din egen API-app. Registrér en her, og indsæt derefter API-nøglen og den delte hemmelighed nedenfor:"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für das Scrobbeln zu Last.fm benötigst du eine eigene API-App. Registriere hier eine und füge unten den API-Schlüssel und das gemeinsame Geheimnis ein:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrobbling to Last.fm requires your own API app. Register one here, then paste the API key and shared secret below:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para hacer scrobble a Last.fm necesitas tu propia aplicación API. Regístrala aquí y luego pega la clave API y el secreto compartido abajo:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le scrobbling vers Last.fm nécessite votre propre application API. Enregistrez-en une ici, puis collez la clé API et le secret partagé ci-dessous :"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per fare scrobble su Last.fm serve la tua app API. Registrane una qui e poi incolla la chiave API e il segreto condiviso sotto:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Last.fm へのスクロブルには独自の API アプリが必要です。ここで登録し、下に API キーと共有シークレットを貼り付けてください:"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrobbling til Last.fm krever din egen API-app. Registrer en her, og lim deretter inn API-nøkkelen og den delte hemmeligheten nedenfor:"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrobblen naar Last.fm vereist je eigen API-app. Registreer er hier een en plak vervolgens de API-sleutel en het gedeelde geheim hieronder:"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrobblowanie do Last.fm wymaga własnej aplikacji API. Zarejestruj jedną tutaj, a następnie wklej klucz API i wspólny sekret poniżej:"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O scrobble para o Last.fm requer seu próprio app de API. Registre um aqui e depois cole a chave de API e o segredo compartilhado abaixo:"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att scrobbla till Last.fm behöver du en egen API-app. Registrera en här och klistra sedan in API-nyckeln och den delade hemligheten nedan:"

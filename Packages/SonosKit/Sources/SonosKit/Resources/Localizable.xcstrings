    "helpBulletLyricsOffset" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug knapperne −10 / −5 / −1 / +1 / +5 / +10 til at justere timing for synkroniseret sangtekst pr. spor. Forskydningen bevares mellem afspilninger af samme spor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit den Tasten −10 / −5 / −1 / +1 / +5 / +10 verschiebst du das Timing der synchronisierten Liedtexte pro Titel. Der Versatz bleibt zwischen Wiedergaben desselben Titels erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the −10 / −5 / −1 / +1 / +5 / +10 buttons to nudge synced-lyric timing per track. The offset persists across plays of the same track."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa los botones −10 / −5 / −1 / +1 / +5 / +10 para ajustar la sincronización de la letra por pista. El desfase se conserva entre reproducciones de la misma pista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez les boutons −10 / −5 / −1 / +1 / +5 / +10 pour ajuster le timing des paroles synchronisées par morceau. Le décalage est conservé entre les lectures du même titre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa i pulsanti −10 / −5 / −1 / +1 / +5 / +10 per regolare il timing del testo sincronizzato per traccia. L’offset si conserva tra le riproduzioni dello stesso brano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "−10 / −5 / −1 / +1 / +5 / +10 ボタンでトラックごとに同期歌詞のタイミングを調整します。オフセットは同じトラックの再生間で保持されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk knappene −10 / −5 / −1 / +1 / +5 / +10 for å justere timing for synkronisert sangtekst per spor. Forskyvningen lagres mellom avspillinger av samme spor."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik de knoppen −10 / −5 / −1 / +1 / +5 / +10 om de timing van gesynchroniseerde songteksten per nummer bij te stellen. De offset blijft bewaard tussen weergaven van hetzelfde nummer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj przycisków −10 / −5 / −1 / +1 / +5 / +10, aby skorygować timing zsynchronizowanego tekstu na utwór. Przesunięcie zostaje zapamiętane między odtworzeniami tego samego utworu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use os botões −10 / −5 / −1 / +1 / +5 / +10 para ajustar o tempo da letra sincronizada por faixa. O desvio mantém-se entre reproduções da mesma faixa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd knapparna −10 / −5 / −1 / +1 / +5 / +10 för att justera tajmingen på synkade sångtexter per spår. Förskjutningen sparas mellan uppspelningar av samma spår."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 −10 / −5 / −1 / +1 / +5 / +10 按钮按每首曲调整同步歌词的节奏。偏移量在同一曲目的多次播放之间持久保存。"
          }
        }
      }
    },

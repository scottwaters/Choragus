    "appearanceInfo" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temaet styrer lys og mørk tilstand. Accentfarven anvendes på skydere, valg og kontakter. Zoneikonfarver styrer højttalerikoner i sidepanelet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Thema steuert den hellen und dunklen Modus. Die Akzentfarbe wird auf Schieberegler, Auswahlen und Schalter angewendet. Zonen-Symbolfarben steuern die Lautsprechersymbole in der Seitenleiste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Theme controls light and dark mode. Accent color is applied to sliders, selections, and toggles. Zone icon colors control the speaker icons in the sidebar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tema controla el modo claro y oscuro. El color de acento se aplica a los controles deslizantes, selecciones y conmutadores. Los colores de los iconos de zona controlan los iconos de los altavoces en la barra lateral."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le thème contrôle le mode clair et sombre. La couleur d’accent s’applique aux curseurs, sélections et boutons. Les couleurs des icônes de zone contrôlent les icônes d’enceintes dans la barre latérale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tema controlla la modalità chiara e scura. Il colore di accento viene applicato a cursori, selezioni e interruttori. I colori delle icone di zona controllano le icone degli altoparlanti nella barra laterale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テーマはライトモードとダークモードを制御します。アクセントカラーはスライダー、選択項目、トグルに適用されます。ゾーンアイコンの色はサイドバーのスピーカーアイコンを制御します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temaet styrer lys og mørk modus. Aksentfargen brukes på skyveknapper, valg og brytere. Soneikonfargene styrer høyttalerikonene i sidefeltet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het thema regelt de lichte en donkere modus. De accentkleur wordt toegepast op schuifregelaars, selecties en schakelaars. Zonepictogramkleuren bepalen de speakerpictogrammen in de zijbalk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motyw kontroluje tryb jasny i ciemny. Kolor akcentu jest stosowany do suwaków, zaznaczeń i przełączników. Kolory ikon stref kontrolują ikony głośników w pasku bocznym."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tema controla o modo claro e escuro. A cor de destaque é aplicada a controles deslizantes, seleções e botões de alternagem. As cores dos ícones de zona controlam os ícones das caixas de som na barra lateral."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temat styr ljust och mörkt läge. Accentfärgen används på reglage, markeringar och växlar. Zonikonfärger styr högtalarikoner i sidofältet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主题控制浅色和深色模式。强调色应用于滑块、选择项和开关。区域图标颜色控制侧边栏中的音箱图标。"
          }
        }
      }
    },

    "whyStep3Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos bruger en intern kontoidentifikator til at godkende streaming-afspilning. Denne identifikator oprettes først, når indhold fra en tjeneste bruges første gang via Sonos-systemet. At tilføje én favorit via den officielle Sonos-app opretter denne forbindelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos verwendet eine interne Konto-Kennung zur Authentifizierung der Streaming-Wiedergabe. Diese Kennung entsteht erst, wenn Inhalte eines Dienstes zum ersten Mal über das Sonos-System genutzt werden. Das Hinzufügen eines Favoriten über die offizielle Sonos-App erstellt diese Verknüpfung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos uses an internal account identifier to authenticate streaming playback. This identifier is only created when content from a service is first used through the Sonos system. Adding one favorite through the official Sonos app creates this link."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos usa un identificador de cuenta interno para autenticar la reproducción en streaming. Este identificador solo se crea cuando el contenido de un servicio se usa por primera vez a través del sistema Sonos. Añadir un favorito desde la app oficial Sonos crea ese vínculo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos utilise un identifiant de compte interne pour authentifier la lecture en streaming. Cet identifiant n’est créé qu’à la première utilisation d’un contenu du service via le système Sonos. Ajouter un favori via l’application Sonos officielle crée ce lien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos usa un identificativo account interno per autenticare la riproduzione streaming. Questo identificativo viene creato solo quando i contenuti del servizio vengono usati per la prima volta tramite il sistema Sonos. Aggiungere un preferito dall’app Sonos ufficiale crea questo collegamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos はストリーミング再生を認証するための内部アカウント識別子を使用します。この識別子はサービスのコンテンツを Sonos システムで初めて使用したときにのみ作成されます。公式 Sonos アプリでお気に入りを 1 つ追加するとこのリンクが作成されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos bruker en intern kontoidentifikator for å godkjenne strøming. Denne identifikatoren lages bare når innhold fra tjenesten brukes første gang via Sonos-systemet. Å legge til én favoritt via den offisielle Sonos-appen lager denne koblingen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos gebruikt een interne accountidentifier voor het authenticeren van streaming-afspelen. Deze identifier wordt pas aangemaakt wanneer inhoud van een dienst voor het eerst via het Sonos-systeem wordt gebruikt. Een favoriet toevoegen via de officiële Sonos-app maakt deze koppeling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos używa wewnętrznego identyfikatora konta do uwierzytelniania odtwarzania strumieniowego. Identyfikator powstaje dopiero, gdy treść z usługi zostanie po raz pierwszy użyta w systemie Sonos. Dodanie jednego ulubionego w oficjalnej aplikacji Sonos tworzy to połączenie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sonos usa um identificador interno de conta para autenticar a reprodução em streaming. Esse identificador só é criado quando o conteúdo de um serviço é usado pela primeira vez pelo sistema Sonos. Adicionar um favorito pelo app Sonos oficial cria esse vínculo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos använder en intern kontoidentifierare för att autentisera strömmande uppspelning. Identifieraren skapas först när innehåll från tjänsten används första gången via Sonos-systemet. Att lägga till en favorit via den officiella Sonos-appen skapar länken."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos 使用内部账户标识符来验证流媒体播放。该标识符仅在服务内容首次通过 Sonos 系统使用时创建。通过官方 Sonos 应用添加一个收藏会建立此连接。"
          }
        }
      }
    },

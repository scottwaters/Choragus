          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spill, Pause, Veksle spill/pause: fortsett eller sett et rom på pause."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afspelen, Pauzeren, Afspelen/pauzeren wisselen: een kamer hervatten of pauzeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odtwarzaj, Pauza, Przełącz odtwarzanie/pauzę: wznów lub wstrzymaj pokój."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduzir, Pausar, Alternar reproduzir/pausar: retomar ou pausar uma divisão."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spela, Pausa, Växla spela/pausa: återuppta eller pausa ett rum."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放、暂停、切换播放/暂停：恢复或暂停某个房间。"
          }
        }
      }
    },
    "helpShortcutActionPreset" : {

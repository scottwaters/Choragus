    "helpBulletDotGray" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grå — tjenesten findes i Sonos-kataloget, men er ikke tilknyttet din husstand. Tilføj den først via den officielle Sonos-app; den dukker op her automatisk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grau — Dienst ist im Sonos-Katalog vorhanden, aber nicht mit deinem Haushalt verknüpft. Füge ihn zuerst über die offizielle Sonos-App hinzu; er erscheint dann hier automatisch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gray — service exists in the Sonos catalogue but isn't linked to your household. Add it via the official Sonos app first; it'll surface here automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gris — el servicio existe en el catálogo de Sonos pero no está vinculado a tu hogar. Añádelo primero mediante la app oficial de Sonos; aparecerá aquí automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gris — le service existe dans le catalogue Sonos mais n’est pas lié à votre foyer. Ajoutez-le d’abord via l’application Sonos officielle ; il apparaîtra ici automatiquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grigio — il servizio esiste nel catalogo Sonos ma non è collegato al tuo sistema. Aggiungilo prima tramite l’app Sonos ufficiale; apparirà qui automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グレー — サービスは Sonos カタログには存在しますが、住宅にリンクされていません。まず公式 Sonos アプリで追加してください。ここに自動的に表示されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grå — tjenesten finnes i Sonos-katalogen, men er ikke knyttet til husholdningen din. Legg den til via den offisielle Sonos-appen først; den dukker opp her automatisk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grijs — dienst bestaat in de Sonos-catalogus maar is niet gekoppeld aan je huishouden. Voeg hem eerst toe via de officiële Sonos-app; hij verschijnt hier dan automatisch."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szara — usługa istnieje w katalogu Sonos, ale nie jest podłączona do Twojego domu. Najpierw dodaj ją przez oficjalną aplikację Sonos; pojawi się tu automatycznie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cinzento — o serviço existe no catálogo Sonos mas não está associado ao seu agregado. Adicione-o primeiro pela app oficial Sonos; aparecerá aqui automaticamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grå — tjänsten finns i Sonos-katalogen men är inte länkad till ditt hushåll. Lägg till den först via den officiella Sonos-appen; den dyker upp här automatiskt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "灰色—该服务在 Sonos 目录中存在但未关联您的家庭。请先通过官方 Sonos 应用添加；之后会自动在此处显示。"
          }
        }
      }
    },
    "helpBulletDotGreen" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grøn — godkendt og klar til afspilning. Tjenesten er tilknyttet, tokenet er gyldigt, og mindst en Sonos-favorit har afsløret et konto-serienummer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grün — authentifiziert und bereit zum Abspielen. Der Dienst ist verknüpft, das Token ist gültig und mindestens ein Sonos-Favorit hat eine Kontoserialnummer dazu geliefert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Green — authenticated and ready to play. The service is linked, the token is valid, and at least one Sonos Favorite has surfaced an account-serial number for it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verde — autenticado y listo para reproducir. El servicio está vinculado, el token es válido y al menos un Favorito Sonos ha aportado un número de serie de cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vert — authentifié et prêt à lire. Le service est lié, le jeton est valide et au moins un favori Sonos a fourni un numéro de série de compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verde — autenticato e pronto a riprodurre. Il servizio è collegato, il token è valido e almeno un Preferito Sonos ha fornito un numero di serie dell’account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "緑 — 認証済みで再生可能。サービスはリンクされ、トークンは有効で、少なくとも 1 つの Sonos ファベリットからアカウントシリアル番号が取得されています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grønn — godkjent og klar til å spille. Tjenesten er tilknyttet, tokenet er gyldig og minst én Sonos-favoritt har avslørt et konto-serienummer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groen — geauthenticeerd en klaar om af te spelen. De dienst is gekoppeld, het token is geldig en ten minste één Sonos-favoriet heeft een account-serienummer opgeleverd."
          }
        },
        "pl" : {
          "stringUnit" : {

    "etymologyDefinition" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korlederen — borgeren, der finansierede og ledede det dramatiske kor i det klassiske Athen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Anführer des Chors — der Bürger, der den dramatischen Chor im klassischen Athen finanzierte und leitete."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The leader of the chorus — the citizen who funded and conducted the dramatic chorus in classical Athens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El líder del coro — el ciudadano que financiaba y dirigía el coro dramático en la Atenas clásica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chef du chœur — le citoyen qui finançait et dirigeait le chœur dramatique dans l’Athènes classique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il capo del coro — il cittadino che finanziava e dirigeva il coro drammatico nell’Atene classica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合唱団の指導者 — 古典期アテネにおいて演劇合唱団に資金を提供し、指揮した市民。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korlederen — borgeren som finansierte og ledet det dramatiske koret i det klassiske Athen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De leider van het koor — de burger die het dramatische koor in het klassieke Athene financierde en leidde."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przywódca chóru — obywatel, który finansował i prowadził chór dramatyczny w klasycznych Atenach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O líder do coro — o cidadão que financiava e dirigia o coro dramático na Atenas clássica."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Körens ledare — medborgaren som finansierade och ledde den dramatiska kören i det klassiska Aten."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合唱团的领导 — 在古典雅典资助并指挥戳剧合唱团的公民。"
          }
        }
      }
    },

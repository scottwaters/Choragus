    "helpAppleShortcutsScheduleBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Tidspunkt-automatisering i appen Genveje kører en handling én gang om dagen. Til kortere intervaller virker en launchd-agent, der kører genvejen efter navn, på alle macOS-versioner. Genvejsvejledningen på GitHub har et færdigt eksempel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Tageszeit-Automation in der Kurzbefehle-App führt eine Aktion einmal täglich aus. Für kürzere Intervalle funktioniert auf jeder macOS-Version ein launchd-Agent, der den Kurzbefehl per Name startet. Die Kurzbefehle-Anleitung auf GitHub enthält ein fertiges Beispiel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Time of Day automation in the Shortcuts app runs an action once a day. For shorter intervals, a launchd agent that runs the shortcut by name works on any macOS version. The Shortcuts guide on GitHub has a ready-made example."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una automatización Hora del día en la app Atajos ejecuta una acción una vez al día. Para intervalos más cortos, un agente launchd que ejecute el atajo por nombre funciona en cualquier versión de macOS. La guía de atajos en GitHub incluye un ejemplo listo para usar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une automatisation Heure de la journée dans l'app Raccourcis exécute une action une fois par jour. Pour des intervalles plus courts, un agent launchd qui lance le raccourci par son nom fonctionne sur toute version de macOS. Le guide des raccourcis sur GitHub contient un exemple prêt à l'emploi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un'automazione Ora del giorno nell'app Comandi rapidi esegue un'azione una volta al giorno. Per intervalli più brevi, un agente launchd che avvia il comando per nome funziona su qualsiasi versione di macOS. La guida ai comandi rapidi su GitHub contiene un esempio pronto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ショートカット App の「時刻」オートメーションは、アクションを 1 日 1 回実行します。より短い間隔には、ショートカットを名前で実行する launchd エージェントがどの macOS バージョンでも使えます。GitHub のショートカットガイドにすぐ使える例があります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Tid på dagen-automatisering i Snarveier-appen kjører en handling én gang om dagen. For kortere intervaller fungerer en launchd-agent som kjører snarveien etter navn på alle macOS-versjoner. Snarveisveiledningen på GitHub har et ferdig eksempel."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een Tijdstip-automatisering in de Opdrachten-app voert een actie eenmaal per dag uit. Voor kortere intervallen werkt op elke macOS-versie een launchd-agent die de opdracht op naam start. De opdrachtengids op GitHub bevat een kant-en-klaar voorbeeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatyzacja Pora dnia w aplikacji Skróty uruchamia akcję raz dziennie. Dla krótszych odstępów na każdej wersji macOS działa agent launchd uruchamiający skrót po nazwie. Przewodnik po skrótach na GitHubie zawiera gotowy przykład."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma automatização Hora do dia na app Atalhos executa uma ação uma vez por dia. Para intervalos mais curtos, um agente launchd que executa o atalho pelo nome funciona em qualquer versão do macOS. O guia de atalhos no GitHub tem um exemplo pronto a usar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Tid på dagen-automation i appen Genvägar kör en åtgärd en gång om dagen. För kortare intervall fungerar en launchd-agent som kör genvägen via namn på alla macOS-versioner. Genvägsguiden på GitHub har ett färdigt exempel."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快捷指令 App 中的「特定时间」自动化每天运行一次操作。若需更短的间隔，可在任何 macOS 版本上使用按名称运行快捷指令的 launchd 代理。GitHub 上的快捷指令指南提供了现成示例。"
          }
        }
      }
    },

    "helpBulletLibrary" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musikbiblioteket gennemser alle indekserede delinger på højttaleren, tagget som (S1) eller (S2), når begge Sonos-systemer er på netværket."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Musikmediathek durchsucht alle indizierten Freigaben auf dem Lautsprecher, die mit (S1) oder (S2) markiert sind, wenn sich beide Sonos-Systeme im Netzwerk befinden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The music library browses any indexed shares on the speaker, tagged (S1) or (S2) when both Sonos systems are on the network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La biblioteca musical explora los recursos compartidos indexados en el altavoz, etiquetados como (S1) o (S2) cuando ambos sistemas Sonos están en la red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bibliothèque musicale parcourt les partages indexés sur l'enceinte, balisés (S1) ou (S2) lorsque les deux systèmes Sonos sont sur le réseau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La libreria musicale sfoglia le condivisioni indicizzate sullo speaker, contrassegnate con (S1) o (S2) quando entrambi i sistemi Sonos sono presenti in rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ミュージックライブラリはスピーカー上のインデックス付き共有をブラウズし、両方のSonosシステムがネットワーク上にある場合は(S1)または(S2)としてタグ付けされます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musikkbiblioteket blar gjennom indekserte delinger på høyttaleren, tagget som (S1) eller (S2) når begge Sonos-systemer er på nettverket."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De muziekbibliotheek doorzoekt alle geïndexeerde gedeelde mappen op de luidspreker, getagd als (S1) of (S2) wanneer beide Sonos-systemen zich in het netwerk bevinden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biblioteka muzyczna przegląda zindeksowane udziały na głośniku, oznaczone jako (S1) lub (S2), gdy oba systemy Sonos znajdują się w sieci."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A biblioteca de música navega por todos os compartilhamentos indexados no alto-falante, marcados como (S1) ou (S2) quando ambos os sistemas Sonos estão na rede."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musikbiblioteket bläddrar i indexerade delningar på högtalaren, taggade som (S1) eller (S2) när båda Sonos-systemen finns i nätverket."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音乐资料库会浏览扬声器上任何已建立索引的共享，当两个 Sonos 系统都在网络上时，将标记为 (S1) 或 (S2)。"
          }
        }
      }
    },
    "helpBulletLineIn" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {

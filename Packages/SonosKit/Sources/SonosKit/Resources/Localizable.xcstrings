    "helpQueueSourceBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver række i køen angiver den tjeneste eller det system, sporet kom fra, så en kø sammensat af flere kilder forbliver læsbar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Zeile in der Warteschlange benennt den Dienst oder das System, aus dem der Titel stammt, sodass eine aus mehreren Quellen zusammengestellte Warteschlange lesbar bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each queue row names the service or system the track came from, so a queue assembled from several sources stays readable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada fila de la cola indica el servicio o sistema del que proviene la pista, para que una cola formada por varias fuentes siga siendo legible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque ligne de la file d'attente indique le service ou le système d'où provient la piste, afin qu'une file d'attente composée de plusieurs sources reste lisible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni riga della coda indica il servizio o il sistema da cui proviene la traccia, così una coda creata da più fonti rimane leggibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キューの各行には、トラックの取得元のサービスまたはシステム名が表示されるため、複数のソースから構成されたキューでも読みやすさが保たれます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver kø-rad angir tjenesten eller systemet sporet kom fra, slik at en kø satt sammen fra flere kilder forblir lesbar."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke rij in de wachtrij vermeldt de dienst of het systeem waar het nummer vandaan komt, zodat een wachtrij die is samengesteld uit meerdere bronnen overzichtelijk blijft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy wiersz kolejki wskazuje usługę lub system, z którego pochodzi utwór, dzięki czemu kolejka złożona z wielu źródeł pozostaje czytelna."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada linha da fila indica o serviço ou sistema de origem da faixa, para que uma fila montada a partir de várias fontes continue legível."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje kö-rad anger vilken tjänst eller vilket system spåret kom från, så att en kö som satts ihop från flera källor förblir läsbar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个队列行都会标明曲目的来源服务或系统，以便由多个来源组成的队列保持可读性。"
          }
        }
      }
    },

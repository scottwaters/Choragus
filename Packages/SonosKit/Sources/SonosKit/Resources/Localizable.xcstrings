    "musicServicesDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lad alle være umarkerede for at scrobble alt uanset kilden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasse alle deaktiviert, um unabhängig von der Quelle alles zu scrobbeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave all unchecked to scrobble everything regardless of source."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja todo sin marcar para hacer scrobble de todo sin importar la fuente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez tout décoché pour scrobbler tout, quelle que soit la source."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia tutto deselezionato per fare scrobble di tutto indipendentemente dalla fonte."

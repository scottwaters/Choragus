        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コマンドが失敗しました。スピーカー構成が変わった可能性があります。更新しています…"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommandoen mislyktes — høyttaleroppsettet kan ha endret seg. Oppdaterer…"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opdracht mislukt — de speakerindeling is mogelijk gewijzigd. Bezig met vernieuwen…"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polecenie nie powiodło się — układ głośników mógł się zmienić. Odświeżanie…"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O comando falhou — a disposição das colunas pode ter mudado. A atualizar…"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommandot misslyckades — högtalaruppsättningen kan ha ändrats. Uppdaterar…"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "命令失败：扬声器布局可能已更改。正在刷新…"
          }
        }
      }
    },
    "staleReconnecting" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Højttalerne opretter forbindelse igen efter en netværksændring… Hvis det fortsætter, sluk og tænd højttalerne, og genstart Choragus."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lautsprecher verbinden sich nach einer Netzwerkänderung neu… Falls das anhält, Lautsprecher aus- und einschalten und Choragus neu starten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speakers reconnecting after network change… If this persists, power-cycle the speakers and relaunch Choragus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los altavoces se están reconectando tras un cambio de red… Si continúa, apaga y enciende los altavoces y reinicia Choragus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconnexion des enceintes après un changement de réseau… Si cela persiste, redémarrez les enceintes puis relancez Choragus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I diffusori si stanno riconnettendo dopo una modifica della rete… Se persiste, spegni e riaccendi i diffusori e riavvia Choragus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットワーク変更後、スピーカーを再接続しています… 続く場合はスピーカーの電源を入れ直し、Choragus を再起動してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høyttalerne kobler til på nytt etter en nettverksendring… Hvis det vedvarer, slå høyttalerne av og på og start Choragus på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speakers maken opnieuw verbinding na een netwerkwijziging… Blijft dit aanhouden, schakel de speakers uit en aan en start Choragus opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Głośniki łączą się ponownie po zmianie sieci… Jeśli to się utrzymuje, wyłącz i włącz głośniki oraz uruchom ponownie Choragus."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As colunas estão a reconectar após uma alteração de rede… Se persistir, desligue e ligue as colunas e reinicie o Choragus."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Högtalarna återansluter efter en nätverksändring… Om det fortsätter, starta om högtalarna och Choragus."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "网络变更后扬声器正在重新连接… 若持续出现，请重启扬声器并重新启动 Choragus。"
          }
        }
      }
    },

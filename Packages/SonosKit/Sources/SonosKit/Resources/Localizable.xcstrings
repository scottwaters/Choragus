    "historyIntroBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lytteaktivitet spores på alle højttalere og zoner mens Choragus kører."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höractivität wird über alle Lautsprecher und Zonen verfolgt, solange Choragus läuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listening activity is tracked across all speakers and zones while Choragus is running."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La actividad de escucha se rastrea en todos los altavoces y zonas mientras Choragus esté en ejecución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’activité d’écoute est suivie sur toutes les enceintes et zones lorsque Choragus est en cours d’exécution."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’attività di ascolto viene monitorata su tutti gli altoparlanti e zone mentre Choragus è in esecuzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus の実行中、すべてのスピーカーとゾーンの視聴アクティビティが追跡されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lytteaktivitet spores på alle høyttalere og soner mens Choragus kjører."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luisteractiviteit wordt op alle luidsprekers en zones bijgehouden terwijl Choragus actief is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktywność odsłuchu jest śledzona we wszystkich głośnikach i strefach, gdy Choragus działa."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A atividade de audição é rastreada em todos os alto-falantes e zonas enquanto o Choragus está em execução."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyssningsaktivitet spåras på alla högtalare och zoner medan Choragus körs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus 运行时，会跳踪所有音箱和区域的收听活动。"
          }
        }
      }
    },

        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke das Scrollrad über „Aktuell läuft\\\", um die Gruppe stummzuschalten oder wieder zu aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click the scroll wheel over Now Playing to mute or unmute the group."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en la rueda de desplazamiento sobre «Reproduciendo» para silenciar o reactivar el grupo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur la molette au-dessus de « Lecture en cours » pour couper ou réactiver le son du groupe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic con la rotella sopra «In riproduzione» per attivare o disattivare l’audio del gruppo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",

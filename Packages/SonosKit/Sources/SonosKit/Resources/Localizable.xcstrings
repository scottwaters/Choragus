    "diagEncryptedReportFormBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## Hvad skete der?\n\n<!-- Beskriv, hvad du gjorde, da bugen opstod. -->\n\n\n## Diagnostikpakke\n\nVedhæft den krypterede pakkefil, der lige er gemt i din Downloads-mappe:\n\n`%@`\n\nTræk den fra Finder-vinduet, der lige er åbnet, til denne kommentar for at vedhæfte den.\n\nPakken er ugennemsigtig for GitHub og for alle undtagen vedligeholderen — autentificeringstokens er allerede fjernet på Choragus-siden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## Was ist passiert?\n\n<!-- Beschreibe, was du gemacht hast, als der Fehler auftrat. -->\n\n\n## Diagnose-Paket\n\nBitte hänge die verschlüsselte Paketdatei an, die gerade in deinen Downloads-Ordner gespeichert wurde:\n\n`%@`\n\nZiehe sie aus dem geöffneten Finder-Fenster in diesen Kommentar, um sie anzuhängen.\n\nDas Paket ist für GitHub und alle außer dem Betreuer undurchsichtig — Auth-Token wurden bereits auf der Choragus-Seite entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## What happened?\n\n<!-- Describe what you were doing when the bug occurred. -->\n\n\n## Diagnostic bundle\n\nPlease attach the encrypted bundle file just saved to your Downloads folder:\n\n`%@`\n\nDrag it from the Finder window that just opened into this comment to attach it. (The `.log` suffix is just so GitHub accepts the upload — the file is still the encrypted bundle, not a plain log; no rename needed.)\n\nThe bundle is opaque to GitHub and to anyone but the maintainer — auth tokens have already been removed at the Choragus side."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## ¿Qué ocurrió?\n\n<!-- Describe lo que estabas haciendo cuando ocurrió el bug. -->\n\n\n## Paquete de diagnóstico\n\nAdjunta el archivo del paquete cifrado que se acaba de guardar en tu carpeta Descargas:\n\n`%@`\n\nArrástralo desde la ventana del Finder que se acaba de abrir a este comentario para adjuntarlo.\n\nEl paquete es opaco para GitHub y para cualquiera excepto el responsable — los tokens de autenticación ya se eliminaron en el lado de Choragus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## Que s’est-il passé ?\n\n<!-- Décrivez ce que vous faisiez quand le bug s’est produit. -->\n\n\n## Lot de diagnostic\n\nVeuillez joindre le fichier de lot chiffré qui vient d’être enregistré dans votre dossier Téléchargements :\n\n`%@`\n\nGlissez-le depuis la fenêtre du Finder qui vient de s’ouvrir vers ce commentaire pour le joindre.\n\nLe lot est opaque pour GitHub et pour quiconque sauf le mainteneur — les jetons d’authentification ont déjà été retirés côté Choragus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## Cosa è successo?\n\n<!-- Descrivi cosa stavi facendo quando si è verificato il bug. -->\n\n\n## Pacchetto diagnostico\n\nAllega il file del pacchetto cifrato appena salvato nella tua cartella Download:\n\n`%@`\n\nTrascinalo dalla finestra del Finder appena aperta in questo commento per allegarlo.\n\nIl pacchetto è opaco per GitHub e per chiunque tranne il manutentore — i token di autenticazione sono già stati rimossi sul lato Choragus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## 何が起きましたか？\n\n<!-- バグが発生したときに何をしていたかを説明してください。 -->\n\n\n## 診断バンドル\n\nダウンロードフォルダに保存された暗号化バンドルファイルを添付してください:\n\n`%@`\n\n開いたFinderウィンドウからこのコメントにドラッグして添付してください。\n\nバンドルはGitHubおよびメンテナー以外の誰にも不透明です — 認証トークンはChoragus側で既に削除されています。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## Hva skjedde?\n\n<!-- Beskriv hva du gjorde da bugen oppstod. -->\n\n\n## Diagnostikkpakke\n\nLegg ved den krypterte pakkefilen som nettopp ble lagret i Nedlastinger-mappen:\n\n`%@`\n\nDra den fra Finder-vinduet som nettopp åpnet seg til denne kommentaren for å legge den ved.\n\nPakken er ugjennomsiktig for GitHub og alle unntatt vedlikeholderen — autentiseringstokens er allerede fjernet på Choragus-siden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## Wat is er gebeurd?\n\n<!-- Beschrijf wat je aan het doen was toen de bug optrad. -->\n\n\n## Diagnostisch pakket\n\nVoeg het versleutelde pakketbestand toe dat zojuist in je Downloads-map is opgeslagen:\n\n`%@`\n\nSleep het uit het zojuist geopende Finder-venster in deze opmerking om het bij te voegen.\n\nHet pakket is ondoorzichtig voor GitHub en iedereen behalve de beheerder — auth-tokens zijn al verwijderd aan de Choragus-kant."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## Co się stało?\n\n<!-- Opisz, co robiłeś, gdy wystąpił błąd. -->\n\n\n## Pakiet diagnostyczny\n\nDołącz plik zaszyfrowanego pakietu, który został zapisany w folderze Pobrane:\n\n`%@`\n\nPrzeciągnij go z otwartego okna Findera do tego komentarza, aby go dołączyć.\n\nPakiet jest nieczytelny dla GitHub i wszystkich oprócz opiekuna — tokeny uwierzytelniania zostały już usunięte po stronie Choragus."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## O que aconteceu?\n\n<!-- Descreva o que estava a fazer quando o bug ocorreu. -->\n\n\n## Pacote de diagnóstico\n\nAnexe o ficheiro do pacote cifrado que acaba de ser guardado na sua pasta Transferências:\n\n`%@`\n\nArraste-o da janela do Finder que acaba de abrir para este comentário para anexá-lo.\n\nO pacote é opaco para o GitHub e para qualquer pessoa exceto o responsável — os tokens de autenticação já foram removidos no lado do Choragus."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## Vad hände?\n\n<!-- Beskriv vad du gjorde när buggen inträffade. -->\n\n\n## Diagnostikpaket\n\nBifoga den krypterade paketfilen som just sparades i din Nedladdningar-mapp:\n\n`%@`\n\nDra den från Finder-fönstret som just öppnades till denna kommentar för att bifoga den.\n\nPaketet är ogenomskinligt för GitHub och för alla utom underhållaren — autentiseringstokens har redan tagits bort på Choragus-sidan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "## 发生了什么？\n\n<!-- 描述错误发生时您正在做什么。 -->\n\n\n## 诊断包\n\n请附加刚刚保存到您“下载”文件夹的加密包文件：\n\n`%@`\n\n将其从刚打开的 Finder 窗口拖入此评论以附加。\n\n包对 GitHub 和除维护者外的任何人都不透明 — 认证令牌已在 Choragus 端被移除。"
          }
        }
      }
    },

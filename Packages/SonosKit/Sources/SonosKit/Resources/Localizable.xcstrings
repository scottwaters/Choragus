    "supportBlurb" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus er gratis og open source og forbliver det. Hvis det har fortjent en plads i din opsætning, kan du bidrage til udviklingen — en kop kaffe eller en bitcoin eller to ;) Eller lad være. Tak, fordi du bruger det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus ist frei und quelloffen und bleibt es auch. Wenn es einen Platz in deinem Setup verdient hat, kannst du etwas zur Entwicklung beitragen — einen Kaffee oder ein, zwei Bitcoin ;) Oder auch nicht. So oder so: danke für die Nutzung!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus is free and open source, and stays that way. If it has earned a place in your setup, you can put something toward its development — a coffee, or a bitcoin or two ;) Or not. Either way, thanks for using it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus es gratuito y de código abierto, y seguirá siéndolo. Si se ha ganado un sitio en tu equipo, puedes aportar algo a su desarrollo: un café, o un bitcoin o dos ;) O no. En cualquier caso, gracias por usarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus est libre et open source, et le restera. S’il a gagné sa place dans votre installation, vous pouvez contribuer à son développement — un café, ou un bitcoin ou deux ;) Ou pas. Dans tous les cas, merci d’utiliser Choragus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus è gratuito e open source, e resta così. Se si è guadagnato un posto nel tuo impianto, puoi contribuire al suo sviluppo — un caffè, o un bitcoin o due ;) Oppure no. In ogni caso, grazie per l'utilizzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus は無料のオープンソースで、これからもそのままです。あなたの環境で役に立っているなら、開発への支援もできます — コーヒー1杯、あるいはビットコインを1〜2枚 ;) もちろん不要です。どちらでも、使っていただきありがとうございます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus er gratis og åpen kildekode, og forblir det. Har det fortjent en plass i oppsettet ditt, kan du bidra til utviklingen — en kaffe, eller en bitcoin eller to ;) Eller la være. Uansett, takk for at du bruker det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus is gratis en open source, en dat blijft zo. Als het een plek in je setup heeft verdiend, kun je iets bijdragen aan de ontwikkeling — een koffie, of een bitcoin of twee ;) Of niet. Hoe dan ook, bedankt voor het gebruik."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus jest darmowy i otwartoźródłowy — i taki pozostanie. Jeśli zasłużył na miejsce w Twoim zestawie, możesz wesprzeć jego rozwój: kawa albo bitcoin lub dwa ;) Albo nie. Tak czy inaczej, dzięki za korzystanie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Choragus é gratuito e de código aberto, e assim continua. Se conquistou um lugar na sua configuração, pode contribuir para o desenvolvimento — um café, ou um bitcoin ou dois ;) Ou não. De qualquer forma, obrigado por usá-lo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus är gratis och öppen källkod, och förblir så. Om det har förtjänat en plats i din anläggning kan du bidra till utvecklingen — en kaffe, eller en bitcoin eller två ;) Eller inte. Tack för att du använder det ändå."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus 是免费开源的，而且会一直如此。如果它在你的系统里派上了用场，可以为开发出一份力——一杯咖啡，或者一两个比特币 ;) 不出也没关系。无论如何，感谢使用。"
          }
        }
      }
    },

          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyczyść wcześniej zignorowane wiersze, aby zostały ponownie ocenione względem bieżących filtrów przy następnym uruchomieniu. Wysłane wiersze pozostają."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limpa as linhas anteriormente ignoradas para serem reavaliadas com os filtros atuais na próxima execução. As linhas enviadas são preservadas."
          }
        },
        "sv" : {
          "stringUnit" : {

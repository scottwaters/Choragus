    "otherServicesBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse tjenester er ikke testet. De kan fungere med AppLink-godkendelse, men resultater er ikke garanteret. YouTube Music kræver egen OAuth og kan ikke tilsluttes her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Dienste wurden nicht getestet. Sie können mit AppLink-Authentifizierung funktionieren, aber Ergebnisse sind nicht garantiert. YouTube Music benötigt ein eigenes OAuth und kann hier nicht verbunden werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These services have not been tested. They may work with AppLink authentication but results are not guaranteed. YouTube Music requires its own OAuth and cannot be connected here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos servicios no han sido probados. Pueden funcionar con autenticación AppLink, pero los resultados no están garantizados. YouTube Music requieren su propio OAuth y no pueden conectarse aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces services n’ont pas été testés. Ils peuvent fonctionner avec l’authentification AppLink, mais les résultats ne sont pas garantis. YouTube Music nécessitent leur propre OAuth et ne peuvent pas être connectés ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi servizi non sono stati testati. Potrebbero funzionare con autenticazione AppLink ma i risultati non sono garantiti. YouTube Music richiedono il proprio OAuth e non possono essere connessi qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのサービスは未テストです。AppLink 認証で機能する可能性がありますが、結果は保証されません。YouTube Music は独自の OAuth が必要でここでは接続できません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse tjenestene er ikke testet. De kan fungere med AppLink-autentisering, men resultater er ikke garantert. YouTube Music krever egen OAuth og kan ikke kobles til her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze diensten zijn niet getest. Ze werken mogelijk met AppLink-authenticatie, maar resultaten zijn niet gegarandeerd. YouTube Music vereisen hun eigen OAuth en kunnen hier niet verbonden worden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te usługi nie zostały przetestowane. Mogą działać z uwierzytelnianiem AppLink, ale wyniki nie są gwarantowane. YouTube Music wymagają własnego OAuth i nie można ich tutaj połączyć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esses serviços não foram testados. Podem funcionar com autenticação AppLink, mas os resultados não são garantidos. YouTube Music exigem o próprio OAuth e não podem ser conectados aqui."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessa tjänster har inte testats. De kan fungera med AppLink-autentisering, men resultat kan inte garanteras. YouTube Music kräver egen OAuth och kan inte anslutas här."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

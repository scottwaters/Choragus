    "diagReportOnGitHubHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbner en forudfyldt sag på GitHub. Hvis pakken er for stor til URL’en, kopieres den til udklipsholderen, så du kan indsætte den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",

    "middleClickTogglesMuteHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik på rullehjulet over Afspilles nu for at slå lyden til eller fra for gruppen."

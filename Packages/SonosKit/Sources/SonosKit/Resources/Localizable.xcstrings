    "setupStep3Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tilsluttede tjenester: i den officielle Sonos-app på din telefon skal du afspille en sang fra tjenesten og tilføje den til dine Sonos-favoritter. Det knytter din konto til afspilning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur für verbundene Dienste: Spiele in der offiziellen Sonos-App auf deinem Smartphone einen Song dieses Dienstes ab und füge ihn zu den Sonos-Favoriten hinzu. So wird dein Konto für die Wiedergabe verknüpft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For connected services only: using the official Sonos app on your phone, play a song from this service and add it to your Sonos Favorites. This links your account for playback."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo servicios conectados: en la app oficial de Sonos de tu teléfono, reproduce una canción del servicio y añádela a tus Favoritos. Esto vincula tu cuenta para la reproducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Services connectés uniquement : dans l’application Sonos officielle sur votre téléphone, lisez une chanson de ce service et ajoutez-la à vos Favoris Sonos. Cela lie votre compte pour la lecture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo servizi connessi: nell’app Sonos ufficiale sul telefono, riproduci un brano del servizio e aggiungilo ai tuoi Preferiti Sonos. Questo collega il tuo account per la riproduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続済サービスのみ:スマートフォンの公式 Sonos アプリでこのサービスの曲を再生し、Sonos お気に入りに追加してください。これで再生用のアカウントがリンクされます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare tilkoblede tjenester: i den offisielle Sonos-appen på telefonen din, spill en låt fra tjenesten og legg den til i Sonos-favorittene. Det knytter kontoen din til avspilling."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen voor verbonden diensten: speel in de officiële Sonos-app op je telefoon een nummer van deze dienst af en voeg het toe aan je Sonos-favorieten. Dit koppelt je account voor afspelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko połączone usługi: w oficjalnej aplikacji Sonos na telefonie odtwórz utwór z tej usługi i dodaj do Ulubionych Sonos. Łączy to Twoje konto z odtwarzaniem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente serviços conectados: no app oficial do Sonos no telefone, reproduza uma música do serviço e adicione-a aos seus Favoritos Sonos. Isso vincula sua conta para reprodução."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endast anslutna tjänster: i den officiella Sonos-appen på din telefon, spela en låt från tjänsten och lägg till den i Sonos-favoriter. Det länkar ditt konto för uppspelning."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅限连接服务：在手机的官方 Sonos 应用中播放该服务的一首歌曲，并将其添加到 Sonos 收藏。这会将您的账户链接到播放。"
          }
        }
      }
    },

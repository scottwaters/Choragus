          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Início rápido: mostra as caixas em cache instantaneamente ao iniciar enquanto a descoberta ao vivo acontece em segundo plano."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snabbstart: visar cachade högtalare direkt vid start medan live-upptäckten körs i bakgrunden."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快速启动：启动时立即显示缓存的音箱，同时实时发现在后台运行。"
          }
        }
      }
    },

    "playAnySongAndFavoriteFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn den officielle Sonos-app, afspil en %@-sang, og tryk på hjertet for at gemme den som favorit. Prikken bliver grøn inden for et minut."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne die offizielle Sonos-App, spiele einen beliebigen %@-Titel ab und tippe auf das Herz, um ihn als Favorit zu speichern. Der Punkt wird innerhalb einer Minute grün."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the official Sonos app, play any %@ song, and tap the heart to save it as a Favorite. The dot turns green within a minute."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre la app oficial de Sonos, reproduce cualquier canción de %@ y toca el corazón para guardarla como Favorita. El punto se pone verde en menos de un minuto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez l’application Sonos officielle, lancez un titre %@ et touchez le cœur pour l’ajouter aux favoris. Le point devient vert en moins d’une minute."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri l’app Sonos ufficiale, riproduci un brano di %@ e tocca il cuore per salvarlo nei Preferiti. Il puntino diventa verde entro un minuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公式 Sonos アプリを開き、%@ の任意の曲を再生してハートをタップし、お気に入りとして保存します。1 分以内にドットが緑色になります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åpne den offisielle Sonos-appen, spill en %@-låt og trykk på hjertet for å lagre den som favoritt. Prikken blir grønn innen ett minutt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open de officiële Sonos-app, speel een %@-nummer af en tik op het hartje om het als favoriet op te slaan. De stip wordt binnen een minuut groen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz oficjalną aplikację Sonos, odtwórz dowolny utwór z %@ i dotknij serca, aby zapisać go jako ulubiony. Kropka zmieni kolor na zielony w ciągu minuty."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra a app Sonos oficial, reproduza uma música do %@ e toque no coração para guardá-la como Favorita. O ponto fica verde em menos de um minuto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna den officiella Sonos-appen, spela en %@-låt och tryck på hjärtat för att spara den som favorit. Pricken blir grön inom en minut."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开官方 Sonos 应用，播放任何 %@ 歌曲，并点击爱心保存为收藏。一分钟内小点会变绿。"
          }
        }
      }
    },

    "blockedFavoritesPlayableHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksisterende favoritter, du har gemt i den officielle Sonos-app, kan stadig afspilles fra favoritvisningen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestehende Favoriten, die du in der offiziellen Sonos-App gespeichert hast, lassen sich weiterhin über die Favoritenansicht abspielen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Existing favorites you saved in the official Sonos app still play from the Favorites view."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los favoritos que ya guardaste en la app oficial de Sonos se siguen reproduciendo desde la vista Favoritos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les favoris déjà enregistrés dans l’app Sonos officielle restent lisibles depuis la vue Favoris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I preferiti già salvati nell’app Sonos ufficiale si possono ancora riprodurre dalla vista Preferiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公式 Sonos アプリで保存済みのお気に入りは、「お気に入り」ビューから引き続き再生できます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksisterende favoritter du har lagret i den offisielle Sonos-appen, kan fortsatt spilles av fra Favoritter-visningen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestaande favorieten die je in de officiële Sonos-app hebt bewaard, kun je nog steeds afspelen vanuit het Favorieten-overzicht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istniejące ulubione zapisane w oficjalnej aplikacji Sonos nadal można odtwarzać z widoku Ulubione."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os favoritos que já guardaste na app oficial da Sonos continuam a ser reproduzíveis a partir da vista Favoritos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befintliga favoriter som du sparat i den officiella Sonos-appen kan fortfarande spelas upp från favoritvyn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在官方 Sonos 应用中保存的现有收藏仍可从「收藏」视图中播放。"
          }
        }
      }
    },
    "blockedServicesBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube Music, SoundCloud og SiriusXM kræver et login, som kun Sonos har adgang til, ikke tredjepartsapps. Favoritter for disse tjenester, der er gemt i den officielle Sonos-app, afspilles stadig via Favoritter-visningen, fordi højttaleren leverer loginoplysningerne. Nogle af tjenesterne er desuden ikke tilgængelige på Sonos S1-systemer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube Music, SoundCloud und SiriusXM verlangen eine nur Sonos vorbehaltene Anmeldung, die Drittanbieter-Apps nicht zur Verfügung steht. In der offiziellen Sonos-App gespeicherte Favoriten dieser Dienste spielen weiterhin über die Favoritenansicht, weil der Lautsprecher die Zugangsdaten liefert. Einige dieser Dienste sind auf Sonos-S1-Systemen zudem nicht verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube Music, SoundCloud and SiriusXM require Sonos-only authentication that is not exposed to third-party apps. Existing favorites for these services that you saved in the official Sonos app still play through the Favorites view because the speaker provides the credential. Some of these services are also unavailable on Sonos S1 systems."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube Music, SoundCloud y SiriusXM requieren una autenticación exclusiva de Sonos que no está disponible para apps de terceros. Los favoritos de estos servicios guardados en la app oficial de Sonos siguen reproduciéndose desde la vista Favoritos, porque el altavoz aporta la credencial. Algunos de estos servicios tampoco están disponibles en sistemas Sonos S1."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube Music, SoundCloud et SiriusXM exigent une authentification réservée à Sonos, inaccessible aux applications tierces. Les favoris de ces services enregistrés dans l'app Sonos officielle se lisent toujours depuis la vue Favoris, car l'enceinte fournit l'identifiant. Certains de ces services sont aussi indisponibles sur les systèmes Sonos S1."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube Music, SoundCloud e SiriusXM richiedono un'autenticazione riservata a Sonos, non disponibile per le app di terze parti. I preferiti di questi servizi salvati nell'app Sonos ufficiale continuano a riprodursi dalla vista Preferiti, perché il diffusore fornisce le credenziali. Alcuni di questi servizi non sono disponibili nemmeno sui sistemi Sonos S1."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube Music、SoundCloud、SiriusXM は Sonos 専用の認証を必要とし、サードパーティアプリには公開されていません。公式 Sonos アプリで保存したこれらのサービスのお気に入りは、スピーカーが資格情報を提供するため、引き続き「お気に入り」から再生できます。一部のサービスは Sonos S1 システムでも利用できません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube Music, SoundCloud og SiriusXM krever en pålogging som bare Sonos har tilgang til, ikke tredjepartsapper. Favoritter for disse tjenestene som er lagret i den offisielle Sonos-appen spilles fortsatt via Favoritter-visningen, fordi høyttaleren leverer påloggingen. Noen av tjenestene er dessuten ikke tilgjengelige på Sonos S1-systemer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube Music, SoundCloud en SiriusXM vereisen een alleen-Sonos-aanmelding die niet beschikbaar is voor externe apps. Favorieten van deze diensten die je in de officiële Sonos-app hebt bewaard spelen nog steeds via de Favorieten-weergave, omdat de speaker de inloggegevens levert. Sommige van deze diensten zijn ook niet beschikbaar op Sonos S1-systemen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube Music, SoundCloud i SiriusXM wymagają logowania dostępnego tylko dla Sonos, niedostępnego dla aplikacji firm trzecich. Ulubione tych usług zapisane w oficjalnej aplikacji Sonos nadal odtwarzają się z widoku Ulubione, ponieważ głośnik dostarcza dane logowania. Niektóre z tych usług są też niedostępne w systemach Sonos S1."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube Music, SoundCloud e SiriusXM exigem uma autenticação exclusiva da Sonos que não está disponível para apps de terceiros. Os favoritos destes serviços guardados na app oficial Sonos continuam a reproduzir-se na vista Favoritos, porque a coluna fornece a credencial. Alguns destes serviços também não estão disponíveis em sistemas Sonos S1."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube Music, SoundCloud och SiriusXM kräver en inloggning som bara Sonos har tillgång till, inte tredjepartsappar. Favoriter för dessa tjänster som sparats i den officiella Sonos-appen spelas fortfarande via Favoriter-vyn, eftersom högtalaren tillhandahåller inloggningen. Vissa av tjänsterna är dessutom inte tillgängliga på Sonos S1-system."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube Music、SoundCloud 和 SiriusXM 需要仅限 Sonos 的认证，不向第三方 App 开放。您在官方 Sonos App 中保存的这些服务的收藏仍可通过“收藏”视图播放，因为凭据由扬声器提供。其中部分服务在 Sonos S1 系统上也不可用。"
          }
        }
      }
    },

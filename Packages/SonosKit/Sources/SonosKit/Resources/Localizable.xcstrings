    "helpSurroundModeBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EQ-vinduet har fanerne EQ, Sub og Surround; de to sidste vises kun, når sættet har dem. For et hjemmebiografsæt skifter fanen Surround musik mellem Fuld — surroundhøjttalerne bærer hele mixet — og Ambient, hvor de kun tilføjer stemning. Tv- og musikniveauer indstilles separat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das EQ-Fenster hat die Tabs EQ, Sub und Surrounds; die beiden letzten erscheinen nur, wenn das Set sie hat. Bei einem Heimkino-Set schaltet der Tab Surrounds die Musikwiedergabe zwischen Voll — die Surrounds tragen den vollen Mix — und Ambient um, wo sie nur Atmosphäre beisteuern. TV- und Musikpegel werden getrennt eingestellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The EQ window has EQ, Sub and Surrounds tabs; the latter two appear only when the set has them. For a home-theatre set, the Surrounds tab switches music playback between Full — surrounds carry the full mix — and Ambient, where they add atmosphere only. TV and music levels are set separately."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ventana de EQ tiene las pestañas EQ, Sub y Surrounds; las dos últimas solo aparecen si el conjunto las tiene. En un conjunto de cine en casa, la pestaña Surrounds alterna la música entre Completo — los surround llevan toda la mezcla — y Ambiente, donde solo añaden atmósfera. Los niveles de TV y música se ajustan por separado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fenêtre EQ a les onglets EQ, Caisson et Surrounds ; les deux derniers n'apparaissent que si l'ensemble en dispose. Pour un ensemble home-cinéma, l'onglet Surrounds bascule la musique entre Complet — les surrounds portent tout le mixage — et Ambiant, où ils n'ajoutent que de l'atmosphère. Les niveaux TV et musique se règlent séparément."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La finestra EQ ha le schede EQ, Sub e Surround; le ultime due compaiono solo se il set le ha. Per un set home theater, la scheda Surround alterna la musica tra Completo — i surround portano l'intero mix — e Ambiente, dove aggiungono solo atmosfera. I livelli TV e musica si regolano separatamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EQ ウィンドウには EQ、サブ、サラウンドのタブがあり、後者 2 つはセットにそれらがある場合のみ表示されます。ホームシアターセットでは、サラウンドタブで音楽再生を「フル」（サラウンドがフルミックスを担う）と「アンビエント」（雰囲気のみ加える）で切り替えます。TV と音楽のレベルは別々に設定します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EQ-vinduet har fanene EQ, Sub og Surround; de to siste vises bare når settet har dem. For et hjemmekinosett veksler fanen Surround musikk mellom Full — surroundene bærer hele miksen — og Ambient, der de bare gir atmosfære. TV- og musikknivåer stilles separat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het EQ-venster heeft de tabbladen EQ, Sub en Surrounds; de laatste twee verschijnen alleen als de set ze heeft. Bij een thuisbioscoopset schakelt het tabblad Surrounds muziek tussen Volledig — surrounds dragen de hele mix — en Ambient, waar ze alleen sfeer toevoegen. Tv- en muziekniveaus worden apart ingesteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okno EQ ma karty EQ, Sub i Surround; dwie ostatnie pojawiają się tylko, gdy zestaw je ma. W zestawie kina domowego karta Surround przełącza muzykę między Pełnym — głośniki surround niosą cały miks — a Ambientowym, gdzie dodają tylko atmosferę. Poziomy TV i muzyki ustawia się osobno."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A janela de EQ tem os separadores EQ, Sub e Surrounds; os dois últimos só aparecem quando o conjunto os tem. Num conjunto de cinema em casa, o separador Surrounds alterna a música entre Completo — os surrounds levam toda a mistura — e Ambiente, onde só acrescentam atmosfera. Os níveis de TV e música definem-se em separado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EQ-fönstret har flikarna EQ, Sub och Surround; de två senare visas bara när uppsättningen har dem. För en hemmabio växlar fliken Surround musik mellan Full — surroundhögtalarna bär hela mixen — och Ambient, där de bara ger atmosfär. TV- och musiknivåer ställs in separat."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EQ 窗口有 EQ、低音炮和环绕三个标签页，后两者仅在套装具备时显示。对于家庭影院套装，环绕标签页在“完整”（环绕承载完整混音）和“环境”（仅增添氛围）之间切换音乐播放。电视和音乐电平分别设置。"
          }
        }
      }
    },
    "helpSystemsBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos-højttalere er opdelt i to platforme. Ældre S1-højttalere og moderne S2-højttalere kan ikke være i samme husstand, men kan sameksistere på samme netværk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos-Lautsprecher verteilen sich auf zwei Plattformen. Ältere S1-Lautsprecher und moderne S2-Lautsprecher können nicht im selben Haushalt zusammenarbeiten, können aber im selben Netzwerk koexistieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos speakers are split across two platforms. Legacy S1 speakers and modern S2 speakers cannot join the same household, but both can coexist on the same network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los altavoces Sonos se dividen en dos plataformas. Los altavoces S1 heredados y los altavoces S2 modernos no pueden unirse al mismo hogar, pero pueden coexistir en la misma red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les enceintes Sonos sont réparties sur deux plateformes. Les enceintes S1 existantes et les enceintes S2 modernes ne peuvent pas faire partie du même foyer, mais peuvent coexister sur le même réseau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli altoparlanti Sonos sono suddivisi tra due piattaforme. Gli altoparlanti S1 legacy e i moderni S2 non possono far parte della stessa casa, ma possono coesistere sulla stessa rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonosスピーカーは2つのプラットフォームに分かれています。レガシーのS1スピーカーと最新のS2スピーカーは同じ世帯に参加できませんが、同じネットワークで共存できます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos-høyttalere er fordelt på to plattformer. Eldre S1-høyttalere og moderne S2-høyttalere kan ikke være i samme husstand, men kan sameksistere på samme nettverk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos-luidsprekers zijn verdeeld over twee platforms. Verouderde S1-luidsprekers en moderne S2-luidsprekers kunnen niet in hetzelfde huishouden zitten, maar kunnen wel samen op hetzelfde netwerk bestaan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Głośniki Sonos są podzielone na dwie platformy. Starsze głośniki S1 i nowoczesne S2 nie mogą należeć do tego samego gospodarstwa, ale mogą współistnieć w tej samej sieci."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As caixas Sonos são divididas em duas plataformas. Caixas S1 legadas e caixas S2 modernas não podem integrar a mesma residência, mas podem coexistir na mesma rede."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos-högtalare är uppdelade i två plattformar. Äldre S1-högtalare och moderna S2-högtalare kan inte tillhöra samma hushåll, men kan samexistera i samma nätverk."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos 音箱分为两个平台。旧有 S1 音箱和现代 S2 音箱无法加入同一家庭，但可以共存在同一网络中。"
          }
        }
      }
    },

    "helpBulletLyricsSynced" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkroniserede (tidsstemplede) sangtekster ruller linje for linje i karaoke-stil, med den aktive linje centreret og tilgrænsende linjer der falmer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisierte (mit Zeitstempel versehene) Liedtexte scrollen Zeile für Zeile im Karaoke-Stil; die aktive Zeile wird mittig hervorgehoben, benachbarte Zeilen verblassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synced (timestamped) lyrics scroll line-by-line in karaoke style with the active line centred and adjacent lines fading out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las letras sincronizadas (con marcas de tiempo) se desplazan línea a línea al estilo karaoke, con la línea activa centrada y las contiguas atenuándose."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paroles synchronisées (avec horodatage) défilent ligne par ligne en mode karaoké : la ligne active est centrée et les lignes adjacentes s’estompent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I testi sincronizzati (con timestamp) scorrono riga per riga in stile karaoke, con la riga attiva centrata e quelle adiacenti che sfumano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイムスタンプ付きの歌詞はカラオケ風に行単位でスクロールし、現在の行が中央に、隣の行はフェードします。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkroniserte (tidsstemplede) sangtekster ruller linje for linje i karaokestil, med aktiv linje sentrert og tilgrensende linjer som visner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesynchroniseerde (getimestamped) songteksten lopen regel-voor-regel in karaokestijl, met de actieve regel gecentreerd en aangrenzende regels die vervagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zsynchronizowane (z znacznikami czasu) teksty przewijają się linia po linii w stylu karaoke, z aktywną linią wycentrowaną, a sąsiednimi wygaszającymi się."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As letras sincronizadas (com marca de tempo) deslocam linha-a-linha em estilo karaoke, com a linha ativa centrada e as adjacentes a esmaecer."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkade (tidsstämplade) sångtexter rullar rad för rad i karaokestil, med den aktiva raden centrerad och närliggande rader som tonas ut."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已同步（带时间戳）的歌词以卡拉 OK 风格逐行滚动，当前行居中，相邻行淡出。"
          }
        }
      }
    },
    "helpBulletMenuBar" : {
      "extractionState" : "manual",
      "localizations" : {

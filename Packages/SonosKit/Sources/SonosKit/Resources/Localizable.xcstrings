        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwiera wstępnie wypełnione zgłoszenie na GitHubie. Jeśli pakiet jest za duży dla adresu URL, zostanie skopiowany do schowka, aby można go było wkleić."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre uma issue pré-preenchida no GitHub. Se o pacote for grande de mais para o URL, é copiado para a área de transferência para colar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppnar ett förifyllt ärende på GitHub. Om paketet är för stort för URL:en kopieras det till urklipp så att du kan klistra in det."

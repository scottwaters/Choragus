    "errorAmazonTrackRefused" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Højttaleren afviste nummeret. Amazon Music Prime afspiller kun album, playlister og stationer; enkelte numre kræver Amazon Music Unlimited."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Lautsprecher hat diesen Titel abgelehnt. Amazon Music Prime spielt nur Alben, Playlists und Sender; einzelne Titel brauchen Amazon Music Unlimited."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speaker refused this track. Amazon Music Prime plays albums, playlists and stations only; single tracks need Amazon Music Unlimited."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El altavoz rechazó esta pista. Amazon Music Prime solo reproduce álbumes, listas y emisoras; las pistas sueltas necesitan Amazon Music Unlimited."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'enceinte a refusé cette piste. Amazon Music Prime ne lit que des albums, des playlists et des stations ; les pistes individuelles nécessitent Amazon Music Unlimited."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il diffusore ha rifiutato questo brano. Amazon Music Prime riproduce solo album, playlist e stazioni; i singoli brani richiedono Amazon Music Unlimited."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スピーカーがこのトラックを拒否しました。Amazon Music Prime ではアルバム、プレイリスト、ステーションのみ再生できます。個別のトラックには Amazon Music Unlimited が必要です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høyttaleren avviste sporet. Amazon Music Prime spiller bare album, spillelister og stasjoner; enkeltspor krever Amazon Music Unlimited."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De speaker weigerde dit nummer. Amazon Music Prime speelt alleen albums, afspeellijsten en stations; losse nummers vereisen Amazon Music Unlimited."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Głośnik odrzucił ten utwór. Amazon Music Prime odtwarza tylko albumy, playlisty i stacje; pojedyncze utwory wymagają Amazon Music Unlimited."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A coluna recusou esta faixa. O Amazon Music Prime reproduz apenas álbuns, playlists e estações; faixas individuais exigem o Amazon Music Unlimited."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Högtalaren avvisade spåret. Amazon Music Prime spelar bara album, spellistor och stationer; enskilda spår kräver Amazon Music Unlimited."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扬声器拒绝了此曲目。Amazon Music Prime 只能播放专辑、播放列表和电台；单曲需要 Amazon Music Unlimited。"
          }
        }
      }
    },

    "setupStep2Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For tilsluttede tjenester, log ind med din konto i browseren. Når godkendt, vises tjenesten på Tilsluttet-listen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei verbundenen Diensten im Browser mit deinem Konto anmelden. Nach der Autorisierung erscheint der Dienst in der Liste der Verbundenen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For connected services, sign in with your account in the browser. Once authorized, the service will appear in the Connected list."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para servicios conectados, inicia sesión con tu cuenta en el navegador. Una vez autorizado, aparece en la lista Conectados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les services connectés, connectez-vous avec votre compte dans le navigateur. Une fois autorisé, le service apparaît dans la liste Connectés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per i servizi connessi, accedi con il tuo account nel browser. Una volta autorizzato, il servizio appare nella lista Connessi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続済サービスの場合、ブラウザでアカウントにサインインします。認可後に接続済みの一覧に表示されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For tilkoblede tjenester, logg på med kontoen din i nettleseren. Etter godkjenning vises tjenesten i Tilkoblet-listen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log bij verbonden diensten in met je account in de browser. Na autorisatie verschijnt de dienst in de lijst Verbonden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dla połączonych usług zaloguj się swoim kontem w przeglądarce. Po autoryzacji usługa pojawi się na liście Połączone."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para serviços conectados, entre com sua conta no navegador. Após autorizar, o serviço aparece na lista Conectados."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För anslutna tjänster, logga in med ditt konto i webbläsaren. Efter auktorisering visas tjänsten i Anslutna-listan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于连接服务，请在浏览器中使用您的账户登录。授权后，服务会出现在已连接列表中。"
          }
        }
      }
    },

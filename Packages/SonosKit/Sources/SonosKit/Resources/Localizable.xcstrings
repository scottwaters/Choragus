          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus łączy się bezpośrednio z Twoim serwerem Plex — bez przekaźnika Sonos. Wystarczy zrobić to raz."
          }
        },
        "pt" : {
          "stringUnit" : {

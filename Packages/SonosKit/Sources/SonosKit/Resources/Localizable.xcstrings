    "largeAddBuildingBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus gennemgår biblioteket. ”Tilføj alle” bliver tilgængelig, når antallet er endeligt, eller vælg ”Annuller” for at stoppe uden at tilføje noget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus durchsucht die Mediathek. „Alle hinzufügen“ wird verfügbar, sobald die Anzahl feststeht, oder mit „Abbrechen“ beenden, ohne etwas hinzuzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus is walking the library. Add All becomes available once the count is final, or Cancel to stop without adding anything."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus está recorriendo la biblioteca. «Añadir todo» estará disponible cuando se conozca el total, o pulsa «Cancelar» para detener sin añadir nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus parcourt la bibliothèque. « Tout ajouter » sera disponible une fois le décompte terminé, ou cliquez sur « Annuler » pour arrêter sans rien ajouter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus sta esplorando la libreria. «Aggiungi tutto» sarà disponibile quando il conteggio sarà definitivo, oppure fai clic su «Annulla» per interrompere senza aggiungere nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragusがライブラリを検索しています。曲数が確定すると「すべて追加」が使えるようになります。何も追加せずに終了するには「キャンセル」をクリックしてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus går gjennom biblioteket. «Legg til alle» blir tilgjengelig når antallet er endelig, eller velg «Avbryt» for å stoppe uten å legge til noe."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus doorloopt de bibliotheek. ‘Alles toevoegen’ wordt beschikbaar zodra het totaal vaststaat, of klik op ‘Annuleer’ om te stoppen zonder iets toe te voegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus przegląda bibliotekę. Przycisk „Dodaj wszystkie” stanie się dostępny po ustaleniu liczby utworów, lub kliknij „Anuluj”, aby przerwać bez dodawania."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Choragus está a percorrer a biblioteca. «Adicionar todas» fica disponível quando a contagem estiver concluída, ou clique em «Cancelar» para parar sem adicionar nada."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus går igenom biblioteket. ”Lägg till alla” blir tillgängligt när antalet är klart, eller välj ”Avbryt” för att stoppa utan att lägga till något."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus 正在遍历资料库。曲目总数确定后即可使用“全部添加”，或点按“取消”以停止且不添加任何内容。"
          }
        }
      }
    },

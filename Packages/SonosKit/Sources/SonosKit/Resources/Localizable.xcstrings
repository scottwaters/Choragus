    "helpAIPlaylistsFormatBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indsatte lister: én sang pr. linje — titel, bindestreg, kunstner. Linjer uden bindestreg springes over, højst 500 sange. Matchningen tjekker kunstneren: en coverversion rapporteres som ikke fundet i stedet for stille at blive erstattet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eingefügte Listen: ein Titel pro Zeile — Titel, Bindestrich, Interpret. Zeilen ohne Bindestrich werden übersprungen, maximal 500 Titel pro Liste. Der Abgleich prüft den Interpreten: eine Coverversion wird als nicht gefunden gemeldet statt still ersetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasted lists use one song per line: the title, a dash, then the artist. Lines without a dash are skipped, up to 500 songs per list. Matching checks the artist, so a cover version is reported as not found rather than silently substituted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listas pegadas: una canción por línea — título, guion, artista. Las líneas sin guion se omiten, hasta 500 canciones. La coincidencia comprueba el artista: una versión se marca como no encontrada en vez de sustituirse en silencio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listes collées : un titre par ligne — le titre, un tiret, puis l'artiste. Les lignes sans tiret sont ignorées, 500 titres maximum. La correspondance vérifie l'artiste : une reprise est signalée introuvable plutôt que substituée en silence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elenchi incollati: un brano per riga — titolo, trattino, artista. Le righe senza trattino vengono saltate, fino a 500 brani. L'abbinamento verifica l'artista: una cover viene segnalata come non trovata invece di essere sostituita in silenzio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "貼り付けるリストは1行1曲：タイトル、ダッシュ、アーティストの順です。ダッシュのない行はスキップされ、1リスト最大500曲です。照合はアーティストを確認するため、カバー曲は黙って置き換えられず「見つからない」と報告されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innlimte lister: én sang per linje — tittel, bindestrek, artist. Linjer uten bindestrek hoppes over, maks 500 sanger. Matchingen sjekker artisten: en coverversjon rapporteres som ikke funnet i stedet for å byttes stille inn."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geplakte lijsten: één nummer per regel — titel, streepje, artiest. Regels zonder streepje worden overgeslagen, maximaal 500 nummers. Het matchen controleert de artiest: een coverversie wordt als niet gevonden gemeld in plaats van stilletjes vervangen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wklejane listy: jeden utwór na wiersz — tytuł, myślnik, wykonawca. Wiersze bez myślnika są pomijane, maksymalnie 500 utworów. Dopasowanie sprawdza wykonawcę: cover zostanie zgłoszony jako nieznaleziony, a nie po cichu podmieniony."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listas coladas: uma música por linha — título, traço, artista. Linhas sem traço são ignoradas, até 500 músicas. A correspondência verifica o artista: um cover é reportado como não encontrado em vez de substituído em silêncio."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inklistrade listor: en låt per rad — titel, bindestreck, artist. Rader utan bindestreck hoppas över, max 500 låtar. Matchningen kontrollerar artisten: en cover rapporteras som ej hittad i stället för att tyst ersättas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粘贴的列表每行一首歌：标题、短划线、艺人。没有短划线的行会被跳过，每个列表最多 500 首。匹配会校验艺人：翻唱版会被标记为未找到，而不是被默默替换。"
          }
        }
      }
    },
    "helpAIPlaylistsIntroBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byg playliste med AI forvandler en beskrivelse til ægte, afspillelige numre. Beskriv, hvad du vil, gennemgå sanglisten og Match mod en kilde: Apple Music, en tilkoblet tjeneste, Lokalt bibliotek eller en medieserver (er den valgte tjeneste utilgængelig, falder den tilbage til Apple Music og siger det). Stop afbryder en lang matching; sange, der ikke blev fundet, vises. Levér resultatet til en Choragus-playliste (med mappevalg), slutningen af køen, afspil næste eller afspil nu. Eksempler og Hvordan virker det? er ét klik væk i vinduet. Funktionen slås til i Indstillinger → AI."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playlist mit KI erstellen macht aus einer Beschreibung echte, abspielbare Titel. Beschreibe, was du willst, prüfe die erzeugte Songliste und gleiche sie mit einer Quelle ab: Apple Music, ein angemeldeter Dienst, die lokale Bibliothek oder ein Medienserver (ist der gewählte Dienst nicht verfügbar, weicht sie auf Apple Music aus und sagt es). Stopp bricht einen langen Abgleich ab; nicht gefundene Songs werden aufgelistet. Liefere das Ergebnis in eine Choragus-Playlist (mit Ordnerauswahl), ans Ende der Warteschlange, als Nächstes oder sofort. Beispielaufträge und „Wie funktioniert das?“ sind im Fenster einen Klick entfernt. Die Funktion wird unter Einstellungen → KI aktiviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build Playlist with AI turns a description of a playlist into real, playable tracks. Describe what you want, review the song list it produces, then Match to a source: Apple Music, any signed-in service, Local Library or a media server (when the chosen service is unavailable it falls back to Apple Music and says so). Stop halts a long match; songs that could not be matched are listed. Deliver the result to a Choragus playlist (with a folder picker), the end of the queue, play next, or play now. Sample prompts and How does this work? are one click away in the window. The feature is enabled in Settings → AI."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crear lista con IA convierte una descripción en pistas reales y reproducibles. Describe lo que quieres, revisa la lista de canciones y Empareja con una fuente: Apple Music, cualquier servicio conectado, Biblioteca local o un servidor multimedia (si el servicio elegido no está disponible recurre a Apple Music y lo indica). Detener interrumpe un emparejamiento largo; las canciones no encontradas se listan. Entrega el resultado a una lista de Choragus (con selector de carpeta), al final de la cola, a continuación o ahora. Los ejemplos y ¿Cómo funciona? están a un clic en la ventana. La función se activa en Ajustes → IA."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créer une playlist avec l'IA transforme une description en vrais titres lisibles. Décrivez ce que vous voulez, relisez la liste produite, puis Apparier sur une source : Apple Music, tout service connecté, Bibliothèque locale ou un serveur multimédia (si le service choisi est indisponible, repli sur Apple Music, annoncé). Arrêter interrompt un long appariement ; les titres non trouvés sont listés. Livrez le résultat dans une playlist Choragus (avec choix du dossier), en fin de file, à lire ensuite ou tout de suite. Exemples de demandes et « Comment ça marche ? » sont à un clic dans la fenêtre. La fonction s'active dans Réglages → IA."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea playlist con IA trasforma una descrizione in brani reali e riproducibili. Descrivi cosa vuoi, rivedi l'elenco prodotto, poi Abbina a una sorgente: Apple Music, qualsiasi servizio collegato, Libreria locale o un server multimediale (se il servizio scelto non è disponibile ripiega su Apple Music e lo dice). Interrompi ferma un abbinamento lungo; i brani non trovati vengono elencati. Consegna il risultato a una playlist Choragus (con scelta cartella), in fondo alla coda, subito dopo o adesso. Esempi di richieste e Come funziona? sono a un clic nella finestra. La funzione si attiva in Impostazioni → IA."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI でプレイリストを作成は、プレイリストの説明を実際に再生できる曲に変えます。希望を書き、生成された曲リストを確認し、ソースに照合します：Apple Music、サインイン済みの任意のサービス、ローカルライブラリ、またはメディアサーバー（選んだサービスが使えない場合は Apple Music に切り替えて通知します）。停止で長い照合を中断でき、見つからなかった曲は一覧表示されます。結果は Choragus プレイリスト（フォルダ選択付き）、キューの末尾、次に再生、今すぐ再生へ送れます。サンプルの依頼文と「どう動く？」はウィンドウ内からワンクリックです。機能は設定 → AI で有効にします。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bygg spilleliste med KI gjør en beskrivelse om til ekte, spillbare spor. Beskriv hva du vil, se over sanglisten og Match mot en kilde: Apple Music, en pålogget tjeneste, Lokalt bibliotek eller en medieserver (er den valgte tjenesten utilgjengelig, faller den tilbake til Apple Music og sier det). Stopp avbryter en lang matching; sanger som ikke ble funnet listes. Lever resultatet til en Choragus-spilleliste (med mappevalg), slutten av køen, spill neste eller spill nå. Eksempler og Hvordan virker dette? er ett klikk unna i vinduet. Funksjonen slås på i Innstillinger → KI."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afspeellijst maken met AI zet een beschrijving om in echte, afspeelbare nummers. Beschrijf wat je wilt, bekijk de nummerlijst en Match met een bron: Apple Music, een aangemelde dienst, Lokale bibliotheek of een mediaserver (is de gekozen dienst niet beschikbaar, dan valt hij terug op Apple Music en zegt dat). Stop breekt een lange match af; niet-gevonden nummers worden getoond. Lever het resultaat als Choragus-afspeellijst (met mapkeuze), achteraan de wachtrij, hierna of nu afspelen. Voorbeeldopdrachten en Hoe werkt dit? staan één klik verderop in het venster. De functie wordt ingeschakeld in Instellingen → AI."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buduj playlistę z AI zamienia opis playlisty w prawdziwe, odtwarzalne utwory. Opisz, czego chcesz, przejrzyj listę i Dopasuj do źródła: Apple Music, dowolnej zalogowanej usługi, Biblioteki lokalnej lub serwera multimediów (gdy wybrana usługa jest niedostępna, przełącza się na Apple Music i o tym informuje). Zatrzymaj przerywa długie dopasowanie; niedopasowane utwory są wymienione. Dostarcz wynik do playlisty Choragus (z wyborem folderu), na koniec kolejki, jako następny lub odtwórz teraz. Przykładowe polecenia i Jak to działa? są w oknie na jedno kliknięcie. Funkcję włącza się w Ustawienia → AI."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construir playlist com IA transforma uma descrição em faixas reais e reproduzíveis. Descreva o que quer, reveja a lista de músicas e Corresponda a uma fonte: Apple Music, qualquer serviço com sessão, Biblioteca local ou um servidor multimédia (se o serviço escolhido não estiver disponível, recorre à Apple Music e diz isso). Parar interrompe uma correspondência longa; as músicas não encontradas são listadas. Entregue o resultado numa playlist Choragus (com escolha de pasta), no fim da fila, a seguir ou agora. Os exemplos e Como funciona? estão a um clique na janela. A funcionalidade ativa-se em Ajustes → IA."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bygg spellista med AI gör om en beskrivning till riktiga, spelbara spår. Beskriv vad du vill, granska låtlistan och Matcha mot en källa: Apple Music, valfri inloggad tjänst, Lokalt bibliotek eller en mediaserver (är den valda tjänsten otillgänglig faller den tillbaka på Apple Music och säger det). Stoppa avbryter en lång matchning; låtar som inte hittades listas. Leverera resultatet till en Choragus-spellista (med mappval), slutet av kön, spela härnäst eller spela nu. Exempel och Hur fungerar det? finns ett klick bort i fönstret. Funktionen slås på i Inställningar → AI."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 AI 构建播放列表把一段描述变成真实可播放的曲目。描述你想要的内容，检查生成的歌曲列表，然后匹配到来源：Apple Music、任意已登录服务、本地资料库或媒体服务器（所选服务不可用时回退到 Apple Music 并提示）。停止可中断较长的匹配；未匹配的歌曲会列出。结果可送到 Choragus 播放列表（可选文件夹）、队列末尾、下一首播放或立即播放。示例提示和“这是怎么工作的？”在窗口中一键可达。该功能在设置 → AI 中启用。"
          }
        }
      }
    },
    "helpAIPlaylistsManualBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg Manuel (kopiér prompt) under Generér med. Kopiér prompt lægger en færdig forespørgsel i udklipsholderen; indsæt den i en AI-chat (et websted, en anden app), kopiér svaret og tryk Indsæt liste. Samme knap accepterer også en liste, du selv skriver, én sang pr. linje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle Manuell (Prompt kopieren) unter Erzeugen mit. Prompt kopieren legt eine fertige Anfrage in die Zwischenablage; füge sie in einen beliebigen KI-Chat ein (Website, andere App), kopiere die Antwort und drücke Liste einfügen. Dieselbe Taste nimmt auch jede selbst geschriebene Liste an, ein Song pro Zeile."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose Manual (copy prompt) under Generate with. Copy prompt puts a ready-made request on the clipboard; paste it into any AI chat (a website, another app), copy the reply, and press Paste list to bring it back. The same button also accepts any list you write yourself, one song per line."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige Manual (copiar prompt) en Generar con. Copiar prompt pone una petición lista en el portapapeles; pégala en cualquier chat de IA (una web, otra app), copia la respuesta y pulsa Pegar lista. El mismo botón acepta cualquier lista escrita por ti, una canción por línea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez Manuel (copier l'invite) sous Générer avec. Copier l'invite place une demande prête dans le presse-papiers ; collez-la dans n'importe quel chat IA (site web, autre app), copiez la réponse et pressez Coller la liste. Le même bouton accepte aussi toute liste écrite par vous, un titre par ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli Manuale (copia prompt) sotto Genera con. Copia prompt mette una richiesta pronta negli appunti; incollala in qualsiasi chat IA (un sito, un'altra app), copia la risposta e premi Incolla elenco. Lo stesso pulsante accetta anche qualsiasi elenco scritto da te, un brano per riga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「生成方法」で手動（プロンプトをコピー）を選びます。プロンプトをコピーで依頼文がクリップボードに入るので、任意の AI チャット（Web サイトや別アプリ）に貼り付け、返答をコピーして「リストを貼り付け」を押します。同じボタンは自分で書いた 1 行 1 曲のリストも受け付けます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg Manuell (kopier prompt) under Generer med. Kopier prompt legger en ferdig forespørsel på utklippstavlen; lim den inn i en KI-chat (et nettsted, en annen app), kopier svaret og trykk Lim inn liste. Samme knapp tar også imot en liste du skriver selv, én sang per linje."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies Handmatig (prompt kopiëren) onder Genereren met. Prompt kopiëren zet een kant-en-klaar verzoek op het klembord; plak het in een AI-chat (website, andere app), kopieer het antwoord en druk op Lijst plakken. Dezelfde knop accepteert ook elke zelfgeschreven lijst, één nummer per regel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz Ręcznie (kopiuj prompt) w sekcji Generuj z. Kopiuj prompt umieszcza gotowe polecenie w schowku; wklej je do dowolnego czatu AI (strona, inna aplikacja), skopiuj odpowiedź i naciśnij Wklej listę. Ten sam przycisk przyjmuje też listę napisaną samodzielnie, jeden utwór na wiersz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha Manual (copiar prompt) em Gerar com. Copiar prompt põe um pedido pronto na área de transferência; cole-o em qualquer chat de IA (um site, outra app), copie a resposta e prima Colar lista. O mesmo botão aceita também qualquer lista escrita por si, uma música por linha."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj Manuell (kopiera prompt) under Generera med. Kopiera prompt lägger en färdig förfrågan i urklipp; klistra in den i valfri AI-chatt (en webbplats, en annan app), kopiera svaret och tryck Klistra in lista. Samma knapp tar också emot en lista du skriver själv, en låt per rad."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“生成方式”下选择手动（复制提示词）。复制提示词会把现成的请求放入剪贴板；粘贴到任意 AI 聊天（网站或其他应用），复制回复，再按粘贴列表带回。同一按钮也接受你自己写的列表，每行一首。"
          }
        }
      }
    },
    "helpAIPlaylistsManualHeading" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uden API-nøgle (manuelt)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne API-Schlüssel (manuell)"
          }
        },
        "en" : {

    "helpHomeTheaterSetsBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Højttalere parret som hjemmebio-satellitter eller subwoofere skjules fra sidepanelet som individuelle rækker. Højreklik på hjemmebio-rummet og vælg Hjemmebio-EQ… for at justere kanalniveauer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Heimkino-Satelliten oder Subwoofer gepaarte Lautsprecher werden in der Seitenleiste nicht als einzelne Zeilen angezeigt. Klicke mit der rechten Maustaste auf den Heimkino-Raum und wähle „Heimkino-EQ…“, um die Kanalpegel anzupassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speakers paired as home-theater satellites or subwoofers are hidden from the sidebar as individual rows. Right-click the home-theater room and choose Home Theater EQ… to tune channel levels."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los altavoces emparejados como satélites Home Theater o subwoofers se ocultan de la barra lateral como filas individuales. Haz clic derecho en la habitación Home Theater y elige Ecualizador Home Theater… para ajustar los niveles de canal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les enceintes associées comme satellites Home Theater ou caissons de basses n’apparaissent pas comme lignes individuelles dans la barre latérale. Cliquez avec le bouton droit sur la pièce Home Theater et choisissez Égaliseur Home Theater… pour ajuster les niveaux des canaux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli altoparlanti abbinati come satelliti home theater o subwoofer vengono nascosti dalla barra laterale come righe individuali. Fai clic con il tasto destro sulla stanza Home Theater e scegli Equalizzatore Home Theater… per regolare i livelli dei canali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホームシアターのサテライトやサブウーファーとしてペアリングされたスピーカーは、サイドバーに個別の行としては表示されません。ホームシアターのルームを右クリックして「ホームシアター EQ…」を選ぶとチャンネルレベルを調整できます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høyttalere sammenkoblet som hjemmekino-satellitter eller subwoofere skjules fra sidefeltet som enkeltrader. Høyreklikk på hjemmekino-rommet og velg Hjemmekino-EQ… for å stille inn kanalnivåer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luidsprekers die als home theater-satellieten of subwoofers zijn gekoppeld, worden niet als losse rijen in de zijbalk getoond. Klik met de rechtermuisknop op de home theater-ruimte en kies Home Theater EQ… om kanaalniveaus af te stellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Głośniki sparowane jako satelity kina domowego lub subwoofery są ukryte w panelu bocznym jako osobne wiersze. Kliknij prawym przyciskiem pokój kina domowego i wybierz Korektor kina domowego…, aby dostroić poziomy kanałów."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caixas pareadas como satélites Home Theater ou subwoofers ficam ocultas da barra lateral como linhas individuais. Clique com o botão direito na sala Home Theater e escolha Equalizador Home Theater… para ajustar os níveis dos canais."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Högtalare parade som hemmabio-satelliter eller subwoofers döljs från sidofältet som separata rader. Högerklicka på hemmabio-rummet och välj Hemmabio-EQ… för att ställa in kanalnivåer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作为家庭影院卫星或低音炮配对的音箱不会在侧边栏中显示为单独行。右键单击家庭影院房间并选择家庭影院 EQ… 以调整通道电平。"
          }
        }
      }
    },
    "helpHomeTheaterTogglesBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For en hjemmebiograf-zone viser Now Playing Natindstilling og Taleforbedring under gruppeknapperne. Andre rum viser ikke denne række. De komplette hjemmebiograf-indstillinger findes i EQ-vinduet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für einen Heimkino-Bereich zeigt Now Playing unter den Gruppentasten den Nachtmodus und die Sprachverbesserung an. Bei anderen Räumen wird diese Zeile nicht angezeigt. Die vollständigen Heimkino-Einstellungen finden sich im EQ-Fenster."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For a home-theatre zone, Now Playing shows Night Mode and Dialog Enhancement below the group buttons. Other rooms do not show the row. The full set of home-theatre settings stays in the EQ window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para una zona de cine en casa, Now Playing muestra el Modo nocturno y la Mejora de la voz debajo de los botones de grupo. Otras habitaciones no muestran esta fila. Todos los ajustes del cine en casa se encuentran en la ventana EQ."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour une zone de home cinéma, Now Playing affiche le Mode nuit et l’Amélioration vocale sous les boutons de groupe. Cette ligne n’apparaît pas pour les autres pièces. L’ensemble complet des réglages du home cinéma se trouve dans la fenêtre EQ."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per una zona home theater, Now Playing mostra la Modalità notte e il Miglioramento del parlato sotto i pulsanti del gruppo. Le altre stanze non mostrano questa riga. Tutte le impostazioni per l'home theater si trovano nella finestra EQ."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホームシアターゾーンの場合、Now Playingのグループボタンの下にナイトモードとスピーチエンハンスメントが表示されます。他の部屋ではこの行は表示されません。すべてのホームシアター設定はEQウィンドウにあります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For en hjemmekinosone viser Now Playing Nattmodus og Taleforbedring under gruppeknappene. Andre rom viser ikke denne raden. Det fulle settet med hjemmekinoinnstillinger finnes i EQ-vinduet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor een home cinema-zone toont Now Playing Nachtstand en Spraakversterking onder de groepsknoppen. In andere kamers wordt deze rij niet weergegeven. De volledige set home cinema-instellingen staat in het EQ-venster."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W strefie kina domowego funkcja Now Playing wyświetla Tryb nocny i Wzmocnienie dialogów pod przyciskami grupy. Inne pokoje nie wyświetlają tego wiersza. Pełny zestaw ustawień kina domowego znajduje się w oknie EQ."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para uma zona de cinema em casa, o Now Playing mostra o Modo de Noite e a Melhoria de Diálogo por baixo dos botões de grupo. As outras divisões não mostram esta linha. O conjunto completo de definições de cinema em casa permanece na janela EQ."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För en hemmabiozon visar Now Playing Nattläge och Talförstärkning under gruppknapparna. Andra rum visar inte denna rad. Alla hemmabioinställningar finns i EQ-fönstret."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于家庭影院区域，Now Playing 在组按钮下方显示夜间模式和对话增强。其他房间不显示此行。全套家庭影院设置保存在 EQ 窗口中。"
          }
        }
      }
    },

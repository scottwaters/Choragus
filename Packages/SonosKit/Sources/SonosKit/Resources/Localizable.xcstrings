    "helpBulletPlaybackSettings" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musik → Afspilning: Klassisk blandetilstand lader blandeknappen bruge højttalerens egen tilstand i stedet for at omordne køen; Proportionel gruppelydstyrke bevarer hver højttalers andel, når gruppeskyderen flyttes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musik → Wiedergabe: Klassischer Zufallsmodus lässt die Zufallstaste den Zufallsmodus des Lautsprechers nutzen statt die Warteschlange umzusortieren; Proportionale Gruppenlautstärke bewahrt den Anteil jedes Lautsprechers beim Bewegen des Gruppenreglers."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Music → Playback: Classic Shuffle Mode makes the player's shuffle button use the speaker's own shuffle instead of reordering the queue rows; Proportional Group Volume keeps each speaker's share when the group slider moves."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Música → Reproducción: Modo aleatorio clásico hace que el botón aleatorio use el modo del altavoz en vez de reordenar la cola; Volumen de grupo proporcional mantiene la parte de cada altavoz al mover el control del grupo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musique → Lecture : Mode aléatoire classique fait utiliser au bouton aléatoire le mode propre de l'enceinte plutôt que de réordonner la file ; Volume de groupe proportionnel conserve la part de chaque enceinte quand le curseur de groupe bouge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musica → Riproduzione: Modalità casuale classica fa usare al pulsante casuale la modalità del diffusore invece di riordinare la coda; Volume di gruppo proporzionale mantiene la quota di ogni diffusore quando si muove il cursore del gruppo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ミュージック → 再生：クラシックシャッフルモードでは、シャッフルボタンがキューの並べ替えではなくスピーカー自身のシャッフルを使います。比例グループ音量は、グループスライダーを動かしても各スピーカーの割合を保ちます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musikk → Avspilling: Klassisk tilfeldig-modus lar tilfeldig-knappen bruke høyttalerens eget modus i stedet for å endre køen; Proporsjonalt gruppevolum beholder hver høyttalers andel når gruppeglideren flyttes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muziek → Afspelen: Klassieke shufflemodus laat de shuffleknop de eigen shuffle van de speaker gebruiken in plaats van de wachtrij te herordenen; Proportioneel groepsvolume behoudt het aandeel van elke speaker als de groepsschuif beweegt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muzyka → Odtwarzanie: Klasyczny tryb losowy sprawia, że przycisk losowania używa trybu samego głośnika zamiast zmieniać kolejność kolejki; Proporcjonalna głośność grupy zachowuje udział każdego głośnika przy ruchu suwaka grupy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Música → Reprodução: Modo aleatório clássico faz o botão aleatório usar o modo da coluna em vez de reordenar a fila; Volume de grupo proporcional mantém a parte de cada coluna quando o cursor do grupo se move."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musik → Uppspelning: Klassiskt blandningsläge låter blandningsknappen använda högtalarens eget läge i stället för att ordna om kön; Proportionell gruppvolym behåller varje högtalares andel när gruppreglaget flyttas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音乐 → 播放：经典随机模式让随机按钮使用扬声器自身的随机播放而不是重排队列；按比例的分组音量在拖动分组滑块时保持每个扬声器的比例。"
          }
        }
      }
    },
    "helpBulletPreset" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem en ofte brugt opstilling som forudindstilling: højttalermenuen → Gruppeforudindstillinger → Administrér forudindstillinger…, derefter Gem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichere eine häufige Anordnung als Voreinstellung: Lautsprechermenü → Gruppenvoreinstellungen → Voreinstellungen verwalten…, dann Sichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save a frequently used arrangement as a preset: speaker menu → Group Presets → Manage Presets…, then Save."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda una disposición habitual como ajuste preestablecido: menú de altavoces → Ajustes de grupo → Gestionar ajustes…, luego Guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez un agencement fréquent comme préréglage : menu enceintes → Préréglages de groupe → Gérer les préréglages…, puis Enregistrer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva una disposizione frequente come preset: menu diffusori → Preset di gruppo → Gestisci preset…, poi Salva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "よく使う構成はプリセットとして保存できます：スピーカーメニュー → グループプリセット → プリセットを管理… → 保存。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagre en ofte brukt oppstilling som forvalg: høyttalermenyen → Gruppeforvalg → Administrer forvalg…, deretter Lagre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar een veelgebruikte opstelling als voorinstelling: speakermenu → Groepsvoorinstellingen → Voorinstellingen beheren…, dan Bewaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisz często używany układ jako ustawienie wstępne: menu głośników → Ustawienia grup → Zarządzaj ustawieniami…, potem Zapisz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarde uma disposição frequente como predefinição: menu de colunas → Predefinições de grupo → Gerir predefinições…, depois Guardar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spara en ofta använd uppställning som förval: högtalarmenyn → Gruppförval → Hantera förval…, sedan Spara."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把常用的布局保存为预设：扬声器菜单 → 分组预设 → 管理预设…，然后保存。"
          }
        }
      }
    },

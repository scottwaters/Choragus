    "helpBulletHistorySettings" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musik → Afspilningshistorik: optagelse til eller fra, ignorér tv, HDMI og linjeindgang, et loft for historikken, realtidsopsummeringer til oversigten (interval og genopbygning) og Ryd historik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musik → Wiedergabeverlauf: Aufzeichnung an oder aus, TV, HDMI und Line-In ignorieren, eine Obergrenze für den Verlauf, Echtzeit-Dashboard-Zusammenfassungen (Intervall und Neuaufbau) und Verlauf löschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Music → Play History: record plays on or off, ignore TV, HDMI and Line-In, a history size cap, realtime dashboard summaries (interval and rebuild) and Clear History."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Música → Historial de reproducción: registrar o no, ignorar TV, HDMI y Entrada de línea, un tamaño máximo del historial, resúmenes del panel en tiempo real (intervalo y reconstrucción) y Borrar historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musique → Historique de lecture : enregistrement activé ou non, ignorer TV, HDMI et entrée ligne, une taille maximale d'historique, des résumés de tableau de bord en temps réel (intervalle et reconstruction) et Effacer l'historique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musica → Cronologia riproduzioni: registrazione attiva o no, ignora TV, HDMI e Line-In, un limite alla cronologia, riepiloghi del pannello in tempo reale (intervallo e ricostruzione) e Cancella cronologia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ミュージック → 再生履歴：記録のオン／オフ、TV・HDMI・ライン入力を無視、履歴サイズの上限、ダッシュボードのリアルタイム集計（間隔と再構築）、履歴を消去。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musikk → Avspillingshistorikk: opptak på eller av, ignorer TV, HDMI og linjeinngang, en øvre grense for historikken, sanntidsoppsummeringer for dashbordet (intervall og gjenoppbygging) og Tøm historikk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muziek → Afspeelgeschiedenis: opnemen aan of uit, tv, HDMI en Line-In negeren, een maximum voor de geschiedenis, realtime dashboardsamenvattingen (interval en herbouwen) en Geschiedenis wissen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muzyka → Historia odtwarzania: zapis włączony lub wyłączony, ignorowanie TV, HDMI i wejścia liniowego, limit rozmiaru historii, podsumowania pulpitu w czasie rzeczywistym (interwał i przebudowa) oraz Wyczyść historię."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Música → Histórico de reprodução: registo ligado ou desligado, ignorar TV, HDMI e Entrada de linha, um limite para o histórico, resumos do painel em tempo real (intervalo e reconstrução) e Limpar histórico."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musik → Uppspelningshistorik: inspelning på eller av, ignorera TV, HDMI och linjeingång, ett tak för historiken, realtidssammanfattningar för översikten (intervall och ombyggnad) och Rensa historik."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音乐 → 播放历史：开启或关闭记录、忽略电视、HDMI 和线路输入、历史大小上限、实时仪表板汇总（间隔与重建）以及清除历史。"
          }
        }
      }
    },

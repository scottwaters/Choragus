    "helpBulletScrobbling" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrobbling: send numre til Last.fm med din egen API-nøgle; filtre pr. rum og pr. tjeneste holder testrum ude, en forhåndsvisning viser, hvad der ville blive sendt, og scrobbles går automatisk hvert femte minut eller straks med Scrobble ventende nu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrobbling: sende Titel mit deinem eigenen API-Schlüssel an Last.fm; Filter je Raum und je Dienst halten Testräume fern, eine Vorschau zeigt, was gesendet würde, und Scrobbles gehen alle fünf Minuten automatisch oder sofort mit Ausstehende jetzt scrobbeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrobbling: send tracks to Last.fm using your own API key; per-room and per-service filters keep test rooms out, a preview shows what would be sent, and scrobbles go automatically every five minutes or at once with Scrobble pending now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrobbling: envía pistas a Last.fm con tu propia clave API; los filtros por habitación y por servicio excluyen las habitaciones de prueba, una vista previa muestra lo que se enviaría, y los scrobbles salen cada cinco minutos o al instante con Enviar pendientes ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrobbling : envoyez les titres à Last.fm avec votre propre clé API ; des filtres par pièce et par service excluent les pièces de test, un aperçu montre ce qui serait envoyé, et les scrobbles partent automatiquement toutes les cinq minutes ou tout de suite avec Scrobbler maintenant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrobbling: invia i brani a Last.fm con la tua chiave API; filtri per stanza e per servizio escludono le stanze di prova, un'anteprima mostra cosa verrebbe inviato, e gli scrobble partono ogni cinque minuti o subito con Invia in sospeso ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクロブル：自分の API キーで Last.fm に曲を送ります。部屋別・サービス別のフィルタでテスト用の部屋を除外し、プレビューで送信内容を確認でき、スクロブルは 5 分ごとに自動送信するか「保留中を今すぐ送信」で即時送信できます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrobbling: send spor til Last.fm med din egen API-nøkkel; filtre per rom og per tjeneste holder testrom utenfor, en forhåndsvisning viser hva som ville bli sendt, og scrobbles går automatisk hvert femte minutt eller straks med Scrobble ventende nå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrobbling: stuur nummers naar Last.fm met je eigen API-sleutel; filters per kamer en per dienst houden testkamers buiten, een voorbeeld toont wat verzonden zou worden, en scrobbles gaan automatisch elke vijf minuten of meteen met Wachtende nu scrobbelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrobbling: wysyłaj utwory do Last.fm własnym kluczem API; filtry per pokój i per usługa wykluczają pokoje testowe, podgląd pokazuje, co zostałoby wysłane, a scrobble idą automatycznie co pięć minut lub od razu przez Wyślij oczekujące teraz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrobbling: envie faixas para a Last.fm com a sua própria chave de API; filtros por sala e por serviço excluem salas de teste, uma pré-visualização mostra o que seria enviado, e os scrobbles seguem a cada cinco minutos ou de imediato com Enviar pendentes agora."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrobbling: skicka spår till Last.fm med din egen API-nyckel; filter per rum och per tjänst håller testrum utanför, en förhandsvisning visar vad som skulle skickas, och scrobblar går automatiskt var femte minut eller direkt med Scrobbla väntande nu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrobbling：用你自己的 API 密钥把曲目发送到 Last.fm；按房间和按服务的筛选可排除测试房间，预览显示将发送的内容，scrobble 每五分钟自动发送，或用“立即发送待处理”即刻发送。"
          }
        }
      }
    },
    "helpBulletSearch" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søg på tværs af aktiverede tjenester med søgefeltet; resultater cachelagres, så tilbage-knappen vender tilbage til tidligere søgeresultater."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suche mit dem Suchfeld in allen aktivierten Diensten; die Ergebnisse werden zwischengespeichert, sodass die Zurück-Schaltfläche zu früheren Suchergebnissen zurückführt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search across enabled services with the search field; results are cached so the back button returns to prior search results."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca en todos los servicios activados con el campo de búsqueda; los resultados se almacenan en caché para que el botón Atrás vuelva a resultados anteriores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effectuez une recherche dans tous les services activés avec le champ de recherche ; les résultats sont mis en cache, de sorte que le bouton Retour revient aux résultats précédents."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca in tutti i servizi attivati tramite il campo di ricerca; i risultati sono memorizzati nella cache, quindi il pulsante Indietro torna ai risultati precedenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索フィールドで有効なサービスを横断的に検索できます。結果はキャッシュされるため、戻るボタンで以前の検索結果に戻れます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søk på tvers av aktiverte tjenester med søkefeltet; resultater bufres, så tilbakeknappen går tilbake til tidligere søkeresultater."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoek in alle ingeschakelde diensten met het zoekveld; resultaten worden in de cache opgeslagen, zodat de terugknop naar eerdere zoekresultaten terugkeert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szukaj we wszystkich włączonych usługach za pomocą pola wyszukiwania; wyniki są buforowane, więc przycisk Wstecz wraca do wcześniejszych wyników."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesquise em todos os serviços ativados com o campo de busca; os resultados ficam em cache, então o botão Voltar retorna aos resultados anteriores."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sök i alla aktiverade tjänster med sökfältet; resultat cachas så att bakåt-knappen återgår till tidigare sökresultat."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用搜索栏跨已启用服务搜索；结果会缓存，返回按钮可回到之前的搜索结果。"
          }
        }
      }
    },
    "helpBulletSeedAddresses" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj højttalere efter adresse — til netværk, der helt blokerer den automatiske søgning, hvor en højere hop-grænse ikke hjælper. Indtast én IP-adresse pr. linje under Avancerede netværksindstillinger i Indstillinger → System. Én højttaler er som regel nok: resten af systemet findes gennem den. Reservér adressen i routeren, så den ikke ændrer sig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lautsprecher per Adresse hinzufügen — für Netzwerke, die die automatische Suche ganz blockieren und bei denen ein höheres Hop-Limit nicht hilft. Gib unter Erweiterte Netzwerkeinstellungen in Einstellungen → System eine IP-Adresse pro Zeile ein. Ein Lautsprecher reicht meist: der Rest des Systems wird über ihn gefunden. Reserviere die Adresse im Router, damit sie sich nicht ändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add speakers by address — for networks that block the automatic search entirely, where raising the hop limit does not help. Enter one IP address per line under Advanced network settings in Settings → System. One speaker is usually enough: the rest of the system is found through it. Reserve the address on your router so it does not change."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir altavoces por dirección — para redes que bloquean por completo la búsqueda automática, donde subir el límite de saltos no ayuda. Escribe una dirección IP por línea en Ajustes de red avanzados dentro de Ajustes → Sistema. Suele bastar un altavoz: el resto del sistema se encuentra a través de él. Reserva la dirección en el router para que no cambie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouter des enceintes par adresse — pour les réseaux qui bloquent totalement la recherche automatique, quand augmenter la limite de sauts n'aide pas. Saisissez une adresse IP par ligne sous Réglages réseau avancés dans Réglages → Système. Une enceinte suffit généralement : le reste du système est trouvé à travers elle. Réservez l'adresse sur votre routeur pour qu'elle ne change pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi diffusori per indirizzo — per reti che bloccano del tutto la ricerca automatica, dove alzare il limite di hop non aiuta. Inserisci un indirizzo IP per riga in Impostazioni di rete avanzate dentro Impostazioni → Sistema. Di solito basta un diffusore: il resto del sistema viene trovato tramite esso. Riserva l'indirizzo sul router perché non cambi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アドレスでスピーカーを追加 — 自動検出を完全にブロックし、ホップ制限を上げても効かないネットワーク向けです。設定 → システムの詳細ネットワーク設定に IP アドレスを 1 行ずつ入力します。通常は 1 台で十分で、残りはそのスピーカー経由で見つかります。アドレスが変わらないようルーターで予約してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til høyttalere etter adresse — for nettverk som blokkerer det automatiske søket helt, der høyere hoppgrense ikke hjelper. Skriv én IP-adresse per linje under Avanserte nettverksinnstillinger i Innstillinger → System. Én høyttaler er som regel nok: resten av systemet finnes gjennom den. Reserver adressen i ruteren så den ikke endres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speakers op adres toevoegen — voor netwerken die de automatische zoektocht volledig blokkeren, waar een hogere hoplimiet niet helpt. Voer één IP-adres per regel in onder Geavanceerde netwerkinstellingen in Instellingen → Systeem. Eén speaker volstaat meestal: de rest van het systeem wordt via die speaker gevonden. Reserveer het adres op je router zodat het niet verandert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj głośniki według adresu — dla sieci całkowicie blokujących automatyczne wyszukiwanie, gdzie zwiększenie limitu skoków nie pomaga. Wpisz po jednym adresie IP w wierszu w Zaawansowanych ustawieniach sieci w Ustawienia → System. Zwykle wystarczy jeden głośnik: reszta systemu zostanie znaleziona przez niego. Zarezerwuj adres w routerze, aby się nie zmieniał."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicionar colunas por endereço — para redes que bloqueiam totalmente a procura automática, onde aumentar o limite de saltos não ajuda. Introduza um endereço IP por linha em Definições de rede avançadas dentro de Ajustes → Sistema. Uma coluna costuma bastar: o resto do sistema é encontrado através dela. Reserve o endereço no router para não mudar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till högtalare via adress — för nätverk som helt blockerar den automatiska sökningen, där en högre hoppgräns inte hjälper. Ange en IP-adress per rad under Avancerade nätverksinställningar i Inställningar → System. En högtalare räcker oftast: resten av systemet hittas via den. Reservera adressen i routern så att den inte ändras."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按地址添加扬声器——用于完全阻止自动搜索、提高跳数限制也无效的网络。在设置 → 系统的高级网络设置中每行输入一个 IP 地址。通常一个扬声器就够：系统的其余部分会通过它被发现。在路由器上保留该地址以免变化。"
          }
        }
      }
    },

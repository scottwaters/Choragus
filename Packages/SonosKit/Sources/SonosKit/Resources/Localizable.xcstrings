          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus se conecta directamente con tu servidor Plex — sin relay de Sonos. Solo tienes que hacerlo una vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus se connecte directement à votre serveur Plex — sans relais Sonos. Vous ne devez le faire qu’une fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus si connette direttamente al server Plex — senza relay Sonos. Devi farlo solo una volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus は Plex サーバーに直接接続します — Sonos リレーは使用しません。この操作は一度だけです。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",

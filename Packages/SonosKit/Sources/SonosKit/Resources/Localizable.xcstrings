    "setupStep4Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiverede tjenester vises i Gennemse-panelet under Tjenestesøgning. Du kan gennemse, søge og afspille direkte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivierte Dienste erscheinen im Browse-Bereich unter Dienstsuche. Du kannst direkt browsen, suchen und abspielen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enabled services appear in the Browse panel under Service Search. You can browse, search, and play content directly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los servicios habilitados aparecen en el panel Explorar bajo Búsqueda de servicios. Puedes navegar, buscar y reproducir directamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les services activés apparaissent dans le panneau Parcourir sous Recherche de services. Vous pouvez parcourir, rechercher et lire directement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I servizi abilitati appaiono nel pannello Naviga sotto Ricerca servizi. Puoi navigare, cercare e riprodurre direttamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効なサービスはブラウズパネルのサービス検索に表示されます。直接ブラウズ、検索、再生できます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiverte tjenester vises i Bla-panelet under Tjenestesøk. Du kan bla, søke og spille direkte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingeschakelde diensten verschijnen in het Bladeren-paneel onder Service Zoeken. Je kunt direct bladeren, zoeken en afspelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włączone usługi pojawiają się w panelu Przeglądaj w sekcji Wyszukiwanie usług. Możesz przeglądać, wyszukiwać i odtwarzać bezpośrednio."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serviços ativados aparecem no painel Navegar em Busca de serviços. Você pode navegar, buscar e reproduzir diretamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiverade tjänster visas i Bläddra-panelen under Tjänstsökning. Du kan bläddra, söka och spela direkt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已启用的服务在浏览面板的服务搜索中显示。您可以直接浏览、搜索和播放内容。"
          }
        }
      }
    },

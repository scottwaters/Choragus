    "plexRelayReturnedNoItems" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plex-relæet returnerede heller ingen elementer — din Plex-server sover måske."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch der Plex-Relay lieferte keine Elemente — dein Plex-Server schläft möglicherweise."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plex's relay returned no items either — your Plex server may be sleeping."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El relay de Plex tampoco devolvió elementos — tu servidor Plex puede estar en reposo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le relais Plex n’a renvoyé aucun élément non plus — votre serveur Plex est peut-être en veille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche il relay di Plex non ha restituito elementi — il tuo server Plex potrebbe essere in stand-by."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plex リレーもアイテムを返しませんでした—Plex サーバーがスリープ中の可能性があります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plex-reléet returnerte heller ingen elementer — Plex-serveren din sover kanskje."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Plex-relay leverde ook geen items op — je Plex-server slaapt mogelijk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przekaźnik Plex również nie zwrócił żadnych elementów — Twój serwer Plex może być uśpiony."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O relay do Plex também não devolveu itens — o seu servidor Plex pode estar a dormir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plex-relän returnerade inte heller några objekt — din Plex-server kanske sover."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plex 中继也没有返回任何项目—您的 Plex 服务器可能休眠中。"
          }
        }
      }
    },
    "plexRemoteNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos' Plex-tjeneste, nået via Plex' servere. Din server vises kun, når Plex fjernadgang har en direkte offentlig adresse; en server kun via relay (CGNAT) meldes af Plex som utilgængelig. Brug Plex – Lokal til rum på dit netværk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Plex-Dienst von Sonos, erreicht über die Plex-Server. Er listet Ihren Server nur, wenn der Plex-Fernzugriff eine direkte öffentliche Adresse hat; ein Server nur über Relay (CGNAT) wird von Plex als nicht verfügbar gemeldet. Für Räume in Ihrem Netzwerk verwenden Sie Plex – Lokal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos's Plex service, reached through Plex's servers. It lists your server only when Plex Remote Access has a direct public address; a relay-only server (CGNAT) is reported by Plex as unavailable. For rooms on your network, use Plex – Local."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servicio Plex de Sonos, a través de los servidores de Plex. Solo muestra tu servidor si el acceso remoto de Plex tiene una dirección pública directa; un servidor solo por relay (CGNAT) es reportado por Plex como no disponible. Para las habitaciones de tu red, usa Plex – Local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le service Plex de Sonos, joint via les serveurs de Plex. Il n'affiche votre serveur que si l'accès à distance Plex a une adresse publique directe ; un serveur joignable uniquement par relais (CGNAT) est signalé indisponible par Plex. Pour les pièces de votre réseau, utilisez Plex – Local."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il servizio Plex di Sonos, raggiunto tramite i server di Plex. Elenca il tuo server solo se l'accesso remoto di Plex ha un indirizzo pubblico diretto; un server solo via relay (CGNAT) viene segnalato da Plex come non disponibile. Per le stanze della tua rete usa Plex – Locale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos の Plex サービスで、Plex のサーバー経由で接続します。Plex のリモートアクセスに直接の公開アドレスがある場合のみサーバーが表示され、リレーのみ（CGNAT）のサーバーは Plex から利用不可と報告されます。ネットワーク内の部屋には Plex – ローカル を使ってください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos sin Plex-tjeneste, nådd via Plex sine servere. Serveren din vises bare når Plex fjerntilgang har en direkte offentlig adresse; en server som bare nås via relé (CGNAT) rapporteres av Plex som utilgjengelig. Bruk Plex – Lokal for rom i nettverket ditt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Plex-service van Sonos, bereikt via de servers van Plex. Uw server wordt alleen getoond als Plex Remote Access een direct openbaar adres heeft; een server die alleen via relay (CGNAT) bereikbaar is, meldt Plex als niet beschikbaar. Gebruik voor kamers in uw netwerk Plex – Lokaal."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usługa Plex firmy Sonos, dostępna przez serwery Plex. Twój serwer pojawia się tylko, gdy zdalny dostęp Plex ma bezpośredni adres publiczny; serwer dostępny wyłącznie przez relay (CGNAT) Plex zgłasza jako niedostępny. Dla pomieszczeń w Twojej sieci użyj Plex – Lokalny."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O serviço Plex da Sonos, acessado pelos servidores da Plex. Só lista o seu servidor quando o acesso remoto do Plex tem um endereço público direto; um servidor apenas por relay (CGNAT) é reportado pela Plex como indisponível. Para salas na sua rede, use Plex – Local."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos Plex-tjänst, nådd via Plex servrar. Din server visas bara när Plex fjärråtkomst har en direkt publik adress; en server som bara nås via relä (CGNAT) rapporteras av Plex som otillgänglig. Använd Plex – Lokal för rum i ditt nätverk."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos 的 Plex 服务，通过 Plex 的服务器连接。只有当 Plex 远程访问具有直接公网地址时才会列出您的服务器；仅通过中继（CGNAT）的服务器会被 Plex 报告为不可用。本地网络中的房间请使用 Plex – 本地。"
          }
        }
      }
    },

    "intentInputNotFoundFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indgangen \"%@\" findes ikke længere i Sonos-systemet. Åbn Choragus og vælg en indgang igen til denne genvej."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Eingang „%@“ ist nicht mehr im Sonos-System. Choragus öffnen und für diesen Kurzbefehl einen Eingang neu wählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The input \"%@\" is no longer in your Sonos system. Open Choragus and re-pick an input for this shortcut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La entrada \"%@\" ya no está en el sistema Sonos. Abre Choragus y vuelve a elegir una entrada para este atajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'entrée « %@ » ne fait plus partie du système Sonos. Ouvrez Choragus et choisissez à nouveau une entrée pour ce raccourci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ingresso \"%@\" non è più nel sistema Sonos. Apri Choragus e scegli di nuovo un ingresso per questo comando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入力「%@」は Sonos システムに存在しません。Choragus を開き、このショートカットの入力を選び直してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inngangen «%@» er ikke lenger i Sonos-systemet. Åpne Choragus og velg en inngang på nytt for denne snarveien."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De ingang \"%@\" zit niet meer in je Sonos-systeem. Open Choragus en kies opnieuw een ingang voor deze opdracht."
          }
        },
        "pl" : {

    "helpKaraokeSettingsBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstillinger → Visualiseringer → Karaoke vælger stilen — Klassisk ruller linjerne jævnt, Dynamisk skalerer og toner den aktive linje — og rummer den globale tekstforskydning (standard −2,0 s; knapperne pr. nummer lægges til). Indstillinger → Skærm → Karaoke-tema giver vinduet sit eget lyse eller mørke udseende, uafhængigt af resten af appen, da det som regel ses på afstand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen → Visualisierungen → Karaoke wählt den Stil — Klassisch rollt Zeilen gleichmäßig, Dynamisch skaliert und blendet die aktive Zeile — und enthält den globalen Text-Zeitversatz (Standard −2,0 s; die Tasten je Titel addieren sich dazu). Einstellungen → Darstellung → Karaoke-Design gibt dem Fenster ein eigenes helles oder dunkles Erscheinungsbild, unabhängig vom Rest der App, weil es meist von weitem betrachtet wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings → Visualisations → Karaoke chooses the style — Classic scrolls lines evenly, Dynamic scales and fades the active line — and holds the global lyrics timing offset (default −2.0 s; the per-track buttons add to it). Settings → Display → Karaoke theme gives the window its own light or dark appearance, independent of the rest of the app, because it is usually viewed from across the room."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes → Visualizaciones → Karaoke elige el estilo — Clásico desplaza las líneas de forma uniforme, Dinámico escala y atenúa la línea activa — y contiene el desfase global de las letras (−2,0 s por defecto; los botones por pista se suman). Ajustes → Pantalla → Tema de Karaoke da a la ventana su propio aspecto claro u oscuro, independiente del resto de la app, porque suele verse desde lejos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglages → Visualisations → Karaoké choisit le style — Classique fait défiler les lignes uniformément, Dynamique agrandit et estompe la ligne active — et contient le décalage global des paroles (−2,0 s par défaut ; les boutons par titre s'y ajoutent). Réglages → Affichage → Thème Karaoké donne à la fenêtre sa propre apparence claire ou sombre, indépendante du reste de l'app, car on la regarde généralement de loin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impostazioni → Visualizzazioni → Karaoke sceglie lo stile — Classico scorre le righe in modo uniforme, Dinamico ingrandisce e sfuma la riga attiva — e contiene lo scostamento globale dei testi (predefinito −2,0 s; i pulsanti per brano si sommano). Impostazioni → Schermo → Tema Karaoke dà alla finestra un aspetto chiaro o scuro proprio, indipendente dal resto dell'app, perché di solito la si guarda da lontano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定 → ビジュアライゼーション → カラオケでスタイルを選びます。クラシックは行を均等にスクロールし、ダイナミックは現在行を拡大・フェードします。歌詞タイミングの全体オフセット（既定 −2.0 秒、曲ごとのボタンはこれに加算）もここにあります。設定 → 表示 → カラオケテーマは、このウィンドウだけにライト／ダークの外観を与えます。離れた場所から見ることが多いためです。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innstillinger → Visualiseringer → Karaoke velger stilen — Klassisk ruller linjene jevnt, Dynamisk skalerer og toner den aktive linjen — og rommer den globale tekstforskyvningen (standard −2,0 s; knappene per spor legges til). Innstillinger → Skjerm → Karaoke-tema gir vinduet sitt eget lyse eller mørke utseende, uavhengig av resten av appen, siden det som regel ses på avstand."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instellingen → Visualisaties → Karaoke kiest de stijl — Klassiek scrolt regels gelijkmatig, Dynamisch schaalt en vervaagt de actieve regel — en bevat de algemene tijdverschuiving van songteksten (standaard −2,0 s; de knoppen per nummer tellen erbij op). Instellingen → Weergave → Karaoke-thema geeft het venster een eigen lichte of donkere weergave, los van de rest van de app, omdat je er meestal van een afstand naar kijkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawienia → Wizualizacje → Karaoke wybiera styl — Klasyczny przewija wiersze równomiernie, Dynamiczny powiększa i wygasza aktywny wiersz — i zawiera globalne przesunięcie czasu tekstów (domyślnie −2,0 s; przyciski per utwór się do niego dodają). Ustawienia → Wyświetlanie → Motyw Karaoke nadaje oknu własny jasny lub ciemny wygląd, niezależny od reszty aplikacji, bo zwykle ogląda się je z daleka."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes → Visualizações → Karaoke escolhe o estilo — Clássico faz as linhas deslizar uniformemente, Dinâmico amplia e esbate a linha ativa — e contém o desvio global das letras (predefinição −2,0 s; os botões por faixa somam-se). Ajustes → Ecrã → Tema do Karaoke dá à janela a sua própria aparência clara ou escura, independente do resto da app, porque costuma ser vista de longe."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inställningar → Visualiseringar → Karaoke väljer stilen — Klassisk rullar raderna jämnt, Dynamisk skalar och tonar den aktiva raden — och rymmer den globala textförskjutningen (standard −2,0 s; knapparna per spår läggs till). Inställningar → Skärm → Karaoketema ger fönstret ett eget ljust eller mörkt utseende, oberoende av resten av appen, eftersom det oftast ses på avstånd."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置 → 可视化 → 卡拉 OK 选择样式——经典平稳滚动各行，动态放大并淡化当前行——并包含全局歌词时间偏移（默认 −2.0 秒；每首曲目的按钮在此基础上叠加）。设置 → 显示 → 卡拉 OK 主题为该窗口单独设定浅色或深色外观，与应用其余部分无关，因为通常隔着房间观看。"
          }
        }
      }
    },

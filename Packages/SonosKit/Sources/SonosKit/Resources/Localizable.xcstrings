    "helpDiagnosticsMCPBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fanen Agentadgang viser MCP-serverens tilstand, tokens efter navn og adgangsniveau, udelukkelser og mislykkede logins, igangværende playlistebygninger og anmodningsloggen; fejlrapportpakken indeholder det samme under mcp."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Tab Agentenzugriff zeigt den Zustand des MCP-Servers, die Tokens mit Name und Zugriffsstufe, Sperren und fehlgeschlagene Anmeldungen, laufende Playlist-Erstellungen und das Anfrageprotokoll; das Fehlerbericht-Bundle enthält dasselbe unter mcp."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Agent access tab shows the MCP server state, the tokens by name and access level, lockouts and failed sign-ins, running playlist builds and the request log; the bug-report bundle carries the same under mcp."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pestaña Acceso de agentes muestra el estado del servidor MCP, los tokens por nombre y nivel de acceso, bloqueos e inicios fallidos, construcciones de listas en curso y el registro de solicitudes; el paquete de informe de errores lleva lo mismo bajo mcp."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'onglet Accès des agents montre l'état du serveur MCP, les jetons par nom et niveau d'accès, les blocages et connexions échouées, les constructions de playlists en cours et le journal des requêtes ; le bundle de rapport de bug porte la même chose sous mcp."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La scheda Accesso agenti mostra lo stato del server MCP, i token per nome e livello di accesso, blocchi e accessi falliti, costruzioni di playlist in corso e il registro delle richieste; il bundle di segnalazione contiene lo stesso sotto mcp."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「エージェントアクセス」タブには MCP サーバーの状態、名前とアクセスレベル別のトークン、ロックアウトと認証失敗、実行中のプレイリスト作成、リクエストログが表示されます。バグレポートバンドルにも mcp として同じ内容が含まれます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fanen Agenttilgang viser MCP-serverens tilstand, tokenene etter navn og tilgangsnivå, utestengelser og mislykkede pålogginger, pågående spillelistebygg og forespørselsloggen; feilrapportpakken inneholder det samme under mcp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het tabblad Agenttoegang toont de status van de MCP-server, de tokens op naam en toegangsniveau, blokkades en mislukte aanmeldingen, lopende afspeellijstbouw en het verzoeklog; de bugrapportbundel bevat hetzelfde onder mcp."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karta Dostęp agentów pokazuje stan serwera MCP, tokeny według nazwy i poziomu dostępu, blokady i nieudane logowania, trwające budowy playlist oraz dziennik żądań; pakiet raportu błędu zawiera to samo pod mcp."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O separador Acesso de agentes mostra o estado do servidor MCP, os tokens por nome e nível de acesso, bloqueios e autenticações falhadas, construções de playlists em curso e o registo de pedidos; o pacote de relatório de erro leva o mesmo sob mcp."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fliken Agentåtkomst visar MCP-serverns tillstånd, token efter namn och åtkomstnivå, utelåsningar och misslyckade inloggningar, pågående spellistbyggen och förfrågningsloggen; felrapportpaketet innehåller samma sak under mcp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“代理访问”标签页显示 MCP 服务器状态、按名称和权限级别列出的令牌、锁定和认证失败、进行中的播放列表构建以及请求日志；错误报告包在 mcp 下包含同样内容。"
          }
        }
      }
    },
    "helpDiagnosticsOpeningBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik på aktivitetsikonet på værktøjslinjen (øverst til højre i hovedvinduet). Hvis du har skjult ikonet i Indstillinger → Visning, indsamles diagnosticering stadig i baggrunden — den vises bare ikke via værktøjslinjen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke auf das Aktivitätssymbol in der Symbolleiste (oben rechts im Hauptfenster). Wenn du das Symbol unter Einstellungen → Darstellung ausgeblendet hast, werden Diagnosedaten weiterhin im Hintergrund erfasst — sie werden nur nicht über die Symbolleiste angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click the activity icon in the toolbar (top-right of the main window). If you've hidden the icon in Settings → Display, diagnostics still capture in the background — they're just not surfaced via the toolbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en el icono de actividad en la barra de herramientas (arriba a la derecha de la ventana principal). Si has ocultado el icono en Ajustes → Visualización, los diagnósticos se seguirán capturando en segundo plano — simplemente no se mostrarán a través de la barra de herramientas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur l'icône d'activité dans la barre d'outils (en haut à droite de la fenêtre principale). Si vous avez masqué l'icône dans Réglages → Affichage, les diagnostics continuent d'être capturés en arrière-plan — ils ne sont tout simplement pas affichés via la barre d'outils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic sull'icona dell'attività nella barra degli strumenti (in alto a destra nella finestra principale). Se hai nascosto l'icona in Impostazioni → Aspetto, la diagnostica continuerà a essere acquisita in background — semplicemente non sarà visibile tramite la barra degli strumenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ツールバー（メインウインドウの右上）にあるアクティビティアイコンをクリックします。「設定」→「表示」でアイコンを非表示にしている場合でも、診断はバックグラウンドで引き続き取得されます（ツールバーに表示されなくなるだけです）。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikk på aktivitetsikonet i verktøylinjen (øverst til høyre i hovedvinduet). Hvis du har skjult ikonet under Innstillinger → Visning, samles diagnostikk fortsatt i bakgrunnen — den vises bare ikke via verktøylinjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik op het activiteitssymbool in de knoppenbalk (rechtsboven in het hoofdvenster). Als je het symbool hebt verborgen in Instellingen → Weergave, worden diagnostische gegevens nog steeds op de achtergrond vastgelegd — ze worden alleen niet getoond via de knoppenbalk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij ikonę aktywności na pasku narzędzi (w prawym górnym rogu okna głównego). Jeśli ikona została ukryta w sekcji Ustawienia → Wyświetlanie, dane diagnostyczne nadal są rejestrowane w tle — po prostu nie są widoczne na pasku narzędzi."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clica no ícone de atividade na barra de ferramentas (canto superior direito da janela principal). Se ocultaste o ícone em Ajustes → Exibição, os diagnósticos ainda serão capturados em segundo plano — eles apenas não ficarão visíveis pela barra de ferramentas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicka på aktivitetsikonen i verktygsfältet (längst upp till höger i huvudfönstret). Om du har dolt ikonen under Inställningar → Visning registreras diagnostik fortfarande i bakgrunden — den visas bara inte via verktygsfältet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按工具栏（主窗口右上角）中的活动图标。如果在“设置”→“显示”中隐藏了该图标，诊断信息仍会在后台捕获 — 只是不会通过工具栏显示出来。"
          }
        }
      }
    },

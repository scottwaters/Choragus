    "mediaServersAdvertisedMismatch" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren annoncerer %@. Højttalerne kan muligvis ikke nå den adresse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server meldet sich mit %@. Die Lautsprecher können diese Adresse möglicherweise nicht erreichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server is advertising %@. Your speakers may be unable to reach that address."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor anuncia %@. Puede que los altavoces no alcancen esa dirección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur annonce %@. Vos enceintes ne peuvent peut-être pas atteindre cette adresse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server annuncia %@. I diffusori potrebbero non raggiungere quell'indirizzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバは %@ を通知しています。スピーカーはこのアドレスに到達できない可能性があります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveren annonserer %@. Høyttalerne når kanskje ikke den adressen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De server adverteert %@. De speakers kunnen dat adres mogelijk niet bereiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer rozgłasza adres %@. Głośniki mogą nie mieć do niego dostępu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor anuncia %@. As colunas podem não alcançar esse endereço."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servern annonserar %@. Högtalarna kanske inte når den adressen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器通告的地址是 %@。音箱可能无法访问该地址。"

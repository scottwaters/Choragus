    "helpRenameFavoriteBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Højreklik på en Sonos-favorit, mens du gennemser Favoritter, for at omdøbe den. Det nye navn gemmes på Sonos-systemet, så enhver controller ser det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke mit der rechten Maustaste auf einen Sonos-Favoriten beim Durchsuchen der Favoriten, um ihn umzubenennen. Der neue Name wird auf das Sonos-System geschrieben, sodass jeder Controller ihn sieht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Right-click a Sonos favourite while browsing Favourites to rename it. The new name is written to the Sonos system, so every controller sees it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic derecho en un favorito de Sonos mientras navegas por Favoritos para cambiarle el nombre. El nuevo nombre se guarda en el sistema Sonos, por lo que todos los controladores lo ven."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites un clic droit sur un favori Sonos lors de la navigation dans les Favoris pour le renommer. Le nouveau nom est enregistré sur le système Sonos, afin que chaque contrôleur le voie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic con il pulsante destro del mouse su un preferito Sonos mentre sfogli i Preferiti per rinominarlo. Il nuovo nome viene scritto sul sistema Sonos, in modo che ogni controller lo veda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「お気に入り」をブラウズ中にSonosのお気に入りを右クリックすると、名前を変更できます。新しい名前はSonosシステムに書き込まれるため、どのコントローラーからでも表示されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høyreklikk på en Sonos-favoritt mens du blar i Favoritter for å gi den nytt navn. Det nye navnet skrives til Sonos-systemet, slik at enhver kontroller ser det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik met de rechtermuisknop op een Sonos-favoriet tijdens het bladeren in Favorieten om de naam ervan te wijzigen. De nieuwe naam wordt weggeschreven naar het Sonos-systeem, zodat elke controller deze ziet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij prawym przyciskiem myszy ulubione Sonos podczas przeglądania Ulubionych, aby zmienić jego nazwę. Nowa nazwa jest zapisywana w systemie Sonos, więc widzi ją każdy kontroler."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique com o botão direito do rato num favorito do Sonos ao navegar em Favoritos para o mudar de nome. O novo nome é escrito no sistema Sonos, pelo que todos os controladores o veem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Högerklicka på en Sonos-favorit när du bläddrar i Favoriter för att byta namn på den. Det nya namnet sparas i Sonos-systemet, så alla kontroller ser det."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在浏览“收藏夹”时右键单击 Sonos 收藏即可将其重命名。新名称将写入 Sonos 系统，因此每个控制器都能看到它。"
          }
        }
      }
    },

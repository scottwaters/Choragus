    "localNetworkAccessMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS blokerer Choragus fra at nå dine Sonos-højttalere.\n\nSlå Choragus TIL under Systemindstillinger → Anonymitet og sikkerhed → Lokalt netværk, og afslut og genstart appen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS blockiert Choragus daran, deine Sonos-Lautsprecher zu erreichen.\\n\\nAktiviere Choragus unter Systemeinstellungen → Datenschutz & Sicherheit → Lokales Netzwerk und beende die App, dann starte sie neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS is blocking Choragus from reaching your Sonos speakers.\n\nTurn Choragus ON under System Settings → Privacy & Security → Local Network, then quit and relaunch the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS impide que Choragus llegue a tus altavoces Sonos.\n\nActiva Choragus en Ajustes del Sistema → Privacidad y seguridad → Red local, sal de la app y vuélvela a abrir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS empêche Choragus d’atteindre vos enceintes Sonos.\n\nActivez Choragus dans Réglages système → Confidentialité et sécurité → Réseau local, puis quittez et relancez l’application."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS sta impedendo a Choragus di raggiungere i tuoi diffusori Sonos.\n\nAttiva Choragus in Impostazioni di Sistema → Privacy e Sicurezza → Rete locale, quindi chiudi e riavvia l’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS は Choragus が Sonos スピーカーにアクセスするのをブロックしています。\n\nシステム設定 → プライバシーとセキュリティ → ローカルネットワークで Choragus をオンにし、アプリを終了して再起動してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS blokkerer Choragus fra å nå Sonos-høyttalerne dine.\n\nSlå PÅ Choragus under Systeminnstillinger → Personvern og sikkerhet → Lokalt nettverk, avslutt og start appen på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS blokkeert Choragus van het bereiken van je Sonos-speakers.\n\nZet Choragus AAN onder Systeeminstellingen → Privacy en beveiliging → Lokaal netwerk, sluit de app af en start opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS blokuje Choragus przed dostępem do Twoich głośników Sonos.\n\nWłącz Choragus w Ustawienia systemowe → Prywatność i ochrona → Sieć lokalna, a następnie zamknij i uruchom ponownie aplikację."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS está a impedir o Choragus de aceder aos seus altifalantes Sonos.\n\nLigue o Choragus em Definições do Sistema → Privacidade e Segurança → Rede Local, depois saia e reinicie a app."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS blockerar Choragus från att nå dina Sonos-högtalare.\n\nSlå PÅ Choragus under Systeminställningar → Integritet och säkerhet → Lokalt nätverk, avsluta och starta om appen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 正在阻止 Choragus 访问您的 Sonos 揚声器。\n\n请在系统设置→隐私与安全→本地网络 中打开 Choragus，然后退出并重新启动应用。"
          }
        }
      }
    },

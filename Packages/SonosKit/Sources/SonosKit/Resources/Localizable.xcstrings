    "helpWelcomeBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus er en indbygget macOS-controller til Sonos-højttalere. Al styring foregår lokalt via dit netværk — ingen cloud-konto er påkrævet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus ist ein nativer macOS-Controller für Sonos-Lautsprecher. Die gesamte Steuerung erfolgt lokal über dein Netzwerk – ein Cloud-Konto ist nicht erforderlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus is a native macOS controller for Sonos speakers. All control happens locally over your network — no cloud account is required."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus es un controlador nativo de macOS para altavoces Sonos. Todo el control se realiza localmente a través de tu red, sin necesidad de cuenta en la nube."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus est un contrôleur macOS natif pour les enceintes Sonos. Toutes les commandes se font localement sur votre réseau — aucun compte cloud n’est requis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus è un controller nativo per macOS per altoparlanti Sonos. Tutto il controllo avviene localmente sulla tua rete: non è richiesto alcun account cloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ChoragusはSonosスピーカー用のmacOSネイティブコントローラーです。すべての操作はネットワーク経由でローカルに行われ、クラウドアカウントは不要です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus er en innebygd macOS-kontroller for Sonos-høyttalere. All styring skjer lokalt via nettverket ditt — ingen skykonto kreves."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus is een native macOS-bedieningsapp voor Sonos-luidsprekers. Alle bediening gebeurt lokaal via je netwerk — er is geen cloudaccount nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus to natywny kontroler macOS dla głośników Sonos. Całe sterowanie odbywa się lokalnie przez twoją sieć — konto w chmurze nie jest wymagane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Choragus é um controlador nativo de macOS para caixas Sonos. Todo o controle ocorre localmente pela sua rede — não é necessária conta na nuvem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus är en inbyggd macOS-kontroll för Sonos-högtalare. All styrning sker lokalt via ditt nätverk — inget molnkonto krävs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus 是适用于 Sonos 音箱的原生 macOS 控制器。所有控制均在本地网络中进行，无需云账户。"
          }
        }
      }
    },
    "helpWindowLifecycleBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selvom du lukker hovedvinduet, kører Choragus fortsat, så afspilningen fortsætter, og menulinjeemnet forbliver tilgængeligt. Tryk på Command-0, eller vælg Choragus i menuen Vindue, for at hente vinduet frem igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du das Hauptfenster schließt, wird Choragus weiterhin im Hintergrund ausgeführt, sodass die Wiedergabe fortgesetzt wird und das Menüleistenobjekt verfügbar bleibt. Drücke Command-0 oder wähle Choragus aus dem Fenster-Menü, um das Fenster wieder einzublenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Closing the main window leaves Choragus running so playback keeps going and the menu bar item stays available. Press Command-0, or choose Choragus from the Window menu, to bring the window back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerrar la ventana principal mantiene Choragus en ejecución para que la reproducción continúe y el ítem de la barra de menús siga disponible. Pulsa Command-0, o selecciona Choragus en el menú Ventana, para volver a mostrar la ventana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fermeture de la fenêtre principale laisse Choragus en cours d'exécution afin que la lecture se poursuive et que l'élément de la barre des menus reste disponible. Appuyez sur Command-0, ou choisissez Choragus dans le menu Fenêtre, pour ramener la fenêtre au premier plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiusura della finestra principale mantiene Choragus in esecuzione affinché la riproduzione continui e l'elemento della barra dei menu resti disponibile. Premi Command-0, o scegli Choragus dal menu Finestra, per richiamare la finestra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メインウインドウを閉じてもChoragusは実行されたままになるため、再生は継続され、メニューバー項目も引き続き利用できます。Command-0を押すか、ウインドウメニューからChoragusを選択すると、ウインドウを再表示できます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Å lukke hovedvinduet lar Choragus fortsette å kjøre slik at avspillingen fortsetter og menylinjeelementet forblir tilgjengelig. Trykk på Command-0, eller velg Choragus fra Vindu-menyen, for å hente frem vinduet igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je het hoofdvenster sluit, blijft Choragus actief zodat het afspelen doorgaat en het menubalkonderdeel beschikbaar blijft. Druk op Command-0 of kies Choragus in het Venster-menu om het venster weer te tonen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamknięcie głównego okna pozostawia Choragus uruchomionym, dzięki czemu odtwarzanie jest kontynuowane, a element paska menu pozostaje dostępny. Naciśnij Command-0 lub wybierz Choragus z menu Okno, aby przywrócić okno."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fechar a janela principal mantém o Choragus em execução para que a reprodução continue e o item da barra de menus permaneça disponível. Pressione Command-0 ou escolha Choragus no menu Janela para trazer a janela de volta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du stänger huvudfönstret fortsätter Choragus att köras så att uppspelningen fortsätter och menyradsobjektet förblir tillgängligt. Tryck på Command-0, eller välj Choragus från Fönster-menyn, för att visa fönstret igen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭主窗口后，Choragus仍会保持运行，因此播放将继续，且菜单栏项目保持可用。按Command-0，或从“窗口”菜单中选取Choragus，即可将窗口调回。"
          }
        }
      }
    },

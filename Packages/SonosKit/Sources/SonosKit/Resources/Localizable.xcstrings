    "listeningFingerprintDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din signatur: spændingstime (viser), tjenester (indre ring), top-kunstnere (ydre kiler), weekendbalance (baggrund), markerede dage (kantglimt)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Signatur: Spitzenstunde (Zeiger), Dienste (innerer Ring), Top-Künstler (äußere Keile), Wochenend-Balance (Hintergrund), markierte Tage (Rand-Funkeln)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your signature: peak hour (hand), services (inner ring), top artists (outer wedges), weekend balance (background), starred days (rim glints)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu firma: hora pico (manecilla), servicios (anillo interior), artistas top (cuñas exteriores), balance del fin de semana (fondo), días destacados (destellos del borde)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre signature : heure de pointe (aiguille), services (anneau intérieur), artistes principaux (segments extérieurs), équilibre week-end (arrière-plan), jours marqués (lueurs du bord)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua firma: ora di punta (lancetta), servizi (anello interno), artisti top (cunei esterni), bilanciamento weekend (sfondo), giorni segnati (riflessi sul bordo)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたのシグネチャー：ピーク時間（針）、サービス（内側のリング）、トップアーティスト（外側のクサビ）、週末のバランス（背景）、スター付きの日（リムの輝き）。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din signatur: rushtid (viser), tjenester (indre ring), topp-artister (ytre kiler), helgbalanse (bakgrunn), merkede dager (kantglimt)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jouw signatuur: piektijd (wijzer), diensten (binnenste ring), topartiesten (buitenste segmenten), weekendbalans (achtergrond), gemarkeerde dagen (randglinsters)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój podpis: godzina szczytu (wskazówka), usługi (wewnętrzny pierścień), top artyści (zewnętrzne kliny), balans weekendu (tło), oznaczone dni (błyski na obrzeżu)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua assinatura: hora de pico (ponteiro), serviços (anel interno), top artistas (cunhas externas), equilíbrio de fim de semana (fundo), dias marcados (reflexos da borda)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din signatur: rusningstimme (visare), tjänster (inre ring), topp-artister (yttre kilar), helgbalans (bakgrund), märkta dagar (kantsken)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的签名：峰值时段（指针）、服务（内环）、顶尖艺术家（外环扮形）、周末平衡（背景）、标星日（边缘闪光）。"
          }
        }
      }
    },

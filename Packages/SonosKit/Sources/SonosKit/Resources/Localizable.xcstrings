    "shuffleDisabledBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug tilfældig-knappen i køpanelet for at omarrangere numrene fysisk, eller aktivér Klassisk tilfældig tilstand i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende die Zufallswiedergabe-Taste im Warteschlangenbereich, um Titel physisch neu anzuordnen, oder aktiviere den klassischen Zufallsmodus in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the shuffle button in the Queue panel to physically reorder tracks, or enable Classic Shuffle Mode in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el botón de orden aleatorio en el panel de cola para reorganizar las pistas, o activa el modo aleatorio clásico en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez le bouton de lecture aléatoire du panneau File d’attente pour réordonner physiquement les pistes, ou activez le mode aléatoire classique dans les Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa il pulsante di riproduzione casuale nel pannello Coda per riordinare fisicamente i brani, oppure abilita la modalità Casuale Classica nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キューパネルのシャッフルボタンでトラックを物理的に並び替えるか、設定でクラシックシャッフルモードを有効にしてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk tilfeldig-knappen i køpanelet for å omorganisere sporene fysisk, eller aktiver Klassisk tilfeldig modus i Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik de shuffle-knop in het wachtrij-paneel om tracks fysiek opnieuw te rangschikken, of schakel Klassieke Shuffle-modus in via Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj przycisku losowania w panelu Kolejki, aby fizycznie zmienić kolejność utworów, lub włącz Klasyczny tryb losowy w Ustawieniach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o botão de reprodução aleatória no painel da Fila para reordenar as faixas fisicamente, ou ative o Modo Aleatório Clássico em Configurações."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd blandningsknappen i köpanelen för att ordna om spåren fysiskt, eller aktivera Klassiskt blandningsläge i Inställningar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用队列面板中的随机按钮以实际重新排序曲目，或在设置中启用经典随机模式。"
          }
        }
      }
    },

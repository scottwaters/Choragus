    "helpAddingToQueueBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Højreklik på en række for Afspil nu, Afspil næste, Føj til kø, Erstat kø eller Gennemse; radiostationer tilbyder kun Afspil nu. Lange lister viser en bjælke med Afspil alle og Tilføj alle. Træk et element til køpanelet (⌥⌘U) for at sætte det i kø, eller klik for at afspille med det samme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechtsklick auf eine Zeile bietet Jetzt abspielen, Als Nächstes, Zur Warteschlange, Warteschlange ersetzen oder Durchsuchen; Radiosender nur Jetzt abspielen. Lange Listen zeigen eine Leiste mit Alle abspielen und Alle hinzufügen. Ziehe einen Eintrag in die Warteschlange (⌥⌘U), um ihn einzureihen, oder klicke ihn für sofortige Wiedergabe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Right-click any row for Play Now, Play Next, Add to Queue, Replace Queue or Browse; radio stations offer Play Now only. Long lists show a bar with Play All and Add All. Drag an item into the Play Queue panel (⌥⌘U) to enqueue it, or click it to play at once."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clic derecho en una fila: Reproducir ahora, A continuación, Añadir a la cola, Reemplazar cola o Explorar; las emisoras solo ofrecen Reproducir ahora. Las listas largas muestran una barra con Reproducir todo y Añadir todo. Arrastra un elemento al panel Cola (⌥⌘U) para encolarlo, o haz clic para reproducirlo al instante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clic droit sur une ligne : Lire, Lire ensuite, Ajouter à la file, Remplacer la file ou Parcourir ; les stations de radio n'offrent que Lire. Les longues listes affichent une barre avec Tout lire et Tout ajouter. Glissez un élément dans le panneau File de lecture (⌥⌘U) pour l'ajouter, ou cliquez-le pour le lire aussitôt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clic destro su una riga: Riproduci ora, Riproduci dopo, Aggiungi alla coda, Sostituisci coda o Sfoglia; le stazioni radio offrono solo Riproduci ora. Gli elenchi lunghi mostrano una barra con Riproduci tutto e Aggiungi tutto. Trascina un elemento nel pannello Coda (⌥⌘U) per accodarlo, o fai clic per riprodurlo subito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行を右クリックすると今すぐ再生、次に再生、キューに追加、キューを置換、ブラウズを選べます。ラジオ局は今すぐ再生のみです。長いリストにはすべて再生とすべて追加のバーが表示されます。項目をキューパネル（⌥⌘U）へドラッグすると追加され、クリックするとすぐ再生されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høyreklikk på en rad for Spill nå, Spill neste, Legg til i kø, Erstatt kø eller Bla; radiostasjoner tilbyr bare Spill nå. Lange lister viser en linje med Spill alle og Legg til alle. Dra et element til køpanelet (⌥⌘U) for å legge det i kø, eller klikk for å spille med en gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechtsklik op een rij voor Nu afspelen, Hierna afspelen, Toevoegen aan wachtrij, Wachtrij vervangen of Bladeren; radiozenders bieden alleen Nu afspelen. Lange lijsten tonen een balk met Alles afspelen en Alles toevoegen. Sleep een item naar het wachtrijpaneel (⌥⌘U) om het toe te voegen, of klik het om meteen af te spelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prawy klik na wierszu: Odtwórz teraz, Odtwórz następny, Dodaj do kolejki, Zastąp kolejkę lub Przeglądaj; stacje radiowe mają tylko Odtwórz teraz. Długie listy pokazują pasek z Odtwórz wszystko i Dodaj wszystko. Przeciągnij element do panelu Kolejka (⌥⌘U), aby go dodać, lub kliknij, aby odtworzyć od razu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique direito numa linha: Tocar agora, Tocar a seguir, Adicionar à fila, Substituir fila ou Navegar; as rádios só oferecem Tocar agora. Listas longas mostram uma barra com Tocar tudo e Adicionar tudo. Arraste um item para o painel Fila (⌥⌘U) para o enfileirar, ou clique para tocar de imediato."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Högerklicka på en rad för Spela nu, Spela härnäst, Lägg till i kö, Ersätt kö eller Bläddra; radiostationer erbjuder bara Spela nu. Långa listor visar en rad med Spela alla och Lägg till alla. Dra ett objekt till köpanelen (⌥⌘U) för att köa det, eller klicka för att spela direkt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右键任意行可选择立即播放、下一首播放、加入队列、替换队列或浏览；广播电台只有立即播放。长列表会显示带“全部播放”和“全部添加”的栏。把项目拖入播放队列面板（⌥⌘U）即可加入，点击则立即播放。"
          }
        }
      }
    },
    "helpAgentBulletAlarms" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos-alarmer: vise, oprette, ændre, slette — \"væk mig 6:30 på hverdage i soveværelset med signalet på lydstyrke 15\""
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos-Wecker: auflisten, anlegen, ändern, löschen — „weck mich werktags um 6:30 im Schlafzimmer mit dem Klingelton bei Lautstärke 15“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos alarms: list, create, change, delete — \"wake me at 6:30 on weekdays in the bedroom with the chime at volume 15\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alarmas de Sonos: listar, crear, cambiar, eliminar — «despiértame a las 6:30 entre semana en el dormitorio con el timbre a volumen 15»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alarmes Sonos : lister, créer, modifier, supprimer — « réveille-moi à 6 h 30 en semaine dans la chambre avec le carillon au volume 15 »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sveglie Sonos: elencare, creare, modificare, eliminare — «svegliami alle 6:30 nei giorni feriali in camera con la suoneria a volume 15»"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos アラーム：一覧、作成、変更、削除 —「平日 6:30 に寝室でチャイムを音量 15 で鳴らして」"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos-alarmer: liste, opprette, endre, slette — «vekk meg 6:30 på hverdager på soverommet med signalet på volum 15»"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos-wekkers: tonen, maken, wijzigen, verwijderen — \"wek me doordeweeks om 6:30 in de slaapkamer met het belsignaal op volume 15\""
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alarmy Sonos: lista, tworzenie, zmiana, usuwanie — „obudź mnie o 6:30 w dni robocze w sypialni dzwonkiem na głośności 15”"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alarmes Sonos: listar, criar, alterar, apagar — «acorda-me às 6:30 nos dias úteis no quarto com o toque no volume 15»"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos-alarm: lista, skapa, ändra, ta bort — \"väck mig 6:30 på vardagar i sovrummet med signalen på volym 15\""
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonos 闹钟：列出、创建、修改、删除——“工作日 6:30 在卧室用提示音以 15 的音量叫醒我”"
          }
        }
      }
    },
    "helpAgentBulletBuilder" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bygge en playliste ud fra en beskrivelse, matchet først i dit bibliotek med streaming som reserve, afspillet undervejs — \"tyve indie-sange fra 90'erne fra mit bibliotek, start dem på terrassen\""
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Playlist aus einer Beschreibung bauen, zuerst in deiner Bibliothek abgeglichen mit Streaming als Ausweichlösung, Wiedergabe während des Aufbaus — „zwanzig 90er-Indie-Songs aus meiner Bibliothek, gleich auf der Terrasse starten“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build a playlist from a description, matched on your library first with a streaming fallback, playing as it goes — \"twenty 90s indie songs, from my library, start them in the deck\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crear una lista a partir de una descripción, buscada primero en tu biblioteca con streaming como respaldo, sonando mientras se construye — «veinte canciones indie de los 90 de mi biblioteca, ponlas en la terraza»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construire une playlist depuis une description, appariée d'abord dans votre bibliothèque avec repli streaming, en jouant au fur et à mesure — « vingt titres indie des années 90 de ma bibliothèque, lance-les sur la terrasse »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Costruire una playlist da una descrizione, cercata prima nella tua libreria con lo streaming di riserva, riproducendo man mano — «venti brani indie anni 90 dalla mia libreria, avviali sul terrazzo»"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "説明文からプレイリストを作成。まず自分のライブラリで照合し、見つからなければストリーミングで補い、作りながら再生 —「自分のライブラリから 90 年代インディー 20 曲、デッキで再生開始」"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bygge en spilleliste fra en beskrivelse, matchet først i biblioteket ditt med strømming som reserve, spilt underveis — «tjue indielåter fra 90-tallet fra biblioteket mitt, start dem på terrassen»"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een afspeellijst bouwen uit een beschrijving, eerst gezocht in je bibliotheek met streaming als reserve, spelend terwijl hij groeit — \"twintig indienummers uit de jaren 90 uit mijn bibliotheek, start ze op het terras\""
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budowanie playlisty z opisu, dopasowanej najpierw w Twojej bibliotece z usługą strumieniową jako rezerwą, odtwarzanej w trakcie — „dwadzieścia indie z lat 90. z mojej biblioteki, zacznij je na tarasie”"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construir uma playlist a partir de uma descrição, procurada primeiro na sua biblioteca com streaming como reserva, a tocar enquanto cresce — «vinte músicas indie dos anos 90 da minha biblioteca, começa-as no deck»"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bygga en spellista från en beskrivning, matchad först i ditt bibliotek med streaming som reserv, spelande medan den byggs — \"tjugo indielåtar från 90-talet ur mitt bibliotek, starta dem på däcket\""
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据描述构建播放列表，优先匹配你的资料库，找不到再用流媒体，边构建边播放——“二十首 90 年代独立摇滚，从我的资料库选，在露台开始放”"
          }
        }
      }
    },

    "helpQueueFollowBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når sporene skifter, bevarer køen det forrige spor øverst i visningen, så det afspillende spor ligger lige under det, og ruller videre mod slutningen af køen, når der er for få spor tilbage at rulle."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Wechsel der Titel hält die Liste den vorherigen Titel am oberen Rand der Ansicht, sodass sich der gerade gespielte Titel genau darunter befindet, und scrollt weiter zum Ende der Liste, wenn zu wenige Titel zum Weiterschieben übrig sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As tracks change, the queue keeps the previous track at the top of the view so the playing track sits just below it, and scrolls on toward the end of the queue when there are too few tracks left to slide."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A medida que cambian las pistas, la cola mantiene la pista anterior en la parte superior de la vista para que la pista en reproducción quede justo debajo, y se desplaza hacia el final de la cola cuando quedan muy pocas pistas para deslizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À mesure que les pistes changent, la file d’attente maintient la piste précédente en haut de la vue afin que la piste en cours de lecture se trouve juste en dessous, et défile vers la fin de la file d’attente lorsqu’il reste trop peu de pistes à faire glisser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando i brani cambiano, la coda mantiene il brano precedente in cima alla vista in modo che il brano in riproduzione si trovi appena sotto, e scorre verso la fine della coda quando rimangono troppo pochi brani da scorrere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トラックが切り替わると、キューは前のトラックをビューの一番上に維持し、再生中のトラックがそのすぐ下にくるようにします。スライドするトラックが残り少なくなると、キューの最後までスクロールします。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når sporene skifter, beholder køen det forrige sporet øverst i visningen slik at sporet som spilles ligger rett under det, og ruller videre mot slutten av køen når det er for få spor igjen å bla gjennom."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naarmate nummers wisselen, houdt de wachtrij het vorige nummer bovenaan de weergave zodat het momenteel afgespeelde nummer er net onder staat, en scrolt door naar het einde van de wachtrij als er te weinig nummers over zijn om te schuiven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W miarę zmiany utworów kolejka utrzymuje poprzedni utwór na górze widoku, dzięki czemu odtwarzany utwór znajduje się tuż pod nim, a następnie przewija w kierunku końca kolejki, gdy do przesunięcia pozostanie zbyt mało utworów."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À medida que as faixas mudam, a fila de espera mantém a faixa anterior no topo da vista para que a faixa em reprodução fique logo abaixo, e desloca-se em direção ao fim da fila de espera quando há muito poucas faixas para deslizar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När låtar ändras behåller kön den föregående låten överst i vyn så att den låt som spelas är precis under den, och bläddrar vidare mot slutet av kön när det finns för få låtar kvar att rulla."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当曲目发生更改时，队列将上一首曲目保持在视图顶部，以便正在播放的曲目位于其正下方；当剩下的曲目太少无法滚动时，它会向队列末尾滚动。"
          }
        }
      }
    },
    "helpQueueHeaderBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Køens sidehoved har Opdatér, et Filterfelt, Bland kø (ændrer rækkefølgen på højttaleren), en indlæsningsmenu med Choragus-playlister pr. mappe og en Historik-undermenu pr. rum (Erstat eller Tilføj), Gem som playliste…, Køhistorik og Ryd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kopfzeile der Warteschlange bietet Aktualisieren, ein Filterfeld, Warteschlange mischen (ordnet die Zeilen auf dem Lautsprecher neu), ein Lademenü der Choragus-Playlists nach Ordnern mit einem Verlaufs-Untermenü je Raum (Ersetzen oder Anhängen), Als Playlist sichern…, Warteschlangenverlauf und Leeren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The queue header holds Refresh, a Filter field, Shuffle Queue (reorders the rows on the speaker), a load menu of Choragus playlists nested by folder with a History submenu per room (Replace or Append), Save to Playlist…, Queue history and Clear."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cabecera de la cola incluye Actualizar, un campo Filtro, Mezclar cola (reordena las filas en el altavoz), un menú de carga de listas de Choragus por carpetas con un submenú Historial por habitación (Reemplazar o Añadir), Guardar en lista…, Historial de la cola y Vaciar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'en-tête de la file offre Actualiser, un champ Filtre, Mélanger la file (réordonne les lignes sur l'enceinte), un menu de chargement des playlists Choragus par dossier avec un sous-menu Historique par pièce (Remplacer ou Ajouter), Enregistrer en playlist…, Historique de la file et Effacer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'intestazione della coda contiene Aggiorna, un campo Filtro, Mescola coda (riordina le righe sul diffusore), un menu di caricamento delle playlist Choragus per cartella con un sottomenu Cronologia per stanza (Sostituisci o Aggiungi), Salva in playlist…, Cronologia coda e Svuota."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キューのヘッダーには、更新、フィルタ欄、キューをシャッフル（スピーカー上の行を並べ替え）、フォルダ別の Choragus プレイリスト読み込みメニュー（部屋ごとの履歴サブメニュー付き、置換または追加）、プレイリストに保存…、キュー履歴、消去があります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Køens topp har Oppdater, et Filter-felt, Bland kø (endrer rekkefølgen på høyttaleren), en lastemeny med Choragus-spillelister per mappe og en Historikk-undermeny per rom (Erstatt eller Legg til), Lagre som spilleliste…, Køhistorikk og Tøm."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kop van de wachtrij bevat Vernieuwen, een Filterveld, Wachtrij schudden (herordent de rijen op de speaker), een laadmenu met Choragus-afspeellijsten per map en een Geschiedenis-submenu per kamer (Vervangen of Toevoegen), Bewaar als afspeellijst…, Wachtrijgeschiedenis en Wissen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagłówek kolejki zawiera Odśwież, pole Filtr, Losuj kolejkę (zmienia kolejność wierszy na głośniku), menu wczytywania playlist Choragus według folderów z podmenu Historia dla każdego pokoju (Zastąp lub Dołącz), Zapisz jako playlistę…, Historię kolejki i Wyczyść."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cabeçalho da fila tem Atualizar, um campo Filtro, Baralhar fila (reordena as linhas na coluna), um menu de carregamento de playlists do Choragus por pasta com um submenu Histórico por sala (Substituir ou Acrescentar), Guardar em playlist…, Histórico da fila e Limpar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Köns sidhuvud har Uppdatera, ett Filterfält, Blanda kö (ordnar om raderna på högtalaren), en laddmeny med Choragus-spellistor per mapp och en Historik-undermeny per rum (Ersätt eller Lägg till), Spara som spellista…, Köhistorik och Rensa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "队列标题栏包含刷新、筛选框、随机排列队列（在扬声器上重排行）、按文件夹组织的 Choragus 播放列表加载菜单（每个房间带历史子菜单，可替换或追加）、保存为播放列表…、队列历史和清空。"
          }
        }
      }
    },
    "helpQueueHealthBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efter et sporskift kontrollerer Choragus de næste rækker for udløbne tjenestelinks, medieservere der ikke kan nås, og rækker sat i kø uden metadata. Sådanne rækker gråtones med et mærke, der forklarer problemet; striben over køen fjerner dem med ét klik. Rækker med kendt oprindelse repareres på stedet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach einem Titelwechsel prüft Choragus die nächsten Zeilen auf abgelaufene Dienst-Links, nicht erreichbare Medienserver und Zeilen ohne Metadaten. Solche Zeilen werden ausgegraut und tragen eine Plakette, die das Problem erklärt; die Leiste über der Warteschlange entfernt sie mit einem Klick. Zeilen mit bekannter Herkunft werden an Ort und Stelle repariert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After a track change, Choragus checks the next rows for expired service links, media-server hosts that cannot be reached, and rows queued without metadata. Such rows grey out with a badge that explains the problem, and the strip above the queue removes them in one click. Rows whose origin is known are repaired in place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras un cambio de pista, Choragus comprueba las siguientes filas en busca de enlaces de servicio caducados, servidores multimedia inalcanzables y filas añadidas sin metadatos. Esas filas se atenúan con una insignia que explica el problema; la franja sobre la cola las quita con un clic. Las filas cuyo origen se conoce se reparan en el sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après un changement de piste, Choragus vérifie les lignes suivantes : liens de service expirés, serveurs multimédias injoignables et lignes ajoutées sans métadonnées. Ces lignes sont grisées avec un badge qui explique le problème ; la bande au-dessus de la file les retire en un clic. Les lignes dont l'origine est connue sont réparées sur place."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo un cambio di brano, Choragus controlla le righe successive alla ricerca di link di servizio scaduti, server multimediali non raggiungibili e righe accodate senza metadati. Tali righe appaiono in grigio con un badge che spiega il problema; la barra sopra la coda le rimuove con un clic. Le righe di cui è nota l'origine vengono riparate sul posto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トラックが切り替わると、Choragus は次の行について、期限切れのサービスリンク、到達できないメディアサーバー、メタデータなしで追加された行がないかを確認します。該当する行は問題を説明するバッジ付きで灰色表示され、キュー上部のバーからワンクリックで削除できます。出所が分かっている行はその場で修復されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etter et sporbytte sjekker Choragus de neste radene for utløpte tjenestelenker, medieservere som ikke kan nås og rader lagt i kø uten metadata. Slike rader gråes ut med et merke som forklarer problemet; stripen over køen fjerner dem med ett klikk. Rader med kjent opphav repareres på stedet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na een nummerwissel controleert Choragus de volgende regels op verlopen servicelinks, onbereikbare mediaservers en regels die zonder metadata zijn toegevoegd. Zulke regels worden grijs met een badge die het probleem uitlegt; de balk boven de wachtrij verwijdert ze met één klik. Regels waarvan de herkomst bekend is, worden ter plekke hersteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po zmianie utworu Choragus sprawdza kolejne wiersze pod kątem wygasłych linków usług, nieosiągalnych serwerów multimediów i wierszy dodanych bez metadanych. Takie wiersze są wyszarzane z plakietką wyjaśniającą problem; pasek nad kolejką usuwa je jednym kliknięciem. Wiersze o znanym pochodzeniu są naprawiane na miejscu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Após uma mudança de faixa, o Choragus verifica as linhas seguintes quanto a ligações de serviço expiradas, servidores multimédia inacessíveis e linhas adicionadas sem metadados. Essas linhas ficam a cinzento com um distintivo que explica o problema; a faixa acima da fila remove-as com um clique. As linhas de origem conhecida são reparadas no local."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efter ett spårbyte kontrollerar Choragus nästa rader efter utgångna tjänstelänkar, mediaservrar som inte kan nås och rader som köats utan metadata. Sådana rader gråas ut med en bricka som förklarar problemet; remsan ovanför kön tar bort dem med ett klick. Rader vars ursprung är känt repareras på plats."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "曲目切换后，Choragus 会检查接下来的行是否存在过期的服务链接、无法访问的媒体服务器主机以及缺少元数据的行。此类行会变灰并附带说明问题的标记；队列上方的提示条可一键移除它们。来源已知的行会就地修复。"
          }
        }
      }
    },

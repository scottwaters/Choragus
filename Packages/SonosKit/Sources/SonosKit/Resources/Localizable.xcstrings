    "helpMusicServicesBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstillinger → Musik → Musiktjenester viser hver tjeneste, Sonos kender til for din husstand, plus fastgjorte tjenester, Choragus selv viser (Plex – Lokal, Apple Music, TuneIn, Calm Radio, SomaFM, suno.ai, Sonos Radio). Hver række har en farvet statusprik og en Forbind-knap, når det er relevant."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen → Musik → Musikdienste listet jeden Dienst, den Sonos für deinen Haushalt kennt, plus angepinnte Dienste, die Choragus selbst anbietet (Plex – Lokal, Apple Music, TuneIn, Calm Radio, SomaFM, suno.ai, Sonos Radio). Jede Zeile trägt einen farbigen Statuspunkt und bei Bedarf eine Verbinden-Taste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings → Music → Music Services lists every service Sonos knows about for your household, plus pinned services Choragus surfaces on its own (Plex – Local, Apple Music, TuneIn, Calm Radio, SomaFM, suno.ai, Sonos Radio). Each row carries a coloured status dot and a Connect button when applicable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes → Música → Servicios de música lista cada servicio que Sonos conoce para tu hogar, más los servicios fijados que Choragus ofrece por sí mismo (Plex – Local, Apple Music, TuneIn, Calm Radio, SomaFM, suno.ai, Sonos Radio). Cada fila lleva un punto de estado de color y un botón Conectar cuando procede."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglages → Musique → Services musicaux liste chaque service que Sonos connaît pour votre foyer, plus les services épinglés que Choragus propose de lui-même (Plex – Local, Apple Music, TuneIn, Calm Radio, SomaFM, suno.ai, Sonos Radio). Chaque ligne porte un point d'état coloré et un bouton Connecter le cas échéant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impostazioni → Musica → Servizi musicali elenca ogni servizio che Sonos conosce per la tua casa, più i servizi fissi che Choragus offre da sé (Plex – Locale, Apple Music, TuneIn, Calm Radio, SomaFM, suno.ai, Sonos Radio). Ogni riga ha un punto di stato colorato e un pulsante Connetti quando serve."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定 → ミュージック → ミュージックサービスには、Sonos が家庭で認識しているすべてのサービスに加えて、Choragus が独自に固定表示するサービス（Plex – ローカル、Apple Music、TuneIn、Calm Radio、SomaFM、suno.ai、Sonos Radio）が並びます。各行には色付きの状態ドットと、必要に応じて接続ボタンがあります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innstillinger → Musikk → Musikktjenester lister hver tjeneste Sonos kjenner for husstanden din, pluss festede tjenester Choragus viser selv (Plex – Lokal, Apple Music, TuneIn, Calm Radio, SomaFM, suno.ai, Sonos Radio). Hver rad har en farget statusprikk og en Koble til-knapp når det trengs."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instellingen → Muziek → Muziekdiensten toont elke dienst die Sonos voor je huishouden kent, plus vastgezette diensten die Choragus zelf aanbiedt (Plex – Lokaal, Apple Music, TuneIn, Calm Radio, SomaFM, suno.ai, Sonos Radio). Elke rij heeft een gekleurde statusstip en zo nodig een Verbind-knop."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawienia → Muzyka → Usługi muzyczne wymieniają każdą usługę znaną Sonos dla Twojego domu oraz przypięte usługi, które Choragus pokazuje samodzielnie (Plex – Lokalny, Apple Music, TuneIn, Calm Radio, SomaFM, suno.ai, Sonos Radio). Każdy wiersz ma kolorową kropkę stanu i w razie potrzeby przycisk Połącz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes → Música → Serviços de música lista todos os serviços que o Sonos conhece para a sua casa, mais os serviços fixos que o Choragus mostra por si (Plex – Local, Apple Music, TuneIn, Calm Radio, SomaFM, suno.ai, Sonos Radio). Cada linha tem um ponto de estado colorido e um botão Ligar quando aplicável."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inställningar → Musik → Musiktjänster listar varje tjänst Sonos känner till för ditt hushåll, plus fästa tjänster som Choragus visar själv (Plex – Lokal, Apple Music, TuneIn, Calm Radio, SomaFM, suno.ai, Sonos Radio). Varje rad har en färgad statuspunkt och en Anslut-knapp när det behövs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置 → 音乐 → 音乐服务列出 Sonos 为你的家庭识别的每项服务，以及 Choragus 自行固定显示的服务（Plex – 本地、Apple Music、TuneIn、Calm Radio、SomaFM、suno.ai、Sonos Radio）。每行有彩色状态点，需要时还有连接按钮。"
          }
        }
      }
    },

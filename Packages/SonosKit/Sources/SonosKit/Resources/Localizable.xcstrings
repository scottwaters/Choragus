    "helpLogPlaybackQueue" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afspilning og kø (PLAYBACK, QUEUE) — et nummer startede ikke, en tilføjelse blev afvist, eller numre blev sprunget over sekunder efter start. Det sidste betyder som regel udløbne sanglinks; føj numrene til igen fra tjenesten. Sonos begrænser også køen, så meget store tilføjelser stopper ved grænsen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiedergabe und Warteschlange (PLAYBACK, QUEUE) — ein Titel startete nicht, ein Hinzufügen wurde abgelehnt, oder Titel wurden Sekunden nach dem Start übersprungen. Letzteres bedeutet meist abgelaufene Songlinks eines Dienstes; die Titel erneut aus dem Dienst hinzufügen. Sonos begrenzt zudem die Warteschlange, sehr große Ergänzungen enden am Limit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playback and queue (PLAYBACK, QUEUE) — a track would not start, a queue add was refused, or tracks advanced seconds after starting. The last one usually means a service's track links have expired; re-add those tracks from the service. Sonos also caps its queue, so very large additions stop at the limit and say so here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproducción y cola (PLAYBACK, QUEUE): una pista no se inició, se rechazó una adición o las pistas se saltaron segundos después de empezar. Esto último suele indicar enlaces caducados del servicio; vuelva a añadir esas pistas desde el servicio. Sonos también limita la cola, así que las adiciones muy grandes se detienen en el límite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lecture et file d’attente (PLAYBACK, QUEUE) — un morceau n’a pas démarré, un ajout a été refusé, ou des morceaux ont été ignorés quelques secondes après leur début. Ce dernier cas signifie généralement que les liens du service ont expiré ; rajoutez ces morceaux depuis le service. Sonos limite aussi la file d’attente : les ajouts très volumineux s’arrêtent à la limite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riproduzione e coda (PLAYBACK, QUEUE): un brano non è partito, un’aggiunta è stata rifiutata o i brani sono stati saltati pochi secondi dopo l’avvio. Quest’ultimo caso indica di solito link scaduti del servizio; aggiungere di nuovo quei brani dal servizio. Sonos limita anche la coda, quindi le aggiunte molto grandi si fermano al limite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生とキュー（PLAYBACK、QUEUE）— トラックが開始しない、キューへの追加が拒否された、または開始数秒後にスキップされた場合です。最後のケースは通常、サービスの曲リンクの有効期限切れが原因です。サービスから追加し直してください。Sonosにはキューの上限があるため、大量の追加は上限で停止します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avspilling og kø (PLAYBACK, QUEUE) – et spor startet ikke, en tilføyelse ble avvist, eller spor ble hoppet over sekunder etter start. Det siste betyr som regel at tjenestens sanglenker har utløpt; legg sporene til på nytt fra tjenesten. Sonos begrenser også køen, så svært store tilføyelser stopper ved grensen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afspelen en wachtrij (PLAYBACK, QUEUE) — een nummer startte niet, een toevoeging werd geweigerd, of nummers werden seconden na de start overgeslagen. Dat laatste betekent meestal verlopen songlinks; voeg die nummers opnieuw toe vanuit de service. Sonos begrenst ook de wachtrij, dus zeer grote toevoegingen stoppen bij de limiet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odtwarzanie i kolejka (PLAYBACK, QUEUE) — utwór się nie uruchomił, dodanie zostało odrzucone albo utwory były pomijane kilka sekund po starcie. To ostatnie zwykle oznacza wygasłe linki usługi; dodaj te utwory ponownie z poziomu usługi. Sonos ogranicza też kolejkę, więc bardzo duże dodania zatrzymują się na limicie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprodução e fila (PLAYBACK, QUEUE) — uma faixa não iniciou, uma adição foi recusada, ou faixas foram ignoradas segundos após começarem. Este último caso significa normalmente ligações expiradas do serviço; volte a adicionar essas faixas a partir do serviço. O Sonos também limita a fila, pelo que adições muito grandes param no limite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppspelning och kö (PLAYBACK, QUEUE) – ett spår startade inte, ett tillägg nekades, eller spår hoppades över sekunder efter start. Det sista betyder oftast att tjänstens låtlänkar har gått ut; lägg till spåren igen från tjänsten. Sonos begränsar också kön, så mycket stora tillägg stannar vid gränsen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放与队列（PLAYBACK、QUEUE）——曲目无法开始、添加被拒绝，或曲目在开始几秒后被跳过。最后一种通常表示服务的歌曲链接已过期，请从该服务重新添加。Sonos 的队列也有上限，超大批量添加会在上限处停止。"
          }
        }
      }
    },
    "helpLogServicesAccounts" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musiktjenester (SMAPI, CATALOG, SERVICES, PLEX, LASTFM) — en tjeneste afviste et login, et token udløb, eller en tjeneste meldte sig med et andet id end før. Log ud og ind igen under Indstillinger → Musik løser de fleste tilfælde. Nogle tjenester blokerer tredjepartslogin helt; det står i indstillingerne og er ikke en fejl."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musikdienste (SMAPI, CATALOG, SERVICES, PLEX, LASTFM) — ein Dienst hat die Anmeldung abgelehnt, ein Token ist abgelaufen, oder ein Dienst hat sich mit einer anderen Kennung gemeldet. Ab- und wieder anmelden unter Einstellungen → Musik löst die meisten Fälle. Manche Dienste sperren Drittanbieter-Anmeldung generell; das steht in den Einstellungen und ist kein Fehler."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Music services (SMAPI, CATALOG, SERVICES, PLEX, LASTFM) — a service refused a sign-in, a token expired, or a service reported itself under a different identifier than before. Signing out and back in from Settings → Music resolves most of these. Some services block third-party sign-in entirely, which is noted in Settings rather than being a fault."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servicios de música (SMAPI, CATALOG, SERVICES, PLEX, LASTFM): un servicio rechazó un inicio de sesión, caducó un token o un servicio se identificó con un identificador distinto. Cerrar sesión y volver a iniciarla en Ajustes → Música resuelve la mayoría. Algunos servicios bloquean por completo el inicio de sesión de terceros, lo que se indica en Ajustes y no es un fallo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Services musicaux (SMAPI, CATALOG, SERVICES, PLEX, LASTFM) — un service a refusé une connexion, un jeton a expiré, ou un service s’est déclaré sous un identifiant différent. Se déconnecter puis se reconnecter depuis Réglages → Musique résout la plupart des cas. Certains services bloquent totalement la connexion tierce, ce qui est indiqué dans les réglages et n’est pas un défaut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servizi musicali (SMAPI, CATALOG, SERVICES, PLEX, LASTFM): un servizio ha rifiutato l’accesso, un token è scaduto o un servizio si è dichiarato con un identificatore diverso. Disconnettersi e riconnettersi da Impostazioni → Musica risolve quasi sempre. Alcuni servizi bloccano del tutto l’accesso di terze parti: è indicato nelle impostazioni e non è un difetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音楽サービス（SMAPI、CATALOG、SERVICES、PLEX、LASTFM）— サービスがサインインを拒否した、トークンが期限切れになった、またはサービスが以前と異なる識別子を報告した場合です。設定 → ミュージックでサインアウトして再度サインインすると多くは解決します。一部のサービスはサードパーティのサインインを完全に拒否しており、これは設定に表示され、不具合ではありません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musikktjenester (SMAPI, CATALOG, SERVICES, PLEX, LASTFM) – en tjeneste avviste pålogging, et token utløp, eller en tjeneste oppga en annen identifikator enn før. Logg ut og inn igjen fra Innstillinger → Musikk løser de fleste tilfeller. Enkelte tjenester blokkerer tredjepartspålogging helt; det vises i innstillingene og er ikke en feil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muziekdiensten (SMAPI, CATALOG, SERVICES, PLEX, LASTFM) — een dienst weigerde een aanmelding, een token verliep, of een dienst meldde zich met een andere identificatie dan eerder. Uit- en weer inloggen via Instellingen → Muziek lost de meeste gevallen op. Sommige diensten blokkeren aanmelding door derden volledig; dat staat in de instellingen en is geen fout."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usługi muzyczne (SMAPI, CATALOG, SERVICES, PLEX, LASTFM) — usługa odrzuciła logowanie, token wygasł albo usługa zgłosiła się pod innym identyfikatorem. Wylogowanie i ponowne zalogowanie w Ustawieniach → Muzyka rozwiązuje większość przypadków. Niektóre usługi całkowicie blokują logowanie z aplikacji innych firm; jest to widoczne w ustawieniach i nie jest błędem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serviços de música (SMAPI, CATALOG, SERVICES, PLEX, LASTFM) — um serviço recusou o início de sessão, um token expirou, ou um serviço identificou-se de forma diferente. Terminar sessão e voltar a iniciá-la em Definições → Música resolve a maioria dos casos. Alguns serviços bloqueiam totalmente o início de sessão de terceiros, o que é indicado nas definições e não é uma falha."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musiktjänster (SMAPI, CATALOG, SERVICES, PLEX, LASTFM) – en tjänst nekade inloggning, en token gick ut, eller en tjänst uppgav en annan identifierare än tidigare. Logga ut och in igen via Inställningar → Musik löser de flesta fall. Vissa tjänster blockerar tredjepartsinloggning helt, vilket visas i inställningarna och inte är ett fel."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音乐服务（SMAPI、CATALOG、SERVICES、PLEX、LASTFM）——服务拒绝登录、令牌过期，或服务报告了与之前不同的标识符。在“设置 → 音乐”中退出并重新登录通常即可解决。部分服务完全阻止第三方登录，这会在设置中标明，并非故障。"
          }
        }
      }
    },
    "helpLogSpeakerConnection" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Højttalere og netværk (TOPOLOGY, TRANSPORT, SOAP) — en højttaler svarede ikke, svarede for langsomt eller meldte en gruppe uden gyldig koordinator. Choragus reparerer det selv. Mange poster her skyldes som regel wi-fi-problemer for én højttaler, ikke en fejl i appen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lautsprecher und Netzwerk (TOPOLOGY, TRANSPORT, SOAP) — ein Lautsprecher hat nicht oder zu langsam geantwortet oder eine Gruppe ohne gültigen Koordinator gemeldet. Choragus repariert das selbst. Häufige Einträge deuten meist auf WLAN-Probleme eines Lautsprechers hin, nicht auf einen App-Fehler."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speaker and network (TOPOLOGY, TRANSPORT, SOAP) — a speaker did not answer, answered too slowly, or reported a group whose coordinator was missing. Choragus repairs these itself. Frequent entries here usually mean Wi-Fi trouble for one speaker rather than a fault in the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altavoces y red (TOPOLOGY, TRANSPORT, SOAP): un altavoz no respondió, respondió demasiado lento o informó de un grupo sin coordinador válido. Choragus lo repara solo. Muchas entradas aquí suelen indicar problemas de wifi en un altavoz, no un fallo de la aplicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enceintes et réseau (TOPOLOGY, TRANSPORT, SOAP) — une enceinte n’a pas répondu, a répondu trop lentement, ou a signalé un groupe dont le coordinateur manquait. Choragus corrige cela lui-même. Des entrées fréquentes indiquent généralement un problème de Wi-Fi sur une enceinte plutôt qu’un défaut de l’application."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diffusori e rete (TOPOLOGY, TRANSPORT, SOAP): un diffusore non ha risposto, ha risposto troppo lentamente o ha segnalato un gruppo senza coordinatore valido. Choragus corregge da solo. Voci frequenti qui indicano di solito problemi Wi-Fi di un diffusore, non un difetto dell’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スピーカーとネットワーク（TOPOLOGY、TRANSPORT、SOAP）— スピーカーが応答しない、応答が遅い、またはコーディネーターが存在しないグループを報告した場合です。Choragusが自動的に修復します。頻発する場合は、特定のスピーカーのWi-Fi環境が原因であることがほとんどです。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høyttalere og nettverk (TOPOLOGY, TRANSPORT, SOAP) – en høyttaler svarte ikke, svarte for sakte, eller meldte en gruppe uten gyldig koordinator. Choragus retter dette selv. Mange oppføringer her skyldes som regel wifi-problemer for én høyttaler, ikke en feil i appen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speakers en netwerk (TOPOLOGY, TRANSPORT, SOAP) — een speaker antwoordde niet, antwoordde te traag, of meldde een groep zonder geldige coördinator. Choragus herstelt dit zelf. Veel meldingen hier wijzen meestal op wifiproblemen bij één speaker, niet op een fout in de app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Głośniki i sieć (TOPOLOGY, TRANSPORT, SOAP) — głośnik nie odpowiedział, odpowiedział zbyt wolno albo zgłosił grupę bez prawidłowego koordynatora. Choragus naprawia to samodzielnie. Częste wpisy zwykle oznaczają problemy z Wi-Fi jednego głośnika, a nie błąd aplikacji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colunas e rede (TOPOLOGY, TRANSPORT, SOAP) — uma coluna não respondeu, respondeu demasiado devagar ou comunicou um grupo sem coordenador válido. O Choragus corrige isto sozinho. Entradas frequentes indicam normalmente problemas de Wi-Fi numa coluna e não uma falha da aplicação."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Högtalare och nätverk (TOPOLOGY, TRANSPORT, SOAP) – en högtalare svarade inte, svarade för långsamt eller rapporterade en grupp utan giltig koordinator. Choragus reparerar detta själv. Många poster här beror oftast på wifi-problem för en högtalare, inte på ett fel i appen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音箱与网络（TOPOLOGY、TRANSPORT、SOAP）——音箱未响应、响应过慢，或报告了缺少协调者的分组。Choragus 会自行修复。此类条目频繁出现通常说明某个音箱的 Wi-Fi 有问题，而非应用故障。"
          }
        }
      }
    },
    "helpLyricsTabBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sangtekster kommer fra LRCLIB. Fanen vælger automatisk den rette visning ud fra hvad kilden leverer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liedtexte stammen von LRCLIB. Der Tab wählt automatisch die passende Darstellung anhand der vorhandenen Quelle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyrics come from LRCLIB. The tab automatically picks the right rendering based on what the source provides."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las letras provienen de LRCLIB. La pestaña elige automáticamente la presentación adecuada según lo que ofrece la fuente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paroles proviennent de LRCLIB. L’onglet choisit automatiquement le rendu adapté selon la source disponible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I testi provengono da LRCLIB. La scheda sceglie automaticamente la resa adatta in base a ciò che la fonte fornisce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歌詞は LRCLIB から取得します。タブはソースの内容に応じて最適な表示を自動的に選びます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sangtekstene hentes fra LRCLIB. Fanen velger automatisk riktig visning ut fra det kilden tilbyr."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Songteksten komen van LRCLIB. Het tabblad kiest automatisch de juiste weergave op basis van wat de bron biedt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teksty pochodzą z LRCLIB. Karta automatycznie dobiera odpowiednią prezentację na podstawie tego, co dostarcza źródło."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As letras vêm do LRCLIB. O separador escolhe automaticamente a apresentação certa com base no que a fonte fornece."

    "cacheInfo" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Højttalercachen gemmer din rumopsætning for øjeblikkelig opstart. Albumcovercachen gemmer albumcovers for hurtigere gennemsyn. Begge genopbygges automatisk, når de ryddes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Lautsprecher-Cache speichert deine Raumanordnung für sofortigen Start. Der Cover-Cache speichert Albumcover für schnelleres Durchsuchen. Beide werden nach dem Leeren automatisch neu aufgebaut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speaker cache stores your room layout for instant startup. Artwork cache stores album art for faster browsing. Both rebuild automatically when cleared."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La caché de altavoces almacena la disposición de las habitaciones para un inicio instantáneo. La caché de carátulas almacena las portadas de los álbumes para una navegación más rápida. Ambas se reconstruyen automáticamente al borrarlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cache des enceintes stocke la disposition de vos pièces pour un démarrage instantané. Le cache des pochettes stocke les pochettes d’albums pour une navigation plus rapide. Les deux se reconstruisent automatiquement après effacement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cache degli altoparlanti memorizza la disposizione delle stanze per un avvio istantaneo. La cache delle copertine memorizza le copertine degli album per una navigazione più veloce. Entrambe si ricostruiscono automaticamente dopo la cancellazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スピーカーキャッシュは即座に起動できるようルームレイアウトを保存します。アートワークキャッシュはより速いブラウジングのためにアルバムアートを保存します。どちらもクリア後に自動的に再構築されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høyttalerhurtiglageret lagrer romoppsettet ditt for umiddelbar oppstart. Omslagshurtiglageret lagrer albumomslag for raskere surfing. Begge gjenoppbygges automatisk når de tømmes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De speakercache slaat je kamerindeling op voor directe opstart. De albumhoescache slaat albumhoezen op voor sneller bladeren. Beide worden automatisch opnieuw opgebouwd na het wissen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pamięć podręczna głośników przechowuje układ pokoi do natychmiastowego uruchomienia. Pamięć podręczna okładek przechowuje okładki albumów do szybszego przeglądania. Obie odbudowują się automatycznie po wyczyszczeniu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cache de caixas de som armazena o layout das salas para inicialização instantânea. O cache de capas armazena as artes dos álbuns para navegação mais rápida. Ambos são reconstruídos automaticamente ao serem limpos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Högtalarcachen lagrar din rumsuppställning för omedelbar start. Omslagscachen lagrar albumomslag för snabbare bläddring. Båda återuppbyggs automatiskt när de rensas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音箱缓存存储您的房间布局以便即时启动。封面缓存存储专辑封面以加快浏览速度。清除后两者均会自动重建。"
          }
        }
      }
    },

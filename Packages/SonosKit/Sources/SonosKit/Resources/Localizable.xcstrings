    "scrobblingIntro" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrobbling sender det, du lytter til på Sonos, til en ekstern tjeneste, så det vises i din lytteprofil. Alle indsendelser kommer fra den lokale afspilningshistorik — ingen nye netværksforespørgsler til dine højttalere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrobbling sendet, was du auf Sonos hörst, an einen externen Dienst, sodass es in deinem Hörprofil erscheint. Alle Übertragungen stammen aus dem lokalen Wiedergabeverlauf — keine zusätzlichen Netzwerkanfragen an deine Lautsprecher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrobbling sends what you listen to on Sonos to an external service so it shows up in your listening profile. All submissions come from local play history — no new network taps on your speakers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El scrobbling envía lo que escuchas en Sonos a un servicio externo para que aparezca en tu perfil de escucha. Todos los envíos provienen del historial local — sin nuevas conexiones a tus altavoces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le scrobbling envoie ce que vous écoutez sur Sonos à un service externe afin qu’il apparaîsse dans votre profil d’écoute. Toutes les soumissions proviennent de l’historique de lecture local — aucune nouvelle interception réseau sur vos enceintes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo scrobbling invia ciò che ascolti su Sonos a un servizio esterno, così da apparire nel tuo profilo di ascolto. Tutti gli invii provengono dalla cronologia locale — nessuna nuova connessione ai tuoi altoparlanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクロブリングは Sonos で再生した内容を外部サービスに送信し、リスニングプロフィールに反映します。すべての送信はローカルの再生履歴から行われ、スピーカーへの新たなネットワークアクセスは発生しません。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrobbling sender det du lytter til på Sonos til en ekstern tjeneste slik at det vises i lytteprofilen din. Alle innsendinger kommer fra lokal avspillingslogg — ingen nye nettverkshenvendelser til høyttalerne dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrobbling stuurt wat je op Sonos afspeelt naar een externe dienst, zodat het in je luisterprofiel verschijnt. Alle inzendingen komen uit de lokale afspeelgeschiedenis — geen nieuwe netwerkverbindingen met je luidsprekers."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrobbling wysyła to, czego słuchasz w Sonos, do zewnętrznej usługi, aby pojawiło się w Twoim profilu odsłuchu. Wszystkie zgłoszenia pochodzą z lokalnej historii — bez nowych połączeń sieciowych z głośnikami."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O scrobbling envia o que você ouve no Sonos para um serviço externo para aparecer no seu perfil de audição. Todos os envios vêm do histórico local — sem novas conexões de rede aos seus alto-falantes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrobbling skickar det du lyssnar på i Sonos till en extern tjänst så det visas i din lyssnarprofil. Alla överföringar kommer från den lokala uppspelningshistoriken — inga nya nätverksanslutningar till dina högtalare."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrobble 会将您在 Sonos 上收听的内容发送到外部服务，使其显示在您的收听档案中。所有提交均来自本地播放历史——不会对您的音箱发起新的网络请求。"
          }
        }
      }
    },

    "networkInfo" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hændelsesdrevet: UPnP-abonnementer i realtid. Mindre trafik, hurtigere respons. Legacy-polling: Forespørgsler hvert 2. sekund. Mere forudsigeligt på problematiske netværk. Hurtig start: Øjeblikkelig UI fra cache, verificeret i baggrunden. Klassisk: Venter på live-opdagelse. Altid nøjagtig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ereignisgesteuert: UPnP-Abonnements in Echtzeit. Weniger Datenverkehr, schnellere Reaktion. Legacy-Abfrage: Abfragen alle 2 Sekunden. Zuverlässiger in problematischen Netzwerken. Schnellstart: Sofortige UI aus dem Cache, im Hintergrund verifiziert. Klassisch: Wartet auf Live-Erkennung. Immer genau."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Event-Driven: Real-time UPnP subscriptions. Lower traffic, faster response. Legacy Polling: Queries every 2 seconds. More predictable on problematic networks. Quick Start: Instant UI from cache, verified in background. Classic: Waits for live discovery. Always accurate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basado en eventos: Suscripciones UPnP en tiempo real. Menos tráfico, respuesta más rápida. Sondeo heredado: Consultas cada 2 segundos. Más predecible en redes problemáticas. Inicio rápido: Interfaz instantánea desde la caché, verificada en segundo plano. Clásico: Espera la detección en vivo. Siempre preciso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Événementiel : Abonnements UPnP en temps réel. Moins de trafic, réponse plus rapide. Interrogation classique : Requêtes toutes les 2 secondes. Plus prévisible sur les réseaux problématiques. Démarrage rapide : Interface instantanée depuis le cache, vérifiée en arrière-plan. Classique : Attend la découverte en direct. Toujours précis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basato su eventi: Abbonamenti UPnP in tempo reale. Meno traffico, risposta più rapida. Polling tradizionale: Interrogazioni ogni 2 secondi. Più prevedibile su reti problematiche. Avvio rapido: Interfaccia istantanea dalla cache, verificata in background. Classico: Attende il rilevamento in tempo reale. Sempre preciso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イベント駆動: リアルタイムのUPnPサブスクリプション。トラフィックが少なく、応答が速い。レガシーポーリング: 2秒ごとにクエリ。問題のあるネットワークでより予測可能。クイックスタート: キャッシュから即座にUIを表示、バックグラウンドで検証。クラシック: ライブ検出を待機。常に正確。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hendelsesdrevet: UPnP-abonnementer i sanntid. Mindre trafikk, raskere respons. Eldre avspørring: Forespørsler hvert 2. sekund. Mer forutsigbart på problematiske nettverk. Hurtigstart: Umiddelbar UI fra hurtiglager, verifisert i bakgrunnen. Klassisk: Venter på direkteoppdagelse. Alltid nøyaktig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebeurtenisgestuurd: Realtime UPnP-abonnementen. Minder verkeer, snellere respons. Legacy-polling: Vraagt elke 2 seconden. Voorspelbaarder op problematische netwerken. Snelle start: Directe UI uit cache, geverifieerd op de achtergrond. Klassiek: Wacht op live-detectie. Altijd nauwkeurig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdarzeniowe: Subskrypcje UPnP w czasie rzeczywistym. Mniejszy ruch, szybsza odpowiedź. Starsze odpytywanie: Zapytania co 2 sekundy. Bardziej przewidywalne w problematycznych sieciach. Szybki start: Natychmiastowy interfejs z pamięci podręcznej, weryfikowany w tle. Klasyczny: Czeka na wykrycie na żywo. Zawsze dokładny."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientado a eventos: Assinaturas UPnP em tempo real. Menos tráfego, resposta mais rápida. Polling legácio: Consultas a cada 2 segundos. Mais previsível em redes problemáticas. Início rápido: Interface instantânea do cache, verificada em segundo plano. Clássico: Aguarda descoberta ao vivo. Sempre preciso."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Händelsestyrt: UPnP-prenumerationer i realtid. Mindre trafik, snabbare svar. Äldre avfrågning: Förfrågningar var 2:a sekund. Mer förutsägbart på problematiska nätverk. Snabbstart: Direkt UI från cache, verifierat i bakgrunden. Klassisk: Väntar på liveupptäckt. Alltid korrekt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "事件驱动: 实时 UPnP 订阅。更低流量，更快响应。传统轮询: 每 2 秒查询一次。在问题网络上更可预测。快速启动: 从缓存即时加载界面，后台验证。经典: 等待实时发现。始终准确。"
          }
        }
      }
    },
    "networkUnstableAdvisory" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Netværksforbindelsen skifter gentagne gange – højttalere kan forsvinde. Brug én forbindelse (Wi-Fi eller Ethernet)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Netzwerkverbindung wechselt wiederholt — Lautsprecher können ausfallen. Verwende eine einzige Verbindung (WLAN oder Ethernet)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Network connection is switching repeatedly — speakers may drop. Use a single connection (Wi-Fi or Ethernet)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conexión de red cambia repetidamente: los altavoces pueden desaparecer. Usa una sola conexión (wifi o Ethernet)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion réseau change sans cesse — des enceintes peuvent disparaître. Utilisez une seule connexion (Wi-Fi ou Ethernet)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connessione di rete cambia di continuo: gli altoparlanti possono sparire. Usa una sola connessione (Wi-Fi o Ethernet)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットワーク接続が繰り返し切り替わっています。スピーカーが消えることがあります。単一の接続（Wi-Fi またはイーサネット）を使用してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nettverkstilkoblingen veksler gjentatte ganger – høyttalere kan forsvinne. Bruk én tilkobling (Wi-Fi eller Ethernet)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De netwerkverbinding wisselt herhaaldelijk — speakers kunnen wegvallen. Gebruik één verbinding (wifi of ethernet)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połączenie sieciowe wielokrotnie się przełącza — głośniki mogą znikać. Użyj jednego połączenia (Wi-Fi lub Ethernet)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ligação de rede muda repetidamente — as colunas podem desaparecer. Use uma única ligação (Wi-Fi ou Ethernet)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nätverksanslutningen växlar upprepade gånger – högtalare kan försvinna. Använd en enda anslutning (Wi-Fi eller Ethernet)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "网络连接反复切换，扬声器可能消失。请使用单一连接（Wi-Fi 或以太网）。"
          }
        }
      }
    },

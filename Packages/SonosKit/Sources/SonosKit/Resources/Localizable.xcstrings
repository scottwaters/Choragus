    "mcpSkipConfirmHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spring bekræftelser over lader den assistent tømme køer, slette playlister, forudindstillinger og alarmer, opdele alle grupper og genindeksere uden bekræftelsestrinnet. Kun til en assistent, du stoler på til at handle alene."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestätigungen überspringen erlaubt diesem Assistenten, Warteschlangen zu leeren, Playlists, Voreinstellungen und Wecker zu löschen, alle Gruppen zu trennen und neu zu indizieren, ohne den Bestätigungsschritt. Nur für einen Assistenten, dem du eigenständiges Handeln zutraust."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skip confirmations lets that assistant clear queues, delete playlists, presets and alarms, split all groups and re-index without the confirm step. Only for an assistant you trust to act alone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omitir confirmaciones permite a ese asistente vaciar colas, eliminar listas, ajustes preestablecidos y alarmas, separar todos los grupos y reindexar sin el paso de confirmación. Solo para un asistente en el que confíes para actuar solo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignorer les confirmations laisse cet assistant vider les files, supprimer playlists, préréglages et alarmes, séparer tous les groupes et réindexer sans l'étape de confirmation. Seulement pour un assistant à qui vous faites confiance pour agir seul."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta le conferme consente a quell'assistente di svuotare code, eliminare playlist, preset e sveglie, separare tutti i gruppi e reindicizzare senza il passaggio di conferma. Solo per un assistente di cui ti fidi ad agire da solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認を省略すると、そのアシスタントはキューの消去、プレイリスト・プリセット・アラームの削除、全グループの解除、再インデックスを確認なしで行えます。単独で行動させて構わないアシスタントにのみ使ってください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hopp over bekreftelser lar den assistenten tømme køer, slette spillelister, forvalg og alarmer, dele alle grupper og indeksere på nytt uten bekreftelsestrinnet. Bare for en assistent du stoler på til å handle alene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevestigingen overslaan laat die assistent wachtrijen wissen, afspeellijsten, voorinstellingen en wekkers verwijderen, alle groepen splitsen en opnieuw indexeren zonder bevestigingsstap. Alleen voor een assistent die je zelfstandig laat handelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomijaj potwierdzenia pozwala temu asystentowi czyścić kolejki, usuwać playlisty, ustawienia wstępne i alarmy, rozdzielać wszystkie grupy i ponownie indeksować bez kroku potwierdzenia. Tylko dla asystenta, któremu ufasz, że działa sam."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saltar confirmações deixa esse assistente limpar filas, apagar playlists, predefinições e alarmes, separar todos os grupos e reindexar sem o passo de confirmação. Só para um assistente em quem confia para agir sozinho."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoppa över bekräftelser låter den assistenten rensa köer, radera spellistor, förval och alarm, dela alla grupper och indexera om utan bekräftelsesteget. Bara för en assistent du litar på att agera själv."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跳过确认允许该助手在无需确认步骤的情况下清空队列、删除播放列表、预设和闹钟、拆分所有分组并重新索引。仅用于你信任其独立行动的助手。"
          }
        }
      }
    },

    "helpSpeakersTabBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fanen Højttalere viser alle opdagede højttalere med deres rum, model, IP-adresse, systemgeneration, firmware, grupperolle og antal hændelsesabonnementer. Kopier alt eksporterer øjebliksbilledet til fejlfinding."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Tab Lautsprecher listet jeden entdeckten Lautsprecher mit Raum, Modell, IP-Adresse, Systemgeneration, Firmware, Gruppenrolle und Ereignis-Abonnementanzahl auf. Alle kopieren exportiert den Schnappschuss zur Fehlerbehebung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Speakers tab lists every discovered speaker with its room, model, IP address, system generation, firmware, group role and event-subscription count. Copy All exports the snapshot for troubleshooting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pestaña Altavoces enumera todos los altavoces descubiertos con su habitación, modelo, dirección IP, generación de sistema, firmware, rol de grupo y recuento de suscripciones de eventos. Copiar todo exporta la instantánea para la resolución de problemas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’onglet Haut-parleurs répertorie chaque haut-parleur détecté avec sa pièce, son modèle, son adresse IP, la génération du système, son firmware, son rôle de groupe et le nombre d’abonnements aux événements. Tout copier exporte l’instantané à des fins de dépannage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La scheda Altoparlanti elenca ogni altoparlante rilevato con la sua stanza, modello, indirizzo IP, generazione del sistema, firmware, ruolo del gruppo e conteggio delle sottoscrizioni agli eventi. Copia tutto esporta l'istantanea per la risoluzione dei problemi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「スピーカー」タブには、検出されたすべてのスピーカーがその部屋、モデル、IPアドレス、システム世代、ファームウェア、グループの役割、イベントサブスクリプション数とともに一覧表示されます。「すべてコピー」を使用すると、トラブルシューティング用のスナップショットをエクスポートできます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høyttalere-fanen lister opp hver oppdaget høyttaler med rom, modell, IP-adresse, systemgenerasjon, fastvare, grupperolle og antall hendelsesabonnementer. Kopier alt eksporterer øyeblikksbildet for feilsøking."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het tabblad Speakers toont elke ontdekte speaker met de bijbehorende kamer, het model, het IP-adres, de systeemgeneratie, de firmware, de groepsrol en het aantal event-abonnementen. Met Kopieer alles exporteer je de momentopname voor probleemoplossing."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karta Głośniki wyświetla listę wszystkich wykrytych głośników wraz z ich pokojem, modelem, adresem IP, generacją systemu, oprogramowaniem układowym, rolą w grupie i liczbą subskrypcji zdarzeń. Kopiuj wszystko eksportuje migawkę do celów rozwiązywania problemów."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O separador Altifalantes lista todos os altifalantes descobertos com a sua divisão, modelo, endereço IP, geração de sistema, firmware, função de grupo e contagem de subscrições de eventos. Copiar tudo exporta o instantâneo para a resolução de problemas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fliken Högtalare listar varje upptäckt högtalare med dess rum, modell, IP-adress, systemgeneration, fast programvara, grupproll och antal händelseprenumerationer. Kopiera alla exporterar ögonblicksbilden för felsökning."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“扬声器”标签页列出了每个发现的扬声器及其所在房间、型号、IP 地址、系统代数、固件、组角色和事件订阅计数。“拷贝全部”可导出快照以便进行故障排除。"
          }
        }
      }
    },
    "helpStatusDotsBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikken ved siden af hvert tjenestenavn fortæller, hvordan Choragus forventer, at godkendelsen vil opføre sig for den tjeneste:"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Punkt neben jedem Dienstnamen zeigt an, wie Choragus die Authentifizierung für diesen Dienst erwartet:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The dot beside each service name says how Choragus expects authentication to behave for that service:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El punto junto al nombre de cada servicio indica cómo espera Choragus que se comporte la autenticación de ese servicio:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pastille à côté de chaque nom de service indique comment Choragus s’attend à ce que l’authentification se comporte pour ce service :"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pallino accanto a ogni nome di servizio indica come Choragus prevede che si comporti l’autenticazione per quel servizio:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各サービス名の横にあるドットは、Choragus がそのサービスの認証の動作をどう見ているかを示します："
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikken ved siden av hvert tjenestenavn forteller hvordan Choragus forventer at autentiseringen oppfører seg for den tjenesten:"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De stip naast elke dienstnaam geeft aan hoe Choragus verwacht dat authenticatie zich voor die dienst gedraagt:"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kropka obok każdej nazwy usługi mówi, jak Choragus oczekuje, że będzie działać uwierzytelnianie dla tej usługi:"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ponto ao lado de cada nome de serviço indica como o Choragus espera que a autenticação se comporte para esse serviço:"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pricken bredvid varje tjänstnamn anger hur Choragus förväntar sig att autentiseringen ska bete sig för den tjänsten:"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个服务名称旁边的点表示 Choragus 预期该服务的身份验证行为："
          }
        }
      }
    },

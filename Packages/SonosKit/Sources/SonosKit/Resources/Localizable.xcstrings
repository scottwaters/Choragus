    "mcpMaxVolumeHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det højeste niveau en assistent må sætte. Højere anmodninger sænkes til dette niveau."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die höchste Lautstärke, die ein Assistent einstellen darf. Höhere Anfragen werden auf diesen Wert gesenkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The loudest an assistant may set any speaker. Requests above it are lowered to this level."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nivel más alto que un asistente puede fijar. Las peticiones superiores se reducen a este nivel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le niveau maximal qu'un assistant peut régler. Les demandes supérieures sont ramenées à ce niveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il livello più alto che un assistente può impostare. Le richieste superiori vengono ridotte a questo valore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アシスタントが設定できる最大音量。これを超える要求はこの値に下げられます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det høyeste nivået en assistent kan sette. Høyere forespørsler senkes til dette nivået."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het hoogste niveau dat een assistent mag instellen. Hogere verzoeken worden tot dit niveau verlaagd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najwyższy poziom, jaki może ustawić asystent. Wyższe żądania są obniżane do tego poziomu."
          }
        },
        "pt" : {
          "stringUnit" : {

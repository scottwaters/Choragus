        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barra dei menu: un elemento di stato con copertina, titolo, precedente / riproduci-pausa / successivo, un cursore del volume, un pulsante stella e Apri Choragus, per controllare senza la finestra principale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバー：アートワーク、タイトル、前へ／再生・一時停止／次へ、音量スライダー、スターボタン、Choragus を開く、を備えたステータス項目で、メインウィンドウなしで操作できます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menylinjen: et statuselement med omslag, tittel, forrige / spill-pause / neste, en volumglider, en stjerneknapp og Åpne Choragus, for styring uten hovedvinduet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menubalk: een statusitem met hoes, titel, vorige / afspelen-pauze / volgende, een volumeschuif, een sterknop en Open Choragus, om te bedienen zonder het hoofdvenster."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasek menu: element stanu z okładką, tytułem, poprzedni / odtwórz-pauza / następny, suwakiem głośności, przyciskiem gwiazdki i Otwórz Choragus, do sterowania bez głównego okna."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barra de menus: um item de estado com capa, título, anterior / reproduzir-pausa / seguinte, um cursor de volume, um botão de estrela e Abrir Choragus, para controlar sem a janela principal."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyraden: ett statusobjekt med omslag, titel, föregående / spela-paus / nästa, ett volymreglage, en stjärnknapp och Öppna Choragus, för styrning utan huvudfönstret."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "菜单栏：一个状态项，含封面、标题、上一首 / 播放暂停 / 下一首、音量滑块、星标按钮和打开 Choragus，无需主窗口即可控制。"
          }
        }
      }
    },
    "helpBulletMouseControls" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mus: rul hjulet over Afspilles nu for at ændre lydstyrke; midterklik for at slå lyden i gruppen til eller fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maus: Scrolle das Mausrad über „Jetzt läuft“, um die Lautstärke zu ändern; Mittelklick stummschaltet die Gruppe oder hebt die Stummschaltung auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mouse: scroll the wheel over Now Playing to change volume; middle-click to mute or unmute the group."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ratón: desplaza la rueda sobre «En reproducción» para cambiar el volumen; clic central para silenciar o activar el grupo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Souris : faites défiler la molette sur la lecture en cours pour modifier le volume ; cliquez avec le bouton central pour activer ou désactiver la sourdine du groupe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mouse: scorri la rotella sopra «In riproduzione» per cambiare il volume; clic centrale per silenziare o riattivare il gruppo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マウス：「今回の再生」上でホイールをスクロールして音量を変更します。中クリックでグループのミュートを切り替えます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mus: rull hjulet over Spilles nå for å endre volum; midtklikk for å dempe eller oppheve demping for gruppen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muis: scroll met het wiel over Now Playing om het volume te wijzigen; middelklik om de groep te dempen of het dempen op te heffen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mysz: przewiń kółkiem nad „Teraz odtwarzane”, aby zmienić głośność; środkowy przycisk wycisza lub włącza dźwięk grupy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rato: rode a roda do rato sobre «A reproduzir» para alterar o volume; clique no botão do meio para silenciar ou ativar o som do grupo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mus: scrolla hjulet över Spelas nu för att ändra volym; mittenklick för att tysta eller slå på ljudet i gruppen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鼠标：在「正在播放」上滚动滚轮以调整音量；中键点击可静音或取消静音组。"
          }
        }
      }
    },

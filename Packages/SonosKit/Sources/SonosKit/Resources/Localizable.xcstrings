    "mediaServersExplainer" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gennemse og afspil musik fra UPnP/DLNA-servere på netværket. Numre afspilles direkte fra serveren; afspilning og covers kræver, at højttalerne kan nå serverens adresse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musik von UPnP/DLNA-Servern im Netzwerk durchsuchen und abspielen. Titel werden direkt vom Server abgespielt; Wiedergabe und Cover setzen voraus, dass die Lautsprecher die Serveradresse erreichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Browse and play music from UPnP/DLNA servers on your network. Tracks play directly from the server; playback and artwork require the speakers to reach the server's address."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explore y reproduzca música de servidores UPnP/DLNA de su red. Las pistas se reproducen directamente desde el servidor; la reproducción y las carátulas requieren que los altavoces alcancen la dirección del servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parcourez et lisez la musique des serveurs UPnP/DLNA de votre réseau. Les pistes sont lues directement depuis le serveur ; la lecture et les pochettes nécessitent que les enceintes atteignent l'adresse du serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sfoglia e riproduci musica dai server UPnP/DLNA della rete. I brani vengono riprodotti direttamente dal server; riproduzione e copertine richiedono che i diffusori raggiungano l'indirizzo del server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットワーク上の UPnP/DLNA サーバの音楽をブラウズして再生します。トラックはサーバから直接再生されます。再生とアートワークにはスピーカーがサーバのアドレスに到達できる必要があります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bla gjennom og spill musikk fra UPnP/DLNA-servere på nettverket. Spor spilles direkte fra serveren; avspilling og omslag krever at høyttalerne når serverens adresse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blader door en speel muziek van UPnP/DLNA-servers in uw netwerk. Nummers spelen rechtstreeks vanaf de server; afspelen en albumhoezen vereisen dat de speakers het serveradres kunnen bereiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeglądaj i odtwarzaj muzykę z serwerów UPnP/DLNA w sieci. Utwory są odtwarzane bezpośrednio z serwera; odtwarzanie i okładki wymagają, aby głośniki mogły połączyć się z adresem serwera."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navegue e reproduza música de servidores UPnP/DLNA na rede. As faixas tocam diretamente do servidor; a reprodução e as capas exigem que as colunas alcancem o endereço do servidor."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bläddra och spela musik från UPnP/DLNA-servrar i nätverket. Spår spelas direkt från servern; uppspelning och omslag kräver att högtalarna når serverns adress."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浏览并播放网络上 UPnP/DLNA 服务器中的音乐。曲目直接从服务器播放；播放和封面要求音箱能够访问服务器地址。"
          }
        }
      }
    },

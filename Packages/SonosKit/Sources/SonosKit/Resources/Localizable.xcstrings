    "helpShortcutActionInput" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg indgang: afspil en højttalers line-in- eller tv-indgang i et rum. At vælge en indgang, der allerede spiller, igen er harmløst, så handlingen kan køre efter en tidsplan."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eingang wählen: den Line-In- oder TV-Eingang eines Lautsprechers in einem Raum abspielen. Das erneute Wählen eines bereits laufenden Eingangs ist unschädlich und kann daher zeitgesteuert laufen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select Input: play a speaker's line-in or TV input in a room. Re-selecting an input that is already playing is harmless, so it can run on a schedule."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleccionar entrada: reproducir la entrada de línea o TV de un altavoz en una habitación. Volver a seleccionar una entrada que ya suena no tiene efecto, así que puede ejecutarse de forma programada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionner l'entrée : lire l'entrée ligne ou TV d'une enceinte dans une pièce. Resélectionner une entrée déjà en lecture est sans effet, l'action peut donc s'exécuter selon un horaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleziona ingresso: riprodurre l'ingresso line-in o TV di un diffusore in una stanza. Riselezionare un ingresso già in riproduzione non ha effetti, quindi può essere eseguito a orari programmati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入力を選択: スピーカーのライン入力または TV 入力を部屋で再生します。再生中の入力を再度選択しても影響はないため、スケジュール実行に使えます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg inngang: spill en høyttalers line-in- eller TV-inngang i et rom. Å velge en inngang som allerede spiller på nytt er ufarlig, så handlingen kan kjøres etter en tidsplan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingang kiezen: de line-in- of tv-ingang van een speaker in een kamer afspelen. Een ingang die al speelt opnieuw kiezen is onschadelijk, dus dit kan volgens een schema draaien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz wejście: odtwarzaj wejście line-in lub TV głośnika w pokoju. Ponowny wybór już odtwarzanego wejścia jest nieszkodliwy, więc akcja może działać według harmonogramu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecionar entrada: reproduzir a entrada de linha ou TV de uma coluna numa divisão. Voltar a selecionar uma entrada já em reprodução é inofensivo, pelo que pode correr de forma agendada."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj ingång: spela en högtalares line-in- eller TV-ingång i ett rum. Att välja om en ingång som redan spelar är ofarligt, så åtgärden kan köras enligt schema."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择输入：在房间中播放某个扬声器的线路输入或电视输入。重新选择正在播放的输入没有副作用，因此可以按计划运行。"
          }
        }
      }
    },
    "helpShortcutActionPlay" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afspil, Pause, Skift afspil/pause: genoptag eller sæt et rum på pause."
          }

    "lyricsGlobalOffsetHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forskyder sangteksttimingen for hvert nummer med dette antal sekunder. Negative værdier trækker teksten frem; positive værdier forsinker den. Justeringer per nummer med ± i sangtekstpanelet anvendes oven på denne basislinje. Standard −2,0 s kompenserer for den typiske Sonos-positionspollingforsinkelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschiebt das Liedtext-Timing aller Titel um diese Sekundenzahl. Negative Werte ziehen den Text vor, positive Werte verzögern ihn. Pro-Titel ±-Anpassungen im Liedtext-Bereich werden zusätzlich zu dieser Grundeinstellung angewendet. Standard −2,0 s gleicht die typische Sonos-Positionsabfrageverzögerung aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shifts every track's lyric timing by this many seconds. Negative values pull lyrics earlier; positive values delay them. Per-track ± adjustments in the lyrics panel apply on top of this baseline. Default −2.0 s compensates for typical Sonos position-poll lag."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desplaza la sincronización de la letra de cada pista en estos segundos. Los valores negativos adelantan la letra; los positivos la retrasan. Los ajustes ± por pista en el panel de letras se aplican sobre esta base. El valor predeterminado −2,0 s compensa la latencia habitual de sondeo de posición de Sonos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décale la synchronisation des paroles de chaque titre de ce nombre de secondes. Les valeurs négatives avancent les paroles ; les valeurs positives les retardent. Les ajustements ± par titre dans le panneau Paroles s’appliquent en plus de cette base. La valeur par défaut −2,0 s compense le décalage typique du sondage de position Sonos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta la sincronizzazione del testo di ogni brano di questi secondi. I valori negativi anticipano il testo; quelli positivi lo ritardano. Le regolazioni ± per brano nel pannello Testo si applicano in aggiunta a questa base. Il valore predefinito −2,0 s compensa la consueta latenza di polling della posizione Sonos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての曲の歌詞タイミングをこの秒数だけずらします。負の値は歌詞を早めに、正の値は遅らせます。歌詞パネルの曲ごとの ± 調整はこの基準値に加算されます。デフォルトの −2.0 秒は、一般的な Sonos の位置ポーリング遅延を補正します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forskyver sangteksttimingen for hver låt med dette antall sekunder. Negative verdier trekker teksten frem; positive verdier forsinker den. Justeringer per låt med ± i sangtekstpanelet legges til denne baselinjen. Standard −2,0 s kompenserer for typisk Sonos-posisjonspolling-forsinkelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschuift de timing van songteksten voor elke track met dit aantal seconden. Negatieve waarden trekken songteksten naar voren; positieve waarden vertragen ze. ±-Aanpassingen per track in het songtekstpaneel komen bovenop deze basisinstelling. Standaard −2,0 s compenseert de gebruikelijke Sonos-positiepollvertraging."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuwa synchronizację tekstu każdego utworu o tę liczbę sekund. Wartości ujemne wyświetlają tekst wcześniej; dodatnie opóźniają go. Regulacje ± dla pojedynczych utworów w panelu tekstu są stosowane na tej podstawie. Domyślnie −2,0 s kompensuje typowe opóźnienie odpytywania pozycji Sonos."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desloca a sincronização da letra de cada faixa este número de segundos. Valores negativos antecipam a letra; valores positivos atrasam-na. Ajustes ± por faixa no painel de letras aplicam-se sobre esta linha de base. O padrão −2,0 s compensa a latência típica de sondagem de posição do Sonos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förskjuter sångtextens timing för varje låt med detta antal sekunder. Negativa värden tidigarelägger texten; positiva värden fördröjer den. Per låt-justeringar med ± i sångtextspanelen läggs till denna baslinje. Standard −2,0 s kompenserar för Sonos vanliga positionspollnings-fördröjning."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将每首曲目的歌词时间偏移指定秒数。负值使歌词提前显示；正值则延后。歌词面板中的每曲 ± 调整将在此基准之上叠加。默认 −2.0 秒可补偿 Sonos 位置轮询的典型延迟。"
          }
        }
      }
    },

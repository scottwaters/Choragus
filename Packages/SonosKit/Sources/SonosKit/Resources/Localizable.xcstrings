    "diagEncryptedReportSecurityHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriver en krypteret pakke til Downloads og åbner GitHubs private sikkerhedsformular. Træk filen til feltet Beskrivelse. Til token-lækage, sandbox eller kodeudførsel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibt ein verschlüsseltes Paket in deinen Downloads-Ordner und öffnet das private Sicherheitshinweis-Formular von GitHub. Ziehe die Datei in das Beschreibungsfeld. Für Token-Leck-, Sandbox- oder Code-Ausführungs-Probleme."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Writes an encrypted bundle to your Downloads folder and opens GitHub’s private security advisory form. Drag the file into the Description field. Use this for token-leakage, sandbox, or code-execution-class issues."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe un paquete cifrado en Descargas y abre el formulario privado de avisos de seguridad de GitHub. Arrastra el archivo al campo Descripción. Para fugas de token, sandbox o ejecución de código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrit un lot chiffré dans Téléchargements et ouvre le formulaire d’avis de sécurité privé de GitHub. Glissez le fichier dans le champ Description. Pour les fuites de jeton, le sandbox, l’exécution de code."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrive un pacchetto cifrato in Download e apre il modulo privato di avviso di sicurezza di GitHub. Trascina il file nel campo Descrizione. Per problemi di fuga di token, sandbox o esecuzione di codice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗号化されたバンドルをダウンロードに書き出し、GitHubの非公開セキュリティアドバイザリーフォームを開きます。ファイルを説明欄にドラッグしてください。トークン漏洩、サンドボックス、コード実行系の問題向けです。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriver en kryptert pakke til Nedlastinger og åpner GitHubs private sikkerhetsformular. Dra filen til Beskrivelse-feltet. For token-lekkasje, sandbox eller kodekørings-problemer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schrijft een versleuteld pakket naar Downloads en opent het privé beveiligingsadviesformulier van GitHub. Sleep het bestand in het beschrijvingsveld. Voor token-lekken, sandbox- of code-uitvoeringsproblemen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuje zaszyfrowany pakiet w Pobranych i otwiera prywatny formularz porady bezpieczeństwa GitHub. Przeciągnij plik do pola Opis. Do problemów z wyciekiem tokenów, sandboxem lub wykonywaniem kodu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escreve um pacote cifrado em Transferências e abre o formulário privado de aviso de segurança do GitHub. Arraste o ficheiro para o campo Descrição. Para fugas de token, sandbox ou execução de código."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriver ett krypterat paket till Nedladdningar och öppnar GitHubs privata säkerhetsformulär. Dra filen till fältet Beskrivning. För token-läckage-, sandbox- eller kodexekveringsproblem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将加密的包写入“下载”，并打开 GitHub 的私密安全咨询表单。将文件拖到“说明”字段。用于令牌泄露、沙盒或代码执行类问题。"
          }
        }
      }
    },

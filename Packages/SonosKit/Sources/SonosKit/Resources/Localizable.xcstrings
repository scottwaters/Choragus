    "slimesDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slim genafspiller din faktiske lytterækkefølge gennem top-kunstnere. Farve = tjeneste. Tætte kanter = kunstnerpar, du kæder sammen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schleime spielen deine tatsächliche Hörreihenfolge durch Top-Künstler ab. Farbe = Dienst. Dichte Kanten = Künstlerpaare, die du verknüpfst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slimes replay your actual listening order through top artists. Colour = service. Dense edges = artist pairs you chain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los limos reproducen tu orden real de escucha a través de los artistas top. Color = servicio. Aristas densas = pares de artistas que encadenas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les « slimes » rejouent votre ordre d’écoute réel à travers les artistes principaux. Couleur = service. Bords denses = paires d’artistes que vous enchaînez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli slime ripercorrono il tuo ordine di ascolto reale tra gli artisti top. Colore = servizio. Bordi densi = coppie di artisti che incateni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スライムは実際の聴取順をトップアーティストを通して再現します。色 = サービス。密なエッジ = 連続したアーティストのペア。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slim spiller av din faktiske lytterekkefølge gjennom topp-artister. Farge = tjeneste. Tette kanter = artistpar du lenker sammen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slijmen spelen je werkelijke luistervolgorde door topartiesten af. Kleur = dienst. Dichte randen = artiestenparen die je aaneenrijgt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Śluzowate odtwarzają Twoją rzeczywistą kolejność słuchania przez topowych artystów. Kolor = usługa. Gęste krawędzie = pary artystów, których łączysz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As lesmas reproduzem a sua ordem real de escuta através dos top artistas. Cor = serviço. Arestas densas = pares de artistas que encadeia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slem spelar upp din faktiska lyssningsordning genom topp-artister. Färg = tjänst. Täta kanter = artistpar du kedjar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "滑行路径重现您通过顶尖艺术家的实际职听顺序。颜色 = 服务。密集边缘 = 您连按的艺术家对。"
          }
        }
      }
    },

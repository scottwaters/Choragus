    "daysConstellationDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver celle = 1 dag. Prikker = afspilninger, farve = tjeneste. Skyderen går gennem historikken."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Zelle = 1 Tag. Punkte = Wiedergaben, Farbe = Dienst. Der Schieberegler durchläuft den Verlauf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each cell = 1 day. Dots = plays, colour = service. Scrubber walks through history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada celda = 1 día. Puntos = reproducciones, color = servicio. El control recorre el historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque cellule = 1 jour. Points = lectures, couleur = service. Le curseur parcourt l’historique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni cella = 1 giorno. Punti = riproduzioni, colore = servizio. Il cursore percorre la cronologia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各セル = 1日。ドット = 再生、色 = サービス。スクラバーが履歴を辿ります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver celle = 1 dag. Prikker = avspillinger, farge = tjeneste. Skrubberen går gjennom historikken."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke cel = 1 dag. Stippen = afspelingen, kleur = dienst. Schuifregelaar loopt door de geschiedenis."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda komórka = 1 dzień. Kropki = odtworzenia, kolor = usługa. Suwak przechodzi przez historię."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada célula = 1 dia. Pontos = reproduções, cor = serviço. O cursor percorre o histórico."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje cell = 1 dag. Prickar = uppspelningar, färg = tjänst. Skrubbaren går genom historiken."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个格子 = 1 天。点 = 播放，颜色 = 服务。滑块漫步于历史。"
          }
        }
      }
    },

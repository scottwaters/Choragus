    "seedSpeakerAddressesHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Én IP-adresse pr. linje, til netværk der blokerer den automatiske søgning. Én højttaler er som regel nok – resten af systemet findes via den. Træder i kraft ved næste opdatering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine IP-Adresse pro Zeile, für Netzwerke, die die automatische Suche blockieren. Ein Lautsprecher genügt meist — die übrigen werden über ihn gefunden. Wirksam beim nächsten Aktualisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One IP address per line, for networks that block the automatic search. One speaker is usually enough — the rest of the system is found through it. Takes effect on the next refresh."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una dirección IP por línea, para redes que bloquean la búsqueda automática. Suele bastar con un altavoz: el resto del sistema se encuentra a través de él. Surte efecto en la próxima actualización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une adresse IP par ligne, pour les réseaux qui bloquent la recherche automatique. Une seule enceinte suffit généralement : le reste du système est trouvé par son intermédiaire. Prend effet à la prochaine actualisation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un indirizzo IP per riga, per le reti che bloccano la ricerca automatica. Di solito basta un diffusore: il resto del sistema viene trovato tramite quello. Ha effetto al prossimo aggiornamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動検索を遮断するネットワーク向けに、1行につき1つのIPアドレスを入力します。通常はスピーカー1台で十分です。残りのシステムはそのスピーカー経由で検出されます。次回の更新時に有効になります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Én IP-adresse per linje, for nettverk som blokkerer det automatiske søket. Én høyttaler holder som regel – resten av systemet finnes via den. Trår i kraft ved neste oppdatering."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén IP-adres per regel, voor netwerken die de automatische zoekopdracht blokkeren. Eén speaker volstaat meestal — de rest van het systeem wordt via die speaker gevonden. Wordt actief bij de volgende verversing."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden adres IP w wierszu, dla sieci blokujących automatyczne wyszukiwanie. Zwykle wystarczy jeden głośnik — pozostałe zostaną znalezione za jego pośrednictwem. Działa po następnym odświeżeniu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um endereço IP por linha, para redes que bloqueiam a procura automática. Normalmente basta uma coluna — o resto do sistema é encontrado através dela. Tem efeito na próxima atualização."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En IP-adress per rad, för nätverk som blockerar den automatiska sökningen. En högtalare räcker oftast – resten av systemet hittas via den. Träder i kraft vid nästa uppdatering."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每行一个 IP 地址，适用于阻止自动搜索的网络。通常一台音箱即可——系统中的其余设备会通过它被找到。将在下次刷新时生效。"
          }
        }
      }
    },

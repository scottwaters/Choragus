    "softwareUpdatesBetaWarning" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beta-versioner er præ-udgivelser. De kan være ustabile, miste data eller ødelægge funktioner, der fungerer i den stabile version. Aktiver ikke dette på din eneste Mac. For at forlade beta-kanalen, sluk dette — du forbliver på den seneste beta, du installerede, indtil den næste stabile version indhenter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beta-Versionen sind Vorab-Builds. Sie können instabil sein, Daten verlieren oder Funktionen beschädigen, die in der stabilen Version funktionieren. Aktiviere dies nicht auf deinem einzigen Mac. Zum Verlassen des Beta-Kanals deaktivieren — du bleibst auf der zuletzt installierten Beta, bis das nächste stabile Release aufgeholt hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beta releases are pre-release builds. They may be unstable, lose data, or break features that work in the stable release. Don’t enable this on your only Mac. To leave the beta channel, turn this off — you’ll stay on the latest beta you installed until the next stable release catches up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las versiones beta son compilaciones previas. Pueden ser inestables, perder datos o romper funciones que funcionan en la versión estable. No lo actives en tu única Mac. Para salir del canal beta, desáctivalo — permanecerás en la última beta instalada hasta que la próxima versión estable la alcance."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les versions bêta sont des builds en pré-publication. Elles peuvent être instables, perdre des données ou casser des fonctionnalités qui fonctionnent dans la version stable. N’activez pas ceci sur votre seul Mac. Pour quitter le canal bêta, désactivez-le — vous resterez sur la dernière bêta installée jusqu’à ce que la prochaine version stable rattrape."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le versioni beta sono build di pre-rilascio. Possono essere instabili, perdere dati o rompere funzionalità che funzionano nella versione stabile. Non attivarlo sull’unico Mac che hai. Per lasciare il canale beta, disattivalo — rimarrai sull’ultima beta installata fino a quando la prossima versione stabile la raggiungerà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ベータ版はプレリリースビルドです。不安定だったり、データを失ったり、安定版で動作する機能を壊したりする可能性があります。唯一のMacでは有効にしないでください。ベータチャンネルから離脱するには、これをオフにしてください — 次の安定版が追いつくまで、インストール済みの最新ベータ版に留まります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beta-utgivelser er forhåndsutgaver. De kan være ustabile, miste data eller ødelegge funksjoner som fungerer i den stabile utgaven. Ikke aktiver dette på din eneste Mac. For å forlate beta-kanalen, slå av dette — du forblir på den siste betaen du installerte til neste stabile utgave tar igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bètaversies zijn pre-release builds. Ze kunnen onstabiel zijn, gegevens verliezen of functies breken die wel werken in de stabiele release. Schakel dit niet in op je enige Mac. Om het bètakanaal te verlaten, schakel dit uit — je blijft op de laatste bèta die je hebt geïnstalleerd tot de volgende stabiele versie inhaalt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wersje beta to przedpremierowe kompilacje. Mogą być niestabilne, tracić dane lub psuć funkcje, które działają w wersji stabilnej. Nie włączaj tego na swoim jedynym Macu. Aby opuścić kanał beta, wyłącz to — pozostaniesz na ostatniej zainstalowanej wersji beta, dopóki następna stabilna wersja jej nie dogoni."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As versões beta são compilações pré-lançamento. Podem ser instáveis, perder dados ou quebrar funcionalidades que funcionam na versão estável. Não ative isto no seu único Mac. Para sair do canal beta, desative isto — permanecerá na última beta instalada até que a próxima versão estável alcance."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betaversioner är förhandsbyggen. De kan vara instabila, förlora data eller bryta funktioner som fungerar i den stabila versionen. Aktivera inte detta på din enda Mac. För att lämna betakanalen, stäng av detta — du stannar på den senaste betan du installerade tills nästa stabila version kommer ikapp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "测试版是预发布构建。可能不稳定、丢失数据或破坏稳定版中可用的功能。不要在您唯一的 Mac 上启用此项。要离开测试通道，请关闭此项 — 您将停留在已安装的最新测试版，直到下一个稳定版赶上。"
          }
        }
      }
    },

    "helpAgentBulletHistory" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historik og vaner: senest afspillet, mest afspillet i enhver periode, stjernemarkerede numre, smarte køer, lyttestatistik — \"hvad har jeg spillet mest denne måned?\""
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlauf und Gewohnheiten: zuletzt gespielt, am häufigsten in beliebigem Zeitraum, markierte Titel, Smart-Warteschlangen, Hörstatistik — „was habe ich diesen Monat am meisten gehört?“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Play history and habits: recently played, most played over any window, starred tracks, smart queues, listening stats — \"what have I played most this month?\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historial y hábitos: reproducido recientemente, lo más escuchado en cualquier periodo, pistas destacadas, colas inteligentes, estadísticas — «¿qué he escuchado más este mes?»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historique et habitudes : écoutés récemment, les plus écoutés sur toute période, titres étoilés, files intelligentes, statistiques d'écoute — « qu'est-ce que j'ai le plus écouté ce mois-ci ? »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronologia e abitudini: riprodotti di recente, più ascoltati in qualsiasi periodo, brani con stella, code intelligenti, statistiche — «cosa ho ascoltato di più questo mese?»"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生履歴と傾向：最近再生、任意期間の最多再生、スター付き曲、スマートキュー、リスニング統計 —「今月いちばん聴いたのは？」"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historikk og vaner: nylig spilt, mest spilt i en valgfri periode, stjernemerkede spor, smarte køer, lyttestatistikk — «hva har jeg spilt mest denne måneden?»"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geschiedenis en gewoonten: recent gespeeld, meest gespeeld in elke periode, nummers met ster, slimme wachtrijen, luisterstatistieken — \"wat heb ik deze maand het meest gespeeld?\""
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historia i nawyki: ostatnio odtwarzane, najczęściej w dowolnym okresie, utwory z gwiazdką, inteligentne kolejki, statystyki słuchania — „czego słuchałem najwięcej w tym miesiącu?”"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Histórico e hábitos: tocado recentemente, mais tocado em qualquer período, faixas com estrela, filas inteligentes, estatísticas — «o que ouvi mais este mês?»"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historik och vanor: nyligen spelat, mest spelat under valfri period, stjärnmärkta spår, smarta köer, lyssningsstatistik — \"vad har jag spelat mest den här månaden?\""
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放历史和习惯：最近播放、任意时段最多播放、星标曲目、智能队列、收听统计——“这个月我听得最多的是什么？”"
          }
        }
      }
    },
    "helpAgentBulletHouse" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gruppere rum, festtilstand med rigtig fortryd, forudindstillinger (vise, anvende, gemme), linje- og tv-indgange, scan igen — \"sæt hele huset på køkkenet, og sæt det bagefter tilbage som det var\""
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Räume gruppieren, Partymodus mit echtem Rückgängig, Voreinstellungen (auflisten, anwenden, sichern), Line-In und TV-Eingänge, Neusuche — „das ganze Haus auf die Küche, danach wieder wie vorher“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Group rooms, party mode with a proper undo, presets (list, apply, save), line-in and TV inputs, rescan — \"put the whole house on the kitchen, then put it back the way it was\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrupar habitaciones, modo fiesta con deshacer real, ajustes preestablecidos (listar, aplicar, guardar), entradas de línea y TV, reescanear — «pon toda la casa con la cocina y luego déjalo como estaba»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grouper les pièces, mode fête avec un vrai retour arrière, préréglages (lister, appliquer, enregistrer), entrées ligne et TV, nouvelle recherche — « mets toute la maison sur la cuisine, puis remets comme avant »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raggruppare stanze, modalità festa con annulla vero, preset (elencare, applicare, salvare), ingressi line-in e TV, nuova scansione — «metti tutta la casa sulla cucina, poi rimetti com'era»"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部屋のグループ化、元に戻せるパーティーモード、プリセット（一覧・適用・保存）、ライン入力と TV 入力、再スキャン —「家全体をキッチンに合わせて、その後元に戻して」"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gruppere rom, festmodus med ekte angre, forvalg (liste, bruke, lagre), linje- og TV-innganger, søk på nytt — «sett hele huset på kjøkkenet, og sett det tilbake etterpå»"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamers groeperen, feestmodus met echt ongedaan maken, voorinstellingen (tonen, toepassen, opslaan), line-in en tv-ingangen, opnieuw zoeken — \"zet het hele huis op de keuken en daarna weer terug zoals het was\""
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupowanie pokoi, tryb imprezy z prawdziwym cofnięciem, ustawienia wstępne (lista, zastosowanie, zapis), wejścia liniowe i TV, ponowne skanowanie — „zgrupuj cały dom za kuchnią, a potem przywróć jak było”"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrupar salas, modo festa com anulação a sério, predefinições (listar, aplicar, guardar), entradas de linha e TV, nova procura — «põe a casa toda na cozinha e depois volta a pôr como estava»"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gruppera rum, partyläge med riktig ångra, förval (lista, tillämpa, spara), linje- och TV-ingångar, sök igen — \"lägg hela huset på köket och ställ sedan tillbaka som det var\""
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "房间分组、可真正撤销的派对模式、预设（列出、应用、保存）、线路输入和电视输入、重新扫描——“让全屋跟着厨房播放，之后恢复原样”"
          }
        }
      }
    },

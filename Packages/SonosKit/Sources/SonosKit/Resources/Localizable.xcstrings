    "visHistorySourceHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor væggen henter sine cover fra. Denne gruppe bruger kun spør, som de valgte højttalere har afspillet; Alle højttalere trækker fra hele biblioteket og giver en rigere blanding på bekostning af fokus."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelle, aus der die Wand ihre Cover bezieht. Diese Gruppe verwendet nur Titel, die von den ausgewählten Lautsprechern abgespielt wurden; Alle Lautsprecher zieht aus der gesamten Bibliothek für mehr Vielfalt auf Kosten des Fokus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where the wall pulls its art pool from. This group uses only tracks the selected speakers have played; All speakers pulls from your entire library, giving a richer mix at the cost of focus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Origen del repertorio de carátulas del muro. Este grupo usa solo temas que han sonado en los altavoces seleccionados; Todos los altavoces toma de toda tu biblioteca, con más variedad a costa de enfoque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définit l’origine des pochettes affichées sur le mur. Ce groupe utilise uniquement les titres lus par les enceintes sélectionnées ; Toutes les enceintes pioche dans toute la bibliothèque pour un mélange plus riche au prix de la cohérence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da dove la parete attinge le copertine. Questo gruppo usa solo i brani riprodotti dagli altoparlanti selezionati; Tutti gli altoparlanti pesca dall’intera libreria, offrendo un mix più ricco a discapito della coerenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "痁のアートワークの取得元です。「このグループ」は選択されたスピーカーで再生したトラックのみを使用し、「すべてのスピーカー」はライブラリ全体から取得します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor veggen henter coverne fra. Denne gruppen bruker bare spor som de valgte høyttalerne har spilt; Alle høyttalere henter fra hele biblioteket for en rikere blanding på bekostning av fokus."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waar de muur zijn hoezen vandaan haalt. Deze groep gebruikt alleen nummers die de geselecteerde luidsprekers hebben afgespeeld; Alle luidsprekers haalt uit je volledige bibliotheek voor meer variatie ten koste van focus."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skąd ściana czerpie okładki. Ta grupa używa tylko utworów odtworzonych przez wybrane głośniki; Wszystkie głośniki czerpie z całej biblioteki, dając bogatszy wybór kosztem spójności."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De onde o mural retira o seu acervo de capas. Este grupo usa apenas faixas reproduzidas pelas colunas selecionadas; Todas as colunas vai buscar a toda a biblioteca, com mais variedade à custa de foco."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Var väggen hämtar omslag. Denna grupp använder bara spår som de valda högtalarna har spelat; Alla högtalare hämtar från hela biblioteket för en rikare blandning på bekostnad av fokus."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "墙面插图库の来源。「此组」仅使用所选扬声器已播放の曲目；「所有扬声器」从整个曲库提取，以贴近性为代价換取更丰富の变化。"
          }
        }
      }
    },

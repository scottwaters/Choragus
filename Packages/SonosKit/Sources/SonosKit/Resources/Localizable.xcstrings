          "stringUnit" : {
            "state" : "translated",
            "value" : "クイックスタート：起動時にキャッシュされたスピーカーをすぐに表示し、ライブディスカバリーをバックグラウンドで実行します。"
          }
        },
        "nb" : {
          "stringUnit" : {

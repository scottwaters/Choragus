        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicio rápido: muestra los altavoces en caché al instante al iniciar mientras la detección en vivo se ejecuta en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Démarrage rapide : affiche instantanément les enceintes mises en cache au lancement pendant que la détection en direct tourne en arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {

    "listeningRidgesDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver kam = et topspor. Højde = afspilninger pr. dag. Nyeste fund øverst, toppe blomstrer på bingedage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Grat = ein Top-Titel. Höhe = Wiedergaben pro Tag. Neueste Entdeckungen oben, Spitzen entstehen an Binge-Tagen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each ridge = one top track. Height = plays per day. Newest finds at top, peaks bloom on binge days."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada cresta = una pista destacada. Altura = reproducciones por día. Los hallazgos más recientes arriba, los picos florecen en días de maratones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque crête = un titre populaire. Hauteur = lectures par jour. Les nouveautés en haut, les pics fleurissent les jours d’écoute intense."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni cresta = un brano in classifica. Altezza = riproduzioni al giorno. Le scoperte più recenti in alto, i picchi sbocciano nei giorni di binge."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各屡 = 一つのトップトラック。高さ = 1日あたりの再生回数。最新の発見は上、連続聴取の日にピークができます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver kam = ett toppspor. Høyde = avspillinger per dag. Nyeste funn øverst, topper blomstrer på bingedager."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke rug = één topnummer. Hoogte = afspelingen per dag. Nieuwste vondsten bovenaan, pieken bloeien op binge-dagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy grzbiet = jeden topowy utwór. Wysokość = odtworzenia na dzień. Najnowsze odkrycia u góry, szczyty wykwitają w dniach intensywnego słuchania."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada cume = uma faixa em destaque. Altura = reproduções por dia. As descobertas mais recentes no topo, picos crescem em dias intensos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje ränd = en topp-låt. Höjd = uppspelningar per dag. Nyaste fynd överst, toppar blommar på bingedagar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个山脈 = 一首热门曲目。高度 = 每日播放次数。最新发现位于顶部，连听日会形成山峰。"
          }
        }
      }

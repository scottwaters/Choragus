    "translationHelpNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser du en oversættelse, der er forkert eller unaturlig? [Opret en sag på GitHub](https://github.com/scottwaters/Choragus/issues) med sproget og dit forslag. Tak for hjælpen!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Übersetzung, die falsch oder unnatürlich klingt? Bitte [öffne ein Issue auf GitHub](https://github.com/scottwaters/Choragus/issues) mit der Sprache und einem Vorschlag. Danke für deine Hilfe!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spot a translation that’s wrong or unnatural? Please [open an issue on GitHub](https://github.com/scottwaters/Choragus/issues) with the language and the suggested wording. Thanks for helping!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Detectas una traducción incorrecta o poco natural? [Abre una incidencia en GitHub](https://github.com/scottwaters/Choragus/issues) indicando el idioma y tu sugerencia. ¡Gracias por colaborar!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous repérez une traduction incorrecte ou peu naturelle ? Merci de [signaler un ticket sur GitHub](https://github.com/scottwaters/Choragus/issues) en indiquant la langue et la formulation suggérée. Merci pour votre aide !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai notato una traduzione sbagliata o innaturale? [Apri un issue su GitHub](https://github.com/scottwaters/Choragus/issues) indicando la lingua e la formulazione suggerita. Grazie per il tuo aiuto!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誤訳や不自然な翻訳を見つけたら、[GitHubでIssueを作成](https://github.com/scottwaters/Choragus/issues)し、言語と修正案をお知らせください。ご協力ありがとうございます！"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ser du en oversettelse som er feil eller unaturlig? [Opprett en sak på GitHub](https://github.com/scottwaters/Choragus/issues) med språket og forslaget ditt. Takk for hjelpen!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zie je een vertaling die fout of onnatuurlijk klinkt? Open dan [een issue op GitHub](https://github.com/scottwaters/Choragus/issues) met de taal en je suggestie. Bedankt voor je hulp!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zauważyłeś błędne lub nienaturalne tłumaczenie? [Zgłoś problem na GitHubie](https://github.com/scottwaters/Choragus/issues) podając język i propozycję. Dzięki za pomoc!"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detetou uma tradução errada ou pouco natural? Por favor [abra uma issue no GitHub](https://github.com/scottwaters/Choragus/issues) com o idioma e a sugestão. Obrigado pela ajuda!"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hittar du en översättning som är fel eller onaturlig? [Öppna ett ärende på GitHub](https://github.com/scottwaters/Choragus/issues) med språket och ett förslag. Tack för hjälpen!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发现翻译有误或不自然？请[在 GitHub 上提交 issue](https://github.com/scottwaters/Choragus/issues)，告知语言和建议的措辞。感谢您的协助！"
          }
        }
      }
    },

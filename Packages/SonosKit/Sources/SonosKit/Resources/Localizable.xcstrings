    "helpBulletSystemTab" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System: Start (Hurtigstart eller Klassisk), Kommunikation (Hændelsesstyret eller Klassisk polling), Søgning (Auto, Bonjour eller Klassisk multicast), Avancerede netværksindstillinger (hændelsesport, hop-grænse, højttaleradresser) og Cache (coverstørrelse og alder, Ryd højttalercache, Ryd covercache)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System: Start (Schnellstart oder Klassisch), Kommunikation (Ereignisgesteuert oder Altes Polling), Suche (Automatisch, Bonjour oder Altes Multicast), Erweiterte Netzwerkeinstellungen (Ereignis-Port, Hop-Limit, Lautsprecheradressen) und Cache (Cover-Größe und -Alter, Lautsprecher-Cache leeren, Cover-Cache leeren)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System: Startup (Quick Start or Classic), Communication (Event-driven or Legacy polling), Discovery (Auto, Bonjour or Legacy Multicast), Advanced network settings (event listener port, hop limit, speaker addresses) and Cache (artwork size and age, Clear Speaker Cache, Clear Artwork Cache)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistema: Inicio (Inicio rápido o Clásico), Comunicación (Por eventos o Sondeo clásico), Detección (Auto, Bonjour o Multicast clásico), Ajustes de red avanzados (puerto del receptor de eventos, límite de saltos, direcciones de altavoces) y Caché (tamaño y antigüedad de carátulas, Vaciar caché de altavoces, Vaciar caché de carátulas)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Système : Démarrage (Rapide ou Classique), Communication (Événementielle ou Interrogation classique), Découverte (Auto, Bonjour ou Multicast classique), Réglages réseau avancés (port d'écoute des événements, limite de sauts, adresses d'enceintes) et Cache (taille et âge des pochettes, Vider le cache des enceintes, Vider le cache des pochettes)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistema: Avvio (Rapido o Classico), Comunicazione (A eventi o Polling classico), Rilevamento (Auto, Bonjour o Multicast classico), Impostazioni di rete avanzate (porta del listener eventi, limite hop, indirizzi dei diffusori) e Cache (dimensione ed età delle copertine, Svuota cache diffusori, Svuota cache copertine)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム：起動（クイックスタートまたはクラシック）、通信（イベント駆動またはレガシーポーリング）、検出（自動、Bonjour、レガシーマルチキャスト）、詳細ネットワーク設定（イベントリスナーのポート、ホップ制限、スピーカーアドレス）、キャッシュ（アートワークのサイズと保持期間、スピーカーキャッシュを消去、アートワークキャッシュを消去）。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System: Oppstart (Hurtigstart eller Klassisk), Kommunikasjon (Hendelsesstyrt eller Klassisk polling), Søk (Auto, Bonjour eller Klassisk multicast), Avanserte nettverksinnstillinger (hendelsesport, hoppgrense, høyttaleradresser) og Cache (omslagsstørrelse og alder, Tøm høyttalercache, Tøm omslagscache)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systeem: Opstarten (Snelstart of Klassiek), Communicatie (Gebeurtenisgestuurd of Klassiek pollen), Detectie (Auto, Bonjour of Klassiek multicast), Geavanceerde netwerkinstellingen (poort van de gebeurtenislistener, hoplimiet, speakeradressen) en Cache (grootte en leeftijd van hoezen, Speakercache wissen, Hoescache wissen)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System: Uruchamianie (Szybki start lub Klasyczny), Komunikacja (Zdarzeniowa lub Klasyczne odpytywanie), Wykrywanie (Auto, Bonjour lub Klasyczny multicast), Zaawansowane ustawienia sieci (port nasłuchu zdarzeń, limit skoków, adresy głośników) oraz Pamięć podręczna (rozmiar i wiek okładek, Wyczyść pamięć głośników, Wyczyść pamięć okładek)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistema: Arranque (Início rápido ou Clássico), Comunicação (Por eventos ou Sondagem clássica), Descoberta (Auto, Bonjour ou Multicast clássico), Definições de rede avançadas (porta do recetor de eventos, limite de saltos, endereços de colunas) e Cache (tamanho e idade das capas, Limpar cache de colunas, Limpar cache de capas)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System: Start (Snabbstart eller Klassisk), Kommunikation (Händelsestyrd eller Klassisk avfrågning), Sökning (Auto, Bonjour eller Klassisk multicast), Avancerade nätverksinställningar (händelseport, hoppgräns, högtalaradresser) och Cache (omslagsstorlek och ålder, Rensa högtalarcache, Rensa omslagscache)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统：启动（快速启动或经典）、通信（事件驱动或传统轮询）、发现（自动、Bonjour 或传统多播）、高级网络设置（事件监听端口、跳数限制、扬声器地址）和缓存（封面大小与保留时间、清除扬声器缓存、清除封面缓存）。"
          }
        }
      }
    },
    "helpBulletToolbar" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Værktøjslinjen fra venstre mod højre: Gennemse (⌘B), Kø (⌥⌘U), højttalermenuen (Pause alle, Genoptag alle, Slå lyd fra, Slå lyd til, Gruppeforudindstillinger), Playlistehåndtering (⌘L), Lyttestatistik (⇧⌘S), Alarmer (⇧⌘A), Visualisering (Karaoke ⌘K, Back of the Club ⌘J), Diagnostik, Støt, Hjælp (⌘?) og Indstillinger (⌘,)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Symbolleiste von links nach rechts: Durchsuchen (⌘B), Warteschlange (⌥⌘U), das Lautsprechermenü (Alle pausieren, Alle fortsetzen, Alle stumm, Alle laut, Gruppenvoreinstellungen), Playlist-Manager (⌘L), Hörstatistik (⇧⌘S), Wecker (⇧⌘A), Visualisierung (Karaoke ⌘K, Back of the Club ⌘J), Diagnose, Unterstützen, Hilfe (⌘?) und Einstellungen (⌘,)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The toolbar, left to right: Browse (⌘B), Play Queue (⌥⌘U), the speaker menu (Pause All, Resume All, Mute All, Unmute All, Group Presets), Playlist Manager (⌘L), Listening Stats (⇧⌘S), Alarms (⇧⌘A), Visualisation (Karaoke ⌘K, Back of the Club ⌘J), Diagnostics, Support, Help (⌘?) and Settings (⌘,)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barra de herramientas, de izquierda a derecha: Explorar (⌘B), Cola (⌥⌘U), el menú de altavoces (Pausar todo, Reanudar todo, Silenciar todo, Activar sonido, Ajustes de grupo), Gestor de listas (⌘L), Estadísticas (⇧⌘S), Alarmas (⇧⌘A), Visualización (Karaoke ⌘K, Back of the Club ⌘J), Diagnóstico, Apoyar, Ayuda (⌘?) y Ajustes (⌘,)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barre d'outils, de gauche à droite : Parcourir (⌘B), File de lecture (⌥⌘U), le menu enceintes (Tout mettre en pause, Tout reprendre, Tout couper, Tout rétablir, Préréglages de groupe), Gestionnaire de playlists (⌘L), Statistiques d'écoute (⇧⌘S), Alarmes (⇧⌘A), Visualisation (Karaoké ⌘K, Back of the Club ⌘J), Diagnostic, Soutenir, Aide (⌘?) et Réglages (⌘,)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La barra degli strumenti, da sinistra a destra: Sfoglia (⌘B), Coda (⌥⌘U), il menu diffusori (Metti tutto in pausa, Riprendi tutto, Silenzia tutto, Riattiva tutto, Preset di gruppo), Gestione playlist (⌘L), Statistiche di ascolto (⇧⌘S), Sveglie (⇧⌘A), Visualizzazione (Karaoke ⌘K, Back of the Club ⌘J), Diagnostica, Sostieni, Aiuto (⌘?) e Impostazioni (⌘,)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ツールバーは左から順に：ブラウズ（⌘B）、キュー（⌥⌘U）、スピーカーメニュー（すべて一時停止、すべて再開、すべて消音、消音解除、グループプリセット）、プレイリストマネージャ（⌘L）、リスニング統計（⇧⌘S）、アラーム（⇧⌘A）、ビジュアライゼーション（カラオケ ⌘K、Back of the Club ⌘J）、診断、サポート、ヘルプ（⌘?）、設定（⌘,）です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verktøylinjen fra venstre til høyre: Bla (⌘B), Kø (⌥⌘U), høyttalermenyen (Pause alle, Fortsett alle, Demp alle, Slå på alle, Gruppeforvalg), Spillelistebehandling (⌘L), Lyttestatistikk (⇧⌘S), Alarmer (⇧⌘A), Visualisering (Karaoke ⌘K, Back of the Club ⌘J), Diagnostikk, Støtt, Hjelp (⌘?) og Innstillinger (⌘,)."
          }
        },
        "nl" : {
          "stringUnit" : {

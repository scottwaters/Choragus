    "aboutCacheBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Højttaler-cachen gemmer din rumopsætning for øjeblikkelig start. Omslags-cachen gemmer albumomslag til hurtigere gennemsyn. Begge genopbygges automatisk efter rydning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Lautsprecher-Cache speichert deine Raumaufteilung für sofortigen Start. Der Cover-Cache speichert Albumcover für schnelleres Durchsuchen. Beide werden automatisch neu aufgebaut, wenn sie geleert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speaker cache stores your room layout for instant startup. Artwork cache stores album art for faster browsing. Both rebuild automatically when cleared."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El caché de altavoces guarda la disposición de habitaciones para arranque instantáneo. El caché de portadas guarda las portadas para una navegación más rápida. Ambos se reconstruyen automáticamente al vaciarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cache des enceintes stocke la disposition des pièces pour un démarrage instantané. Le cache des pochettes stocke les pochettes d’album pour une navigation plus rapide. Les deux se reconstruisent automatiquement après effacement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cache altoparlanti memorizza la disposizione delle stanze per avvio istantaneo. La cache copertine memorizza le copertine per navigare più veloce. Entrambe si ricostruiscono automaticamente dopo la cancellazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スピーカーキャッシュは即座の起動のために部屋レイアウトを保存します。アートワークキャッシュは高速なブラウズのためにアルバムアートを保存します。クリア後、どちらも自動的に再構築されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høyttalerbufferen lagrer romoppsett for umiddelbar oppstart. Omslagsbufferen lagrer albumomslag for raskere bla. Begge bygges om automatisk når de slettes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luidsprekercache slaat je kameropstelling op voor instant opstart. Hoescache slaat albumhoezen op voor sneller bladeren. Beide worden na wissen automatisch opnieuw opgebouwd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bufor głośników przechowuje układ pokoi dla natychmiastowego uruchomienia. Bufor okładek przechowuje okładki albumów dla szybszego przeglądania. Oba są odbudowywane automatycznie po wyczyszczeniu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cache de alto-falantes guarda o layout das salas para início instantâneo. O cache de capas armazena capas para navegação mais rápida. Ambos são recriados automaticamente após limpeza."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Högtalarcachen lagrar rumsuppsättningen för omedelbar start. Omslagscachen lagrar albumomslag för snabbare bläddring. Båda byggs om automatiskt efter rensning."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音箱缓存存储房间布局以便立即启动。封面缓存存储专辑封面以加快浏览。清除后两者都会自动重建。"
          }
        }
      }

    "helpNowPlayingDetailsBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under højttalerlydstyrkerne tilbyder et fanepanel Sangtekst, Info og Historik for det aktuelle spor. Panelet kan klappes ind — klik på chevronen på adskilleren for at skjule eller vise det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter den Lautstärken bietet ein Tab-Panel Liedtext, Info und Verlauf des aktuellen Titels. Das Panel ist einklappbar — klicke auf den Pfeil im Trennstrich, um es ein- oder auszublenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Below the speaker volumes a tabbed panel offers Lyrics, About, and History for the current track. The panel is collapsible — click the chevron on the divider to hide or show it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debajo de los volúmenes de los altavoces, un panel con pestañas ofrece Letra, Información e Historial de la pista actual. El panel se puede contraer — haz clic en el chevron del divisor para ocultarlo o mostrarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sous les volumes d’enceintes, un panneau à onglets propose Paroles, À propos et Historique du morceau en cours. Le panneau est repliable — cliquez sur le chevron du séparateur pour le masquer ou l’afficher."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto i volumi dei diffusori, un pannello a schede offre Testo, Info e Cronologia del brano in corso. Il pannello è comprimibile — fai clic sul chevron del divisore per nasconderlo o mostrarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スピーカーの音量の下に、現在のトラックに関する歌詞・情報・履歴のタブパネルがあります。パネルは折りたため可能—区切りのシェブロンをクリックすると表示/非表示が切り替わります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under høyttalervolumene tilbyr et fanepanel Sangtekst, Info og Historikk for det aktuelle sporet. Panelet kan kollapses — klikk på chevronen på skilletegnet for å skjule eller vise det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onder de speakervolumes biedt een tabbladpaneel Songtekst, Info en Geschiedenis voor het huidige nummer. Het paneel is inklapbaar — klik op de chevron op de scheidingslijn om het te verbergen of tonen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pod poziomami głośności głośników panel z kartami zawiera Tekst, Informacje i Historię bieżącego utworu. Panel można zwijać — kliknij szewron na separatorze, aby go ukryć lub pokazać."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abaixo dos volumes das colunas, um painel com separadores oferece Letra, Informações e Histórico para a faixa atual. O painel é retrátil — clique no chevron no separador para ocultá-lo ou mostrá-lo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under högtalarvolymerna erbjuder en flikpanel Sångtext, Info och Historik för aktuellt spår. Panelen kan fällas in — klicka på chevronen på avgränsaren för att dölja eller visa den."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "揚声器音量下方有一个带标签页的面板，提供当前曲目的歌词、信息与历史。面板可折叠—点击分隔线上的人字形图标以隐藏或显示。"
          }
        }
      }
    },

    "classicShuffleHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når aktiveret bruger tilfældig-knappen på afspilleren Sonos-tilstand. Deaktiveret (standard): brug tilfældig-knappen i køen for at omarrangere numrene fysisk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, verwendet die Zufallswiedergabe-Taste am Player den Sonos-Zufallsmodus. Wenn deaktiviert (Standard), verwende die Zufallswiedergabe-Taste in der Warteschlange, um die Titel physisch neu anzuordnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, the shuffle button on the player uses Sonos play mode shuffle. When disabled (default), use the queue shuffle button to physically reorder tracks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando está activado, el botón aleatorio del reproductor usa el modo aleatorio de Sonos. Cuando está desactivado (por defecto), usa el botón aleatorio de la cola para reordenar las pistas físicamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsqu’activé, le bouton de lecture aléatoire utilise le mode aléatoire Sonos. Lorsqu’il est désactivé (par défaut), utilisez le bouton de la file d’attente pour réordonner physiquement les pistes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se attivo, il pulsante casuale del player usa la modalità casuale di Sonos. Se disattivato (predefinito), usa il pulsante casuale della coda per riordinare fisicamente i brani."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にするとプレーヤーのシャッフルボタンが Sonos 再生モードで動作します。無効(標準)の場合はキューのシャッフルボタンでトラックを物理的に並び替えます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når aktivert bruker tilfeldig-knappen på spilleren Sonos avspillingsmodus. Deaktivert (standard): bruk tilfeldig-knappen i køen for å omorganisere sporene fysisk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer ingeschakeld gebruikt de shuffle-knop op de speler Sonos play-mode shuffle. Uit (standaard): gebruik de shuffle-knop in de wachtrij om nummers fysiek te herschikken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy włączone, przycisk losowy w odtwarzaczu używa trybu losowego Sonos. Wyłączone (domyślnie): użyj przycisku losowego w kolejce, aby fizycznie zmienić kolejność utworów."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, o botão aleatório do player usa o modo aleatório do Sonos. Desativado (padrão): use o botão aleatório da fila para reordenar as faixas fisicamente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När aktiverat använder blandningsknappen på spelaren Sonos blandningsläge. Avaktiverat (standard): använd blandningsknappen i kön för att ordna om spår fysiskt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用时，播放器上的随机按钮使用 Sonos 随机播放模式。禁用（默认）时，使用队列随机按钮实际重排曲目。"
          }
        }
      }
    },

    "arcsDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top-kunstnere på grundlinjen. Buer forbinder fortløbende afspilninger; tykkere = flere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top-Künstler auf der Grundlinie. Bögen verbinden aufeinanderfolgende Wiedergaben; dicker = mehr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top artists on the baseline. Arcs connect consecutive plays; thicker = more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artistas top en la línea base. Los arcos conectan reproducciones consecutivas; más grueso = más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artistes principaux sur la ligne de base. Les arcs relient les lectures consécutives ; plus épais = plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artisti top sulla linea di base. Gli archi collegano riproduzioni consecutive; più spessi = di più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ベースライン上のトップアーティスト。アークは連続する再生を接続します；太いほど多い。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topp-artister på grunnlinjen. Buer kobler etterfølgende avspillinger; tykkere = flere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topartiesten op de basislijn. Bogen verbinden opeenvolgende afspelingen; dikker = meer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topowi artyści na linii bazowej. Łuki łączą kolejne odtworzenia; grubsze = więcej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top artistas na linha de base. Os arcos ligam reproduções consecutivas; mais grossos = mais."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Topp-artister på baslinjen. Bågar förbinder på varandra följande uppspelningar; tjockare = fler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基线上的顶尖艺术家。弧线连接连续的播放；越粗 = 越多。"
          }
        }
      }
    },

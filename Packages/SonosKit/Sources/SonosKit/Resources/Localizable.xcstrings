    "timeSpiralsOutwardDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiden spiralerer ud. Hver prik = en afspilning, farvet efter tjeneste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zeit windet sich nach außen. Jeder Punkt = eine Wiedergabe, nach Dienst eingefärbt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time spirals outward. Each dot = one play, coloured by service."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tiempo se enrolla hacia fuera. Cada punto = una reproducción, coloreado por servicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le temps spirale vers l’extérieur. Chaque point = une lecture, colorée par service."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tempo si avvolge a spirale verso l’esterno. Ogni punto = una riproduzione, colorata per servizio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間は外側に渦巻き状に広がります。各ドット = 1回の再生、サービスごとに色付けされます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiden spiraler utover. Hver prikk = én avspilling, farget etter tjeneste."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tijd spiraalt naar buiten. Elke stip = één weergave, gekleurd per dienst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czas zwija się w spiralę na zewnątrz. Każda kropka = jedno odtworzenie, kolor według usługi."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tempo espiraliza para fora. Cada ponto = uma reprodução, colorida por serviço."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiden spiralar utåt. Varje prick = en uppspelning, färgad per tjänst."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时间向外螺旋。每个点 = 一次播放，按服务着色。"
          }
        }
      }
    },

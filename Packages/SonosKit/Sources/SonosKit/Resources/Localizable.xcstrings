        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Line-In listet jeden Lautsprecher mit physischem Eingang: analog bei Connect, Amp, Five, Play:5 und Move; TV bei Arc, Beam, Playbar, Playbase und Ray. Der Eingang kann in jedem Raum abgespielt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Line-In lists every speaker with a physical input: analog on Connect, Amp, Five, Play:5 and Move; TV on Arc, Beam, Playbar, Playbase and Ray. The input can play in any room."
          }
        },
        "es" : {
          "stringUnit" : {

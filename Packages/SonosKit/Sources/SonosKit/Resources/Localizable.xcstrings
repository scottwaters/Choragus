    "resetIgnoredTooltip" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ryd tidligere ignorerede rækker, så de revurderes mod de aktuelle filtre ved næste kørsel. Sendte rækker bevares."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",

    "helpBulletAITab" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI: de AI-tjenester, playlistebyggeren genererer med, og Agentadgang (MCP) til assistenter — hver har sit eget hjælpeemne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KI: die KI-Dienste, mit denen der Playlist-Builder erzeugt, und Agentenzugriff (MCP) für Assistenten — beide haben ein eigenes Hilfethema."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI: the AI services the Playlist Builder generates with, and Agent access (MCP) for assistants — each has its own Help topic."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IA: los servicios de IA con los que genera el constructor de listas, y Acceso de agentes (MCP) para asistentes; cada uno tiene su tema de ayuda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IA : les services d'IA utilisés par le constructeur de playlists, et l'Accès des agents (MCP) pour les assistants — chacun a sa rubrique d'aide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IA: i servizi di IA con cui genera il costruttore di playlist, e Accesso agenti (MCP) per gli assistenti — ognuno ha il proprio argomento di aiuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI：プレイリストビルダーが生成に使う AI サービスと、アシスタント向けのエージェントアクセス（MCP）。それぞれ専用のヘルプ項目があります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KI: KI-tjenestene spillelistebyggeren genererer med, og Agenttilgang (MCP) for assistenter — hver har sitt eget hjelpeemne."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI: de AI-diensten waarmee de afspeellijstbouwer genereert, en Agenttoegang (MCP) voor assistenten — elk met een eigen Help-onderwerp."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI: usługi AI, z których korzysta kreator playlist, oraz Dostęp agentów (MCP) dla asystentów — każde ma własny temat Pomocy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IA: os serviços de IA com que o construtor de playlists gera, e Acesso de agentes (MCP) para assistentes — cada um tem o seu tópico de Ajuda."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI: de AI-tjänster spellistbyggaren genererar med, och Agentåtkomst (MCP) för assistenter — var och en har ett eget hjälpämne."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI：播放列表构建器用于生成的 AI 服务，以及面向助手的代理访问（MCP）——各有独立的帮助主题。"
          }
        }
      }

          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens a pre-filled issue on GitHub. If the bundle is too large for the URL, it’s copied to your clipboard so you can paste it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre una incidencia prerrellena en GitHub. Si el paquete es demasiado grande para la URL, se copia al portapapeles para que lo pegues."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre un ticket pré-rempli sur GitHub. Si le lot est trop volumineux pour l’URL, il est copié dans le presse-papiers pour le coller."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre un issue precompilato su GitHub. Se il pacchetto è troppo grande per l’URL, viene copiato negli appunti così puoi incollarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHubに事前入力済みのIssueを開きます。バンドルがURLには大きすぎる場合、クリップボードにコピーされ、貼り付けて使えます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åpner en forhåndsutfylt sak på GitHub. Hvis pakken er for stor for URL-en, kopieres den til utklippstavlen så du kan lime den inn."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",

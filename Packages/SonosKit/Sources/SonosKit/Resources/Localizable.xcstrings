    "discoveryAutoHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto kører begge — behold den, medmindre dit netværk kræver en bestemt transport."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto verwendet beide — nur ändern, wenn dein Netzwerk gezielt eine Variante erfordert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto runs both — keep it unless you know your network needs one specific transport."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto usa ambos — déjalo así salvo que tu red requiera un transporte específico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto utilise les deux — laissez tel quel sauf si votre réseau exige un transport spécifique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto utilizza entrambi — lascialo così a meno che la tua rete richieda un trasporto specifico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自動」は両方を使用します。特定のトランスポートが必要な場合のみ変更してください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto kjører begge — behold med mindre nettverket ditt krever én bestemt transport."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto gebruikt beide — laat staan tenzij je netwerk één specifieke methode vereist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto używa obu — pozostaw, chyba że Twoja sieć wymaga konkretnego transportu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto usa ambos — mantenha, a menos que sua rede exija um transporte específico."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto kör båda — behåll om inte ditt nätverk kräver en specifik transport."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“自动”同时运行两者。除非您的网络明确需要某一种传输方式，否则请保持此设置。"
          }
        }
      }
    },
    "discoveryComfortDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver stjerne = en uge. X = % fra top-3-kunstnere. Y = % fra kunstnere, du ikke har hørt i 30 dage. Spor = din smagsvej gennem tiden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Stern = eine Woche. X = % von den Top-3-Künstlern. Y = % von Künstlern, die du 30 Tage lang nicht gehört hast. Spur = dein Geschmackspfad durch die Zeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each star = one week. X = % from top-3 artists. Y = % from artists you hadn't heard in 30 days. Trail = your taste path through time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada estrella = una semana. X = % de los 3 artistas top. Y = % de artistas que no escuchabas hacía 30 días. Estela = tu camino de gustos en el tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque étoile = une semaine. X = % des 3 artistes les plus écoutés. Y = % d’artistes non entendus depuis 30 jours. Sentier = votre parcours de goûts dans le temps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni stella = una settimana. X = % dai primi 3 artisti. Y = % da artisti non ascoltati da 30 giorni. Scia = il tuo percorso di gusti nel tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各星 = 一週間。X = トップ3アーティストの割合。Y = 30日間聴いていないアーティストの割合。跡 = 時間を通した趣味の路。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver stjerne = én uke. X = % fra topp-3-artister. Y = % fra artister du ikke har hørt på 30 dager. Spor = din smaksvei gjennom tiden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke ster = één week. X = % van de top-3 artiesten. Y = % van artiesten die je 30 dagen niet had gehoord. Spoor = je smaakpad door de tijd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda gwiazda = jeden tydzień. X = % z top-3 artystów. Y = % z artystów niesilszanych przez 30 dni. Ślad = Twoja ścieżka gustu w czasie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada estrela = uma semana. X = % dos top-3 artistas. Y = % de artistas não ouvidos há 30 dias. Trilho = o seu caminho de gostos no tempo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje stjärna = en vecka. X = % från topp-3-artister. Y = % från artister du inte hört på 30 dagar. Spår = din smakväg genom tiden."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每颗星 = 一周。X = 来自前 3 位艺术家的百分比。Y = 来自 30 天未听过的艺术家的百分比。轨迹 = 您随时间推移的品味路径。"
          }
        }
      }
    },

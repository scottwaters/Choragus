    "legendUntested" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikke testet — vi ved endnu ikke, om denne tjeneste virker gennem Choragus. Tryk på Tilslut for at prøve; rapportér resultatet på GitHub, så vi kan markere den som bekræftet virkende."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ungetestet — wir wissen noch nicht, ob dieser Dienst über Choragus funktioniert. Auf Verbinden tippen, um es zu versuchen; bitte melde Erfolg oder Misserfolg auf GitHub, damit wir ihn als bestätigt funktionierend markieren können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",

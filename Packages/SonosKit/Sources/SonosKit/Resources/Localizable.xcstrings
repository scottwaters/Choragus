    "sourcesDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvilke højttaleres/rums historik der scrobbles. Gruppeafspilning matcher ethvert medlem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcher Lautsprecher/Raum-Verlauf gescrobbelt wird. Gruppenwiedergabe passt auf beliebige Mitglieder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Which speakers/rooms' history to scrobble. Group playback matches any member."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De qué altavoces/habitaciones se envía el historial. La reproducción en grupo coincide con cualquier miembro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quels haut-parleurs/pièces dont l’historique sera scrobblé. La lecture groupée correspond à n’importe quel membre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di quali altoparlanti/stanze inviare la cronologia. La riproduzione in gruppo corrisponde a qualsiasi membro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのスピーカー/部屋の履歴をスクロブルするか。グループ再生はいずれかのメンバーに一致します。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvilke høyttaleres/rommenes logg som scrobbles. Gruppeavspilling samsvarer med ethvert medlem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welke luidsprekers/kamers’ geschiedenis gescrobbled wordt. Groepsafspelen matcht elk lid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historia których głośników/pokoi ma być scrobblowana. Odtwarzanie grupowe pasuje do dowolnego członka."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De quais alto-falantes/salas enviar o histórico. A reprodução em grupo corresponde a qualquer membro."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vilka högtalares/rums historik att scrobbla. Gruppuppspelning matchar vilken medlem som helst."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要 Scrobble 的音箱/房间历史。群组播放匹配任一成员。"
          }
        }
      }
    },

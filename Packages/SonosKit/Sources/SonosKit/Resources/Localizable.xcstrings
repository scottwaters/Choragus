    "helpBrowsingMusicBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik på musikbiblioteksknappen i værktøjslinjen, eller tryk ⌘B, for at åbne browserpanelet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke in der Symbolleiste auf die Schaltfläche für die Musikbibliothek oder drücke ⌘B, um das Browser-Panel zu öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click the music-library button in the toolbar, or press ⌘B, to open the browser panel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en el botón de biblioteca musical en la barra de herramientas, o pulsa ⌘B, para abrir el panel del explorador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur le bouton de la bibliothèque musicale dans la barre d’outils, ou appuyez sur ⌘B, pour ouvrir le panneau du navigateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic sul pulsante della libreria musicale nella barra degli strumenti, oppure premi ⌘B, per aprire il pannello del browser."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ツールバーのミュージックライブラリボタンをクリックするか、⌘Bを押してブラウザーパネルを開きます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikk på musikkbibliotek-knappen i verktøylinjen, eller trykk ⌘B, for å åpne leserpanelet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik op de muziekbibliotheekknop in de werkbalk of druk op ⌘B om het browserpaneel te openen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij przycisk biblioteki muzycznej na pasku narzędzi lub naciśnij ⌘B, aby otworzyć panel przeglądarki."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique no botão da biblioteca de música na barra de ferramentas, ou pressione ⌘B, para abrir o painel do navegador."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicka på musikbiblioteksknappen i verktygsfältet, eller tryck ⌘B, för att öppna bläddringspanelen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

    "helpBulletBothSystems" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis begge systemer er til stede, viser sidepanelet en S2-sektion og en S1-sektion adskilt af en vandret skillelinje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn beide Systeme vorhanden sind, zeigt die Seitenleiste einen S2- und einen S1-Abschnitt, getrennt durch einen horizontalen Trenner."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If both systems are present, the sidebar shows an S2 section and an S1 section separated by a horizontal divider."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ambos sistemas están presentes, la barra lateral muestra una sección S2 y una S1 separadas por un divisor horizontal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si les deux systèmes sont présents, la barre latérale affiche une section S2 et une section S1 séparées par un séparateur horizontal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se entrambi i sistemi sono presenti, la barra laterale mostra una sezione S2 e una sezione S1 separate da un divisore orizzontale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両方のシステムが存在する場合、サイドバーにはS2セクションとS1セクションが横区切り線で区切られて表示されます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis begge systemer er til stede, viser sidefeltet en S2-seksjon og en S1-seksjon adskilt av en horisontal skillelinje."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als beide systemen aanwezig zijn, toont de zijbalk een S2- en een S1-sectie, gescheiden door een horizontale scheidingslijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli oba systemy są obecne, panel boczny pokazuje sekcję S2 i sekcję S1 oddzielone poziomym separatorem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ambos os sistemas estiverem presentes, a barra lateral mostra uma seção S2 e uma seção S1 separadas por um divisor horizontal."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om båda systemen finns visar sidofältet en S2-sektion och en S1-sektion åtskilda av en horisontell avdelare."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果两个系统都存在，侧边栏会显示一个 S2 部分和一个 S1 部分，用水平分隔线分隔。"
          }
        }
      }
    },
    "helpBulletChoragusSources" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus-kilder samler det, Choragus tilføjer ud over Sonos: Playlistehåndtering, Byg playliste med AI, hver medieserver, TuneIn (RadioTime-søgning, der giver en direkte stream), suno.ai og linjeindgang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus-Quellen bündelt, was Choragus über Sonos hinaus bietet: Playlist-Manager, Playlist mit KI erstellen, jeden Medienserver, TuneIn (RadioTime-Suche mit direktem Stream), suno.ai und Line-In."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus Sources gathers what Choragus adds beyond Sonos: Playlist Manager, Build Playlist with AI, each media server, TuneIn (RadioTime search that resolves to a direct stream), suno.ai and Line-In."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuentes de Choragus reúne lo que Choragus añade a Sonos: Gestor de listas, Crear lista con IA, cada servidor multimedia, TuneIn (búsqueda RadioTime resuelta a un flujo directo), suno.ai y Entrada de línea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sources Choragus regroupe ce que Choragus ajoute à Sonos : Gestionnaire de playlists, Créer une playlist avec l'IA, chaque serveur multimédia, TuneIn (recherche RadioTime résolue en flux direct), suno.ai et l'entrée ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorgenti Choragus raccoglie ciò che Choragus aggiunge a Sonos: Gestione playlist, Crea playlist con IA, ogni server multimediale, TuneIn (ricerca RadioTime risolta in flusso diretto), suno.ai e Line-In."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus ソースには、Sonos に加えて Choragus が提供するものが集まります。プレイリストマネージャ、AI でプレイリストを作成、各メディアサーバー、TuneIn（RadioTime 検索から直接ストリームを解決）、suno.ai、ライン入力です。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus-kilder samler det Choragus legger til utover Sonos: Spillelistebehandling, Bygg spilleliste med KI, hver medieserver, TuneIn (RadioTime-søk som gir en direkte strøm), suno.ai og linjeinngang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus-bronnen bundelt wat Choragus naast Sonos toevoegt: Afspeellijstbeheer, Afspeellijst maken met AI, elke mediaserver, TuneIn (RadioTime-zoeken dat naar een directe stream leidt), suno.ai en Line-In."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Źródła Choragus zbierają to, co Choragus dodaje ponad Sonos: Menedżer playlist, Buduj playlistę z AI, każdy serwer multimediów, TuneIn (wyszukiwanie RadioTime dające bezpośredni strumień), suno.ai i wejście liniowe."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fontes Choragus reúne o que o Choragus acrescenta ao Sonos: Gestor de playlists, Construir playlist com IA, cada servidor multimédia, TuneIn (pesquisa RadioTime resolvida num fluxo direto), suno.ai e Entrada de linha."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus-källor samlar det Choragus lägger till utöver Sonos: Spellisthanteraren, Bygg spellista med AI, varje mediaserver, TuneIn (RadioTime-sökning som ger en direkt ström), suno.ai och linjeingång."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choragus 来源汇集了 Choragus 在 Sonos 之外提供的内容：播放列表管理器、用 AI 构建播放列表、各媒体服务器、TuneIn（RadioTime 搜索并解析为直接流）、suno.ai 和线路输入。"
          }
        }
      }
    },
    "helpBulletColors" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farver: tilpas accentprikken, indikatoren for spillende zone og indikatoren for inaktiv zone uafhængigt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farben: Passe den Akzent-Punkt, den Indikator für die spielende Zone und den Indikator für inaktive Zonen unabhängig voneinander an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colors: customise the accent dot, the playing-zone indicator, and the inactive-zone indicator independently."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colores: personaliza el punto de acento, el indicador de zona en reproducción y el indicador de zona inactiva de forma independiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couleurs : personnalisez indépendamment la pastille d’accent, l’indicateur de zone en lecture et l’indicateur de zone inactive."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colori: personalizza in modo indipendente il punto d’accento, l’indicatore della zona in riproduzione e l’indicatore della zona inattiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "色：アクセントドット、再生中ゾーンインジケーター、非アクティブゾーンインジケーターをそれぞれ独立にカスタマイズできます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Farger: tilpass aksentprikken, indikatoren for spillende sone og indikatoren for inaktiv sone uavhengig av hverandre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleuren: pas de accentstip, de indicator voor de spelende zone en de indicator voor inactieve zones onafhankelijk aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolory: niezależnie dostosuj kropkę akcentu, wskaźnik strefy odtwarzania i wskaźnik strefy nieaktywnej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cores: personalize o ponto de destaque, o indicador de zona em reprodução e o indicador de zona inativa de forma independente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Färger: anpassa accentpricken, indikatorn för spelande zon och indikatorn för inaktiv zon oberoende av varandra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "颜色：可分别自定义强调色圆点、正在播放区指示器以及非活动区指示器。"
          }
        }
      }
    },
    "helpBulletCommunication" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommunikationstilstand: hændelsesstyret (standard, effektiv) eller klassisk polling (kompatibilitetsreserve)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommunikationsmodus: ereignisgesteuert (Standard, effizient) oder klassisches Polling (Kompatibilitäts-Fallback)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Communication mode: event-driven (default, efficient) or legacy polling (compatibility fallback)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modo de comunicación: por eventos (predeterminado, eficiente) o sondeo clásico (alternativa de compatibilidad)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mode de communication : piloté par événements (par défaut, efficace) ou interrogation classique (repli de compatibilité)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modalità di comunicazione: basata su eventi (predefinita, efficiente) o polling legacy (fallback di compatibilità)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通信モード：イベント駆動（デフォルト、効率的）または従来のポーリング（互換用フォールバック）。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommunikasjonsmodus: hendelsesdrevet (standard, effektiv) eller eldre polling (kompatibilitetsreserve)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Communicatiemodus: event-gedreven (standaard, efficiënt) of klassieke polling (compatibiliteitsfallback)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryb komunikacji: oparty na zdarzeniach (domyślny, wydajny) lub klasyczne odpytywanie (awaryjny dla zgodności)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modo de comunicação: orientado a eventos (padrão, eficiente) ou consulta legada (fallback de compatibilidade)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kommunikationsläge: händelsestyrd (standard, effektiv) eller klassisk polling (kompatibilitetsreserv)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通信模式：事件驱动（默认、高效）或传统轮询（兼容回退）。"
          }
        }
      }
    },
    "helpBulletControlsMenu" : {

    "eventListenerPortHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Højttalerne sender statusopdateringer til denne TCP-port. Tilpas firewallregler derefter. Træder i kraft efter genstart."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lautsprecher senden Statusaktualisierungen an diesen TCP-Port. Firewall-Regeln entsprechend anpassen. Wirksam nach Neustart."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speakers push state updates to this TCP port. Match any firewall rule to it. Takes effect after relaunch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los altavoces envían actualizaciones de estado a este puerto TCP. Ajuste las reglas del cortafuegos en consecuencia. Surte efecto tras reiniciar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les enceintes envoient leurs mises à jour d’état vers ce port TCP. Adaptez vos règles de pare-feu en conséquence. Prend effet après redémarrage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I diffusori inviano gli aggiornamenti di stato a questa porta TCP. Allineare le regole del firewall. Ha effetto dopo il riavvio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スピーカーはこのTCPポートに状態更新を送信します。ファイアウォール規則を合わせてください。再起動後に有効。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høyttalerne sender statusoppdateringer til denne TCP-porten. Tilpass brannmurregler deretter. Trår i kraft etter omstart."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speakers sturen statusupdates naar deze TCP-poort. Stem firewallregels hierop af. Wordt actief na herstart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Głośniki wysyłają aktualizacje stanu na ten port TCP. Dostosuj reguły zapory. Działa po ponownym uruchomieniu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As colunas enviam atualizações de estado para esta porta TCP. Ajuste as regras de firewall em conformidade. Tem efeito após reiniciar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Högtalarna skickar statusuppdateringar till denna TCP-port. Anpassa brandväggsregler därefter. Träder i kraft efter omstart."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音箱将状态更新推送到此TCP端口。请相应调整防火墙规则。重启后生效。"
          }
        }
      }
    },

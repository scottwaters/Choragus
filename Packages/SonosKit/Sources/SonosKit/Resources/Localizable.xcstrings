    "albumConstellationsDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver ring = et album. Stjerner = dens spor. Lysstyrke = afspilninger. Stjerner tændes i den rækkefølge, du først afspillede dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Ring = ein Album. Sterne = seine Titel. Helligkeit = Wiedergaben. Sterne leuchten in der Reihenfolge auf, in der du sie zuerst gespielt hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each ring = one album. Stars = its tracks. Brightness = plays. Stars light up in the order you first played them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada anillo = un álbum. Estrellas = sus pistas. Brillo = reproducciones. Las estrellas se iluminan en el orden en que las reproduciste primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque anneau = un album. Les étoiles = ses pistes. Luminosité = lectures. Les étoiles s’allument dans l’ordre où vous les avez écoutées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni anello = un album. Stelle = i suoi brani. Luminosità = riproduzioni. Le stelle si accendono nell’ordine in cui le hai ascoltate per primo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各リング = 一つのアルバム。星 = トラック。明るさ = 再生回数。初めて再生された順に星が輝きます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver ring = ett album. Stjerner = sporene. Lysstyrke = avspillinger. Stjerner tennes i den rekkefølgen du først spilte dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke ring = één album. Sterren = de nummers. Helderheid = afspelingen. Sterren lichten op in de volgorde waarin je ze eerst hebt afgespeeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy pierścień = jeden album. Gwiazdy = jego utwory. Jasność = odtworzenia. Gwiazdy zapalają się w kolejności pierwszego odtworzenia."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada anel = um álbum. Estrelas = as faixas. Brilho = reproduções. As estrelas acendem pela ordem em que as reproduziu primeiro."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje ring = ett album. Stjärnor = dess låtar. Ljusstyrka = uppspelningar. Stjärnor tänds i den ordning du först spelade dem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个环 = 一张专辑。星星 = 专辑中的曲目。亮度 = 播放次数。星星按您首次播放的顺序依次点亮。"
          }
        }
      }
    },

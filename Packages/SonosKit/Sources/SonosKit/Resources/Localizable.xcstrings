          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inställningar"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置"
          }
        }
      }
    },
    "setupStep1Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjenester uden forbindelse (TuneIn, Calm Radio, Apple Music-søgning) kan aktiveres via et afkrydsningsfelt. For Spotify klikker du på Tilslut for at logge ind i browseren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dienste ohne Verbindung (TuneIn, Calm Radio, Apple Music-Suche) können per Kontrollkästchen aktiviert werden. Bei Spotify auf Verbinden klicken, um dich im Browser anzumelden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Services that don't need a connection (TuneIn, Calm Radio, Apple Music Search) can be enabled with a checkbox. For Spotify, click Connect to sign in via your browser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los servicios sin conexión (TuneIn, Calm Radio, búsqueda de Apple Music) se habilitan con una casilla. Para Spotify, pulsa Conectar para iniciar sesión en el navegador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les services sans connexion (TuneIn, Calm Radio, recherche Apple Music) peuvent être activés par une case à cocher. Pour Spotify, cliquez sur Se connecter pour vous authentifier dans votre navigateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I servizi senza connessione (TuneIn, Calm Radio, ricerca Apple Music) si abilitano con una casella. Per Spotify, clicca Connetti per accedere dal browser."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続不要のサービス(TuneIn, Calm Radio, Apple Music 検索)はチェックボックスで有効にできます。Spotify は接続をクリックしてブラウザでサインインしてください。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjenester uten tilkobling (TuneIn, Calm Radio, Apple Music-søk) aktiveres med en avkrysningsboks. For Spotify, klikk Koble til for å logge på i nettleseren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diensten zonder verbinding (TuneIn, Calm Radio, Apple Music-zoeken) kun je via een selectievakje inschakelen. Voor Spotify klik je op Verbinden om in je browser aan te melden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usługi nie wymagające połączenia (TuneIn, Calm Radio, wyszukiwanie Apple Music) można włączyć polem wyboru. Dla Spotify kliknij Połącz, aby zalogować się w przeglądarce."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serviços sem conexão (TuneIn, Calm Radio, busca do Apple Music) podem ser ativados com uma caixa. Para Spotify, clique em Conectar para entrar pelo navegador."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjänster som inte kräver anslutning (TuneIn, Calm Radio, Apple Music-sök) aktiveras via en kryssruta. För Spotify, klicka på Anslut för att logga in i webbläsaren."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需连接的服务（TuneIn、Calm Radio、Apple Music 搜索）可通过复选框启用。Spotify 请点击连接在浏览器中登录。"
          }
        }
      }
    },
